[{"text":"인도 - 칼랄 이디가 43","width":0.17808219178082196,"x":0.7899543391715589,"y":0.9613526570853462,"height":0.01449275362318836},{"y":0.9194847020243846,"text":"인도 칼랄 이디가 카스트의 인구는","width":0.3013698630136986,"x":0.08675798871493803,"height":0.019323671497584627},{"y":0.8904991948604402,"text":"현재 200만 명이 조금 넘습니다.","width":0.2899543378995434,"height":0.024154589371980673,"x":0.086757993283866},{"height":0.03248956161228733,"text":"기도제목","x":0.6711772858156249,"width":0.16449474526322594,"y":0.8806956379465496},{"width":0.365296803652968,"height":0.019323671497584516,"y":0.8695652173107891,"text":"그들은 술 생산으로 알려져 힌두 사회에서","x":0.08675798858447492},{"height":0.020933977455716568,"text":"경멸을 받습니다. 예수께서는 칼랄 이디가 같은","x":0.0867579938193085,"y":0.843800322141707,"width":0.41324200913242015},{"x":0.5707762529490108,"width":0.33105022831050224,"text":"• 칼랄 이디가 공동체가 복음 안에서","y":0.834138486231884,"height":0.019323671497584516},{"width":0.3447488584474886,"y":0.816425120598497,"text":"사람들을 자유롭게 하시러 오셨습니다.","height":0.020933977455716568,"x":0.08675799370243524},{"text":"자유와 치유, 공급, 소망을 갖고","width":0.273972602739726,"height":0.02254428341384862,"y":0.8067632851247987,"x":0.600456622716895},{"height":0.019323671497584516,"y":0.7842190015297906,"width":0.2557077625570776,"text":"하나님의 사랑을 통해 존엄이","x":0.6004566194063927},{"width":0.11218525612190977,"text":"회복되도록.","y":0.7579928450253992,"x":0.6003000671216168,"height":0.02024619398869565},{"y":0.7085346215110038,"height":0.017713365539452464,"text":"• 많은 칼랄 이디가 사람들이 예수님을","width":0.3470319634703197,"x":0.5707762528158294},{"width":0.2808219178082192,"height":0.017713365539452464,"x":0.600456623010437,"text":"그들의 주님과 구주로 알게 되고","y":0.6827697263515068},{"height":0.019760363727760022,"y":0.6567864847570671,"text":"신뢰하도록.","x":0.6003800497294285,"width":0.10974218638520261},{"y":0.6392914654320987,"text":"\"주의 성령이 내게 임하셨으니","x":0.08447488926940636,"width":0.410958904109589,"height":0.02898550724637694},{"y":0.6086956523809524,"text":"이는 가난한 자에게 복음을","width":0.365296803652968,"x":0.08447488525766471,"height":0.02898550724637683},{"text":"• 칼랄 이디가 그리스도인들의 삶 가운데","y":0.6070853463231347,"width":0.36986301369863017,"height":0.019323671497584627,"x":0.5707762587899543},{"y":0.581320450958132,"width":0.3949771689497717,"height":0.027375201288244777,"text":"전하게 하시려고 내게 기름을","x":0.0867579928424657},{"width":0.25841785239302406,"height":0.019530446057158368,"y":0.5812249563389902,"x":0.6002545358500515,"text":"하나님의 영광이 나타나도록."},{"text":"부으시고 나를 보내사 마음이","x":0.08447488337614158,"y":0.5523349435688406,"width":0.3949771689497717,"height":0.027375201288244777},{"x":0.5707762588127853,"width":0.3105022831050228,"text":"• 술 생산에 종사하는 칼랄 이디가","height":0.01610305958132041,"y":0.5330112722061192},{"width":0.43150684931506844,"text":"상한 자를 고치며 포로된 자에게","y":0.5249597422705314,"height":0.027375201288244777,"x":0.08447488344748863},{"x":0.6004566234018265,"width":0.3356164383561644,"y":0.5072463768806073,"height":0.019323671497584516,"text":"사람들이 카스트 계급제도의 속박에서"},{"width":0.3835616438356164,"height":0.033816425120772986,"y":0.48953301103059577,"x":0.08447488604044359,"text":"자에게 자유를, 눈먼 자에게"},{"y":0.48148148156199677,"x":0.600456623467058,"width":0.3447488584474886,"height":0.017713365539452464,"text":"자유롭게 풀려나 하나님의 자녀가 될 수"},{"x":0.08675799309994922,"height":0.027375201288244666,"y":0.46859903389694035,"text":"다시 보게 함을 전파하며 눌린","width":0.4018264840182648},{"x":0.600324372581208,"y":0.45369956366922515,"width":0.13725079575630084,"text":"있음을 알도록.","height":0.023357716927397854},{"height":0.03059581320450888,"text":"자를 자유롭게 하고\"","y":0.44122383267914655,"x":0.08447488764269406,"width":0.2876712328767123},{"y":0.40579710152979065,"width":0.3287671232876712,"text":"• 칼랄 이디가 사람들과 그들이 사는","height":0.017713365539452464,"x":0.5707762589954338},{"y":0.3863161321300279,"text":"누가복음 4:18","height":0.02446918518262975,"width":0.20098878694995895,"x":0.08672022040604063},{"x":0.6004566208219178,"height":0.019323671497584516,"text":"공동