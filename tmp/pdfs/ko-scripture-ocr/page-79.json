[{"height":0.01449275362318836,"text":"기타 아시아 - 누리스타니 79","y":0.9613526570853462,"width":0.23287671232876705,"x":0.7351598190150033},{"text":"정치적 상황과 지리적 위치 때문에 이 외딴","y":0.9194847020128825,"width":0.3721461187214612,"x":0.0867579885416667,"height":0.019323671497584516},{"text":"지역인 누리스탄에 접근하는 것은 매우","x":0.08675799265601214,"height":0.02093397745571668,"width":0.3424657534246575,"y":0.8937198069377348},{"height":0.03542673107890504,"width":0.16666666666666663,"x":0.6712328777071102,"text":"기도제목","y":0.8792270528870485},{"height":0.02254428341384862,"width":0.33333333333333337,"x":0.08675798991628615,"text":"어렵습니다. 최근 수십 년 동안 기독교","y":0.8663446052871713},{"x":0.08675799402587514,"width":0.3835616438356164,"text":"사역자들은 의료팀을 누리스탄에 보냈지만,","height":0.02254428341384862,"y":0.8405797099570586},{"y":0.8341384864868492,"height":0.020933977455716568,"x":0.5707762558980214,"text":"• 전 세계의 아프간 기독교인들이","width":0.30593607305936077},{"x":0.08675799420091322,"width":0.4337899543378996,"text":"일부는 목숨을 잃거나 큰 트라우마를 겪었습니다.","height":0.02254428341384862,"y":0.8164251209983897},{"text":"누리스타니를 위해 기도하고,","x":0.6004566228636661,"width":0.26027397260273966,"height":0.02254428341384862,"y":0.806763285047159},{"width":0.36529680365296807,"height":0.019323671497584516,"x":0.08675798825831706,"y":0.7938808372900851,"text":"현재는 안전의 이유로 외국인은 이 지역에"},{"width":0.2465753424657534,"x":0.6004566225456621,"y":0.7809983897141707,"height":0.02254428341384862,"text":"그들을 섬길 방법을 찾도록."},{"width":0.18309482591881598,"height":0.024419290048104836,"x":0.08653477891738658,"y":0.7655681322103518,"text":"들어갈 수 없습니다."},{"height":0.020933977455716568,"text":"• 누리스타니가 조상들이 찾았던","y":0.7326892110305958,"x":0.5707762573693557,"width":0.2990867579908676},{"width":0.20319634703196354,"height":0.020933977455716568,"x":0.6004566224559686,"text":"참된 빛을 발견하도록.","y":0.7069243156544743},{"text":"\"예수께서 또 말씀하여","y":0.6876006443013061,"height":0.032206119162640934,"x":0.08219177913495691,"width":0.3127853881278539},{"y":0.6618357488808373,"height":0.024154589371980784,"text":"이르시되 나는 세상의 빛이니","x":0.08904109783105017,"width":0.3881278538812786},{"width":0.36986301369863017,"height":0.020933977455716568,"y":0.6570048310084541,"text":"• 카불에 사는 누리스타니가 복음을 듣고","x":0.5707762580194063},{"height":0.027375201288244777,"text":"나를 따르는 자는 어둠에","x":0.08675798938356166,"y":0.6312399358158883,"width":0.3333333333333333},{"width":0.23972602739726023,"y":0.6296296293880836,"x":0.6004566233561643,"height":0.024154589371980784,"text":"자신의 민족에게 나누도록."},{"y":0.6038647342190017,"height":0.025764895330112725,"text":"다니지 아니하고 생명의 빛을","x":0.08447488253424665,"width":0.3972602739726028},{"height":0.027375201288244777,"text":"얻으리라\"","x":0.08904109677511414,"y":0.5780998391203703,"width":0.1415525114155251},{"height":0.019323671497584516,"x":0.573059363099315,"width":0.3789954337899544,"y":0.5829307569041868,"text":"• 의료와 복음 사역을 위해 이 지역에 다시"},{"y":0.5555555553462158,"x":0.6004566242694064,"width":0.33105022831050224,"text":"접근할 길이 열리도록 기도해 주세요.","height":0.020933977455716568},{"x":0.08891439193281037,"y":0.5196054590226096,"text":"요한복음 8:12","width":0.19660043934164528,"height":0.025201319112485798},{"text":"누리스타니 사람들은 주로 농부와","x":0.08675799290810499,"width":0.3264840182648402,"y":0.4460547504830916,"height":0.019323671497584627},{"y":0.4235104669082126,"text":"목축업자로 살아갑니다. 남성은 가축을","height":0.020933977455716568,"x":0.08675798819308547,"width":0.3744292237442922},{"y":0.3993558774442144,"text":"돌보고, 여성은 관개된 계단식 밭에서","width":0.35844748858447484,"height":0.024154589371980673,"x":0.08675798941617743},{"height":0.02254428341384862,"text":"곡물을 생산합니다. 그들이 자신들을","y":0.3800322059312936,"x":0.08675799111491626,"width":0.3538812785388128},{"text":"사랑하고 돌보시는 선한 목자가 있다는","height":0.020933977455716568,"width":0.3744292237442922,"x":0.08675798819308547,"y":0.3607085345410629},{"x":0.0867579920547945,"text":"소식을 듣도록 기도합시다.","y":0.3381642514331723,"height":0.02254428341384862,"width":0.2648401826484018},{"height":0.011272141706924