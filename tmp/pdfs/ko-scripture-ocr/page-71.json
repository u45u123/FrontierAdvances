[{"x":0.5913242055936071,"text":"기타 아시아 - 투베시 (술라웨시, 인도네시아) 71","width":0.379851598173516,"height":0.017713365539452575,"y":0.9581320451892109},{"y":0.919484702173913,"width":0.406392694063927,"height":0.019323671497584627,"text":"거의 모든 월리오족은 수피 이슬람을 따르지만","x":0.08675799340753418},{"text":"명상을 통해 하나님의 계시나 숨겨진 진리를","x":0.08675799308219179,"width":0.3858447488584475,"y":0.8937198069726248,"height":0.020933977455716568},{"y":0.880401616003347,"width":0.16701789751444773,"text":"기도제목","x":0.671057262122511,"height":0.034687911446735664},{"x":0.08670813514622765,"text":"찾으려 합니다.","y":0.8677913954622871,"height":0.021261009425164845,"width":0.13708601476939303},{"text":"• 예수 그리스도를 통한 영원한 생명의","height":0.020933977455716568,"width":0.35159817351598166,"x":0.5707762586377473,"y":0.8341384863794954},{"x":0.08904109361998988,"text":"월리오족은 생계를 위해 더 많은 일자리 기회가","width":0.408675799086758,"y":0.8180354266595098,"height":0.019323671497584516},{"height":0.020933977455716568,"text":"진리가 그들이 지닌 환생에 대한 거짓","y":0.8083735910628019,"x":0.6004566233529028,"width":0.3287671232876712},{"y":0.7906602255348516,"x":0.08675799378669273,"text":"필요합니다. 그들의 지리적 위치는 인도네시아","width":0.40867579908675794,"height":0.02254428341384873},{"y":0.7793880835633771,"x":0.6004566209230268,"height":0.024154589371980673,"text":"믿음을 이기도록, 악령의 두려움에서","width":0.32191780821917815},{"x":0.08675799518264832,"width":0.4406392694063927,"y":0.7648953298711755,"height":0.024154589371980673,"text":"주요 해상로를 따라 있기에 관광 잠재력이 큽니다."},{"x":0.6004566210045662,"y":0.7584541064546431,"width":0.29680365296803657,"text":"해방되고 하나님의 능력과 보호가","height":0.020933977455716568},{"text":"어부들은 수산물 생산과 유통을 개선하기 위해","x":0.08675798748097419,"y":0.7423510466317766,"width":0.4063926940639269,"height":0.02093397745571668},{"y":0.7319567621745457,"width":0.11240515861337042,"height":0.022398874955476877,"text":"나타나도록.","x":0.6001901156889942},{"y":0.7149758451851852,"x":0.0867579939269406,"height":0.02254428341384862,"text":"더 나은 훈련과 지식이 필요합니다.","width"