[{"y":0.9613526569444444,"x":0.824200911444064,"width":0.14383561643835607,"height":0.01449275362318847,"text":"인도 - 브라만 39"},{"height":0.019323671497584627,"x":0.08675798829093286,"text":"브라만 종족에게 복음을 전하기 위해서는","width":0.36073059360730597,"y":0.9194847020243846},{"x":0.08675799238964992,"height":0.02093397745571668,"text":"지적이고 문화적으로 민감하게 행동하거나","width":0.3744292237442922,"y":0.8937198069377348},{"y":0.8808373593282723,"x":0.671232876842792,"text":"기도제목","height":0.032206119162640934,"width":0.1643835616438356},{"y":0.8679549114446745,"text":"힌디어와 현지 언어를 사용해 소통해야 합니다.","x":0.08675799383561639,"height":0.020933977455716568,"width":0.4155251141552511},{"text":"• 하나님께서는 사람들을 어둠에서","y":0.8341384863929147,"height":0.019323671497584516,"x":0.5707762577054794,"width":0.319634703196347},{"y":0.8180354268115942,"width":0.363013698630137,"text":"그들의 풍부한 유산과 지속적인 영향력은","x":0.0867579934605349,"height":0.020933977455716568},{"x":0.600456622617009,"y":0.809983897020934,"text":"그의 놀라운 빛으로 부르시는","width":0.25799086757990874,"height":0.019323671497584516},{"x":0.08675798829908679,"width":0.410958904109589,"height":0.019323671497584516,"text":"그들을 인도의 복잡한 사회 구조 안에서 중요한","y":0.7938808372785829},{"text":"분이십니다. 브라만이 지혜와 진리","x":0.6004566203196346,"height":0.02254428341384862,"width":0.3013698630136986,"y":0.7809983895061728},{"text":"공동체로 만듭니다. 따라서 주님께서 브라만","x":0.08675799363992169,"width":0.3881278538812785,"height":0.02254428341384862,"y":0.7665056361628709},{"y":0.7552334941022545,"text":"추구를 통해 그리스도께로 인도되며,","x":0.600456624971461,"width":0.32191780821917804,"height":0.020933977455716568},{"x":0.08904109611872152,"y":0.7391304345813206,"text":"백성 가운데 움직이실 때, 많은 이들이 주목하고","height":0.02415458937198056,"width":0.4155251141552511},{"width":0.2009132420091324,"text":"하나님의 택하신 백성,","y":0.7310789049382715,"x":0.6004566193302893,"height":0.02254428341384873},{"height":0.020933977455716568,"y":0.7165861513821793,"x":0.08675799238964992,"text":"귀 기울일 것입니다.","width":0.182648401826484},{"y":0.7