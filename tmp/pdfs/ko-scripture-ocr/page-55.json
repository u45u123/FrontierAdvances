[{"x":0.824200911444064,"text":"인도 - 사타니 55","height":0.01449275362318847,"width":0.14383561643835607,"y":0.9613526569444444},{"x":0.08675799370515325,"y":0.9162640902691511,"text":"1871년 인구조사에 따르면, 사타니 공동체는","width":0.3972602739726028,"height":0.02254428341384862},{"text":"종교적 걸인과 하급 사원의 제사장, 제물로","height":0.02254428341384873,"x":0.08675799294140027,"y":0.8921095006172839,"width":0.3721461187214612},{"text":"기도제목","width":0.16455985639737625,"height":0.03265666808099177,"x":0.6711447294486032,"y":0.880612084840653},{"y":0.8663446052495974,"text":"사용되는 꽃을 파는 사람들로 기록되어 있습니다.","width":0.4337899543378996,"x":0.08675799515981732,"height":0.02254428341384862},{"height":0.020933977455716568,"x":0.08675799387366813,"y":0.8438003221282877,"text":"이들은 열등한 지위로 인식되었기 때문에","width":0.36073059360730597},{"y":0.8341384864130434,"text":"• 사타니가 그리스도 안에서","width":0.26027397260273966,"x":0.5707762589611872,"height":0.017713365539452575},{"text":"상위 카스트들로부터 사회적으로 배제된 것으로","width":0.42237442922374424,"y":0.8180354268276973,"height":0.019323671497584627,"x":0.08675799509132417},{"width":0.2465753424657534,"text":"자신의 존엄과 가치를 알고,","height":0.02254428341384862,"x":0.6004566230593607,"y":0.8067632850241546},{"y":0.7906602252549652,"x":0.08675799214231353,"text":"알려져 있습니다.","width":0.15753424657534246,"height":0.02254428341384862},{"text":"하나님 나라에서 발견되는 기쁨과","width":0.29680365296803657,"height":0.019323671497584516,"y":0.7842190016908213,"x":0.600456622859589},{"width":0.17579908675799083,"height":0.02093397745571668,"x":0.600456622260274,"y":0.7568438003335634,"text":"소망을 발견하도록."},{"text":"• 그리스도를 따르는 힌두 배경","y":0.710144927605245,"x":0.5707762577299412,"width":0.2831050228310502,"height":0.016103059581320522},{"width":0.28767123287671226,"x":0.6004566234018265,"text":"기독교인들이 성령으로 중만하여","height":0.017713365539452464,"y":0.6827697263419217},{"y":0.6553945250670961,"height":0.02254428341384862,"text":"거절, 적대감, 또는 손실올","x":0.6004566229261795,"width":0.23059360730593603},{"text":"마주하더라도 믿음 안에 굳게 서도록,","x":0.6004566237252664,"y":0.6296296294417606,"width":0.33105022831050224,"height":0.02254428341384862},{"text":"그리스도의 깊은 사랑을 경험하고,","height":0.024154589371980673,"width":0.30365296803652964,"x":0.6004566229023972,"y":0.6038647343095813},{"text":"\"주 여호와의 영이 내게","x":0.08219177907153731,"width":0.32420091324200917,"height":0.03220611916264082,"y":0.5958132046877795},{"width":0.273972602739726,"x":0.6004566175799089,"text":"어떤 대가를 치르더라도 그분의","height":0.017713365539452575,"y":0.5829307567431561},{"width":0.3835616438356165,"height":0.027375201288244666,"text":"내리셨으니 이는 여호와께서","x":0.08447488434442273,"y":0.5668276970669428},{"y":0.5571658612922705,"height":0.017713365539452464,"width":0.2808219178082192,"text":"임채 안에서 위로 받고 믿음으로","x":0.6004566200057077},{"y":0.5394524960547504,"width":0.363013698630137,"height":0.027375201288244666,"x":0.08675799251764213,"text":"내게 기름을 부으사 가난한"},{"y":0.5312323093737401,"text":"견고하도록.","height":0.019660985028302158,"x":0.6003973290888144,"width":0.10970762766659536},{"y":0.5104669885567632,"x":0.08447488351883568,"height":0.027375201288244888,"width":0.42237442922374424,"text":"자에게 아름다운 소식을 전하게"},{"height":0.027375201288244777,"x":0.08447488417047186,"y":0.4830917876677402,"text":"하려 하심이라 나를 보내사","width":0.3652968036529681},{"x":0.5707762581050227,"text":"• 존재할 수도 있는 비밀 기독교인과,","height":0.020933977455716568,"width":0.3356164383561644,"y":0.47826086957671954},{"y":0.45571658622456446,"width":0.33105022831050224,"x":0.08675799237235363,"text":"마음이 상한 자를 고치며","height":0.025764895330112725},{"text":"주님께서 예비하신 구원에 이를","width":0.27625570776255703,"x":0.6004566190313112,"y":0.45732689201748333,"height":0.019323671497584516},{"height":0.019898445325965075,"text":"사람들을 위해.","y":0.43127460983874344,"x":0.6003762959982365,"width":0.13714695412274358},{"height":0.033816425120772986,"width":0.36986301369863006,"x":0.08675799253098501,"y":0.42028985483091785,"text":"포로된 자에게 자유를, 갇힌"},{"height":0.038866259625568444,"width":0.37358939810974956,"x":0.08388424292981964,"y":0.3914060776340814,"text":"자에게 놓임을 선포하며...\""},{"y":0.3816425119852772,"x":0.5707762532126549,"text":"• 그들이 유일하신 참 하나님을 알고자","height":0.019323671497584516,"width":0.34931506849315075},{"y":0.35426731057971017,"height":0.020933977455716568,"text":"하는 갈망을 갖도록 기도해 주세요.","width":0.3105022831050229,"x":0.6004566240639269},{"height":0.025764895330112725,"x":0.08675799090563165,"y":0.3429951688674181,"text":"(이사야 61:1)","width":0.1917808219178082},{"height":0.008051529790660261,"y":0.2818035427334943,"x":0.3447488598744292,"width":0.1141552511415525,"text":"Peoplas of South Asia"},{"y":0.2689210951154052,"text":"Satani","width":0.043378995433789924,"x":0.3812785395357687,"height":0.009661835748792313},{"width":0.03938356164383561,"y":0.1964573268468197,"height":0.03703703703703698,"x":0.4703196346247146,"text":"22"},{"height":0.008857015250385625,"x":0.10263103181766223,"y":0.11714959228423971,"width":0.05729501541346718,"text":"Population"},{"height":0.006441223832528209,"y":0.09822866349973158,"x":0.11187214699391168,"text":"10,000 ~ 50.000","width":0.05251141552511415},{"x":0.10958904189497716,"width":0.04794520547945204,"text":"0ve 100.000","height":0.008051529790660261,"y":0.07568438011272127},{"x":0.21232876780821913,"y":0.07085346226516365,"text":"MALDIVES","width":0.0410958904109589,"height":0.009661835748792313},{"y":0.0515297905797103,"text":"Photo Source: Joshua Project","height":0.011272141706924255,"width":0.228310502283105,"x":0.2853881240487064}]