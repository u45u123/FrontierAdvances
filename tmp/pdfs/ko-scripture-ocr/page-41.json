[{"width":0.12557077625570778,"x":0.8401826471461188,"height":0.01449275362318847,"y":0.9613526569243156,"text":"인도 - 도비 41"},{"width":0.39497716894977175,"height":0.02254428341384873,"text":"도비는 매일 다른 사람들의 빨래를 해주지만,","x":0.0867579869178083,"y":0.9162640901449275},{"x":0.08675798911719941,"width":0.34703196347031967,"y":0.8937198069377348,"height":0.02093397745571668,"text":"그들의 영적 정화의 필요에 대해 아무도"},{"y":0.8807301992378357,"x":0.6711908020103534,"height":0.03242043942069084,"text":"기도제목","width":0.1644677114268961},{"x":0.08675799347412479,"width":0.317351598173516,"height":0.02254428341384862,"text":"관심 갖지 않는 것은 슬픈 일입니다.","y":0.8663446052871713},{"y":0.8421900161332528,"width":0.4337899543378996,"x":0.08675799357876714,"text":"그들의 헌신과 희생에 아무도 주목하지 않습니다.","height":0.020933977455716568},{"width":0.3082191780821917,"height":0.017713365539452464,"text":"• 도비 종족이 복음을 듣고 그들의","y":0.8341384862453033,"x":0.5707762531392695},{"y":0.8148148146135266,"width":0.3059360730593607,"height":0.024154589371980673,"x":0.08675799337899538,"text":"그들은 존업성이나 명예도 없으며,"},{"text":"죄를 씻어 버리실 수 있는 유일한 분이","width":0.33333333333333337,"height":0.019323671497584516,"y":0.809983897004831,"x":0.6004566243378995},{"x":0.08904109872526633,"width":0.3401826484018265,"text":"매일 빈곤, 불의, 차별로 고통받습니다.","height":0.02415458937198056,"y":0.7890499195249598},{"text":"예수 그리스도이심을 깨닫도록.","x":0.6004566237899542,"height":0.019323671497584516,"width":0.27853881278538806,"y":0.782608695652174},{"text":"만약 예수께서 오늘 인도에 오신다면,","y":0.7648953303542674,"x":0.08675798810502292,"width":0.33105022831050224,"height":0.02415458937198056},{"y":0.7439613525764895,"x":0.0867579890125571,"height":0.019323671497584516,"text":"그분은 도비에게 가서 사역하시고","width":0.2968036529680365},{"y":0.7342995169887279,"height":0.017713365539452464,"text":"• 도비 종족이 하나님의 가족으로","width":0.30365296803652975,"x":0.5707762587442922},{"width":0.3242009132420091,"height":0.020933977455716457,"x":0.08675798855185914,"text":"복음과 사랑을 가져다주실 것입니다.","y":0.7165861513112493},{"text":"환영받고 받아들여지며, 주님께서","x":0.6004566221270929,"width":0.29452054794520544,"height":0.02254428341384873,"y":0.7053140094739667},{"y":0.6827697261674719,"x":0.600456618737769,"height":0.017713365539452464,"text":"그들의 명예와 존엄을 회복시켜 주실","width":0.317351598173516},{"text":"것을 알도록.","x":0.6002507675337447,"y":0.6564198822630205,"width":0.11685006476972748,"height":0.022103873235975735},{"x":0.5707762573820395,"text":"• 성령님께서 도비 종족에게 영적 갈망올","y":0.6070853463902308,"width":0.36986301369863017,"height":0.020933977455716568},{"height":0.02254428341384862,"text":"주셔서, 주님이 선하시다는 것올 깨닫고","x":0.6004566192922374,"width":0.3470319634703196,"y":0.5797101447396672},{"y":0.5571658614533013,"width":0.32420091324200906,"text":"맛보기 전에는 어떤 것도 만족을 주지","height":0.017713365539452464,"x":0.6004566169520549},{"width":0.22146118721461183,"text":"못하다는 것올 깨닫도록.","x":0.6004566228500761,"height":0.02254428341384862,"y":0.5297906602522813},{"y":0.4814814816908213,"x":0.5707762567123288,"width":0.3561643835616438,"text":"• 주님께서 도비 종족과 함께 일할 복음","height":0.020933977455716568},{"y":0.4492753624798711,"x":0.08447488380136986,"text":"\"나의 죄악을 말끔히 씻으시며","width":0.4132420091324201,"height":0.032206119162640934},{"width":0.2808219178082192,"y":0.4541062800053677,"height":0.02254428341384862,"text":"전도자들에게 전략올 주시도록.","x":0.6004566232686452},{"text":"나의 죄를 깨끗이 제하소서\"","width":0.3858447488584475,"height":0.03059581320450888,"y":0.42190016091988725,"x":0.08675798845605026},{"width":0.3721461187214612,"height":0.017713365539452464,"y":0.4057971015432099,"x":0.5707762588089801,"text":"• 도비 종족을 위해 효과적인 사회적:의료"},{"y":0.3800322061306648,"x":0.600456623467058,"width":0.3447488584474886,"height":0.020933977455716568,"text":"프로그램이 시행되도록 기도해 주세요."},{"y":0.367149758373591,"width":0.13926940639269408,"height":0.024154589371980673,"text":"시편 51:2","x":0.08904109489562949},{"y":0.2769726248523886,"text":"Peoples of South Asia","x":0.3561643855022831,"width":0.11643835616438358,"height":0.009661835748792313},{"text":"Dhobi (Hindu traditions)","height":0.011272141706924366,"y":0.2640901769457863,"x":0.32876712614155246,"width":0.17579908675799083},{"text":"WHAAMAR","y":0.17552334935587754,"width":0.03881278538812788,"x":0.4566210039193303,"height":0.008051529790660261},{"width":0.054794520547945216,"y":0.11594202906602247,"text":"Population","x":0.10730593698630135,"height":0.00805152979066015},{"x":0.10273972598934553,"width":0.0639269406392694,"height":0.008051529790660261,"y":0.1046698872450349,"text":"E Les tm 10,000"},{"text":"1일 10,000 . 00,000","y":0.09500805161030579,"width":0.059360730593607317,"height":0.008051529790660261,"x":0.10273972701674274},{"y":0.08534621586151359,"width":0.0642123287671233,"height":0.008051529790660261,"text":"골 30,000 . 100,000","x":0.10273972709284623},{"text":"Photo Source: Joshua Project","width":0.226027397260274,"x":0.29223744562404863,"height":0.012882447281129528,"y":0.04991948491680076}]