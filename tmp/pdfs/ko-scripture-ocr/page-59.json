[{"x":0.8401826471232877,"text":"인도 - 텔리 59","y":0.9613526569243156,"height":0.01449275362318847,"width":0.1278538812785388},{"height":0.02254428341384862,"x":0.08675799333618717,"width":0.3949771689497717,"y":0.9162640901972625,"text":"일반적으로 텔리는 빈곤 속에 살지는 않지만,"},{"width":0.410958904109589,"y":0.8921095010305958,"height":0.02254428341384862,"text":"고등교육과 좋은 직업을 가지기는 어렵습니다.","x":0.08675798936073059},{"height":0.032842104753626256,"y":0.8805193665718529,"x":0.6711087860177547,"text":"기도제목","width":0.16463174340931785},{"y":0.8679549112587225,"x":0.08675798795662107,"text":"더 중요한 것은 그들이 부활하신 그리스도를","height":0.020933977455716568,"width":0.38584474885844744},{"y":0.8421900159286098,"height":0.02093397745571668,"width":0.363013698630137,"text":"만나고 그분의 가르침을 받아들일 기회가","x":0.08675799377853873},{"y":0.8341384862548884,"width":0.23972602739726023,"text":"• 텔리 사람들이 부활하신","height":0.017713365539452575,"x":0.5707762539954337},{"y":0.8164251207154359,"text":"필요하다는 것입니다.","x":0.08675798946510112,"width":0.1963470319634703,"height":0.020933977455716568},{"y":0.8051529788244767,"width":0.3082191780821918,"text":"그리스도를 만나고, 슬픔의 재 대신","height":0.024154589371980673,"x":0.6004566213926941},{"x":0.6004566228636661,"width":0.26027397260273966,"text":"기쁨의 기름으로 채워지도록.","y":0.7826086956636761,"height":0.020933977455716568},{"text":"• 하나님께서 현지 기독교인들을 일으켜","height":0.017713365539452464,"y":0.7342995169887279,"width":0.36073059360730597,"x":0.5707762582844096},{"text":"복음을 전하게 하시고, 많은 반대에도","width":0.3287671232876712,"y":0.7069243157234875,"x":0.6004566233529028,"height":0.02093397745571668},{"height":0.017713365539452464,"width":0.31278538812785384,"y":0.6827697263419217,"x":0.6004566236111111,"text":"불구하고 예수님을 따르는 자들에게"},{"x":0.6004566230365297,"y":0.6570048309017713,"height":0.02093397745571668,"text":"힘과 용기를 주시도록.","width":0.20319634703196354},{"x":0.5707762576484018,"width":0.34931506849315075,"height":0.019323671497584627,"y":0.6070853463052424,"text":"• 텔리 여성들이 그리스도 안에서 참된"},{"height":0.02254428341384862,"text":"평화와 자유를 찾고, 가족을 위한 소망올","width":0.3538812785388128,"y":0.5797101450348899,"x":0.6004566239535768},{"x":0.600456619954338,"text":"발견하도록, 가정과 사회에서 중요한","width":0.319634703196347,"height":0.020933977455716568,"y":0.5539452493880838},{"text":"6","y":0.5426731080676328,"width":0.027397260273972615,"x":0.0913242007762557,"height":0.017713365539452575},{"x":0.10730593340943688,"y":0.5281803540660225,"height":0.027375201288244777,"width":0.31963470319634696,"text":"...그들에게 화관을 주어"},{"width":0.26027397260273966,"height":0.020933977455716568,"y":0.531400966195077,"text":"역할이 인정되고 존중받도록.","x":0.6004566228636661},{"width":0.3584474885844749,"text":"그들의 재 대신하며 기쁨의","height":0.025764895330112725,"y":0.5024154588566827,"x":0.0936073029490107},{"text":"• 텔리(Teli) 사람들이 영적인 보호를 위해","y":0.481481481573499,"width":0.3744292237442922,"height":0.019323671497584516,"x":0.570776258382257},{"x":0.09360730412861493,"height":0.025764895330112725,"width":0.32191780821917815,"y":0.4734299514761138,"text":"기름으로 그들의 슬픔을"},{"x":0.6004566213660579,"width":0.3447488584474886,"height":0.024154589371980673,"y":0.4524959740338165,"text":"예수님을 바라보도록, 또한 악한 영들에"},{"height":0.025764895330112725,"y":0.4460547503310073,"text":"대신하며 찬송의 옷으로 그들의","x":0.0936073036149163,"width":0.4178082191780822},{"y":0.43156199669887274,"text":"대한 두려움이 하나님께 드리는 기쁨의","width":0.34018264840182644,"height":0.019323671497584516,"x":0.600456618169711},{"height":0.036381008928332736,"y":0.4100130671995208,"text":"근심을 대신하시고...”","width":0.3004279289071418,"x":0.0907671447450842},{"y":0.40418679524959744,"x":0.6004566247146118,"height":0.019323671497584516,"text":"찬양으로 바뀌도록 기도해 주세요.","width":0.3013698630136986},{"text":"이사야 61:3","x":0.08904109712981081,"width":0.17351598173515984,"height":0.025764895330112725,"y":0.3607085346905913},{"width":0.1141552511415525,"height":0.009661835748792202,"x":0.36073059503424654,"text":"Peoples of South Asia","y":0.2785829308373592},{"width":0.16210045662100458,"height":0.01449275362318847,"x":0.33789954540525113,"text":"Teli (Hindu traditions)","y":0.26409017719404193},{"y":0.17230273760064396,"width":0.0502283105022831,"text":"BANGLADESE","x":0.38356164467275494,"height":0.008051529790660372},{"y":0.11594202904589379,"width":0.0547945205479452,"height":0.008051529790660261,"x":0.1095890417808219,"text":"Population"},{"x":0.1164383560586174,"y":0.09661835748792269,"height":0.0032206119162641045,"text":"119000 24,00","width":0.04566209610194376},{"x":0.11872146194824959,"width":0.045662100456621,"y":0.07729468604401502,"text":"ABE 506,000","height":0.006441223832528209},{"y":0.07085346223832512,"text":"MALBNVES","x":0.21917808287671228,"height":0.008051529790660261,"width":0.04109589041095893},{"y":0.053140096698872874,"text":"Photo Source: Joshua Project","x":0.2945205507990867,"width":0.228310502283105,"height":0.009661835748792202}]