[{"width":0.14383561643835618,"y":0.9613526569377349,"x":0.824200912043379,"text":"아랍 - 페자라 29","height":0.01449275362318836},{"width":0.33561643835616434,"x":0.08675798876997719,"text":"하나님은 페자라 사람들의 부르짖음을","height":0.019323671497584516,"y":0.9194847020128825},{"x":0.08675799363992169,"width":0.3881278538812785,"height":0.02254428341384862,"y":0.8904991949620428,"text":"들으시며 울고 계시고, 페자라 기독교인들도"},{"height":0.034034854931915826,"text":"기도제목","width":0.16675548466373258,"y":0.8807281442640285,"x":0.6711884685473186},{"width":0.42694063926940634,"x":0.08675799353595885,"y":0.8663446055756844,"text":"마찬가지입니다. 하나님은 그들이 겪는 어려움을","height":0.02254428341384862},{"y":0.8421900160359634,"height":0.02093397745571668,"x":0.0867579872716895,"text":"모두 이해하십니다. 그러나 하나님은 상황을 바로","width":0.43150684931506855},{"text":"• 하나님께서 깊은 빈곤과 불안정 속에","width":0.34931506849315075,"x":0.5707762585159816,"height":0.020933977455716568,"y":0.8341384865217392},{"x":0.08675799536529674,"y":0.8164251207890499,"text":"변화시키기보다 그들에게 깊은 사랑을 베푸십니다.","width":0.44977168949771695,"height":0.020933977455716568},{"y":0.8099838970094317,"text":"사는 페자라 백성들에게 그분의 빛과","width":0.32420091324200906,"height":0.019323671497584627,"x":0.598173518297456},{"width":0.4269406392694064,"text":"하나님은 그 자녀들이 페자라 사람을 사랑하도록","height":0.020933977455716568,"x":0.08675799052511414,"y":0.7922705312514378},{"height":0.024154589371980673,"text":"소망을 비추시도록, 그들이 굶주림과","x":0.6004566212557078,"width":0.32191780821917804,"y":0.779388083494364},{"y":0.7665056362587225,"text":"초청하고 계십니다.","x":0.08675798980213087,"height":0.02254428341384862,"width":0.17808219178082194},{"text":"고통가운데서도 그분의 공급, 보호,","width":0.3105022831050228,"height":0.024154589371980673,"y":0.7552334945652174,"x":0.6004566212328767},{"y":0.7326892109615828,"text":"그리고 사랑을 경험하도록.","x":0.6050228327788649,"width":0.24200913242009137,"height":0.020933977455716568},{"y":0.6827697263400045,"height":0.019323671497584627,"text":"• 수단에 하나님이 개입하시어 평화를","x":0.5707762581702543,"width":0.3447488584474886},{"height":0.02254428341384862,"y":0.6553945250670961,"x":0.6004566236872145,"text":"가져오고, 굶주린 이들과 난민들에게","width":0.32191780821917804},{"x":0.6004566234969558,"y":0.6296296296564681,"width":0.2990867579908676,"text":"공급하시며, 신자들의 신앙안에서","height":0.02254428341384862},{"text":"굳건히 서도록.","y":0.6048410326602693,"width":0.13736454863526504,"height":0.022201992655337843,"x":0.6002674983504686},{"y":0.557165861453301,"height":0.019323671497584627,"text":"• 하나님이 페자라 들 가운데 일꾼들을","width":0.34931506849315064,"x":0.5707762535245434},{"x":0.08675799155251145,"text":"\"주린 자에게 네 심정이 동하며","width":0.4246575342465753,"y":0.5281803539989265,"height":0.03220611916264082},{"height":0.02093397745571668,"y":0.5314009661260639,"x":0.6004566194879322,"width":0.21232876712328763,"text":"보내셔서 그들의 마음이"},{"text":"예수 그리스도께 열리게 하시고","y":0.5072463768806073,"height":0.019323671497584516,"width":0.27853881278538817,"x":0.6004566229941292},{"text":"괴로워하는 자의 심정을","width":0.3242009132420091,"x":0.09132420238688249,"y":0.5008051530595813,"height":0.027375201288244777},{"y":0.4798711755367687,"text":"그분의 사랑과 진리를 받아들이도록.","x":0.6004566237252664,"width":0.3264840182648402,"height":0.020933977455716568},{"text":"만족하게 하면 네 빛이 흑암","x":0.09132420325342464,"width":0.3744292237442922,"y":0.47181964582326885,"height":0.027375201288244777},{"height":0.027375201288244666,"y":0.44444444451690823,"width":0.40410958904109584,"x":0.09132420293378987,"text":"중에서 떠올라 네 어둠이 낮과"},{"height":0.019323671497584516,"width":0.26712328767123295,"x":0.570776257615786,"y":0.4315619968714056,"text":"• 바가라 종족에서 일어나는"},{"y":0.4150439478318627,"text":"같이 될 것이며\"","width":0.22627408101678442,"height":0.034646404346214243,"x":0.0912008603867396},{"width":0.2442922374429224,"x":0.6004566223617452,"height":0.019323671497584516,"y":0.4057971015387368,"text":"그리스도께로의 회복운동이"},{"x":0.600456622260274,"width":0.226027397260274,"height":0.019323671497584516,"text":"페자라에게도 확산되도록","y":0.3816425121488639},{"y":0.35815482816870636,"widt