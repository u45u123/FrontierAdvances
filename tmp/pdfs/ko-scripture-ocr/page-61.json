[{"y":0.9613526569243156,"text":"인도 - 야다브 61","width":0.13926940639269403,"height":0.01449275362318847,"x":0.824200911849315},{"height":0.019323671497584516,"y":0.9194847021854152,"text":"인도의 야다브는 세계에서 5번째로 큰 미전도","width":0.39954337899543374,"x":0.08675799372146115},{"width":0.3538812785388128,"x":0.08675799381659052,"text":"종족이며, 인도에서는 세 번째로 큽니다.","y":0.8904991948738593,"height":0.02254428341384862},{"text":"기도제목","y":0.880637299489871,"x":0.6711517237808905,"width":0.16682897419690002,"height":0.034216544478411826},{"height":0.019323671497584516,"width":0.34246575342465757,"text":"통계에 따르면 예수님을 따르는 사람은","x":0.0867579942922374,"y":0.8695652174879227},{"y":0.8421900161164788,"text":"0.002%에 불과합니다.","x":0.08675799263698628,"width":0.21232876712328766,"height":0.020933977455716568},{"text":"• 야다브가 하나님의 축복을 받아들여","y":0.8341384865217392,"width":0.3447488584474886,"x":0.5707762563698631,"height":0.020933977455716568},{"text":"어둠에 행하던 백성이 그분의 큰 빛을","x":0.600456618283866,"height":0.019323671497584627,"width":0.3264840182648402,"y":0.8099838968599034},{"height":0.02254428341384862,"text":"그러기에 그들은 구원의 길에 대해 들어야 합니다.","width":0.44063926940639264,"y":0.7906602252549652,"x":0.086757994501522},{"x":0.6004566207990869,"text":"보도록.","y":0.7809983899033817,"height":0.020933977455716568,"width":0.07077625570776247},{"width":0.43150684931506844,"text":"대부분의 야다브는 예수님의 이름을 한 번도 듣지","y":0.7681159421095007,"x":0.08675799394977167,"height":0.02093397745571668},{"x":0.08675798995433795,"y":0.7407407405528716,"text":"못한 채 죽습니다. 최근 몇 년 사이에 일부 야다브","height":0.02254428341384873,"width":0.42922374429223753},{"height":0.019323671497584516,"text":"• 주님께서 그분의 말씀과 사랑을 나누고","x":0.5707762580194063,"y":0.7342995169887279,"width":0.36986301369863017},{"width":0.3995433789954338,"text":"가정들과 마을 전체가 그리스도께로 나아가고","x":0.08675799477168941,"y":0.7165861511594203,"height":0.02093397745571668},{"x":0.6004566224632166,"y":0.7085346216675613,"width":0.2625570776255708,"height":0.019323671497584516,"text":"제자 공동체로 초대할 수 있는"},{"y":0.6892109501955372,"height":0.02254428341384851,"x":0.0867579938193085,"text":"있으며, 그 가운데에는 예수님을 따르는 야다브","width":0.41324200913242015},{"y":0.6811594201154052,"width":0.3013698630136986,"height":0.02093397745571668,"text":"사람에게로 야다브를 이끄시도록.","x":0.598173518455099},{"text":"신자들이 이끌고 있는 경우도 있습니다.","x":0.08675799431506843,"y":0.6650563604830918,"width":0.3493150684931507,"height":0.02254428341384862},{"height":0.019323671497584627,"y":0.6328502415458936,"width":0.365296803652968,"text":"• 주님께서 야다브 예술가들을 일으켜서","x":0.5707762587519026},{"width":0.3538812785388128,"height":0.020933977455716568,"x":0.6004566232163242,"y":0.6070853462862319,"text":"공동체 전체에 복음을 쉽게 전할 수 있는"},{"height":0.019323671497584627,"x":0.600456619063927,"text":"방식으로 노래하도록.","y":0.5813204508212559,"width":0.19406392694063923},{"text":"• 전통적인 방식으로 생계를 유지할 수","y":0.533011272208803,"x":0.5707762586187213,"width":0.34931506849315075,"height":0.017713365539452575},{"y":0.5201288245410629,"height":0.019323671497584405,"x":0.08447488616438356,"width":0.0319634703196347,"text":"6"},{"width":0.319634703196347,"text":"흑암에 행하던 백성이","height":0.027375201288244888,"y":0.5072463766390614,"x":0.1004566187214612},{"text":"없는 야다브의 젊은이들이 폭넓은","y":0.5072463767149759,"x":0.6004566180365296,"width":0.29680365296803657,"height":0.019323671497584516},{"width":0.36986301369863006,"height":0.025764895330112725,"text":"큰 빛을 보고 사망의 그늘진","y":0.481481481696189,"x":0.08904109360730597},{"y":0.48148148157094295,"x":0.6027397278285135,"height":0.019323671497584627,"width":0.32420091324200906,"text":"탐구를 통해 더 나은 직업뿐만 아니라"},{"y":0.45249597431562005,"text":"땅에 거주하던 자에게","height":0.025764895330112725,"width":0.29452054794520544,"x":0.0844748882990867},{"y":0.45410627998389697,"text":"예수님께로 인도되도록.","width":0.2168949771689498,"x":0.6004566230821917,"height":0.020933977455716568},{"x":0.08898425125222306,"y":0.4232894604150511,"height":0.03103782819665002,"text":"빛이 비치도다...\"","width":0.23755661428791205},{"height":0.017713365539452464,"x":0.5707762531392695,"text":"• 예수님을 향해 열려 있는 가정과","y":0.4057971013821793,"width":0.3082191780821917},{"width":0.2374429223744292,"height":0.024154589371980673,"text":"마을에게 용기, 소망, 인내,","x":0.6004566193085453,"y":0.3768115941453877},{"x":0.08419326008677715,"width":0.1558143929259418,"height":0.029010201421912685,"text":"이사야 9:2","y":0.36633225861617646},{"text":"그리고 기쁨을 주시도록 기도해 주세요.","width":0.34931506849315064,"x":0.6004566239155251,"y":0.355877616747182,"height":0.019323671497584516},{"width":0.1141552511415525,"height":0.008051529790660261,"x":0.3561643816590564,"y":0.27858293067632844,"text":"Peoples of South Asia"},{"height":0.012882447281129528,"x":0.3264840211567731,"text":"Yadav (Hindu traditions)","width":0.17808219178082196,"y":0.26409017730287476},{"x":0.10501112200822614,"text":"Population","y":0.11429188030917503,"width":0.05481794000216274,"height":0.008131214961913491},{"text":"1 com Ben 10,000","width":0.06278538812785388,"x":0.10273972705479449,"y":0.10305958140096605,"height":0.008051529790660261},{"x":0.10273972531392696,"width":0.057077625570776266,"height":0.008051529790660261,"y":0.093397745511272,"text":"필 10,000. 50,000"},{"x":0.102739725913242,"text":"2 80,000 100,000","width":0.06164383561643834,"height":0.006441223832528209,"y":0.08534621579292656},{"height":0.006441223832528209,"text":"Abowe 590,000","y":0.07568438008588296,"width":0.050228310502283116,"x":0.10958904193302889},{"text":"MALENVES","y":0.06924315628019306,"x":0.21461187283105018,"width":0.04109589041095893,"height":0.008051529790660261},{"text":"1%","x":0.4703196349568746,"width":0.04566210045662106,"y":0.06763285027733035,"height":0.02254428341384862},{"y":0.04830917863124007,"width":0.22602739726027393,"x":0.28995433961187217,"height":0.011272141706924255,"text":"Photo Source: Joshua Project"}]