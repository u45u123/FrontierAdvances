[{"y":0.9613526570853462,"x":0.7579908690802349,"text":"기타 아시아 - 다게스탄 69","height":0.01449275362318836,"width":0.2100456621004566},{"x":0.08675798763318117,"y":0.9162640901234568,"text":"다게스탄에서 가장 큰 민족은 아바르족이며,","width":0.3881278538812786,"height":0.02254428341384862},{"height":0.020933977455716568,"width":0.3150684931506849,"x":0.08675799283675796,"text":"기독교인은 0.1%도 되지 않습니다.","y":0.8921095008353462},{"y":0.880598777804215,"width":0.16686001433629427,"height":0.03429358784895209,"x":0.6711362037112587,"text":"기도제목"},{"height":0.019323671497584516,"text":"저명한 아바르족 기독교인 중 한 명인 아르투르","width":0.410958904109589,"x":0.08675798829908679,"y":0.8695652173107891},{"height":0.019323671497584516,"x":0.08675798781800394,"text":"술레이메노프 목사는 2010년 7 월 마하치칼라에","width":0.4269406392694064,"y":0.8438003219921785},{"text":"• 다게스탄에서는 이슬람이 민족 정체성과","width":0.38584474885844744,"height":0.020933977455716568,"y":0.8341384864868492,"x":0.5707762568683409},{"width":0.3698630136986301,"height":0.020933977455716568,"x":0.08675799350945855,"text":"있는 자신의 교회 밖에서 살해되었습니다.","y":0.8164251208074534},{"width":0.3470319634703196,"x":0.6004566214611872,"height":0.024154589371980784,"y":0.8051529788647342,"text":"깊이 연결되어 있으며, 기독교는 때때로"},{"height":0.02254428341384862,"text":"그 교회는 무슬림, 마약 중독자, 그리고","x":0.08675799329745597,"y":0.790660225557856,"width":0.34018264840182644},{"x":0.5978939510632016,"height":0.024729524449641715,"y":0.7808978822371844,"width":0.3452923221675228,"text":"'러시아의 종교'로 의심받기도 합니다."},{"y":0.7681159419585346,"width":0.3789954337899543,"height":0.02093397745571668,"x":0.08675798849885848,"text":"전과자들을 대상으로 하는 사역으로 알려져"},{"width":0.33333333333333337,"x":0.6004566209474886,"height":0.024154589371980673,"y":0.7552334942129629,"text":"이 거짓이 깨지고, 마음이 복음의 참된"},{"height":0.02254428341384862,"x":0.08675798928571432,"text":"있었고, 1,000명 이상의 교인이 있었으며","y":0.7407407405797102,"width":0.363013698630137},{"text":"소망, 사랑, 자유의 메시지에 열리도록.","x":0.6004566198630137,"width":0.34246575342465757,"y":0.7294685988325282,"height":0.024154589371980673},{"text":"그중 80%가 이슬람에서 개종한","y":0.7165861514814815,"x":0.08675799369863012,"height":0.020933977455716457,"width":0.2831050228310502},{"y":0.6924315622061191,"width":0.4063926940639269,"x":0.08675799447488579,"text":"사람들이었습니다. 그의 죽음은 무슬림 배경의","height":0.020933977455716568},{"y":0.679549114143854,"width":0.3744292237442922,"height":0.02254428341384862,"text":"• 하나님만이 모든 민족의 창조주이시며,","x":0.5707762587899542},{"height":0.02254428341384851,"x":0.08675799410197865,"text":"신자들을 위협하며, 사람들이 예수를 따르는","y":0.6650563608158884,"width":0.3881278538812785},{"y":0.6586151369565217,"x":0.6004566230165526,"height":0.019323671497584516,"text":"모든 나라와 족속과 언어에서 유일한","width":0.32191780821917804},{"width":0.36986301369863017,"y":0.640901771524423,"height":0.02254428341384873,"text":"것올 방해하기 위한 시도로 여겨졌습니다.","x":0.08675799037290716},{"width":0.36757990867579904,"height":0.02254428341384862,"text":"구원자이심올 다게스탄 사람들이 알도록.","x":0.600456624067732,"y":0.6312399355877617},{"x":0.5707762546347033,"width":0.33105022831050224,"height":0.020933977455716568,"y":0.5813204506763285,"text":"• 이 지역의 소수 신자들이 그리스도"},{"width":0.3318518721349707,"text":"안에서 자신의 정체성을 깊이 깨닫고,","x":0.6000883807835347,"height":0.026000260922835805,"y":0.5537798661987282},{"height":0.024154589371980673,"y":0.528180354094778,"text":"가족의 핍박에 맞서며, 담대하게 믿음을","width":0.3470319634703197,"x":0.6004566213959557},{"text":"나누도록 기도해 주세요.","width":0.22146118721461183,"height":0.02093397745571668,"x":0.600456623219178,"y":0.5056360708373591},{"y":0.40257648971193427,"text":"\"너희는 유대인이나","x":0.08904109440639271,"height":0.03220611916264082,"width":0.27625570776255703},{"x":0.0913242043759512,"width":0.41552511415525106,"height":0.027375201288244777,"text":"헬라인이나 종이나 자유인이나","y":0.373590982380569},{"x":0.0913242002772342,"width":0.363013698630137,"text":"남자나 여자나 다 그리스도","height":0.027375201288244777,"y":0.3462157811939268},{"height":0.032206119162640934,"y":0.3172302739820565,"width":0.3447488584474886,"x":0.09132420304957599,"text":"예수 안에서 하나이니라\""},{"width":0.23287671232876717,"height":0.025764895330112725,"y":0.26247987125603867,"x":0.09132420207762555,"text":"갈라디아서 3:28"},{"y":0.10551655671215099,"width":0.06481518375274797,"x":0.13388589655979102,"text":"DAGESIANAT","height":0.014241333744952067},{"width":0.0273972602739726,"height":0.006441223832528209,"text":"JAPAN","x":0.44292237488584474,"y":0.10628019329039184},{"width":0.045662100456621,"x":0.3082191788432268,"y":0.09822866352656989,"text":"MONGOLIA","height":0.008051529790660261},{"y":0.08051529801395596,"height":0.006441223640564764,"x":0.32648401784627096,"width":0.029680365296803624,"text":"CHINA"},{"y":0.053140096678744086,"width":0.1894977168949772,"x":0.3310502306792237,"height":0.011272141706924255,"text":"Photo Source: Britannica"}]