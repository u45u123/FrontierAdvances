[{"y":0.9613526569243156,"text":"인도 - 카푸 45","x":0.8401826471232877,"width":0.1278538812785388,"height":0.01449275362318847},{"x":0.08675799119101973,"width":0.408675799086758,"height":0.024154589371980673,"text":"카푸 사람들은 힌두 신앙, 농업 생활 방식, 마을","y":0.9146537840177134},{"text":"전통에 젖어 있고 점점 강해지는 사회적 정체성을","y":0.8937198066942719,"height":0.019323671497584627,"width":0.43150684931506855,"x":0.08675798778538815},{"y":0.8808373591697978,"x":0.6712328776255707,"text":"기도제목","height":0.032206119162640934,"width":0.1643835616438356},{"width":0.410958904109589,"x":0.08675799037290713,"y":0.8679549112587225,"height":0.020933977455716568,"text":"확립하고 있습니다. 그들의 영적 생활은 전통적"},{"width":0.4178082191780822,"text":"예배와 조상 숭배에 뿌리를 두고 있지만, 시대의","height":0.02093397745571668,"y":0.8421900162065792,"x":0.08675799385192429},{"y":0.8341384864130434,"x":0.5707762597602739,"width":0.32420091324200917,"height":0.017713365539452575,"text":"• 카푸 사람들이 하나님께서 그들의"},{"x":0.08675799449771686,"width":0.3995433789954338,"y":0.8148148150563608,"text":"변화, 폭넓은 운동과의 통합, 개인의 자아실현","height":0.02415458937198056},{"y":0.808373590942029,"text":"보호자이심을 알고 경험할 수 있도록.","width":0.3287671232876713,"height":0.019323671497584516,"x":0.6004566251141551},{"text":"등을 통해 변화하고 있습니다.","y":0.7906602254696726,"height":0.02254428341384862,"x":0.08675799309360725,"width":0.2671232876712329},{"y":0.7584541063741278,"text":"• 하나님께서 그들이 카스트 제도의","x":0.5707762583904109,"width":0.32191780821917804,"height":0.017713365539452464},{"y":0.7342995169772257,"width":0.3287671232876712,"x":0.6004566233529028,"text":"한계와 스스로 정치적 권리를 지킬 수","height":0.019323671497584516},{"x":0.6004566210616439,"text":"없음을 보게 하시어, 회개 가운데 영원한","y":0.7053140094739667,"height":0.02254428341384873,"width":0.3538812785388128},{"y":0.6988727858829844,"x":0.08447488873668184,"text":"\"여호와는 너를 지키시는","width":0.34703196347031956,"height":0.032206119162640934},{"text":"왕 되신 주님께 나아오도록.","y":0.6811594200966185,"x":0.6004566234018265,"width":0.24429223744292228,"height":0.019323671497584405},{"y":0.6714975844605475,"x":0.08675798822773974,"text":"이시라 여호와는 네 오른쪽에서","height":0.025764895330112725,"width":0.42237442922374435},{"width":0.3995433789954338,"text":"네 그늘이 되시나니 낮의 해가","height":0.025764895330112725,"y":0.6441223831723027,"x":0.09132419891552515},{"x":0.5707762532452707,"width":0.3447488584474886,"y":0.6328502414768806,"text":"• 하나님께서 힌두교와 관련된 관습과","height":0.019323671497584516},{"text":"너를 상하게 하지 아니하며","height":0.02898550724637683,"y":0.6135265699677939,"x":0.08675798784246581,"width":0.363013698630137},{"height":0.02254428341384851,"y":0.6038647343639292,"text":"전통의 사슬을 끊으시고, 그들을 진리로","x":0.6004566244977169,"width":0.34931506849315064},{"width":0.3036529680365297,"height":0.027375201288244666,"x":0.08675799303652969,"text":"밤의 달도 너를 해하지","y":0.5861513688405797},{"height":0.019323671497584516,"text":"인도하시어 하나님께서 주시는 자유를","y":0.5829307569082126,"x":0.6004566243835616,"width":0.3378995433789954},{"x":0.08675798801369868,"y":0.5587761673913043,"text":"아니하리로다 여호와께서","width":0.34246575342465757,"height":0.025764895330112614},{"width":0.091324200913242,"y":0.5555555555555556,"text":"누리도록.","x":0.6004566219178081,"height":0.019323671497584516},{"y":0.5297906601449276,"text":"너를 모든 환난에서 면하게","height":0.027375201288244666,"x":0.08675798827462496,"width":0.36301369863013694},{"x":0.08904109784735811,"width":0.273972602739726,"text":"하시며 또 네 영혼을","height":0.024154589371980673,"y":0.5040257649758454},{"height":0.02254428341384862,"x":0.5707762588660578,"text":"• 하나님께서 카푸 종족을 위해 기도하고,","y":0.5040257648953301,"width":0.3789954337899544},{"y":0.4814814814124685,"height":0.019323671497584516,"text":"그들을 깊이 사랑하며 예수님의","x":0.6004566190313112,"width":0.27625570776255703},{"x":0.08675798900684933,"text":"보호하시리로다 여호와께서","width":0.3721461187214612,"height":0.027375201288244666,"y":0.47342995161835755},{"y":0.45732689202898547,"text":"마음으로 섬길 사람들을 일으키시도록","x":0.6004566182077625,"width":0.3356164383561644,"height":0.019323671497584516},{"y":0.4444444442163178,"height":0.027375201288244777,"text":"너의 출입을 지금부터 영원까지","width":0.42237442922374435,"x":0.0867579894025875},{"x":0.6003215315538031,"width":0.1349733779419502,"y":0.4310358188504071,"height":0.01876572134414156,"text":"기도해 주세요."},{"width":0.20561256582878495,"x":0.08669143534932516,"height":0.03263128590852549,"text":"지키시리로다\"","y":0.41685666005447597},{"width":0.19650411388101097,"x":0.08667944850591834,"height":0.0263671813571702,"text":"시편 121:5-8","y":0.36040739154334067},{"width":0.1141552511415525,"y":0.27697262487922714,"text":"Peoples of South Asia","height":0.008051529790660261,"x":0.3584474904870623},{"height":0.011425394942795042,"x":0.39493516401951884,"width":0.04117990084434753,"text":"Kapu","y":0.26401355018392214},{"height":0.008051529790660261,"text":"MAR","x":0.47260273961187216,"y":0.1755233494766505,"width":0.022831050228310557},{"x":0.10730593675799086,"text":"Population","y":0.11594202904589379,"width":0.0547945205479452,"height":0.008051529790660261},{"y":0.09661835741673219,"width":0.05707762121609901,"height":0.004830917874396157,"text":"P 45,000~40,000","x":0.10273972689195056},{"width":0.06421232876712327,"height":0.008051529790660261,"text":"블 30,000 . 100,000","y":0.08534621584138491,"x":0.10273972679794519},{"width":0.0410958904109589,"y":0.07246376816961886,"text":"MALDIVES","x":0.21689497785388123,"height":0.006441223832528209},{"y":0.06602254428341381,"text":"1%","x":0.4703196350028539,"width":0.047945205479452024,"height":0.025764895330112725},{"text":"Photo Source: Joshua Project","x":0.2922374450627853,"width":0.22602739726027404,"height":0.011272141706924366,"y":0.04669887264492756}]