[{"text":"인도 - 바그반 37","width":0.14383561643835607,"y":0.9613526569444444,"height":0.01449275362318847,"x":0.824200911444064},{"x":0.08675798842751146,"text":"이들에 대한 정보가 너무 적어서 마치 잊혀진","width":0.3904109589041096,"height":0.019323671497584516,"y":0.9194847020128825},{"y":0.8921095008185722,"x":0.08675799326484014,"text":"사람들처럼 느껴질 수 있습니다.","width":0.2876712328767123,"height":0.020933977455716568},{"height":0.032446205520015536,"y":0.880717316188203,"width":0.1644777968593928,"x":0.6711857592940204,"text":"기도제목"},{"y":0.8679549112238325,"text":"그러나 하나님께서 바그반을 잊지 않으셨다는","width":0.3995433789954338,"height":0.02093397745571668,"x":0.08675799477168941},{"width":0.33105022831050235,"text":"것을 그들이 알게 되도록 기도합시다.","y":0.8421900160455487,"x":0.08675798850293544,"height":0.020933977455716568},{"height":0.017713365539452464,"x":0.5707762583713851,"width":0.319634703196347,"y":0.8341384864063339,"text":"• 바그반 그리스도인들이 하나님을"},{"width":0.34246575342465746,"height":0.019323671497584516,"x":0.6004566244292237,"text":"사랑의 정원사가 되신 분으로 기억하며","y":0.809983897004831},{"text":"낙심하지 않도록.","width":0.15316352670051192,"height":0.020108952422456916,"y":0.7822160551818798,"x":0.6026419824716213},{"y":0.7342995169753086,"text":"• 이 땅에 하나님의 일꾼들이 많이","height":0.017713365539452575,"width":0.3082191780821918,"x":0.5707762582762557},{"text":"파송되어 복음의 씨를 심을 수 있도록.","x":0.6073059393607306,"height":0.019323671497584516,"y":0.7069243154267311,"width":0.33333333333333326},{"width":0.3470319634703197,"y":0.6586151367820718,"text":"• 정원사 되신 하나님이 그들을 돌보고","x":0.5707762528158294,"height":0.017713365539452575},{"x":0.6004566199771689,"height":0.02254428341384862,"width":0.34246575342465757,"y":0.6296296294417606,"text":"기억하시듯, 세상도 그들을 기억하도록"},{"text":"기도해 주세요.","x":0.6003338507115095,"width":0.13494873917810446,"height":0.020193992221605006,"y":0.6066501858610303},{"y":0.5857520331958836,"text":"\"만군의 하나님이여, 구하옵나니","x":0.08371152411699782,"height":0.03934137218432332,"width":0.43736901130850453},{"text":"돌아오소서 하늘에서 굽어보시고","y":0.5652173912238325,"x":0.08675798811358452,"height":0.025764895330112836,"width":0.4406392694063927},{"text":"포도나무를 돌보소서 주의","y":0.5394524958937197,"x":0.09132419901065453,"width":0.3424657534246575,"height":0.024154589371980784},{"width":0.4200913242009132,"height":0.025764895330112725,"y":0.5088566826981571,"x":0.08675798853373928,"text":"오른손으로 심으신 줄기요 주를"},{"x":0.08675798974505326,"width":0.4406392694063927,"text":"위하여 힘있게 하신 가지니이다\"","height":0.03220611916264082,"y":0.47987117525496514},{"text":"시편80:14,15","width":0.1940639269406393,"x":0.08675799176451403,"height":0.032206119162640934,"y":0.4170692429261559},{"y":0.2914653785024154,"x":0.35844749003995424,"height":0.009661835748792202,"text":"Peoples of South Asia","width":0.11643835616438358},{"y":0.27697262487922714,"height":0.008051529790660261,"text":"APCHANISTAN","x":0.13242009227549464,"width":0.05707762557077625},{"text":"Baghban (Mus lim traditions)","width":0.18036529680365299,"x":0.3264840205194063,"y":0.2785829308373592,"height":0.009661835748792202},{"height":0.006441223832528209,"x":0.18493150757229831,"text":"PAKISTAN","y":0.24959742356414383,"width":0.04337899543378995},{"height":0.006441223832528209,"y":0.19162640907139017,"width":0.027397260273972615,"text":"OMAN","x":0.09360730639269403},{"text":"Population","width":0.059360730593607317,"height":0.008051529790660261,"y":0.122383252878422,"x":0.10958904183789951},{"y":0.11111111119162631,"width":0.0593607305936073,"height":0.00805152979066015,"text":"Less then 10,000","x":0.11643835715372905},{"text":"Photo Source: Joshua Project","y":0.04830917867686524,"height":0.011272141706924366,"width":0.226027397260274,"x":0.301369861130137}]