[{"text":"아프리카 - 풀라니 15","height":0.01449275362318836,"x":0.7945205491846054,"width":0.1735159817351598,"y":0.9613526570853462},{"y":0.9194847020039363,"x":0.10273972415017761,"height":0.019323671497584516,"width":0.3378995433789954,"text":"풀라니는 무슬림 정체성에 큰 자부심을"},{"text":"가지고 있습니다. 그들의 상황은 국가마다","height":0.02254428341384873,"width":0.36757990867579904,"y":0.8937198065754159,"x":0.10045662052891934},{"y":0.8792270529432814,"height":0.03542673107890504,"text":"기도제목","width":0.16666666666666674,"x":0.6712328775114155},{"y":0.8711755234500805,"text":"생활 방식, 교육, 자신과 타인의 인식에 따라","height":0.02254428341384862,"x":0.10045662341609582,"width":0.38584474885844744},{"height":0.021268710230091692,"width":0.09147733749319975,"y":0.8484638729873737,"x":0.10038005343627437,"text":"다릅니다."},{"height":0.020933977455716568,"y":0.8341384862453033,"width":0.27625570776255703,"text":"• 풀라니 가운데 멈출 수 없는","x":0.5662100433599695},{"x":0.10045662372798433,"width":0.3812785388127854,"text":"그러나 하나님께서는 특정 지역에서 자신을","y":0.8051529791580401,"height":0.019323671497584405},{"width":0.29680365296803657,"text":"성령님의 역사가 일어나 예수님의","y":0.8083735910628019,"x":0.5981735189497717,"height":0.020933977455716568},{"text":"나타내셨고, 여러 나라에 소수의 풀라니","width":0.3470319634703196,"height":0.024154589371980784,"y":0.7777777777294685,"x":0.10045661753424664},{"height":0.024154589371980673,"y":0.779388083766103,"text":"제자, 영적 목자, 목회자, 선교사,","x":0.5981735177939498,"width":0.2899543378995434},{"y":0.7568438000966183,"width":0.38584474885844744,"x":0.10045662061643837,"height":0.02254428341384862,"text":"신자들이 있습니다. 소수의 풀라니 신자들은"},{"text":"사역자들이 아프리카와 전 세계에","x":0.5958904123059361,"width":0.2990867579908676,"y":0.7584541064895329,"height":0.02093397745571668},{"text":"그들의 공동체로부터 배척당하거나","width":0.3105022831050228,"x":0.10045661841704723,"height":0.019323671497584516,"y":0.7375201287439614},{"text":"세워지도록.","y":0.7310789049919485,"width":0.11415525114155245,"height":0.02254428341384862,"x":0.5981735171232877},{"height":0.020933977455716568,"y":0.7117552334460547,"width":0.35844748858447484,"text":"극단주의자들로부터 위협받고 있습니다.","x":0.1004566174200914},{"x":0.1004566170091325,"width":0.3995433789954338,"height":0.020933977455716457,"text":"어떤 사람들은 공격받거나 그들의 집으로부터","y":0.6908212559581322},{"height":0.019323671497584516,"y":0.682769726178974,"x":0.5662100435583823,"width":0.29452054794520555,"text":"• 풀라니 민족을 위해 사랑 많고"},{"y":0.6666666668921095,"x":0.1004566219178082,"height":0.02254428341384862,"width":0.2602739726027397,"text":"떠나기를 강요받고 있습니다."},{"x":0.5981735185616438,"text":"헌신적인 그리스도 사역자들이","y":0.6570048307085345,"height":0.02093397745571668,"width":0.271689497716895},{"width":0.18289414497270973,"height":0.023556810646241377,"x":0.5980506427216908,"y":0.6307336722063734,"text":"더 많이 세워지도록."},{"x":0.10045662393455096,"y":0.6215780996645196,"height":0.020933977455716568,"text":"그렇지만 그들에게는 더 많은 사역자들이","width":0.3607305936073059},{"text":"필요합니다. 한편 서아프리카 몇몇 나라에는","width":0.38584474885844744,"height":0.02254428341384862,"y":0.5974235102791197,"x":0.10045661961567734},{"width":0.3287671232876712,"height":0.019323671497584516,"text":"성숙한 목회자가 있는 몇몇 잘 형성된","y":0.5764895330917874,"x":0.10045662374429218},{"width":0.25684929764978415,"height":0.024154589371980673,"x":0.5662100481278538,"y":0.5780998387278583,"text":"• 테러의 피해자들 위해,"},{"height":0.020933977455716457,"width":0.17808219178082194,"y":0.5523349436553946,"text":"교회들도 있습니다.","x":0.10045662278538811},{"y":0.5571658615942029,"x":0.5981735174657534,"text":"풀라니 민족이 복음을 통해","height":0.019323671497584516,"width":0.2374429223744292},{"y":0.52970755059577,"height":0.024777642770665853,"x":0.10031053972171697,"width":0.4021817211691102,"text":"한 목회자는 '풀라니 선교회'를 시작했습니다."},{"text":"자유, 평화, 변화를 찾도록.","y":0.5281803543120416,"width":0.23744292237442932,"x":0.5981735173008624,"height":0.02415458937198056},{"width":0.32191780821917815,"y":0.47987117550724634,"text":"• 차별을 겪는 풀라니 난민올 위해,","x":0.5662100488812785,"height":0.020933977455716568},{"width":0.31506849315068497,"height":0.020933977455716568,"x":0.5981735142313547,"y":0.4557165860708535,"text":"하나님께서 그들의 필요를 채우시고"},{"height":0.03059581320450877,"x":0.10045661911466267,"y":0.4460547505725533,"width":0.3447488584474886,"text":"\"여호와께서 너의 출입을"},{"y":0.4299516908346753,"width":0.24200913242009137,"height":0.020933977455716568,"text":"미래를 준비시켜 주시도록.","x":0.5981735179984778},{"x":0.10045662000978474,"width":0.25342465753424653,"text":"지금부터 영원까지","height":0.027375201288244777,"y":0.4170692429606625},{"height":0.03249027878765898,"width":0.20785073058245934,"text":"지키시리로다\"","y":0.3895519611705405,"x":0.10041253276845025},{"x":0.5662100481409003,"text":"• 풀라니 지도자들이 젊은이들을 위해","y":0.3800322061996779,"width":0.3470319634703196,"height":0.020933977455716568},{"height":0.019323671497584516,"x":0.5981735140981734,"text":"미래를 위한 정규 교육의 필요성을","width":0.3013698630136986,"y":0.35587761666666673},{"width":0.15753424657534243,"text":"시편 121:8","y":0.34782608687600647,"x":0.10273972490215265,"height":0.024154589371980673},{"width":0.22146118721461183,"height":0.020933977455716568,"text":"깨닫도록 기도해 주세요.","y":0.3285024154723565,"x":0.598173517827245}]