[{"x":0.7922374411643835,"y":0.9613526569243156,"text":"아랍 - 아랍문화권 23","width":0.17579908675799094,"height":0.01449275362318847},{"y":0.8808373593397746,"height":0.02898550724637683,"text":"\"예수께서 이르시되 내가 곧","width":0.38127853881278545,"x":0.084474882781583},{"width":0.1668392512351955,"y":0.88062455465375,"text":"기도제목","height":0.034242034150398504,"x":0.6711465852617644},{"width":0.3926940639269406,"text":"길이요 진리요 생명이니 나로","height":0.027375201288244666,"x":0.08675799332191775,"y":0.8486312400261675},{"width":0.363013698630137,"text":"• 아랍 사람들이 두려움, 혼란, 오해에서","x":0.5707762573630137,"y":0.8309178742082662,"height":0.02254428341384862},{"y":0.8228663445249598,"text":"말미암지 않고는 아버지께로 올","width":0.4223744292237443,"x":0.08675798734779311,"height":0.025764895330112725},{"width":0.27853881278538806,"height":0.019323671497584516,"text":"벗어나 길이요 진리요 생명이신","x":0.6004566237899542,"y":0.809983897004831},{"height":0.032206119162640934,"x":0.08447488739399865,"text":"자가 없느니라\"","width":0.2168949771689498,"y":0.7922705315619968},{"text":"예수님을 알고 진리를 받아들이도록.","x":0.6004566237252664,"height":0.020933977455716568,"width":0.3264840182648402,"y":0.7826086956655931},{"height":0.02492885697099123,"x":0.08894685319336738,"y":0.7387433014527671,"text":"요한복음 14:6","width":0.19653551981329376},{"y":0.7310789050149529,"width":0.3378995433789955,"x":0.5981735183953033,"text":"아랍 문화권의 사역자들이 이웃, 동료,","height":0.02254428341384862},{"y":0.7053140094739667,"width":0.27625570776255715,"height":0.02254428341384873,"x":0.5707762579718416,"text":"• 친구들과 깊은 관계를 맺고,"},{"width":0.35159817351598177,"text":"삶을 변화시키는 영적 대화를 나누도록.","height":0.020933977455716568,"x":0.5981735130517505,"y":0.681159420222759},{"width":0.3105022831050228,"y":0.6296296296430488,"x":0.598173518569254,"height":0.024154589371980784,"text":"꿈, 환상을 통한 예수님과의 만남이"},{"x":0.570776253678336,"y":0.6070853461442118,"height":0.019323671497584627,"text":"• 계속되며 아랍 사람들이 기독교인들을","width":0.365296803652968},{"width":0.23972602739726023,"height":0.020933977455716568,"y":0.5813204508185722,"x":0.6004566190068494,"text":"만나 예수님을 알아가도록."},{"height":0.019323671497584627,"text":"진리를 진심으로 찾는 메카 순례자들이","y":0.5330112720496893,"x":0.5981735135518591,"width":0.34018264840182655},{"y":0.5040257646859904,"x":0.5707762578995433,"width":0.22374429223744285,"height":0.020933977455716568,"text":"• 하나님을 발견하도록."},{"x":0.2899543407534246,"y":0.46215781006441226,"height":0.012882447665056418,"text":"Photo Source: Joshua Project","width":0.22831050228310507},{"width":0.2808219178082191,"height":0.019323671497584627,"y":0.4573268921810699,"x":0.600456622564688,"text":"이 지역에 존재하는 작은 기독교"},{"y":0.42834138481711526,"text":"• 공동체들이 믿음 안에서 강해지고,","x":0.5707762533268103,"width":0.33333333333333337,"height":0.02254428341384862},{"y":0.40579710152979076,"text":"그리스도를 더 깊이 알고 경험하도록","width":0.32191780821917804,"height":0.019323671497584516,"x":0.6004566236872145},{"y":0.3791605288011074,"width":0.137500510368173,"x":0.6001995160434989,"height":0.022677332498793,"text":"기도해 주세요."}]