[{"y":0.9613526570853462,"text":"기타 아시아 - 루리족 (이란) 73","x":0.7283105039954338,"width":0.23972602739726023,"height":0.01449275362318836},{"x":0.0867579949771689,"text":"루리족은 정치적 단위인 부족(\"일\")으로 나뉘어","width":0.410958904109589,"height":0.020933977455716568,"y":0.919484702141707},{"y":0.8904991946744881,"text":"있으며, 각 부족은 세습적인 족장 (칸)이 이끕니다.","height":0.024154589371980673,"x":0.08675798874755386,"width":0.4383561643835617},{"height":0.03475732849415947,"x":0.6710434490863506,"y":0.8803669074792869,"text":"기도제목","width":0.16704552358688285},{"width":0.4178082191780822,"height":0.019323671497584516,"x":0.08675798825627865,"text":"칸은 각 부족 중에서 선출됩니다. 그들이 유일한","y":0.8695652173107891},{"width":0.4292237442922375,"height":0.02254428341384862,"text":"참된 족장, 만왕의 왕에 대해 듣도록 기도합시다.","x":0.08675799515981725,"y":0.8405797101771336},{"y":0.8309178744319199,"text":"• 루리족이 유목 목자든 정착 농부든,","height":0.02254428341384862,"x":0.570776257597666,"width":0.34018264840182655},{"x":0.60045662345075,"y":0.8083735910628019,"height":0.020933977455716568,"width":0.34246575342465757,"text":"목자이신 예수님의 음성을 듣고 그분이"},{"x":0.6004566243835616,"text":"그들을 예수님의 양우리로 인도하시길","width":0.3378995433789954,"y":0.7826086957326892,"height":0.020933977455716568},{"x":0.6004566229023972,"text":"간절히 원하신다는 것올 깨닫도록.","width":0.30365296803652964,"y":0.75684380034219,"height":0.02254428341384862},{"y":0.7085346216701173,"text":"• 부족 족장들이 그리스도를 믿고","width":0.30593607305936066,"height":0.019323671497584516,"x":0.5707762578930202},{"y":0.6811594203345858,"text":"부족에게 복음을 나누도록.","width":0.23972602739726023,"x":0.6004566223363774,"height":0.020933977455716568},{"height":0.020933977455716568,"width":0.36986301369863006,"x":0.5707762584474885,"text":"• 그리스도의 메시지가 루리 사회의 강한","y":0.6328502417203435},{"text":"계급 구분올 깨뜨려, 그들이 한 목자","y":0.6038647342512078,"x":0.5981735128082193,"width":0.317351598173516,"height":0.02415458937198056},{"text":"아래 하나의 양떼가 되며, 연합과 존업,","x":0.6004566231449772,"y":0.5780998389995975,"width":0.34246575342465746,"height":0.02415458937198056},{"height":0.02093397745571668,"text":"소망을 발견하도록.","y":0.5555555555857488,"x":0.6004566221033105,"width":0.17579908675799094},{"height":0.02093397745571668,"y":0.5056360707830112,"text":"• 소수의 루리 기독교인들이 믿음 안에서","width":0.36757990867579904,"x":0.5707762534103882},{"text":"강해지고, 정기적으로 교제할 공동체를","y":0.47826086966586157,"x":0.6004566231449772,"height":0.02254428341384862,"width":0.34246575342465746},{"y":0.4524959740338165,"height":0.024154589371980673,"text":"찾도록, 루리족 가운데 복음의 문이","width":0.30593607305936077,"x":0.6004566196347031},{"text":"\"나는 선한 목자라 선한","x":0.08447488817677756,"y":0.4460547504485852,"width":0.3264840182648402,"height":0.032206119162640934},{"y":0.4315619968714056,"x":0.6004566232061318,"width":0.3082191780821918,"height":0.019323671497584516,"text":"열릴 뿐 아니라 이란 교회가 복음을"},{"y":0.41706924322866346,"text":"목자는 양들을 위하여 목숨을","x":0.08904109786529675,"width":0.3949771689497717,"height":0.027375201288244777},{"y":0.40418679550264547,"text":"나눌 열망을 갖도록.","x":0.6004566223091977,"width":0.182648401826484,"height":0.020933977455716568},{"text":"버리거니와\"","x":0.08904109675799084,"height":0.03059581320450888,"width":0.17351598173515986,"y":0.38969404200483093},{"width":0.3561643835616439,"text":"• 루리족과 함께 살며 그들을 조건 없이","x":0.5707762531637312,"y":0.355877616678169,"height":0.019323671497584516},{"x":0.09132420209284625,"y":0.3349436393719808,"text":"요한복음 10:11","height":0.024154589371980673,"width":0.2123287671232877},{"text":"사랑할 사역자들이 세워지도록 기도해","x":0.5981735131659057,"y":0.3301127213365539,"height":0.019323671497584516,"width":0.3378995433789954},{"height":0.020933977455716568,"x":0.6004566204109589,"text":"주세요.","width":0.0730593607305936,"y":0.3043478262962963},{"width":0.045662100456621,"y":0.26247987125603867,"x":0.09360730669710804,"height":0.008051529790660261,"text":"0 Karkuk"},{"y":0.26731078888888893,"width":0.05251141552511418,"x":0.42009132499999996,"height":0.009661835748792313,"text":"t Tehran"},{"text":"a Sanandal","hei