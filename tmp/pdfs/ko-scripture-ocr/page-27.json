[{"y":0.9613526570853462,"height":0.01449275362318836,"text":"아랍 - 알제리 아랍어 사용 집단 27","x":0.7009132439171559,"width":0.26712328767123283},{"width":0.2968036529680365,"x":0.08675799369863008,"text":"알제리 아랍어 공동체는 세계에서","y":0.9178743959259259,"height":0.020933977455716568},{"width":0.34246575342465757,"x":0.08675799331376385,"height":0.024154589371980673,"y":0.8904991948585231,"text":"가장 복음화가 덜 된 민족 중 하나이며,"},{"text":"기도제목","width":0.16680629503781397,"y":0.8806653952576542,"height":0.034160352943408134,"x":0.6711630633603857},{"width":0.28310502283105027,"y":0.867954911352657,"text":"복음주의는 0.01% 이하입니다.","height":0.020933977455716568,"x":0.0867579888454012},{"text":"이 민족 가운데 하나님의 나라가 뿌리내리려면","height":0.020933977455716568,"width":0.406392694063927,"y":0.843800322141707,"x":0.0867579949315068},{"y":0.8341384862520129,"x":0.5707762535530821,"width":0.3447488584474886,"height":0.019323671497584516,"text":"• 알제리 아랍인들이 예수 그리스도의"},{"x":0.08675798848458907,"width":0.3812785388127854,"height":0.024154589371980784,"y":0.8148148147443639,"text":"전략적 투자, 장기적 헌신, 지속적인 기도가"},{"y":0.809983897020934,"width":0.3264840182648402,"text":"참된 진리를 만나 사람을 자유케 하는","x":0.6004566230450913,"height":0.019323671497584516},{"height":0.024944391419538192,"x":0.08630516654074033,"y":0.7894601706480335,"text":"필요합니다.","width":0.11506090207731343},{"width":0.3264840182648402,"text":"진리를 알게 되고, 하나님께서 그들의","x":0.600456620936073,"height":0.024154589371980673,"y":0.779388083494364},{"width":0.3470319634703196,"y":0.7584541063707729,"x":0.6004566231735159,"height":0.020933977455716568,"text":"마음을 말씀에 순종케 하고 임재 안으로"},{"width":0.15772290861225557,"height":0.0216521648585124,"x":0.6003622915612714,"text":"인도해 주시도록.","y":0.7323301172253937},{"text":"• 아랍어 사용 알제리인들이 거주하는","y":0.6827697264573269,"x":0.5707762551369863,"width":0.3447488584474886,"height":0.020933977455716568},{"text":"나라들에 자유의 물결이 흘러가도록,","width":0.3264840182648402,"x":0.6004566241780821,"y":0.6537842187600644,"height":0.024154589371980673},{"width":0.3447488584474886,"y":0.6296296296618358,"x":0.5981735194292236,"height":0.02254428341384851,"text":"2024년 기준, 47개의 개신교회 가운데"},{"y":0.6070853463193007,"width":0.34018264840182644,"height":0.02093397745571668,"x":0.6004566234344423,"text":"단 4곳만이 공식적으로 문을 열고 있을"},{"height":0.02254428341384862,"x":0.6004566194634703,"text":"뿐이다. 이는 알제리 아랍인들 가운데","width":0.3264840182648402,"y":0.5797101447396672},{"text":"“진리를 알지니 진리가 너희를","x":0.08447488324771694,"width":0.4155251141552512,"y":0.5732689210849437,"height":0.03059581320450888},{"y":0.5571658616057051,"height":0.019323671497584516,"width":0.3264840182648402,"x":0.600456623336595,"text":"복음 전파와 제자 삼기가 특히 어렵게"},{"x":0.09132420407153724,"width":0.3789954337899543,"height":0.027375201288244777,"text":"자유롭게 하리라... 그러므로","y":0.5426731080112721},{"y":0.5297906600375738,"height":0.02254428341384862,"text":"만든다. 기독교 지도자들이 그들의","x":0.600456619672755,"width":0.3013698630136986},{"y":0.5152979064067174,"height":0.027375201288244666,"x":0.08904109716242664,"width":0.3926940639269406,"text":"아들이 너희를 자유롭게 하면"},{"y":0.5040257647074611,"x":0.6004566228120243,"text":"신앙을 굳건히 지키도록.","width":0.22146118721461194,"height":0.02254428341384862},{"y":0.48792270554405337,"height":0.032206119162640934,"width":0.40410958904109595,"text":"너희가 참으로 자유로우리라\"","x":0.08904109845075012},{"x":0.570776253438927,"text":"• 카빌족 베르베르인들의 기독교 성장은","width":0.363013698630137,"y":0.4573268920289856,"height":0.019323671497584516},{"y":0.4267310789210951,"x":0.08904109301369868,"text":"(요한복음 8:32, 36)","width":0.28767123287671237,"height":0.03059581320450877},{"text":"알제리 정부의 더 강한 사찰과 박해를","width":0.3264840182648402,"y":0.4315619968509573,"height":0.019323671497584516,"x":0.6004566228183662},{"width":0.32191780821917804,"height":0.024154589371980673,"x":0.6004566215563166,"y":0.400966183373591,"text":"증가하게 만들었는데, 박해 속에서도"},{"height":0.019323671497584516,"text":"알제리의 그리스도인들이 견고하게","width":0.3082191780821918,"y":0.3816425121488639,"x":0.600456622716895},{"y":0.350603312676221,"text":"SPAIN","width":0.043826277397539,"height":0.012158914464683312,"x":0.1961233907075849},{"text":"버티도록.","x":0.6000862697053575,"y":0.35341176203375124,"width":0.09434801040719087,"height":0.022645074964145473},{"x":0.1369863003805175,"height":0.00805152979066015,"y":0.33494363921095005,"width":0.0593607305936073,"text":"CIBRALTAR(UX)."},{"height":0.008164046467214359,"y":0.32522554533733716,"x":0.09359080014135968,"text":"ATLANTIC","width":0.05482753335613094},{"y":0.3123993560386473,"x":0.1027397268116526,"width":0.03652967818795817,"text":"OCEAN","height":0.009661835748792202},{"width":0.3447488584474886,"height":0.020933977455716568,"text":"• 아랍어 사용 알제리인들이 거주하는","x":0.5707762535844749,"y":0.3043478258776168},{"y":0.29629629635668275,"width":0.04109589041095889,"text":"Chlaseng","height":0.008051529790660261,"x":0.10958904160958903},{"y":0.2882447665257649,"text":"TUNISIA","height":0.01449275362318836,"x":0.43150684988584476,"width":0.045662100456621},{"height":0.019323671497584516,"text":"나라들에 영적으로 성숙하고","width":0.25114155251141557,"x":0.6004566194349314,"y":0.2801932366344606},{"x":0.09817351729452052,"width":0.10502283105022832,"text":"Saek MOROCCO","height":0.009661835748792202,"y":0.26570048317230266},{"y":0.25442834141706927,"text":"Asedir","height":0.006441223832528209,"x":0.10045662090182647,"width":0.02511415525114155},{"width":0.25114155251141557,"text":"문화적으로 민감한 선교팀이","y":0.25603864726247993,"height":0.019323671497584516,"x":0.6004566194349314},{"height":0.009661835748792202,"y":0.2302737519323672,"x":0.271689496489726,"text":"ALGERIA","width":0.09817351598173518},{"width":0.2191780821917808,"x":0.5981735181735159,"y":0.2286634460386473,"text":"세워지도록 기도합시다.","height":0.020933977455716568},{"text":"LIBYA","y":0.21256038644974895,"x":0.4726027398401826,"width":0.03881278538812788,"height":0.008051529790660261},{"height":0.00805152979066015,"text":"MAURITANIA","width":0.050228310502283116,"y":0.1642512078099838,"x":0.09132420175038049},{"te