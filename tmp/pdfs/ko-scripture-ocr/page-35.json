[{"x":0.687214613878017,"y":0.9613526570853462,"text":"인도 - 인도의 최전방 미전도 종족 35","width":0.2808219178082192,"height":0.01449275362318836},{"y":0.9178743959608159,"x":0.08675798907914761,"width":0.4200913242009133,"height":0.020933977455716568,"text":"그들에게 다가가려면 성령의 인도하심을 따르는"},{"x":0.08675799289383557,"y":0.8921095008252818,"width":0.32420091324200917,"height":0.02254428341384862,"text":"새롭고 창의적인 접근이 필요합니다."},{"x":0.6710972032220259,"y":0.880501650450882,"text":"기도제목","width":0.16693801531508634,"height":0.034487842553671655},{"width":0.410958904109589,"height":0.019323671497584516,"x":0.08675798829908679,"y":0.8695652173107891,"text":"여기에는 인도와 전 세계에서 더 많은 전문인과"},{"width":0.34246575342465757,"x":0.08675799331376385,"y":0.8438003221532091,"text":"헌신된 직장 사역자들을 동원하는 일도","height":0.019323671497584516},{"height":0.019323671497584627,"text":"• 성령께서 주요 도시의 최전방 미전도","x":0.5707762582191781,"width":0.35159817351598177,"y":0.8341384864044168},{"x":0.08667530085278201,"text":"포함됩니다.","width":0.11432063307391997,"y":0.8161985087222359,"height":0.02138720157641727},{"x":0.6004566236872145,"text":"종족들에 다가갈 창의적인 길을 열어","height":0.019323671497584516,"width":0.32191780821917804,"y":0.8099838969940956},{"y":0.7842190016818751,"text":"주시고 하나님께서 마 9:38와 같이","width":0.30593607305936066,"height":0.019323671497584627,"x":0.6004566227042111},{"y":0.7584541061996779,"text":"그 새로운 길에 응답할 더 많은","x":0.6004566193207763,"width":0.26940639269406386,"height":0.019323671497584627},{"x":0.6004566230821917,"text":"일꾼들올 보내주시도록,","width":0.2168949771689498,"y":0.7294685987922706,"height":0.024154589371980673},{"x":0.6004566225900558,"width":0.28538812785388123,"text":"그들이 요 4:35처럼 추수할 밭이","height":0.019323671497584405,"y":0.7085346216496691},{"width":0.3356164383561644,"y":0.6827697263400045,"height":0.019323671497584627,"text":"희어졌음을 보게 하시고 종족사람들이","x":0.6004566234018265},{"text":"복음을 들을 준비가 되도록.","width":0.2465753424657534,"y":0.6570048309293766,"height":0.02093397745571668,"x":0.6004566227658187},{"x":0.570776258219178,"y":0.6038647340740741,"text":"• 어느 한 종족도 제외되지 않고, 모든","height":0.02254428341384851,"width":0.34246575342465757},{"x":0.6004566238394214,"y":0.5829307569108964,"text":"종족들이 기도와 전도의 대상이 되도록","width":0.34018264840182655,"height":0.017713365539452575},{"x":0.5981735130136986,"height":0.017713365539452464,"y":0.5571658614533013,"text":"(마 9:37-38; 고후 10:16;","width":0.2374429223744292},{"text":"벧후 3:9; 계 7:9).","y":0.5292419680893832,"width":0.16009897728488864,"height":0.022031360202365513,"x":0.6025989147823598},{"text":"\"그런즉 그들이 믿지 아니하는","width":0.4155251141552512,"x":0.08447488297455968,"y":0.5217391306648264,"height":0.032206119162640934},{"text":"이를 어찌 부르리요 듣지도","width":0.365296803652968,"x":0.08675798782343992,"y":0.49436392906602245,"height":0.025764895330112836},{"width":0.36073059360730586,"text":"• 최전방 미전도 종족들에게 효과적으로","x":0.5707762587138507,"y":0.48148148157541604,"height":0.017713365539452464},{"width":0.33561643835616434,"height":0.027375201288244777,"x":0.08675798900304417,"y":0.4653784218196456,"text":"못한 이를 어찌 믿으리요"},{"text":"다가가기 위해 문화적으로 민감한","width":0.29680365296803657,"y":0.45732689202898547,"x":0.6004566185312025,"height":0.019323671497584516},{"width":0.3333333333333333,"height":0.025764895330112725,"x":0.0867579887842466,"y":0.43800322053140095,"text":"전파하는 자가 없이 어찌"},{"text":"접근이 이루어지도록,","y":0.42834138465378424,"x":0.6004566228995434,"width":0.19406392694063923,"height":0.020933977455716568},{"x":0.08846767266708451,"width":0.1472655692601313,"y":0.4076723448251056,"text":"들으리요\"","height":0.03489685672876719},{"x":0.6004566184741248,"y":0.4057971013821793,"text":"또한 이들 공동체 가운데 사역할 때","height":0.017713365539452464,"width":0.30365296803652975},{"height":0.02254428341384862,"x":0.6004566238127853,"text":"장기적인 헌신과 인내가 있도록.","y":0.3784218999355877,"width":0.28538812785388123},{"y":0.35380284906985393,"x":0.0889228735518418,"text":"로마서 10:14","width":0.18745105342777896,"height":0.02508351115596852},{"y":0.3268921094547964,"height":0.02254428341384862,"text":"• 영적 전도와 함께 그들의 육체적,","x":0.5707762534246575,"width":0.319634703196347},{"width":0.32420091324200906,"y":0.3043478260064413,"height":0.020933977455716568,"x":0.5981735127397261,"text":"사회적 필요를 채우기 위한 실제적인"},{"text":"도움과 자원이 제공되도록","y":0.2801932366344606,"height":0.019323671497584516,"x":0.6004566195490868,"width":0.23287671232876717},{"text":"기도해 주세요.","y":0.2544283415942029,"x":0.6004566197716895,"width":0.136986301369863,"height":0.020933977455716568},{"text":"Photo Source: Joshua Project","width":0.226027397260274,"y":0.04991948464170681,"x":0.29452054511986303,"height":0.011272141706924366}]