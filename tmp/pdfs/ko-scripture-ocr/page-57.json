[{"text":"인도 - 셰이크 57","x":0.824200911444064,"y":0.9613526569444444,"width":0.14383561643835607,"height":0.01449275362318847},{"height":0.02254428341384862,"text":"가장 낮은 힌두 카스트는 빈곤, 배제, 체계적","x":0.08675799408295275,"y":0.9162640902844874,"width":0.3858447488584475},{"y":0.8904991946859904,"text":"차별로 고통받고 있지만, 여전히 일부 카스트","width":0.3926940639269406,"x":0.08675799119373778,"height":0.02254428341384862},{"height":0.032206119162640934,"y":0.880837359366613,"width":0.1643835616438356,"text":"기도제목","x":0.6712328769025876},{"text":"기반 보호를 받습니다. 하지만 인도 무슬림들은","height":0.019323671497584627,"width":0.4132420091324201,"x":0.08675799431126324,"y":0.8695652174718196},{"text":"일상생활에서 같은 고통 속에 있지만,","width":0.3310502283105023,"x":0.08675799057077628,"height":0.024154589371980784,"y":0.8405797103864734},{"height":0.017713365539452464,"width":0.363013698630137,"text":"• 하나님께서 인도 기독교인들의 마음에","x":0.5707762587328766,"y":0.8341384864063339},{"width":0.2602739726027397,"x":0.08675799249429222,"y":0.8164251208031401,"text":"정부로부터 지원이 없습니다.","height":0.020933977455716568},{"text":"셰이크를 향한 사랑을 부어 주시도록,","x":0.6004566242922375,"height":0.020933977455716568,"width":0.3287671232876712,"y":0.8067632850080515},{"width":0.20319634703196343,"height":0.017713365539452464,"text":"기독교인들이 인도인의","x":0.6004566195531638,"y":0.7842190015297907},{"text":"고정관념을 넘어 셰이크를","y":0.76006441215781,"x":0.6004566193411611,"width":0.23287671232876717,"height":0.017713365539452575},{"y":0.7326892109098229,"height":0.019323671497584516,"x":0.6004566244863013,"width":0.27853881278538806,"text":"하나님의 가족으로 환영하도록."},{"width":0.35301184109901185,"height":0.035629676351992545,"text":"• 셰이크가 주님의 초대,\"오라, 목마른","x":0.5700569069229156,"y":0.6759887945117202},{"text":"자들아... 너희 영혼이 살리라\"","width":0.2648401826484018,"y":0.6570048311433172,"height":0.02254428341384873,"x":0.6004566233789955},{"width":0.24200913242009137,"x":0.598173518892694,"height":0.019323671497584627,"text":"(이사야 55:1-3)를 듣도록.","y":0.6312399353462157},{"height":0.03220611916264082,"text":"“내가 나를 위하여 그를이","x":0.0821917783268102,"y":0.6054750404876927,"width":0.363013698630137},{"y":0.5780998391534392,"height":0.025764895330112725,"text":"땅에 심고 긍휼히 여김을","width":0.3356164383561644,"x":0.08675799101435092},{"x":0.5707762532778865,"width":0.34018264840182655,"height":0.017713365539452464,"text":"• 셰이크 사람들이 억압적인 조건에서","y":0.5829307567632851},{"text":"자유롭게 되도록.","width":0.15541120206928682,"height":0.01997401748878369,"x":0.6003765922986626,"y":0.555230382553449},{"x":0.08447488540715375,"y":0.5475040255233494,"text":"받지 못하였던 자를 긍휼히","width":0.363013698630137,"height":0.02898550724637683},{"height":0.027375201288244777,"y":0.5201288245571658,"text":"여기며 내 백성 아니었던","x":0.08675799271943176,"width":0.3333333333333333},{"text":"• 셰이크가 현재 상황을","width":0.2191780821917808,"y":0.5072463768921095,"x":0.5707762572733204,"height":0.017713365539452464},{"width":0.3949771689497717,"x":0.08675799333618717,"height":0.025764895330112725,"text":"자에게 향하여 이르기를 너는","y":0.49275362326892114},{"text":"두려워하기보다 주님께로부터 오는","x":0.6004566179223745,"y":0.48148148140096614,"width":0.3082191780821918,"height":0.017713365539452464},{"x":0.084474882781583,"height":0.027375201288244777,"y":0.46376811587493283,"width":0.36757990867579915,"text":"내 백성이라 하리니 그들은"},{"width":0.20319634703196354,"x":0.6004566230365297,"height":0.020933977455716568,"y":0.45571658613526567,"text":"평화와 소망을 찾도록."},{"y":0.43639291473429953,"width":0.4246575342465754,"height":0.025764895330112725,"x":0.08675799352168946,"text":"이르기를 주는 내 하나님이시라"},{"x":0.08442353372979171,"y":0.4072001574399021,"height":0.031010311390850753,"width":0.2466780431738727,"text":"하리라 하시니라\""},{"y":0.4057971013821793,"width":0.2831050228310502,"text":"• 셰이크가 밀집한 지역에 사는","x":0.5707762533485541,"height":0.017713365539452464},{"text":"이슬람 문화를 따르는 젊은 셰이크들이","y":0.3816425122987118,"height":0.017713365539452464,"width":0.3378995433789954,"x":0.602739727283105},{"text":"호세아 2:23","x":0.08896150217051578,"width":0.17139206629365544,"height":0.02315376576594108,"y":0.35396256968970696},{"width":0.3529495169582977,"text":"예수님의 말씀, \"너는 내 사랑하는 자요,","height":0.03219864333885303,"y":0.34874115595750776,"x":0.5998120825035439},{"x":0.6004566230974124,"y":0.3268921093129361,"width":0.2557077625570776,"text":"너는 내 백성이라\"올 듣도록,","height":0.02254428341384862},{"height":0.024154589371980673,"text":"예수님 안에서 생명과 소망을 발견하고,","x":0.6004566229452054,"y":0.30112721419753097,"width":0.34931506849315075},{"x":0.35616438344748863,"text":"Peopies of South Asia","height":0.008051529790660261,"y":0.2834138486392914,"width":0.1141552511415525},{"height":0.02254428341384862,"text":"\"주는 내 하나님이시라\"라고","x":0.5981735180936073,"y":0.2801932367686527,"width":0.2534246575342466},{"height":0.009755516205816828,"width":0.05482757690290335,"y":0.27209486677514705,"text":"Shaikh","x":0.38811132638900575},{"text":"응답하도록 기도해 주세요.","y":0.2544283415942029,"width":0.23972602739726034,"height":0.020933977455716568,"x":0.6004566187442922},{"text":"Poot ation","width":0.05251141117043691,"x":0.10502283454035226,"y":0.12238325285829299,"height":0.004830917874396157},{"text":"Leis Dan 13,000","width":0.0547945205479452,"height":0.006441223832528098,"x":0.10958904098173516,"y":0.10950080516639837},{"text":"MALDES","y":0.07568438016639834,"width":0.04109589041095893,"x":0.2146118726027397,"height":0.008051529790660261},{"y":0.04966561150960502,"x":0.2898076273812855,"text":"Photo Source: Joshua Project","width":0.22857711304268336,"height":0.01320393726637592}]