[{"height":0.01449275362318836,"width":0.14383561643835618,"y":0.9613526569377349,"text":"아랍 - 예멘인 25","x":0.824200912043379},{"x":0.08675799002283106,"text":"기독교 선교가 19세기에 다시 시작되어","width":0.34474885844748854,"y":0.9194847023027375,"height":0.020933977455716568},{"x":0.08675799448249612,"y":0.8904991948604402,"height":0.024154589371980673,"text":"의료 활동, 교육, 기술 훈련에 중점을 두었습니다.","width":0.4337899543378996},{"x":0.6711720601235335,"text":"기도제목","width":0.1667883015114423,"height":0.03411588653466169,"y":0.8806876292301037},{"height":0.019323671497584516,"text":"전쟁과 불안정 가운데서도 복음은 충실히","width":0.36073059360730597,"x":0.08675798861301373,"y":0.8695652173107891},{"height":0.024154589371980673,"width":0.4063926940639269,"y":0.8405797099723947,"x":0.08675798982387478,"text":"전파되었으나, 최근까지 이를 받아들인 사람은"},{"text":"• 잦은 폭력적 내부 갈등과 난민,","y":0.8309178742082662,"height":0.02254428341384862,"x":0.5707762581811262,"width":0.3013698630136987},{"y":0.8148148149275363,"text":"별로 없습니다. 3,400만 명이 넘는 예멘인","height":0.024154589371980673,"width":0.3675799086757991,"x":0.08904109956620998},{"y":0.8083735910628019,"width":0.29680365296803646,"height":0.020933977455716568,"text":"영양실조를 동반한 오늘날 예멘의","x":0.6004566239726028},{"text":"대다수는 복음을 들어 보거나 이해하지 못했으며,","y":0.7890499192431562,"x":0.08675799515981732,"width":0.4337899543378996,"height":0.024154589371980784},{"text":"고통은, 옛 스바 왕국의 부요함 또는","width":0.31278538812785384,"height":0.02254428341384873,"x":0.6004566229594749,"y":0.7809983897946859},{"x":0.08675799383561639,"width":0.3561643835616438,"height":0.02093397745571668,"text":"신자들은 박해를 두려워하여 공개적으로","y":0.76811594212292},{"text":"아름다움과 극명한 대조를 이룹니다.","y":0.7568438003220612,"x":0.6004566242922375,"height":0.02254428341384862,"width":0.3287671232876712},{"height":0.023168082398492995,"width":0.1622725360469731,"x":0.08667195246590739,"text":"모일 수 없습니다.","y":0.7404288406715709},{"height":0.019323671497584516,"x":0.5981735134893456,"text":"예멘 사람들이 전심으로 구세주께","width":0.2990867579908676,"y":0.7342995168276973},{"text":"돌아오고, 다시 주님의 찬양을","y":0.7053140097906603,"width":0.2648401826484018,"height":0.02254428341384851,"x":0.600456623652968},{"height":0.02254428341384873,"x":0.08675798791585132,"y":0.6892109500345065,"width":0.4132420091324201,"text":"오늘날 일부 예멘인들은 이집트, 아랍에미리트,"},{"x":0.6002889189205268,"height":0.02184412444847217,"width":0.11220755206939836,"y":0.6807043462278262,"text":"선포하도록."},{"x":0.08675799390410953,"text":"영국 같은 국가에서 해외 생활하며","height":0.02093397745571668,"y":0.6666666667471819,"width":0.3036529680365297},{"x":0.0867579929223744,"height":0.02254428341384862,"y":0.6409017715619968,"text":"그리스도인들을 더 쉽게 만날 수 있습니다.","width":0.3744292237442922},{"height":0.020933977455716568,"text":"• 기독교 구호 NGO와 구호 사역자들이","y":0.6312399353784219,"x":0.5707762592694062,"width":0.36073059360730597},{"width":0.30365296803652975,"text":"이 땅에서 등불로 비추고 향기로운","height":0.020933977455716568,"y":0.6070853463902308,"x":0.6004566221651445},{"width":0.29680365296803657,"text":"향기를 뿜어냄으로써 많은 이들이","height":0.019323671497584516,"y":0.5829307569128134,"x":0.6004566231245922},{"height":0.019323671497584516,"text":"회개와 회복과 영혼이 새롭게 됨올","y":0.5571658616031491,"x":0.6004566226788431,"width":0.3013698630136986},{"height":0.024154589371980673,"x":0.6004566199543379,"width":0.2831050228310502,"y":0.5281803540257649,"text":"경험하고, 모든 가정들이 고통과"},{"width":0.271689497716895,"text":"죄책감, 수치에서 구원 받도록.","x":0.6004566229452054,"y":0.5040257649183345,"height":0.02254428341384862},{"y":0.4573268920289856,"x":0.5707762535245434,"width":0.34931506849315064,"height":0.019323671497584516,"text":"• 나라 안팎에서 흔들리지 않고 믿음을"},{"x":0.08219178349029675,"text":"\"스바 사람들은 다 금과 유향을","width":0.4269406392694064,"y":0.42673107895531404,"height":0.03059581320450888},{"text":"지켜온 예멘 신자들로 인하여","x":0.600456622283105,"width":0.2557077625570776,"height":0.019323671497584516,"y":0.43156199685990326},{"width":0.3926940639269406,"text":"가지고 와서 여호와의 찬송을","y":0.3993558778743962,"x":0.08904109616438355,"height":0.025764895330112725},{"height":0.02254428341384862,"y":0.40257648955601566,"x":0.6004566225538159,"text":"하나님께 감사드리도록,","width":0.2168949771689498},{"text":"그들의 간증이 더 많은 사람들에게","width":0.3013698630136987,"height":0.019323671497584516,"y":0.38164251214170697,"x":0.6004566240182647},{"text":"전파할 것이며\"","y":0.3680153735173337,"x":0.08654732925215361,"width":0.21275009085598603,"height":0.032085194487886604},{"text":"예수 안에서 새 희망을 찾게 하며","y":0.35587761682769725,"x":0.6004566228025113,"width":0.28767123287671237,"height":0.019323671497584516},{"width":0.25799086757990863,"x":0.6004566231544901,"height":0.019323671497584516,"text":"예멘 사람들이 주님께 나아와","y":0.33011272149758464},{"text":"이사야 60:6","x":0.08424324460965277,"y":0.3116836932464081,"height":0.030416832645926095,"width":0.17626237216061108},{"y":0.30434782618089107,"height":0.020933977455716568,"text":"그들의 마음이 금처럼 연단되고","x":0.6004566233257229,"width":0.27853881278538817},{"width":0.34246575342465757,"y":0.2801932367839889,"height":0.019323671497584516,"text":"삶이 거룩한 찬양의 향기로 드려지도록","x":0.60045662345075},{"y":0.25281803565217387,"x":0.6004566205479451,"text":"기도해 주세요.","width":0.136986301369863,"height":0.02254428341384862},{"text":"Saudi Arabia","width":0.1095890410958904,"height":0.016103059581320522,"x":0.2077625557077626,"y":0.21739130426731068},{"width":0.02968036529680365,"y":0.21095008061191622,"text":"Red","x":0.1575342468721461,"height":0.012882447665056418},{"x":0.39041095848554036,"y":0.2141706925523349,"text":"Oman","width":0.0547945205479452,"height":0.01449275362318847},{"x":0.16438356135844753,"width":0.0273972602739726,"y":0.19806763303140085,"text":"Sea","height":0.01449275362318847},{"height":0.02412954735871098,"text":"Yemen","y":0.1846411163681141,"width":0.14748525401772974,"x":0.22531377963575358},{"width":0.06621004566210047,"height":0.01449275362318847,"text":"Eritrea","y":0.17552334937600633,"x":0.11415525031392697},{"text":"* sanala","width":0.06792237007454652,"x":0.23744292195042402,"height":0.022544283413848