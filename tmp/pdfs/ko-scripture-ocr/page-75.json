[{"x":0.6826483994482496,"text":"기타 아시아 - 말레이시아 말레이 75","height":0.01449275362318836,"y":0.9613526569377349,"width":0.28538812785388123},{"y":0.9194847020128825,"text":"말레이를 대상으로 사역하는 한 부부는","width":0.34246575342465757,"height":0.019323671497584516,"x":0.08675798801369868},{"y":0.8917369940665438,"x":0.08890042327426177,"text":"말했습니다.","height":0.021678991363820233,"width":0.10987038808326198},{"text":"기도제목","y":0.8804185164638257,"x":0.6710639944535023,"width":0.16700443285240973,"height":0.03465411052611711},{"x":0.08428734857815656,"height":0.022709418034208007,"y":0.8678669042274851,"text":"\"말레이 선교의 민감한 특성으로 교회가","width":0.3542249845043165},{"x":0.08675798732876717,"height":0.019323671497584627,"y":0.8438003220075148,"width":0.4246575342465754,"text":"인력이나 재정으로 말레이 선교에 거의 참여하지"},{"x":0.5707762586377473,"y":0.8341384863929147,"height":0.019323671497584516,"text":"• 주님께서 많은 말레이인의 눈을 열어","width":0.35159817351598166},{"y":0.8164251208668813,"width":0.4269406392694064,"height":0.02093397745571668,"text":"않습니다. 말레이인은 여전히 복음에서 소외되어","x":0.08675799442541851},{"y":0.8099838968599034,"text":"사회적:정치적 어려움에도 불구하고","x":0.5981735133371385,"width":0.317351598173516,"height":0.019323671497584627},{"x":0.08649916424497678,"text":"있지만, 일부는 그리스도를 알기를 열망합니다.\"","height":0.02759351131420784,"width":0.42299523201162953,"y":0.7889594772143749},{"text":"진리를 찾도록.","height":0.024637339771657718,"width":0.13992037838452487,"x":0.6001311364010271,"y":0.7799518611102285},{"y":0.7342995169887279,"x":0.5707762588660578,"width":0.3789954337899544,"height":0.019323671497584516,"text":"• 말레이시아의 기독교인들이 말레이인을"},{"y":0.705314009520934,"width":0.34931506849315064,"text":"사랑으로 대하고, 말과 행동으로 복음을","x":0.5981735157962329,"height":0.02254428341384862},{"text":"“하나님이 우리에게 주신 것은","x":0.08675798789954342,"y":0.6956521739015413,"width":0.4155251141552511,"height":0.03059581320450877},{"width":0.09360730593607303,"height":0.02093397745571668,"y":0.6811594203243616,"text":"나누도록.","x":0.6004566216731899},{"y":0.6666666667471819,"text":"두려워하는 마음이 아니요","width":0.3538812785388128,"height":0.025764895330112836,"x":0.09132420312499998},{"x":0.09132419894977171,"width":0.3926940639269406,"height":0.027375201288244777,"y":0.6376811593478261,"text":"오직 능력과 사랑과 절제하는"},{"x":0.5707762537813927,"width":0.3082191780821917,"height":0.02254428341384862,"y":0.6296296295692432,"text":"• 오디오 성경, 앱, 소셜 미디어 등"},{"y":0.6086956522678475,"text":"마음이니 그러므로 너는 우리","width":0.3926940639269406,"height":0.027375201288244888,"x":0.09132420418569248},{"y":0.6070853462862319,"text":"미디어를 통한 말레이 선교가","width":0.25799086757990874,"height":0.020933977455716568,"x":0.600456622617009},{"x":0.09132419909713578,"width":0.3995433789954338,"text":"주의 증거와 또는 주를 위하여","height":0.027375201288244666,"y":0.581320450805153},{"height":0.021086137651821213,"x":0.600429216189181,"y":0.5812443703220869,"text":"열매 맺도록.","width":0.11649316413217481},{"x":0.08904109785007605,"width":0.39497716894977164,"height":0.027375201288244666,"text":"갇힌 나를 부끄러워하지 말고","y":0.5523349434111648},{"x":0.5707762536815069,"text":"• 교회가 과거와 현재에 말레이인을","width":0.32420091324200917,"y":0.5330112720611917,"height":0.019323671497584516},{"y":0.524959742278583,"height":0.027375201288244666,"text":"오직 하나님의 능력을 따라","x":0.09132419909817353,"width":0.363013698630137},{"width":0.30365296803652964,"text":"복음에서 소외시킨 것을 회개하고,","height":0.02254428341384862,"y":0.5040257649154589,"x":0.6004566229023972},{"y":0.4975845412327786,"width":0.3835616438356165,"text":"복음과 함께 고난을 받으라\"","height":0.030595813204508993,"x":0.09132420276509386},{"x":0.6004566241780821,"text":"그리스도의 사랑으로 그들을 온전히","y":0.48148148154589376,"height":0.019323671497584516,"width":0.317351598173516},{"width":0.36986301369863017,"y":0.45571658613526567,"x":0.6004566247031963,"text":"용납하는 새로운 사역의 시대가 열리도록.","height":0.020933977455716568},{"text":"디모데후서 1:7-8","width":0.2442922374429224,"height":0.024154589371980673,"y":0.44283413856682774,"x":0.09360730729325212},{"x":0.5707762536366602,"width":0.2899543378995433,"text":"• 하나님께서 전 세계 교회 안에","y":0.40579710138026237,"height":0.019323671497584516},{"x":0.6004566180365296,"width":0.3561643835616439,"height":0.020933977455716568,"text":"말레이시아에 창의적인 방법으로 들어가","y":0.38003220602522814},{"x":0.09360730360223243,"y":0.3526570047504025,"width":0.4200913242009132,"text":"말레이시아의 말레이인은 \"말레이가 되려면","height":0.020933977455716568},{"x":0.6004566230165526,"width":0.32191780821917804,"height":0.019323671497584516,"y":0.35587761682769725,"text":"자유롭게 복음을 전할 새로운 세대를"},{"x":0.0913242000951294,"text":"무슬림이어야 한다\"는 믿음을 가지고","height":0.020933977455716568,"width":0.35844748858447484,"y":0.3301127212426195},{"width":0.26027397260273977,"x":0.6004566231735159,"height":0.020933977455716568,"y":0.3285024154723565,"text":"일으키시도록 기도해 주세요."},{"height":0.02254428341384862,"x":0.09132420394651009,"y":0.30756843809523815,"width":0.4246575342465754,"text":"있습니다. 말레이인이 그리스도 안에서 참된"},{"x":0.09132419797782132,"height":0.020933977455716568,"width":0.410958904109589,"y":0.28824476642512076,"text":"정체성을 발견하고 두려움에서 벗어나도록"},{"height":0.022790631618284762,"x":0.09127915681585438,"text":"기도합시다.","y":0.26557730960030723,"width":0.12337776079569779},{"width":0.038812785388127824,"y":0.19967793886588447,"height":0.01449275362318847,"text":"10n E","x":0.4703196349804305},{"width":0.07077625570776258,"x":0.2534246566495434,"text":"Malaysia","height":0.011272141706924255,"y":0.17874396129227055},{"text":"\" Lumpur","height":0.008051529790660261,"y":0.11916264103596352,"width":0.04794520547945205,"x":0.13242009090563167},{"x":0.29908675926940637,"y":0.06924315626409028,"text":"© WorldAtlas.com","height":0.009661835748792202,"width":0.1278538812785388},{"height":0.009661835748792313,"x":0.32420091520547945,"width":0.19634703196347036,"text":"Photo Source: WorldAtlas","y":0.0515297907246377}]