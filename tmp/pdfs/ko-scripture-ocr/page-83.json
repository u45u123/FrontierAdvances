[{"height":0.01449275362318836,"x":0.7671232891063275,"y":0.9613526570853462,"width":0.2009132420091324,"text":"기타 아시아 - 실헤티 83"},{"width":0.4041095890410959,"text":"실헤티가 사는 지역은 국제적으로 철새 이동에","x":0.0867579933932648,"y":0.919484702173913,"height":0.019323671497584627},{"x":0.08675798968036526,"width":0.4246575342465753,"y":0.8921095005797102,"text":"중요한 지역으로, 기독교 조류학자나 과학자들이","height":0.02254428341384862},{"width":0.16666666666666663,"height":0.03542673107890504,"x":0.6712328777071102,"text":"기도제목","y":0.8792270528870485},{"y":0.8663446054750402,"text":"현지인과 교류할 기회를 제공할 수 있습니다.","width":0.3949771689497717,"x":0.08675799415905626,"height":0.02254428341384862},{"height":0.020933977455716568,"text":"• 강한 지역 정체성을 가진 실헤티인들이","y":0.8341384865217392,"width":0.3721461187214611,"x":0.570776253127854},{"width":0.34246575342465757,"text":"참된 시민권이 하나님의 영원한 나라에","height":0.020933977455716568,"x":0.6004566229071537,"y":0.8083735910628019},{"text":"있음을 깨닫고, 예수 그리스도를 간절히","y":0.7809983895330113,"height":0.02254428341384862,"width":0.34931506849315075,"x":0.60045662043379},{"x":0.6004566233039791,"y":0.7584541063607085,"width":0.32191780821917804,"height":0.020933977455716568,"text":"기다리며 지역 한계를 넘어 하나님의"},{"height":0.03059581320450888,"y":0.7520128824979871,"width":0.41324200913242015,"x":0.08904109847317346,"text":"\"오직 우리의 시민권은 하늘에"},{"y":0.7310789049919485,"text":"사랑을 받아들이도록.","height":0.02254428341384862,"width":0.2009132420091324,"x":0.5981735179908676},{"text":"있는지라 거기서 구원하는","y":0.723027375120773,"x":0.09132419894723495,"width":0.3538812785388128,"height":0.027375201288244777},{"width":0.3424657534246575,"x":0.09360730878995427,"text":"자 곧 주 예수 그리스도를","y":0.6972624799651099,"height":0.024154589371980784},{"text":"• 그들이 주의 이름을 부르고","height":0.019323671497584627,"x":0.570776257615786,"y":0.6827697263400045,"width":0.26712328767123295},{"y":0.6696726897225406,"x":0.09353975742280224,"text":"기다리노니\"","width":0.17365108124197348,"height":0.02780437930194657},{"y":0.657004830837359,