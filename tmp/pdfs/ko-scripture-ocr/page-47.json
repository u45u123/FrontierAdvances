[{"height":0.01449275362318847,"x":0.824200911444064,"text":"인도 - 쿰하르 47","y":0.9613526569444444,"width":0.14383561643835607},{"y":0.9194847021624108,"text":"쿰하르들은 힌두교도이며","height":0.019323671497584516,"width":0.226027397260274,"x":0.08675799248206129},{"y":0.8953301128019324,"x":0.08675799207255196,"text":"파괴의 신 시바(Shiva)와","height":0.017713365539452464,"width":0.21689497716894973},{"x":0.6711775906435268,"width":0.16449413560841175,"y":0.8806964042614172,"height":0.03248802744056101,"text":"기도제목"},{"text":"어머니 여신 마타(Mata)을 숭배합니다.","x":0.08675799372146115,"height":0.02254428341384862,"width":0.3470319634703196,"y":0.8663446052871713},{"text":"• 그들이 하나님의 손에 의해 그분의","height":0.019323671497584627,"width":0.33105022831050235,"x":0.570776258072407,"y":0.8341384864044168},{"y":0.8067632850241546,"x":0.600456624543379,"text":"형상대로 빚어진 그릇임을 알게 하시고,","height":0.02254428341384862,"width":0.3538812785388127},{"text":"지금도 하나님이 강력한 손으로 그들을","x":0.6004566231449772,"height":0.019323671497584516,"width":0.34246575342465746,"y":0.7842190016908213},{"text":"빚고 싶어 하심올 깨닫도록.","height":0.020933977455716568,"y":0.7568438003354804,"x":0.6004566230593607,"width":0.2465753424657534},{"y":0.7053140096618358,"x":0.5707762587214611,"width":0.3013698630136986,"height":0.02254428341384862,"text":"• 이미 그들에게 정직함, 근면함,"},{"width":0.43150684931506855,"text":"\" 큰 집에는 금 그릇과 은 그릇뿐","x":0.0844748834982243,"height":0.032206119162641045,"y":0.6779388085525138},{"text":"영적 성품을 주신 하나님 찬양합니다.","x":0.600456624589041,"y":0.6811594203381642,"width":0.35844748858447495,"height":0.020933977455716568},{"height":0.019323671497584516,"x":0.6004566185257665,"text":"이들이 이 성품을 통해 하나님의 영광을","width":0.3470319634703196,"y":0.658615136783989},{"text":"아니라 나무 그릇과 질그릇도","y":0.6505636071658615,"x":0.08675799306189745,"height":0.027375201288244777,"width":0.3949771689497717},{"x":0.6004566230165526,"y":0.632850241626409,"text":"선포하며 하나님의 속성을 나타낼 수","height":0.019323671497584516,"width":0.32191780821917804},{"text":"있어 귀하게 쓰는 것도 있고","x":0.08904109821632417,"width":0.37214611872146114,"y":0.6231884058776167,"height":0.025764895330112725},{"height":0.02254428341384862,"y":0.605475040445518,"text":"있도록 기도해 주세요.","x":0.6004566194063927,"width":0.2009132420091324},{"height":0.027375201288244777,"x":0.08675799366438351,"y":0.5942028987251744,"text":"천하게 쓰는 것도 있나니","width":0.3356164383561644},{"x":0.08904109872146117,"width":0.4200913242009132,"height":0.025764895330112614,"y":0.5668276970048309,"text":"그러므로 누구든지 이런 것에서"},{"y":0.5378421901055646,"height":0.025764895330112725,"x":0.08675799288432264,"text":"자기를 깨끗하게 하면 귀히","width":0.363013698630137},{"height":0.027375201288244777,"text":"쓰는 그릇이 되어 거룩하고","x":0.08675799315068489,"width":0.36529680365296807,"y":0.5088566828603059},{"y":0.48148148140096614,"text":"주인의 쓰심에 합당하며 모든","width":0.3949771689497717,"x":0.08675798867326233,"height":0.027375201288244777},{"x":0.08675798893835619,"text":"선한 일에 준비함이 되리라\"","height":0.03059581320450888,"width":0.3858447488584475,"y":0.4541062800885668},{"y":0.3993558776892109,"width":0.2853881278538813,"text":"디모데후서 2:20-21","x":0.08904109731735156,"height":0.024154589371980673},{"height":0.008051529790660261,"text":"Peoples of South Asia","width":0.11187214611872143,"y":0.2753623189009662,"x":0.35844748998287673},{"text":"ArGHANISTAN","width":0.0547945205479452,"x":0.13013698691019784,"y":0.26409017726784756,"height":0.008051529790660261},{"text":"Kumhar (Hindu traditions)","x":0.321917806324201,"y":0.26247987111111104,"width":0.1894977168949772,"height":0.009661835748792313},{"y":0.11272141720343531,"width":0.0547945205479452,"x":0.10730593523592089,"text":"Population","height":0.008051529790660261},{"y":0.06763285016103071,"width":0.041381278538812793,"height":0.008051529790660261,"x":0.21461187146118726,"text":"MALDWES"},{"x":0.2899543406392693,"width":0.228310502283105,"y":0.045088567042404604,"text":"Photo Source: Joshua Project","height":0.012882447281129528}]