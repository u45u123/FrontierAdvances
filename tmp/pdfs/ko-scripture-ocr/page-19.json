[{"y":0.9613526570987654,"x":0.794520549391172,"text":"아프리카 - 소말리 19","height":0.01449275362318847,"width":0.1735159817351598},{"height":0.019323671497584516,"x":0.10273972938356159,"width":0.3356164383561644,"y":0.91948470215781,"text":"소말리아인들은 특히 시들을 포함하여"},{"y":0.8937198065888352,"x":0.10273972853881273,"height":0.020933977455716568,"width":0.30593607305936066,"text":"풍부한 구전 유산으로 유명합니다."},{"x":0.6711481529455655,"width":0.16683611586757985,"height":0.03423422968521972,"y":0.8806284568863785,"text":"기도제목"},{"height":0.024154589371980673,"y":0.8679549114465915,"x":0.10273972899543374,"text":"시는 감정을 표현하고, 역사를 공유하며,","width":0.3561643835616438},{"x":0.10273972398891067,"text":"갈등을 해결하는 데 사용됩니다.","width":0.28538812785388123,"height":0.02254428341384862,"y":0.8470209339084426},{"y":0.8260869566022544,"text":"시골 지역에서도 사람들은 긴 시를 외우고","x":0.10273972909056309,"height":0.019323671497584627,"width":0.36757990867579904},{"x":0.5707762583333333,"text":"• 소말리아인들이 갈등, 트라우마, 이주,","width":0.36757990867579904,"y":0.8309178744191397,"height":0.02254428341384862},{"height":0.019323671497584516,"y":0.809983897020934,"width":0.32191780821917804,"x":0.6004566236872145,"text":"고난 속에서도 새로운 노래와 희망의"},{"height":0.02254428341384862,"text":"낭송합니다. 시인들은 사회에서 존경받으며,","x":0.10502283493150681,"width":0.3881278538812785,"y":0.7987117552657005},{"width":0.27853881278538806,"text":"시와 하나님 찬양으로 자신들을","y":0.7842190016747181,"x":0.6004566237899542,"height":0.019323671497584627},{"text":"시 경연대회가 빈번하게 열립니다.","height":0.02254428341384851,"width":0.3059360730593607,"y":0.7761674720450886,"x":0.10273972735159818},{"width":0.11187214611872143,"text":"표현하도록.","y":0.7584541064546431,"height":0.020933977455716568,"x":0.6004566204908676},{"y":0.7278582928502415,"width":0.3949771689497717,"x":0.10273972993150683,"height":0.02254428341384873,"text":"이 전통은 소말리아 언어를 강하게 유지하며,"},{"text":"이야기 나누기, 지혜, 창의력올 통해","x":0.10502283365677316,"height":0.024154589371980673,"width":0.3127853881278539,"y":0.7037037038244767},{"y":0.7053140096618358,"text":"• 하나님의 말씀이 낭송되게 하시고,","x":0.5707762590410959,"width":0.33333333333333326,"height":0.02254428341384862},{"x":0.10273972587519024,"width":0.1963470319634703,"text":"세대들을 연결합니다.","y":0.6827697264358561,"height":0.02254428341384873},{"text":"성도들이 소말리아 사회에서 성경이","width":0.31506849315068486,"y":0.682769726176418,"x":0.6004566192541858,"height":0.019323671497584516},{"width":0.3082191780821918,"x":0.6004566190781964,"text":"표현하는 진리, 아름다움, 희망으로","height":0.02254428341384851,"y":0.655394524899356},{"y":0.6300517992103285,"text":"존경받도록.","x":0.6000334780803741,"height":0.023310249746325673,"width":0.11271843409429405},{"y":0.5829307569243156,"text":"• 기독교 미디어와 온라인","width":0.23972602739726023,"height":0.017713365539452464,"x":0.5707762574200913},{"x":0.60045662345075,"width":0.34246575342465757,"text":"플랫폼이 시적일 뿐만 아니라 풍부하고","y":0.5571658616057051,"height":0.019323671497584516},{"x":0.6004566189069636,"text":"전통적이며 창의적인 방식으로 복음을","width":0.3356164383561644,"height":0.019323671497584516,"y":0.5330112720611917},{"text":"6","x":0.08219178072407046,"y":0.5217391305728089,"width":0.0273972602739726,"height":0.019323671497584516},{"width":0.3698630136986301,"text":"새 노래 곧 우리 하나님께","y":0.5088566830434783,"x":0.10045662168949775,"height":0.027375201288244777},{"text":"제시함으로써 국민들의 마음이","y":0.5072463768831634,"width":0.26940639269406397,"x":0.6004566225012683,"height":0.019323671497584405},{"x":0.08447488775277232,"width":0.3995433789954338,"text":"올릴 찬송을 내 입에 두셨으니","height":0.027375201288244777,"y":0.4798711753278123},{"width":0.19634703196347025,"height":0.020933977455716568,"y":0.4798711755367687,"text":"복음으로 감동받도록.","x":0.6004566226407915},{"text":"많은 사람이 보고 두려워하여","x":0.08447488911719933,"height":0.024154589371980673,"y":0.45410628028717126,"width":0.3926940639269406},{"y":0.4315619968714056,"text":"• 많은 소말리아인들이 예수님을 알고","width":0.3447488584474886,"x":0.5707762581702543,"height":0.019323671497584516},{"x":0.08219177822896286,"text":"여호와를 의지하리로다...\"","height":0.032206119162640934,"y":0.4235104668737061,"width":0.36301369863013694},{"y":0.40257648934514223,"x":0.6004566212519026,"width":0.32191780821917804,"height":0.02254428341384862,"text":"그분을 신뢰하도록, 그들이 찬양으로"},{"height":0.020933977455716568,"y":0.3800322059098229,"x":0.6004566239269407,"width":0.3013698630136986,"text":"가득찬 입으로 삶과 복음을 담대히"},{"width":0.1442014528736132,"y":0.36666360085203065,"text":"시편 40:3","x":0.08200886368561026,"height":0.028347514485775327},{"text":"나누며 그리스도와 다른 성도들과의","y":0.35587761666666673,"width":0.31506849315068497,"height":0.019323671497584516,"x":0.6004566190353882},{"x":0.6004566245205479,"y":0.3285024154428341,"width":0.35159817351598166,"height":0.020933977455716568,"text":"교제를 통해 능력과 영적성장을 얻도록."},{"x":0.12100456780821915,"height":0.009661835748792202,"text":"Somali in SOMALIA","y":0.2818035427536232,"width":0.1278538812785388},{"height":0.019323671497584516,"width":0.34246575342465746,"text":"• 주님께서 향후 수 개월 동안 더 많은","y":0.2801932368044373,"x":0.5707762576103501},{"x":0.10802919431084065,"y":0.2596071796601168,"text":"suuAN 5","width":0.07885211787811697,"height":0.021011553716736353},{"width":0.08675799086757996,"height":0.012882447281129417,"y":0.2640901773483628,"text":"3ccs4350 동물었다.","x":0.363013698934551},{"y":0.2544283413144123,"x":0.6004566191495434,"width":0.29680365296803657,"text":"일꾼들과 주님을 찬양하는 자들을","height":0.020933977455716568},{"height":0.0101470947265625,"text":"Adds Ababa","y":0.23486204043257775,"x":0.1574692778534193,"width":0.07090619492204223},{"x":0.6004566200228311,"height":0.020933977455716568,"text":"소말리아인들에게 보내주도록","y":0.2286634462640902,"width":0.26712328767123283},{"x":0.1825400154060746,"y":0.21707729114881247,"width":0.06414371211779174,"height":0.01190016811020711,"text":"ETHOPIA"},{"height":0.009661835748792313,"text":"Pgaroowe","width":0.0593607305936073,"y":0.21900161025228126,"x":0.34474885745814315},{"y":0.20611916270531405,"height":0.009661835748792313,"width":0.047945205479452066,"text":"SCUTH