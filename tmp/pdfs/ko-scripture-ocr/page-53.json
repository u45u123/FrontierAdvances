[{"width":0.15753424657534243,"text":"인도 - 라즈푸트 53","y":0.9613526570853462,"height":0.01449275362318836,"x":0.8105022842302674},{"height":0.02254428341384862,"x":0.08675799189497714,"y":0.9162640900362319,"text":"복음이 라즈푸트를 변화시킬 때, 그들의 영향력","width":0.4109589041095891},{"text":"있는 위치는 인도와 전 세계의 다른 민족 집단들","width":0.41780821917808225,"y":0.8937198068303811,"height":0.020933977455716568,"x":0.08675799434931504},{"y":0.8803454152520931,"x":0.6710418727731297,"text":"기도제목","height":0.033190005451392834,"width":0.1647655713503764},{"width":0.3607305936073059,"height":0.020933977455716568,"y":0.8679549112587225,"x":0.08675798816590569,"text":"가운데 복음을 전파하고 하나님의 나라를"},{"y":0.8421900163285024,"x":0.08675798977168954,"width":0.2922374429223744,"text":"확장하는 촉매가 될 수 있습니다.","height":0.02254428341384862},{"y":0.8341384864044168,"text":"• 세대를 통해 라즈푸트들을 묶어둔 영적","width":0.3721461187214612,"x":0.570776258365949,"height":0.019323671497584627},{"width":0.3287671232876712,"y":0.8051529788244767,"height":0.024154589371980673,"x":0.6004566211872145,"text":"결박이 풀어지도록, 거짓 믿음과 우상"},{"height":0.019323671497584516,"width":0.3538812785388128,"y":0.7842190016908213,"x":0.6004566232163242,"text":"숭배의 사슬이 예수 안에서 찾을 수 있는"},{"width":0.3013698630136986,"y":0.7584541064297217,"x":0.60045662012394,"text":"진리에 대한 추구로 바뀌고 그분의","height":0.020933977455716568},{"x":0.600456624543379,"text":"이름 안에서 자유와 구원을 경험하도록.","height":0.020933977455716568,"width":0.3538812785388127,"y":0.7326892109339774},{"height":0.019323671497584516,"x":0.5707762535673516,"y":0.6827697261876007,"text":"• 주님께서 힌두교 라즈푸트 사란들의","width":0.34246575342465757},{"height":0.019323671497584627,"y":0.6586151369450195,"x":0.6004566229941292,"text":"마음을 부드럽게 하시고 진리를","width":0.27853881278538817},{"text":"받아들이도록, 예수 그리스도를 통한","width":0.32420091324200917,"y":0.6296296298309179,"x":0.6004566233637747,"height":0.024154589371980673},{"height":0.019323671497584516,"x":0.6004566223515982,"y":0.6070853460225443,"text":"구원의 메시지가 그들의 영혼을","width":0.27625570776255703},{"height":0.02254428341384862,"text":"감동시켜서 꿈, 환상, 신적 계시를 통해","width":0.3378995433789954,"y":0.5797101448671498,"x":0.6004566188926941},{"width":0.319634703196347,"y":0.557165861594203,"text":"예수를 만나 하나님의 사랑과 은혜를","height":0.017713365539452464,"x":0.6004566242009132},{"y":0.5312439815183829,"x":0.6004014094214108,"text":"경험하도록.","width":0.10969946700144029,"height":0.019637639203893276},{"height":0.019323671497584516,"text":"• 라즈푸트들이 복음을 받아들이기 위해","y":0.4814814814124685,"width":0.3630136986301369,"x":0.5707762531148076},{"width":0.3835616438356164,"x":0.08447488578767125,"text":"\"주 앞에서 낮추라 그리하면","height":0.03220611916264082,"y":0.45732689190821263},{"y":0.4524959740338165,"width":0.3287671232876712,"x":0.6004566208523593,"text":"자신을 낮추도록, 하나님 영광올 위해","height":0.024154589371980673},{"x":0.08904109818982384,"y":0.4299516910512998,"width":0.37671232876712324,"height":0.03220611916264082,"text":"주께서 너희를 높이시리라\""},{"width":0.28538812785388135,"y":0.428341384863124,"text":"그들의 문화가 회복되게 하시고,","height":0.02254428341384862,"x":0.6004566233828006},{"width":0.3013698630136986,"height":0.019323671497584516,"x":0.600456622888128,"text":"유산을 기념하되 지극히 높은 분의","y":0.40579710152979065},{"text":"자녀로서의 정체성을 더 소중히 여겨","x":0.6004566190068494,"width":0.319634703196347,"y":0.3800322060487118,"height":0.020933977455716568},{"text":"야고보서 4:10","y":0.3747827458474292,"height":0.02499167431571825,"x":0.0912236092883525,"width":0.19883132307496793},{"text":"하나님께 기쁘게 영광 돌리도록.","height":0.02254428341384873,"x":0.6004566239954336,"y":0.352657004605475,"width":0.3076483844077751},{"height":0.019323671497584516,"width":0.34931506849315064,"text":"• 주님께서 그들 가운데 자신의 백성을","x":0.5707762535245434,"y":0.30595813196457333},{"text":"Peoples of South Asia","width":0.1141552511415525,"height":0.00805152979066015,"y":0.28180354259259255,"x":0.3584474866818874},{"width":0.2831050228310502,"x":0.6004566230267449,"y":0.2801932368069934,"text":"보내 예수를 따르고 만왕의 왕을","height":0.019323671497584516},{"x":0.32876712150684934,"width":0.1780821917808219,"height":0.011272141706924366,"text":"Rajput (Hindu traditions)","y":0.26892109492753613},{"height":0.024154589371980673,"x":0.6004566235159816,"text":"경배하는 의미를 깨닫게 해주시며,","width":0.30593607305936077,"y":0.25120772971014493},{"x":0.6004566231449772,"text":"각 가정들이 자발적으로 복음을 나누고","width":0.34246575342465746,"height":0.019323671497584516,"y":0.23027375209339773},{"y":0.2045088566290929,"text":"먼저 하나님의 나라를 구하려는 의지로","width":0.34246575342465757,"height":0.019323671497584516,"x":0.600456618150685},{"width":0.2191780821917808,"y":0.1787439615619968,"text":"구별되게 기도해 주세요.","x":0.6004566214155251,"height":0.020933977455716568},{"y":0.11916264083058081,"width":0.05251141117043691,"x":0.1073059370517679,"text":"Popu ation","height":0.004830917874396157},{"width":0.0502283105022831,"height":0.006441223832528209,"y":0.10628019325684379,"text":"Lers Uhan 13,000","x":0.11643835609303654},{"y":0.07085346213097143,"x":0.2146118714231355,"text":"MALDWES","height":0.008051529790660261,"width":0.04337899543378995},{"y":0.0515297907407406,"width":0.226027397260274,"height":0.011272141706924366,"text":"Photo Source: Joshua Project","x":0.2922374451826484}]