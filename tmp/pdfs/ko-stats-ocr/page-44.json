[{"height":0.01449275362318836,"y":0.9613526570853462,"x":0.03196347121656881,"text":"44 인도 - 카푸","width":0.12557077625570778},{"y":0.9194847021537842,"x":0.5205479475028538,"width":0.36757990867579915,"height":0.02254428341384862,"text":"카푸는 텔루구어로 \"농부\" 또는 \"보호자\"를"},{"width":0.07534246575342465,"height":0.019323671497584516,"text":"14일차","y":0.90177133647343,"x":0.05936073012271691},{"y":0.8921095007917338,"x":0.5205479484779298,"width":0.39269406392694073,"text":"의미합니다. 카푸 공동체에는 발리자(Balia),","height":0.020933977455716568},{"width":0.410958904109589,"y":0.8663446052133655,"text":"문누루 카푸(Munnuru Kapu), 텔라가(Telaga),","x":0.522831055308219,"height":0.020933977455716568},{"x":0.05479452083333333,"height":0.019323671497584516,"y":0.845410628099839,"text":"인도","width":0.045662100456621},{"x":0.5205479462328767,"text":"투르푸 카푸(Turupu Kapu) 등의 다양한","width":0.3538812785388128,"height":0.020933977455716568,"y":0.8438003222705314},{"width":0.40639269406392686,"height":0.02254428341384862,"x":0.5205479483637746,"y":0.8180354269189479,"text":"하위그룹이 있습니다. 그들은 \"나이두(Naidu)\""},{"width":0.3744292237442922,"x":0.522831052902805,"height":0.02254428341384862,"y":0.7906602254658385,"text":"라고도 불리는데, 이는 지도자를 뜻합니다."},{"y":0.7713365538647343,"text":"카푸","x":0.04337899494359387,"width":0.16666666666666666,"height":0.0628019323671497},{"width":0.35159817351598177,"x":0.5205479481354641,"height":0.024154589371980673,"y":0.7648953301261406,"text":"과거 카푸들은 주로 군인과 농부였으며,"},{"width":0.3378995433789954,"height":0.019323671497584516,"y":0.7439613527214171,"x":0.5205479485844748,"text":"전쟁시에는 싸웠고 평화시에는 농사를"},{"y":0.7164770424130815,"text":"지었습니다.","height":0.021152193803526176,"x":0.5205079268632185,"width":0.11423529010929478},{"y":0.6682769725442834,"height":0.019323671497584627,"width":0.36757990867579915,"x":0.5205479421423136,"text":"오늘날 대부분의 카푸 사람들은 인도 남부"},{"height":0.020933977455716568,"x":0.5205479474559687,"width":0.31506849315068497,"y":0.6409017713480561,"text":"안드라프라데시(Andhra Pradesh),"},{"y":0.6135265702898551,"text":"텔랑가나(Telangana), 타밀나두(Tamil Nadu)","width":0.4018264840182648,"height":0.02415458937198056,"x":0.522831051826484},{"x":0.5205479480593607,"text":"주에 삽니다. 카푸는 인도에서 가장 큰 공동체","y":0.589371980768346,"height":0.02254428341384873,"width":0.3995433789954338},{"y":0.5636070853140096,"height":0.02254428341384873,"text":"(안드라프라데시에서 약 18%) 중 하나이며,","x":0.5182648362785388,"width":0.3904109589041096},{"text":"정치적으로 점점 더 영향력을 발휘하고","x":0.5205479430650686,"height":0.019323671497584405,"y":0.541062801851852,"width":0.34246575342465746},{"width":0.09360730593607303,"y":0.5136876004562534,"x":0.5205479459474885,"height":0.02254428341384851,"text":"있습니다."},{"text":"그들은 인도-아리아계 카푸(Kaampu)","x":0.5205479478120243,"width":0.3598743943863264,"height":0.020933977455716568,"y":0.4653784217257112},{"height":0.020933977455716568,"x":0.5205479428571429,"y":0.439613526489533,"text":"종족의 후손입니다. 카푸 종족은 인도","width":0.3287671232876712},{"y":0.4154589371175522,"width":0.39497716894977164,"height":0.019323671497584627,"x":0.5205479419140031,"text":"중앙정부와 안드라프라데시 정부로부터 상위"},{"text":"카스트로 분류되며, 평균적으로 다른","y":0.388083736010467,"x":0.5205479472317351,"width":0.32420091324200917,"height":0.02254428341384873},{"text":"카스트보다 경제적 교육적으로 앞서 있습니다.","width":0.4118150336557327,"height":0.020933977455716568,"y":0.3639291465493444,"x":0.5205479481245923},{"x":0.5228310536529679,"y":0.33977455724637684,"height":0.019323671497584627,"text":"그렇기에 2023년 기준으로 카스트별 할당이나","width":0.410958904109589},{"y":0.31239935582393985,"x":0.520547941933029,"text":"보호 대상이 아닙니다. 카푸들은 카스트 제도","width":0.3926940639269406,"height":0.02254428341384873},{"text":"Photo Source: Pixabay","width":0.17579908675799089,"y":0.29307568444041865,"x":0.26027397480022824,"height":0.011272141706924366},{"text":"내에서 정치적 권익 향상을 위해 투쟁했으며,","width":0.3972602739726028,"height":0.024154589371980673,"y":0.28502415434782613,"x":0.5205479490867579},{"text":"그들의 생활 방식을 보호하기 위해 농업조합도","y":0.26409017706464233,"width":0.40639269406392686,"height":0.019323671497584516,"x":0.5205479423026745},{"y":0.2399355878958669,"height":0.02254428341384862,"x":0.08447488759512936,"text":"인구: 16,085,000명","width":0.21004566210045664},{"height":0.02254428341384873,"x":0.5205479441019787,"y":0.23671497579173373,"text":"조직했습니다.","width":0.13242009132420096},{"x":0.08447488677067475,"width":0.16666666666666666,"height":0.01610305958132041,"text":"(2025년 8월 기준)","y":0.2222222222937914},{"text":"• 종교: 힌두교","y":0.19323671489533012,"x":0.04109588923679062,"height":0.017713365539452464,"width":0.1643835616438356},{"text":"오늘날 상당수의 카푸들이 산업, 예술, 학계로","width":0.3972602739726028,"height":0.024154589371980673,"y":0.18518518529589367,"x":0.5228310527111871},{"height":0.017713365539452575,"y":0.1642512078234032,"x":0.041095891971080635,"text":"• 언어: 텔루구어","width":0.18721461187214614},{"x":0.522831050304414,"y":0.1610305956253355,"text":"다양하게 진출했으며, 정치적으로도 활발히","width":0.37899543378995426,"height":0.02254428341384862},{"height":0.017713365539452464,"text":"• 기독교인: 0.01%","width":0.2146118721461187,"x":0.041095891943900835,"y":0.13526570056360698},{"y":0.13687600637412778,"width":0.36986301369863017,"x":0.5205479421232877,"text":"그들의 권리와 이익을 옹호하고 있습니다.","height":0.020933977455716568},{"width":0.2990867579908676,"y":0.10144927518978619,"x":0.04109589117742985,"height":0.024154589371980673,"text":"• 성경: 신약 있음, 완역 있음"}]