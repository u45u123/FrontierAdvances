[{"width":0.14155251141552513,"text":"38 인도 - 브라만","y":0.9613526569243156,"height":0.01449275362318847,"x":0.02968036388127857},{"text":"브라만은 전통적으로 사제, 교사, 그리고","x":0.5205479416666667,"y":0.9162640901449275,"width":0.3538812785388128,"height":0.02254428341384873},{"text":"11일차","x":0.05707762512842467,"width":0.07077625570776257,"y":0.903381642431562,"height":0.019323671497584516},{"height":0.020933977455716568,"y":0.8937198068538648,"text":"신성한 지식의 수호자로서 수천 년 동안","x":0.5205479473886987,"width":0.34931506849315064},{"y":0.8695652173107891,"height":0.019323671497584516,"text":"인도의 문화적•영적 삶에서 존경받는 역할을","width":0.38584474885844744,"x":0.5205479419901066},{"y":0.8470209338394294,"width":0.04566210045662101,"text":"인도","height":0.019323671497584627,"x":0.05251141549249836},{"height":0.02093397745571668,"x":0.5205479479288975,"y":0.8421900162065792,"width":0.3812785388127854,"text":"해왔습니다. 역사적으로 그들은 통치자들의"},{"x":0.5205479430821919,"y":0.8132045086151369,"height":0.02415458937198056,"text":"조언자나, 식민시대 행정관으로 활동했으며,","width":0.3904109589041096},{"x":0.5205479475171232,"y":0.7906602254629629,"height":0.02254428341384873,"text":"독립 후에도 정부에서 계속 활동했습니다.","width":0.36986301369863017},{"text":"브라만","width":0.2465753424657534,"height":0.06280193236714982,"x":0.043378996204337925,"y":0.7729468599788647},{"width":0.33333333333333326,"x":0.5205479463850837,"y":0.7648953303140096,"text":"그들의 전통적 의무에는 사원 사제직,","height":0.024154589371980784},{"y":0.7391304347960279,"height":0.024154589371980784,"x":0.5205479485540334,"width":0.4018264840182648,"text":"통과의례 주관, 영적 교사 역할들이 포함되나,"},{"width":0.38584474885844744,"height":0.02254428341384851,"y":0.7149758453569512,"text":"많은 이들이 농업, 무역, 또는 다른 직업에도","x":0.5205479419901066},{"text":"종사했습니다.","x":0.520485730996089,"width":0.13254452187176713,"height":0.021329073514339436,"y":0.6906237078317072},{"x":0.5205479477168949,"y":0.6392914654014263,"text":"그들의 높은 사제적 지위에도 불구하고,","width":0.35159817351598166,"height":0.02254428341384851},{"text":"현대 인도에서는 하층 카스트를 우대하는","y":0.616747182173913,"height":0.02093397745571668,"x":0.5205479417123289,"width":0.363013698630137},{"y":0.5925925925120773,"height":0.019323671497584516,"text":"역차별 정책으로 인해 브라만의 특권이","x":0.5205479430650686,"width":0.34246575342465746},{"width":0.35844748858447495,"height":0.02254428341384851,"y":0.563607085292539,"text":"쇠퇴했습니다. 한때 정치, 경제, 문화에서","x":0.520547942218417},{"height":0.019323671497584627,"y":0.5410628018633541,"x":0.5205479424820614,"text":"지배적이었던 브라만들은 이제 많은 이들이","width":0.3812785388127854},{"height":0.011272141706924255,"y":0.5346215781803543,"text":"Photo Source: WIkimedia","width":0.18949771689497713,"x":0.2534246594292237},{"height":0.020933977455716457,"x":0.5159817323059361,"y":0.5169082127348363,"text":"'역차별'이라고 묘사하는 상황에 직면해","width":0.3470319634703196},{"y":0.4847020934897631,"height":0.01610305958132041,"x":0.041095893150684897,"width":0.3835616438356164,"text":"브라만은 인도에서 가장 영향력 있는 종족 중"},{"text":"있습니다. 남인도에서는 그들의 영향력에","y":0.48792270512614055,"x":0.5205479437214613,"width":0.36073059360730597,"height":0.02254428341384873},{"text":"하나이지만, 그들을 대상으로 한 집중적인","height":0.020933977455716568,"y":0.46215781010466994,"x":0.041095893398021256,"width":0.35844748858447484},{"y":0.46698872792730606,"x":0.5228310530658838,"text":"대한 오랜 반감으로 인해 반()브라만 운동이","width":0.3972602739726028,"height":0.019323671497584627},{"text":"선교 활동은 거의 이루어지지 않았습니다.","height":0.017713365539452464,"x":0.04337899904109583,"width":0.36073059360730597,"y":0.44605475041867937},{"width":0.34246575342465757,"y":0.43800322042404716,"height":0.02254428341384873,"x":0.5205479449391172,"text":"특히 강했습니다. 그럼에도 평균적으로"},{"height":0.017713365539452464,"width":0.35844748858447484,"text":"그러나 세속적이고 높은 교육 수준을 가진","y":0.42834138504025765,"x":0.04109588783105029},{"width":0.363013698630137,"x":0.5205479482305936,"y":0.41545893727858296,"height":0.019323671497584627,"text":"브라만들은 상대적으로 교육 수준이 높고"},{"x":0.0410958854737444,"width":0.3949771689497717,"text":"일부 카스트 힌두인들은 변화에 대해 개방적인","y":0.40901771328502423,"height":0.01610305958132041},{"width":0.21689497716894976,"y":0.38808373593666134,"text":"태도를 가지고 있습니다.","x":0.04109589221841701,"height":0.019323671497584627},{"text":"경제적으로 안정적이며, 자녀들에게 양질의","height":0.02254428341384862,"width":0.3812785388127854,"x":0.5205479490182647,"y":0.3880837360064412},{"x":0.5205479480821917,"y":0.3623188403542673,"width":0.2922374429223744,"text":"교육 기회를 제공할 수 있습니다.","height":0.02254428341384862},{"x":0.04109588828006094,"text":"• 인구: 48,000,000명","y":0.3091787438942566,"height":0.020933977455716568,"width":0.25570776255707767},{"x":0.5228310520738203,"height":0.02254428341384862,"text":"이 공동체는 다양합니다.","width":0.22146118721461194,"y":0.3123993558776168},{"width":0.16894977168949776,"text":"(2025년 8월 기준)","height":0.017713365539452575,"y":0.2930756842995168,"x":0.08219177913242011},{"text":"브라만 하위 그룹은 신학적으로 다양하며,","y":0.2866344605014953,"height":0.02254428341384862,"x":0.5205479425636008,"width":0.36986301369863017},{"x":0.04109588876712331,"y":0.265700483011272,"height":0.017713365539452575,"width":0.16438356164383564,"text":"• 종교: 힌두교"},{"x":0.5205479476883561,"width":0.3972602739726028,"y":0.2640901772141707,"height":0.019323671497584627,"text":"개인들은 독실한 힌두교도부터 세속주의자나"},{"height":0.019323671497584516,"x":0.043378994178082234,"text":"• 언어: 힌디어 및 지역 방언","y":0.23510466964573273,"width":0.28767123287671237},{"width":0.36073059360730597,"height":0.02254428341384862,"x":0.5228310511035007,"text":"무신론자까지 다양합니다. 이러한 다양성","y":0.23671497565754163},{"text":"때문에 그들의 신앙을 일반화하기 어렵습니다.","y":0.21256038648684916,"x":0.5228310536339421,"width":0.408675799086758,"height":0.02093397745571668},{"x":0.04337899817351592,"width":0.2191780821917808,"height":0.019323671497584516,"y":0.20611916268115937,"text":"• 기독교인: 0.04%"},{"text":"• 성경: 신약 있음, 완역 있음","width":0.2968036529680365,"y":0.17391304339774571,"height":0.02254428341384851,"x":0.04109588670091332},{"text":"규율, 학습, 지혜 추구 등의 브라만 가치를","x":0.5205479488812784,"y":0.15942028996779378,"height":0.024154589371980673,"width":0.36757990867579915},{"width":0.43835616438356173,"text":"이해하는 것은 의미 있는 선교 운동에 중요합니다.","height":0.020933977455716568,"x":0.5228310529680364,"y":0.13687600647141696},{"height":0.017713365539452464,"width":0.317351598173516,"x":0.5205479425608829,"text":"소외된 이들에게 효과적으로 쓰이는","y":0.11433172293344063},{"width":0.408675799086758,"y":0.08695652175254964,"x":0.5228310536339421,"height":0.02093397745571668,"text":"복음 전도법은 이들에게는 적합하지 않습니다."}]