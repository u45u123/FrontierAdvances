[{"x":0.03196347312785384,"text":"34 인도 - 인도의 최전방 미전도 종족","height":0.01449275362318836,"width":0.28082191780821913,"y":0.9613526570853462},{"x":0.5205479426777561,"y":0.9194847020243846,"width":0.3538812785388128,"height":0.019323671497584627,"text":"인도는 수천 개의 서로 다른 종족 집단이"},{"text":"9일차","y":0.9001610306602255,"width":0.06621004566210045,"height":0.019323671497584516,"x":0.059360731255707753},{"text":"존재하는 세계에서 가장 다양성이 풍부한","x":0.5205479421803654,"width":0.363013698630137,"height":0.019323671497584516,"y":0.8953301126409018},{"x":0.5205479413242009,"height":0.020933977455716568,"y":0.8679549113848631,"text":"국가입니다. 인도의 최전방 미전도 종족들은","width":0.3881278538812786},{"y":0.8421900161996779,"width":0.04794520547945205,"height":0.019323671497584516,"x":0.05479452102739725,"text":"인도"},{"x":0.5205479475028538,"text":"복음을 들어본 적이 없거나 카스트 기반의","height":0.019323671497584516,"y":0.845410628099839,"width":0.36757990867579915},{"width":0.3881278538812786,"height":0.020933977455716568,"y":0.8180354268518518,"text":"종족 집단들을 뜻합니다. 이들은 일반적으로","x":0.5205479484398782},{"height":0.020933977455716568,"text":"전체의 0.1% 미만만이 그리스도인이라고","x":0.5205479436643835,"width":0.36757990867579904,"y":0.7938808371846484},{"text":"인도","height":0.06119162640901765,"y":0.7697262480586867,"x":0.045662100913242014,"width":0.1643835616438356},{"text":"밝히며, 그들 가운데 자립 가능한 교회 운동은","y":0.7665056363123994,"height":0.02415458937198056,"x":0.5228310516438356,"width":0.3972602739726028},{"x":0.5205479437899544,"text":"전혀 알려져 있지 않습니다.","y":0.7439613528824476,"height":0.02254428341384873,"width":0.2465753424657534},{"text":"최전방","y":0.6988727859140604,"height":0.06441223832528187,"x":0.04337899608868058,"width":0.2488584474885845},{"x":0.5205479449543379,"y":0.6924315617713366,"height":0.02254428341384862,"text":"인도는 전 세계 약 4,800개의 최전방 미전도","width":0.3904109589041096},{"x":0.5205479492465753,"height":0.02415458937198056,"text":"종족들 가운데 1,700개가 넘는 종족들이 있어,","width":0.41324200913242004,"y":0.6666666664251208},{"y":0.6441223832125604,"width":0.3561643835616438,"x":0.5205479422374429,"text":"오늘날 가장 큰 선교지 중의 하나입니다.","height":0.020933977455716568},{"text":"미전도 종족","height":0.06571723950273944,"y":0.6305874350807191,"width":0.42048965523776405,"x":0.045462936554457496},{"x":0.522831053196347,"text":"이들 중 많은 종족들은 힌두 카스트 체계,","y":0.5925925924047235,"width":0.36073059360730597,"height":0.02254428341384873},{"text":"무슬림 공동체, 또는 토착 종족에 속합니다.","width":0.38356164383561653,"y":0.5700483091921632,"height":0.020933977455716568,"x":0.5205479484018264},{"y":0.5475040256728778,"width":0.36073059360730597,"text":"우리가 조사한 15개 주요 도시 인구의 약","height":0.019323671497584627,"x":0.5205479426288324},{"y":0.5201288245068438,"height":0.02093397745571668,"text":"50~95%가 최전방 미전도 종족들이었습니다.","width":0.406392694063927,"x":0.5205479477454337},{"height":0.020933977455716568,"text":"그들은 도시에 살지만 여전히 시골의","x":0.5205479484474885,"y":0.49597423518518513,"width":0.32420091324200917},{"y":0.4702093397879764,"x":0.5205479480974124,"width":0.3470319634703196,"text":"공동체와 긴밀하게 연결되어 있습니다.","height":0.020933977455716568},{"height":0.020933977455716568,"text":"또 소수 언어를 사용하고 전통 신앙을 따르기","y":0.4460547501932367,"x":0.5205479438356165,"width":0.3926940639269406},{"text":"때문에 복음을 전하기가 매우 어렵습니다.","x":0.5205479421232877,"y":0.42028985500536764,"width":0.36986301369863017,"height":0.020933977455716568},{"x":0.5205479462899543,"y":0.3687600642109501,"text":"카스트에 따른 불공정한 대우, 타 종교 사람올","height":0.024154589371980673,"width":0.3995433789954338},{"x":0.5228310506392694,"y":0.3429951688405797,"height":0.024154589371980673,"text":"받아들이지 않는 태도, 그리고 빈곤 같은","width":0.35159817351598166},{"y":0.3204508856951154,"x":0.520547948306697,"text":"사회적 장벽이 그들을 더욱 고립시킵니다.","height":0.02254428341384862,"width":0.3721461187214612},{"x":0.5228310510110893,"width":0.365296803652968,"y":0.2946859901771337,"text":"이러한 도전에도 불구하고, 하나님은 모든","height":0.02254428341384862},{"width":0.32420091324200917,"height":0.020933977455716568,"text":"족속과 방언으로 그분을 알게 되기를","x":0.5205479478310502,"y":0.2721417067498658},{"x":0.1552511444292237,"height":0.011272141706924366,"y":0.241545893800322,"text":"Photo Source: Adan Mughal - Pexels","width":0.28767123287671237},{"y":0.24476650541062805,"height":0.02254428341384862,"x":0.5205479435159818,"text":"원하십니다. 이 집단들에 다가가기 위해서는","width":0.3881278538812786},{"y":0.22866344612184653,"text":"Licensed under CCO 1.0","x":0.26255707912861487,"width":0.18036529680365293,"height":0.011272141706924255},{"text":"집중적인 기도, 더 많은 타문화 사역자,","x":0.5205479486529679,"y":0.22061191626409016,"height":0.02254428341384862,"width":0.3447488584474886},{"width":0.36073059360730597,"x":0.5205479482115676,"y":0.19806763294417606,"height":0.020933977455716568,"text":"장기적인 헌신, 문화에 대한 이해, 그리고"},{"y":0.17230273753354808,"x":0.5205479479832572,"text":"강한 현지 지도력 개발이 필요합니다.","height":0.020933977455716568,"width":0.33333333333333326},{"height":0.02093397745571668,"x":0.04337899223744295,"text":"• 인구: 1,051,877,000명 (2025년 8월 기준)","y":0.16425120767195767,"width":0.4474885844748859},{"height":0.019323671497584516,"y":0.13848631230273745,"width":0.25114155251141557,"text":"• 종교: 힌두교 \/ 이슬람","x":0.041095887899543396},{"x":0.522831052118214,"height":0.019323671497584627,"width":0.34018264840182644,"y":0.1239935588656289,"text":"이들은 여전히 세계에서 가장 영적으로"},{"height":0.019323671497584516,"width":0.21461187214611874,"text":"• 언어: 다양한 언어","x":0.043378997579908624,"y":0.10950080521739136},{"text":"복음이 미치지 못하는 사람들 가운데 하나이며,","x":0.5228310543607305,"y":0.09661835748792269,"width":0.41324200913242004,"height":0.02254428341384862},{"height":0.017713365539452464,"y":0.08212560401234559,"text":"• 기독교인: 0.1% 미만","x":0.04337899457762557,"width":0.2442922374429224},{"height":0.019323671497584516,"text":"예수 그리스도의 사랑의 증언과 진리를 깨달을","width":0.40639269406392686,"x":0.5205479426655253,"y":0.0740740739935587},{"y":0.05121219493374096,"x":0.04330174465892475,"width":0.14399012038696846,"height":0.018348557169694635,"text":"• 성경: 있음"},{"x":0.5228310522260273,"height":0.020933977455716568,"y":0.04830917875738061,"width":0.23972602739726023,"text":"기회가 절실히 필요합니다."}]