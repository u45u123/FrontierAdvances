[{"height":0.01449275362318836,"text":"28 아랍 - 페지라","x":0.0319634717351598,"y":0.9613526570853462,"width":0.1415525114155251},{"height":0.019323671497584627,"y":0.919484702173913,"x":0.5205479477454337,"text":"페자라 종족은 수단에 거주하는 소수 종족인데","width":0.406392694063927},{"height":0.019323671497584516,"text":"7일차","y":0.9033816423510467,"x":0.06164383601598173,"width":0.06164383561643836},{"height":0.019323671497584516,"text":"아라비아에서 이집트를 거쳐 수단으로 이주해","x":0.5205479418759513,"y":0.8953301126409018,"width":0.3995433789954338},{"x":0.5228310493721461,"y":0.8679549112453033,"text":"온 사람들입니다. 현재 페자라는 세계에서 오직","height":0.02254428341384862,"width":0.408675799086758},{"width":0.1095890410958904,"x":0.05707762625570775,"y":0.8486312400161031,"height":0.019323671497584516,"text":"아랍문화권"},{"x":0.5205479472412481,"y":0.8454106278448739,"width":0.36757990867579915,"text":"수단에서만 살고 있는 종족입니다. 그들은","height":0.020933977455716568},{"x":0.5205479477005871,"height":0.019323671497584516,"width":0.34931506849315064,"text":"가축을 중심에 두고 그 둘레에 원형으로","y":0.8228663446974925},{"y":0.7938808371175523,"text":"배치되는 원형 돔 형태의 이동식 텐트(푸르간,","width":0.3995433789954338,"x":0.5228310541780821,"height":0.024154589371980673},{"y":0.7777777778410399,"width":0.25114155251141557,"height":0.0628019323671497,"text":"페자라","x":0.043378996330724076},{"width":0.3789954337899544,"x":0.5182648404490107,"text":"furgan)에서 생활하며, 그들의 문화 관습은","height":0.02254428341384862,"y":0.7713365537573805},{"height":0.020933977455716568,"text":"바가르(Baggare) 종족처럼 수단 북부의 다른","width":0.39497716894977164,"y":0.7487922704643049,"x":0.5205479419140031},{"width":0.28767123287671226,"height":0.02093397745571668,"text":"아랍계 유목 민족과 유사합니다.","x":0.5205479476027397,"y":0.7246376811728394},{"width":0.38584474885844755,"y":0.6779388082815735,"height":0.019323671497584516,"x":0.5205479424494455,"text":"수단은 세계에서 가장 가난하고 개발 수준이"},{"text":"낮은 나라 중 하나로, 2024년 인간개발지수","y":0.6505636071926999,"height":0.02254428341384862,"width":0.3835616438356164,"x":0.5228310534246575},{"height":0.02254428341384862,"y":0.6264090176328503,"text":"(HDl)에서 170위, 1인당 국내총생산(GDP)","width":0.38584474885844744,"x":0.5182648369672755},{"x":0.5205479483561642,"width":0.32420091324200917,"y":0.6022544281159421,"height":0.02254428341384851,"text":"순위에서 185위에 머물고 있습니다."},{"text":"수단 경제는 농업에 크게 의존하고 있으나,","width":0.37671232876712324,"x":0.520547948306697,"y":0.5764895328099839,"height":0.024154589371980673},{"width":0.33105022831050224,"text":"국제 제재와 고립, 그리고 내전 때문에","height":0.02254428341384862,"x":0.5228310522973744,"y":0.5539452496980677},{"text":"심각한 타격올 받고 있습니다.","width":0.26712328767123283,"x":0.5205479473934551,"y":0.5297906600375738,"height":0.02254428341384862},{"x":0.5205479425799087,"text":"수단은 세계에서 가장 심각한 난민 위기와","y":0.4847020933057281,"width":0.36757990867579904,"height":0.019323671497584516},{"x":0.5205479484474885,"width":0.33333333333333337,"text":"기록적인 기아를 겪고 있는 나라로서,","height":0.024154589371980673,"y":0.4557165859098229},{"height":0.019323671497584516,"text":"2024년 2월 세계식량계획(WFP) 보고서에","y":0.43639291472535335,"width":0.3789954337899544,"x":0.5205479473110096},{"width":0.37899543378995426,"y":0.4122383252012882,"x":0.5205479420471842,"height":0.019323671497584516,"text":"따르면 국민의 95% 이상이 하루 한 끼조차"},{"width":0.2648401826484019,"text":"먹지 못하고 있는 상황입니다.","height":0.02254428341384862,"x":0.5228310523972601,"y":0.38486312380568977},{"height":0.02093397745571668,"x":0.5205479471080668,"text":"페자라 종족내 복음주의적 사역은 극히","width":0.34246575342465757,"y":0.3381642512882448},{"y":0.3140096619263285,"x":0.5228310523972601,"width":0.3470319634703197,"text":"어렵습니다. 그들은 이슬람에 대한 강한","height":0.020933977455716568},{"height":0.012882447665056307,"x":0.08675798630136997,"width":0.3652968036529681,"y":0.30756843796296307,"text":"Image generated by Al using Microsoft Copilot"},{"x":0.5228310539497717,"width":0.3721461187214612,"height":0.02093397745571668,"text":"헌신과 유목 생활 방식 때문에 전도가 거의","y":0.28985507254428333},{"height":0.02254428341384862,"text":"• 인구: 407,000명 (2025년 8월 기준)","y":0.26086956493558777,"x":0.043378994320776285,"width":0.3858447488584475},{"x":0.5228310543607305,"width":0.4178082191780822,"height":0.024154589371980673,"text":"불가능합니다. 현재 페자라 종족 중에 선교사도,","y":0.2624798709339774},{"text":"• 종교: 이슬람","height":0.017713365539452464,"width":0.16438356164383564,"y":0.2367149759393452,"x":0.04337899680365293},{"height":0.024154589371980673,"width":0.40410958904109595,"y":0.2383252816022544,"x":0.5205479448820396,"text":"믿는 사람도 없으며, 수단 밖에 큰 규모의 이주"},{"text":"공동체(diaspora)도 존재하지 않습니다.","width":0.3538812785388128,"height":0.02254428341384862,"x":0.5205479487442922,"y":0.215780998389694},{"text":"• 언어: 수단 아랍어","x":0.04337899528158294,"y":0.206119162466452,"height":0.020933977455716568,"width":0.2146118721461187},{"y":0.17874396127214176,"height":0.017713365539452464,"text":"• 기독교인: 0.00%","width":0.21689497716894976,"x":0.04337899388454016},{"height":0.019323671497584516,"width":0.36986301369863017,"x":0.5205479424200913,"y":0.16908212579710147,"text":"수단은 2025년 오픈도어즈(Open Doors)"},{"height":0.024154589371980673,"y":0.14492753605935138,"text":"• 성경: 신약 있음, 완역 없음","x":0.0433789962002609,"width":0.29908675799086754},{"y":0.14653784227053146,"height":0.017713365539452464,"text":"월드 워치 리스트(World Watch List)에서","x":0.5228310522704211,"width":0.36757990867579904},{"height":0.020933977455716568,"x":0.5205479464840183,"y":0.12077294706924313,"width":0.3561643835616438,"text":"5위의기독교 박해국가입니다. 이 나라는"},{"x":0.5205479424168298,"y":0.09500805147227975,"height":0.020933977455716568,"width":0.3904109589041096,"text":"그리스도인들이 극도의 박해를 받는 땅이며,"},{"text":"내전은 예수를 따르는 자들에게 이미 참혹한","y":0.07407407397745569,"x":0.5205479413242009,"width":0.3881278538812786,"height":0.019323671497584516},{"text":"상황을 더욱 악화시키고 있습니다.","height":0.02254428341384862,"x":0.52054794630898,"y":0.04669887297369835,"width":0.30593607305936077}]