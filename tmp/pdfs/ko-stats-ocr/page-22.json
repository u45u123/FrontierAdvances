[{"y":0.9613526570853462,"height":0.01449275362318836,"x":0.0319634720547945,"width":0.17351598173515984,"text":"22 아랍 - 아랍문화권"},{"y":0.9194847020128825,"width":0.36757990867579915,"height":0.019323671497584516,"x":0.520547942908105,"text":"아랍 문화권은 그 문화와 배경이 아라비아"},{"height":0.019323671497584627,"text":"4일차","x":0.061643836001712325,"y":0.9001610306763285,"width":0.06164383561643836},{"text":"반도에서 유래한 사람들을 포함합니다.","width":0.3447488584474885,"height":0.02254428341384862,"x":0.5228310531012177,"y":0.8921095008051529},{"x":0.5228310530251141,"width":0.3356164383561644,"height":0.019323671497584627,"text":"대부분의 사람들은 아랍어를 사용하고","y":0.8695652174718196},{"y":0.8438003221417069,"width":0.047945205479452045,"height":0.019323671497584516,"text":"아랍","x":0.05479452094748858},{"y":0.8421900160359634,"height":0.02093397745571668,"width":0.24200913242009126,"x":0.5205479431887368,"text":"주요 종교는 이슬람입니다."},{"y":0.8148148147688061,"x":0.5205479426614481,"width":0.3561643835616438,"text":"아랍 문화가 사람들에게 어떤 옷을 입고,","height":0.02254428341384851},{"x":0.520547944109589,"y":0.7890499192431562,"width":0.3789954337899544,"height":0.024154589371980784,"text":"무엇을 믿으며, 매일 어떻게 살아야 할 지에"},{"text":"아랍","width":0.16894977168949774,"x":0.04337899603718198,"height":0.06441223832528176,"y":0.7665056361628709},{"x":0.5203045897353018,"width":0.15802096014153466,"text":"영향을 끼칩니다.","y":0.765552618266883,"height":0.022840012290819445},{"y":0.7133655394972267,"height":0.024154589371980673,"text":"아랍 문화권 종족들은 중동, 북아프리카,","width":0.3561643835616438,"x":0.5205479471841704},{"x":0.043378995348173514,"y":0.6988727861044015,"height":0.06602254428341392,"text":"문화권","width":0.2442922374429224},{"height":0.02254428341384862,"text":"아프리카의 뿔 지역, 그리고 전 세계","x":0.5205479456621004,"y":0.6892109498550725,"width":0.31506849315068497},{"y":0.6650563605206656,"text":"디아스포라로 분포해 있습니다.","width":0.27853881278538817,"height":0.02254428341384851,"x":0.5228310525114155},{"height":0.019323671497584516,"x":0.5228310521943175,"y":0.6425120773841474,"text":"여호수아 프로젝트에서는 수단 아랍인도","width":0.3538812785388128},{"text":"아랍문화권에 포함하고 있습니다.","y":0.6151368761943103,"x":0.5205479451674278,"width":0.3013698630136986,"height":0.02254428341384851},{"width":0.40410958904109584,"x":0.5228310524733637,"y":0.5668276973519413,"height":0.019323671497584627,"text":"이슬람이 주 종교이기에 매년 메카를 방문하는"},{"width":0.36757990867579904,"x":0.522831052525685,"height":0.020933977455716457,"y":0.5394524960044285,"text":"많은 순례자들을 위한 기도가 중요합니다."},{"x":0.5205479479680364,"text":"사우디아라비아는 이슬람의 발상지로","y":0.5152979063929146,"width":0.33105022831050224,"height":0.02093397745571668},{"text":"견고한 진입니다. 이슬람은 메카로부터","width":0.34246575342465746,"y":0.4879227055555556,"x":0.520547942739726,"height":0.024154589371980673},{"width":0.36757990867579915,"y":0.46698872792730606,"text":"수십억 명의 무슬림뿐만 아니라 전 세계에","height":0.019323671497584627,"x":0.5205479478310502},{"y":0.43756899760439827,"height":0.023412729806946087,"text":"영향을 끼칩니다.","width":0.15777944974158997,"x":0.5204253448949668},{"height":0.019323671497584516,"width":0.34246575342465746,"y":0.41545893713365534,"text":"이슬람을 세계적으로 확산하는 데 매년","x":0.5205479417808221},{"text":"수백억 달러의 석유 수익이 사용됩니다.","x":0.5205479480974124,"height":0.02254428341384873,"y":0.38808373572195376,"width":0.35159817351598166},{"width":0.3538812785388128,"text":"모든 무슬림은 하루 다섯 번 메카를 향해","y":0.3397745571014492,"x":0.5205479416666667,"height":0.019323671497584516},{"height":0.024154589371980673,"y":0.3107890500230044,"width":0.33333333333333337,"text":"기도해야 하며, 매년 200만 명 이상의","x":0.5205479475864319},{"y":0.29285767589608935,"x":0.26674824495714305,"width":0.17885366640134487,"text":"Photo Source: Pixabay","height":0.01709013860582731},{"height":0.020933977455716568,"width":0.36986301369863006,"y":0.2882447663747987,"text":"무슬림이 하지(Hai)라 불리는 순례를 위해","x":0.5205479450342466},{"y":0.25764895340848093,"text":".","x":0.04337899608066968,"width":0.03881278538812785,"height":0.009661835748792202},{"x":0.5205479452283105,"height":0.02254428341384862,"text":"그곳을 방문합니다. 하나님올 찾는 많은","y":0.26086956499194847,"width":0.34931506849315075},{"height":0.024154589371980673,"text":"인구: 139,929,000명","y":0.2495974237117552,"x":0.08447488740487061,"width":0.22374429223744294},{"height":0.02093397745571668,"x":0.5205479419634703,"width":0.32420091324200917,"text":"이들이 참된 생명과 진리의 원천이신","y":0.23832528172302736},{"text":"(최전방 미전도 종족 기준, 2025년 8월","y":0.23188405776167476,"width":0.3264840182648402,"x":0.08219178189497711,"height":0.020933977455716568},{"width":0.04794520547945205,"height":0.017713365539452464,"y":0.21739130417069252,"x":0.0844748862785388,"text":"현재)"},{"x":0.5205479469463471,"text":"살아 계신 그리스도를 만나도록","y":0.21417069251207732,"width":0.27853881278538806,"height":0.019323671497584627},{"x":0.04109588923679062,"width":0.1643835616438356,"height":0.017713365539452464,"y":0.18840579702093396,"text":"• 종교: 이슬람"},{"x":0.520378569054334,"height":0.022065993476413137,"width":0.13732505171266318,"y":0.1878397882508337,"text":"기도해 주세요."},{"height":0.021265240299145005,"y":0.15925465787661364,"x":0.041054391226395655,"width":0.1667496668149347,"text":"• 언어: 아랍어"},{"x":0.04109588879647752,"width":0.226027397260274,"y":0.13043478250517582,"height":0.017713365539452464,"text":"• 기독교인: 0~0.1%"}]