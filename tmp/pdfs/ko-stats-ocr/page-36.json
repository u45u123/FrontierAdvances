[{"x":0.02968036673515979,"text":"36 인도 - 바그반","y":0.9613526570853462,"height":0.01449275362318836,"width":0.14383561643835618},{"height":0.020933977455716568,"text":"바그반(Baghban) 사람들은 100만 명이 되지","width":0.3972602739726028,"y":0.9178743959608159,"x":0.5205479436834094},{"x":0.05707762621004565,"width":0.07762557077625573,"y":0.9066022542351047,"height":0.019323671497584516,"text":"10일차"},{"text":"않는 공동체입니다. 이 중 약 616,000명은","y":0.8921095006556246,"x":0.5205479450424005,"width":0.3744292237442922,"height":0.020933977455716568},{"text":"힌두교 배경을, 약 268,000명은 무슬림","y":0.8663446054428341,"width":0.34931506849315064,"height":0.02254428341384873,"x":0.5205479417123289},{"width":0.045662100456621,"height":0.017713365539452464,"text":"인도","x":0.05479452083333333,"y":0.8518518519424316},{"y":0.8421900160547504,"text":"배경을 가지고 있습니다. 인도 인구가 10억이","x":0.5205479412328768,"width":0.39726027397260266,"height":0.020933977455716568},{"height":0.020933977455716568,"x":0.5205479452968037,"y":0.8180354269404186,"width":0.3470319634703196,"text":"넘기 때문에 바그반은 널리 알려져 있지"},{"width":0.3356164383561644,"y":0.7906602254629629,"x":0.5205479473030822,"height":0.02254428341384873,"text":"않습니다. 그들은 주로 인도에 살지만,"},{"y":0.7761674715896021,"height":0.06441223832528176,"x":0.0433789949527071,"text":"바그반","width":0.2488584474885845},{"x":0.5228310527207002,"text":"네팔과 파키스탄에도 거주합니다.","y":0.7665056360842727,"width":0.2990867579908675,"height":0.020933977455716568},{"text":"인도에서는 주로 우타르프라데시,","y":0.7407407407608695,"height":0.02254428341384873,"x":0.5228310520833334,"width":0.29680365296803646},{"width":0.410958904109589,"height":0.024154589371980784,"y":0.7133655394363929,"x":0.5205479410958905,"text":"마하라슈트라, 카르나타카에 많이 거주합니다."},{"x":0.5205479492465752,"height":0.024154589371980673,"y":0.6634460545088567,"width":0.408675799086758,"text":"그들은 보통 우르두어와 힌디어를 사용하는데,"},{"text":"성경과 기독교 자료가 이미 이 언어들로","x":0.5205479452283105,"height":0.020933977455716568,"width":0.34931506849315075,"y":0.6425120775040257},{"x":0.5205479434018265,"y":0.6151368762318841,"width":0.3630136986301369,"text":"번역되어 있습니다. 바그반이라는 단어는","height":0.02254428341384862},{"width":0.39385989811866795,"y":0.5865766013419353,"x":0.5176064474104087,"height":0.031430140017695285,"text":"\"정원을 돌보는 사람\" 이라는 뜻으로, 그들이"},{"width":0.3196347031963471,"y":0.5652173913345411,"x":0.5205479472031962,"height":0.02093397745571668,"text":"정원사에서 기인했음을 반영합니다."},{"x":0.2557077653348553,"width":0.17123287671232879,"height":0.012882447281129528,"y":0.5410628021015866,"text":"Photo Source; Pixabay"},{"width":0.40639269406392686,"text":"오늘날에도 많은 이들이 여전히 과일과 채소를","y":0.5410628018633541,"height":0.019323671497584627,"x":0.5205479423026745},{"text":"팔며, 다른 이들은 공무원으로 일합니다.","x":0.5205479487899544,"width":0.35844748858447484,"y":0.5120772947020934,"height":0.024154589371980673},{"height":0.024154589371980673,"width":0.3972602739726028,"x":0.5205479478538811,"y":0.4879227055555556,"text":"그들은 가족을 부양하기 위해 열심히 일하고,"},{"x":0.04078673126212163,"height":0.026026347985014242,"text":"• 인구: 884,000명 (2025년 8월 기준)","y":0.4804733358520652,"width":0.3910602935372967},{"x":0.5205479426750381,"text":"아들과 딸 모두를 학교에 보내려 노력하는","y":0.4653784217257112,"height":0.020933977455716568,"width":0.36757990867579904},{"width":0.25570776255707767,"height":0.017713365539452464,"y":0.4573268920155663,"x":0.04109588828006094,"text":"• 종교: 이슬람과 힌두교"},{"height":0.02254428341384873,"text":"경우가 많습니다. 그럼에도 인도의 카스트","y":0.43800322042404716,"x":0.5205479447298326,"width":0.36757990867579904},{"text":"• 언어: 우르두, 힌디어","x":0.04109588738584481,"width":0.24200913242009137,"height":0.02254428341384862,"y":0.4235104669484703},{"x":0.5205479424494455,"width":0.38584474885844755,"y":0.41545893712905446,"height":0.019323671497584627,"text":"제도에 기인한 정치 때문에 바그반 자녀들이"},{"width":0.228310502283105,"x":0.041095892313546385,"y":0.3993558776838433,"text":"• 기독교인: 0~0.1%","height":0.017713365539452464},{"text":"의사나 변호사 같은 전문직에 들어가기는","y":0.3896940416935051,"x":0.5205479431697108,"height":0.020933977455716568,"width":0.363013698630137},{"text":"• 성경: 신약 있음, 완역 있음","width":0.2990867579908676,"height":0.024154589371980673,"y":0.365539452294686,"x":0.04109589130517502},{"x":0.5202511426679584,"text":"어렵습니다.","y":0.3631101437355182,"width":0.11246574959254163,"height":0.02257198373668623},{"text":"선교사들은 1700년대부터 인도에서 활동해","y":0.3140096619162641,"width":0.38584474885844755,"height":0.020933977455716568,"x":0.5205479479615134},{"width":0.36986301369863017,"text":"왔으며, 처음에는 남인도에서 시작해 이후","height":0.024154589371980673,"y":0.28502415434782613,"x":0.5205479429223744},{"y":0.2624798711084273,"x":0.5205479423515983,"width":0.34246575342465746,"height":0.020933977455716568,"text":"동부와 북부로 확산되었습니다. 인도인"},{"text":"선교사들도 복음 전파에 중요 역할을 담당해","height":0.020933977455716568,"y":0.2383252817096082,"x":0.5205479419710808,"width":0.38812785388127846},{"height":0.02254428341384862,"width":0.30365296803652975,"text":"왔습니다. 그럼에도 바그반 가운데","y":0.2109500803274289,"x":0.520547944197108},{"width":0.35844748858447495,"x":0.52054794815449,"text":"그리스도인의 비율은 여전히 0%입니다.","y":0.18679549095544823,"height":0.02254428341384862}]