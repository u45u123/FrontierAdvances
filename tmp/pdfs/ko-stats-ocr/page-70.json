[{"x":0.03196347277397254,"y":0.9581320448671498,"height":0.017713365539452464,"width":0.3744292237442922,"text":"70 기타 아시아- 투강베시 (술라웨시, 인도네시아)"},{"y":0.919484702173913,"height":0.019323671497584627,"x":0.5228310522688355,"text":"술라웨시의 투캉베시 지역에는 6개의","width":0.3264840182648402},{"width":0.07779293844144639,"y":0.9016028166034374,"text":"25일차","height":0.01966071090452537,"x":0.059277047023139295},{"text":"최전방 미전도 종족(FPG)이 있으며, 월리오","x":0.5205479477168949,"width":0.3835616438356164,"height":0.024154589371980784,"y":0.890499194605475},{"text":"(Wolio)족은 그중 하나입니다. 월리오족","y":0.8679549115271068,"width":0.35159817351598177,"height":0.02093397745571668,"x":0.5205479481354641},{"width":0.11904348086004388,"x":0.052350404842325476,"y":0.8449060075108518,"text":"기타 아시아","height":0.02033291231606893},{"height":0.024154589371980784,"text":"(바우바우, 부톤, 부툰으로도 알려짐)은","y":0.8405797099033816,"width":0.34246575342465757,"x":0.5205479436986302},{"height":0.02254428341384862,"x":0.5228310525827625,"text":"남동 술라웨시의 부톤, 무나, 카바에나 섬에","y":0.816425120873591,"width":0.37671232876712335},{"height":0.02254428341384862,"x":0.5205479443607306,"width":0.30365296803652964,"text":"거주합니다. 15세기에 말레이시아","y":0.7922705311755234},{"x":0.042672006025533,"text":"투캉베시","width":0.3233317893389697,"y":0.7679218164027781,"height":0.06802110165213615},{"height":0.02415458937198056,"x":0.5205479447716895,"text":"조호르에서 이주한 사람들의 후손으로,","y":0.7665056363123994,"width":0.3447488584474886},{"text":"부톤 왕조를 세웠습니다.","height":0.020933977455716568,"y":0.7439613526086957,"width":0.22146118721461194,"x":0.5205479429908676},{"y":0.6924315621256039,"height":0.02254428341384862,"width":0.319634703196347,"x":0.5205479484018264,"text":"1540년, 여섯 번째 왕이 이슬람으로"},{"width":0.3470319634703196,"x":0.5205479480974124,"text":"개종하면서 왕국은 술탄국으로 변했고,","y":0.666666666680086,"height":0.02415458937198056},{"y":0.6425120771068169,"x":0.5205479463470319,"text":"1960년까지 지속되었습니다. 오늘날 부톤은","width":0.3926940639269406,"height":0.02254428341384873},{"width":0.36757990867579904,"x":0.5205479466894978,"y":0.6167471817230274,"text":"아스팔트 생산으로 유명하며, 석유와 광물","height":0.02415458937198056},{"text":"자원에 대한 탐사도 이루어지고 있습니다.","x":0.5205479425636008,"y":0.5942028984932137,"width":0.36986301369863017,"height":0.020933977455716568},{"width":0.36073059360730597,"height":0.020933977455716568,"text":"많은 월리오족은 일자리를 찾아 말루쿠와","x":0.520547946392694,"y":0.5716586153462158},{"text":"파푸아와 같은 다른 지역으로 이주해 왔습니다.","y":0.5442834138486312,"height":0.02254428341384873,"width":0.41552511415525106,"x":0.5205479486681888},{"y":0.5185185183306494,"width":0.38584474885844755,"height":0.02254428341384862,"x":0.5205479462899544,"text":"그들은 월리오어를 사용하며, 종교적:역사적"},{"width":0.3356164383561644,"text":"문서에서 사용되는 아랍어를 이해하는","x":0.5228310530251141,"y":0.4975845411433173,"height":0.019323671497584516},{"height":0.02093397745571668,"text":"사람들도 일부 있습니다.","width":0.226027397260274,"y":0.4702093397262479,"x":0.5182648379223744},{"y":0.42190016111111106,"x":0.5228310521461187,"width":0.3835616438356164,"height":0.019323671497584516,"text":"월리오 마을에서는 비단과 면과 같은 옷감이"},{"height":0.011272141706924255,"x":0.2922374447773972,"text":"Source: Wikimedia","y":0.410628019384058,"width":0.14840182648401828},{"x":0.5205479477005871,"height":0.02254428341384862,"text":"시장에서 판매되며, 작은 상점과 행상도","y":0.3945249598573728,"width":0.34931506849315064},{"x":0.5205479438165906,"width":0.34931506849315064,"text":"흔합니다. 또한 육지와 바다에서 농업올","height":0.02254428341384862,"y":0.3703703701825013},{"x":0.0456620995005708,"y":0.3542673106380837,"height":0.024154589371980673,"width":0.34474885844748854,"text":"월리오족, 투캉베시의 최전방 미전도"},{"width":0.34931506849315064,"height":0.024154589371980673,"text":"합니다. 쌀, 옥수수, 카사바를 재배하고,","x":0.5205479451864536,"y":0.34299516888083736},{"width":0.045662100456621,"height":0.019323671497584516,"y":0.3349436393719807,"x":0.04566210074200913,"text":"종족"},{"text":"6월부터 9월까지 해초(아가르아가르)를","y":0.32206119141706924,"height":0.020933977455716568,"width":0.34931506849315064,"x":0.5205479485616438},{"text":"양식합니다. 많은 사람들이 선원과 배 제작자로","y":0.2962962964170692,"height":0.020933977455716568,"x":0.5205479486491628,"width":0.41324200913242015},{"height":0.02254428341384862,"x":0.043378994863013734,"width":0.41324200913242015,"y":0.28502415436392914,"text":"• 인구: 약 252,000명 (2025년 8월 기준)"},{"text":"일하며, 부톤과 무나 주변의 풍부한 해양","width":0.3561643835616438,"y":0.26892109511157114,"height":0.024154589371980673,"x":0.5205479477495109},{"height":0.017713365539452464,"y":0.2576489533950618,"text":"• 종교: 이슬람","width":0.16438356164383564,"x":0.04337899680365293},{"text":"자원을 활용합니다. 전통 가옥은 나무판자로","height":0.02093397745571668,"y":0.24637681170692427,"width":0.3881278538812786,"x":0.5205479490867579},{"x":0.04109588738584481,"width":0.363013698630137,"y":0.22383252812667742,"text":"• 언어: 월리오어, 일부 아랍어 이해","height":0.025764895330112725},{"x":0.5228310502772341,"width":0.34018264840182655,"height":0.02254428341384862,"text":"만든 고상가옥이며, 지붕은 나무판이나","y":0.22061191610305964},{"x":0.04337899729288976,"y":0.19967793888888885,"width":0.26027397260273977,"height":0.017713365539452464,"text":"• 기독교인: 0.01% 미만"},{"width":0.41552511415525106,"y":0.19645732689210949,"x":0.5205479486681888,"height":0.02254428341384862,"text":"야자잎으로 덮습니다. 남성은 외부에서 일하고,"},{"width":0.1462684875209582,"height":0.018338665678113264,"y":0.17037978138420384,"x":0.041021005555489314,"text":"• 성경: 없음"},{"x":0.5228310532876712,"text":"여성은 가정과 재정을 관리합니다.","width":0.30593607305936077,"height":0.020933977455716568,"y":0.1723027375040258},{"x":0.5205479426614481,"text":"바우바우는 공식적인 도시로 지정되면서","y":0.12399355870715423,"width":0.3561643835616438,"height":0.019323671497584516},{"width":0.39269406392694073,"y":0.09500805132850232,"text":"개발의 기회를 얻게 되었고, 월리오 사람들은","x":0.5205479460426179,"height":0.024154589371980673},{"y":0.07246376790660225,"width":0.34931506849315064,"height":0.020933977455716568,"text":"교육과 언어 학습을 매우 중요하게 여겨","x":0.5205479438127855},{"y":0.04830917875738061,"text":"사회적 발전을 이루어 가고 있습니다.","x":0.5205479479832572,"width":0.33333333333333326,"height":0.020933977455716568}]