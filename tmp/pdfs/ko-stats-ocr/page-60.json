[{"y":0.9613526570853462,"height":0.01449275362318836,"text":"60 인도 - 야다브","width":0.13926940639269406,"x":0.031963471314416174},{"x":0.5205479427083334,"text":"야다브는 전통적으로 목축과 우유를 판매하던","width":0.3995433789954338,"height":0.019323671497584516,"y":0.9194847020128825},{"y":0.903381642431562,"width":0.0776255707762557,"height":0.019323671497584516,"x":0.059360730108447494,"text":"22일차"},{"height":0.024154589371980673,"x":0.5205479438784246,"text":"공동체로, 중앙아시아에서 기원했을 가능성이","width":0.3995433789954338,"y":0.8904991946960548},{"x":0.5205479431934932,"width":0.32191780821917804,"height":0.019323671497584516,"text":"있으며 자신의 정체성을 카스트 신인","y":0.8695652173107891},{"x":0.05479452102739725,"text":"인도","height":0.017713365539452575,"y":0.848631240016103,"width":0.04794520547945205},{"text":"크리슈나와 동일시합니다. 오늘날 대부분의","height":0.02093397745571668,"x":0.5205479420281585,"width":0.3812785388127854,"y":0.8421900160359634},{"height":0.02254428341384862,"x":0.5205479467579908,"width":0.3744292237442923,"text":"야다브는 농사를 짓고 있지만, 소와 관련된","y":0.814814814589372},{"x":0.5228310525748351,"height":0.02254428341384862,"text":"목축업을 하는 사람은 3분의 1도 되지 않습니다.","y":0.7906602254786187,"width":0.42237442922374435},{"text":"야다브","x":0.04337899472251494,"y":0.772946860151121,"width":0.2442922374429224,"height":0.06441223832528176},{"width":0.3378995433789955,"height":0.02415458937198056,"text":"인도 전역과 네팔 남부에 살고 있지만,","x":0.52054794456621,"y":0.7648953303542674},{"y":0.7439613525879917,"x":0.5205479427103719,"text":"북인도의 우타르프라데시와 비하르주에","width":0.34931506849315064,"height":0.019323671497584516},{"y":0.7165861513821793,"x":0.5205479466894978,"width":0.17808219178082185,"height":0.020933977455716568,"text":"집중해 거주합니다."},{"x":0.5205479446156773,"text":"대가족으로 살며, 대부분 채식주의자였지만","y":0.6634460545491143,"width":0.3812785388127854,"height":0.024154589371980784},{"text":"많은 사람들이 생선, 양고기, 닭고기, 때로는","x":0.5205479479615134,"height":0.02254428341384851,"y":0.6392914654934438,"width":0.38584474885844755},{"x":0.5205479479223745,"text":"돼지고기를 먹기 시작했습니다.","y":0.6135265698228664,"height":0.02254428341384862,"width":0.2808219178082192},{"width":0.35159817351598166,"text":"그러나 여전히 소고기는 먹지 않습니다.","height":0.020933977455716568,"y":0.5909822866459628,"x":0.5205479477168949},{"y":0.5410628020243846,"width":0.3812785388127854,"text":"사회적•교육적으로 뒤처진 것으로 간주되고","x":0.5205479479288975,"height":0.019323671497584627},{"text":"가장 많은 '기타의 후진 계급(Other Backward","x":0.5205479426369863,"width":0.410958904109589,"y":0.5169082124798712,"height":0.019323671497584627},{"y":0.4879227053240741,"x":0.5205479475599315,"text":"Castes)' 중 하나입니다. 그들은 크리슈나,","width":0.37671232876712335,"height":0.024154589371980673},{"width":0.39269406392694073,"x":0.5228310541552511,"text":"비슈누 등 신들에 대한 전문적인 구전 전통과","height":0.019323671497584516,"y":0.4669887279227054},{"text":"Photo Source: Wikimedia","x":0.24657534098173522,"y":0.4573268922973699,"width":0.1894977168949772,"height":0.011272141706924255},{"width":0.3082191780821917,"text":"공동체 합창을 보유하고 있습니다.","x":0.5205479477739726,"y":0.4380032206119162,"height":0.02254428341384873},{"text":"이들은 크리슈나를 자신들의 혈통상 조상으로","x":0.5205479418759513,"width":0.3995433789954338,"y":0.4154589371175522,"height":0.019323671497584627},{"text":"• 인구: 57,595,000명","width":0.2511415525114155,"height":0.02254428341384862,"y":0.39935587754773416,"x":0.04566209866275279},{"height":0.01610305958132041,"text":"(2025년 8월 기준)","x":0.08904109708088716,"width":0.16666666666666669,"y":0.38486312406257195},{"text":"주장하며, 그에게 특별한 헌신 보입니다.","x":0.52054794358828,"y":0.38647342975040266,"width":0.38099313326622253,"height":0.024154589371980673},{"x":0.5205479490410958,"y":0.36231884054750396,"height":0.02254428341384862,"text":"야다브는 저주로부터 보호받기 위해 부적,","width":0.3835616438356164},{"x":0.04566209928245272,"y":0.35587761666666673,"width":0.1643835616438356,"height":0.017713365539452464,"text":"• 종교: 힌두교"},{"x":0.5205479481354641,"y":0.3365539452764359,"text":"점성술사, 전통 치유사에게 의지합니다.","width":0.35159817351598177,"height":0.02254428341384862},{"width":0.16894977168949774,"text":"• 언어: 힌디어","y":0.3268921095813204,"x":0.045662101512557056,"height":0.019323671497584516},{"y":0.29629629610305963,"width":0.23515981735159816,"height":0.019323671497584516,"text":"• 기독교인: 0.002%","x":0.04566210276255703},{"text":"그들의 삶과 생활 수준은 크게 변화하고","height":0.019323671497584627,"x":0.5205479427103719,"y":0.28985507239475494,"width":0.34931506849315064},{"text":"• 성경:신약 있음, 완역 있음","x":0.03652968150684928,"width":0.30593607305936077,"height":0.02254428341384862,"y":0.26409017690821257},{"text":"있습니다. 다음 세대는 다른 종류의 직업을","height":0.02254428341384862,"y":0.26086956499194847,"x":0.5205479432420091,"width":0.3744292237442922},{"y":0.2351046696859903,"width":0.3744292237442923,"x":0.5205479458523592,"height":0.024154589371980784,"text":"가져야 할 필요가 있지만, 많은 지역에서는"},{"height":0.02254428341384862,"x":0.5228310489726028,"text":"이를 위한 적절한 교육이 부족한 상황입니다.","y":0.21256038669887278,"width":0.39497716894977164}]