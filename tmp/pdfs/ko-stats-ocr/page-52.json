[{"text":"52 인도 - 라즈푸트","height":0.01449275362318847,"x":0.03196346921069799,"y":0.9613526569243156,"width":0.15525114155251143},{"y":0.9178743959608159,"width":0.28767123287671237,"height":0.020933977455716568,"x":0.5228310499619482,"text":"라즈푸트(Raiputs)는 일반적으로"},{"text":"18일차","x":0.0593607310644977,"width":0.07534246575342467,"y":0.9001610306763285,"height":0.019323671497584627},{"x":0.5228310503881278,"y":0.8937198065700482,"text":"크샤트리야(전사) 계급에 속한다고 여기는","height":0.019323671497584627,"width":0.36757990867579915},{"x":0.5205479421461188,"height":0.020933977455716568,"y":0.8679549113848631,"text":"대규모의 다양한 힌두 집단입니다.","width":0.30593607305936077},{"width":0.047945205479452045,"text":"인도","x":0.05479452094748858,"height":0.017713365539452464,"y":0.8454106280864198},{"height":0.019323671497584627,"text":"그들은 상위 카스트(Forward Caste)로,","width":0.34931506849315064,"y":0.8421900160493827,"x":0.5205479422945206},{"x":0.5228310521055302,"height":0.019323671497584627,"y":0.8180354268205403,"text":"다양한 민족적•지리적 배경의 사람들을","width":0.3378995433789954},{"height":0.02254428341384873,"text":"포함합니다. 주로 라자스탄(Rajasthan)에","x":0.5205479426125245,"width":0.363013698630137,"y":0.7906602253968253},{"text":"라즈푸트","height":0.069596949406868,"y":0.7671338941694997,"width":0.3307327200832976,"x":0.04239619615936093},{"y":0.7648953300966184,"text":"거주하지만 인도 전역에 흩어져 있습니다.","x":0.5205479489269406,"width":0.3721461187214612,"height":0.024154589371980673},{"text":"\"라즈푸트(Raiput)\"라는 이름은 \"왕의 아들\"올","width":0.4018264840182648,"height":0.025764895330112836,"y":0.7165861515834675,"x":0.5159817364535768},{"y":0.6908212561325819,"x":0.5205479484398782,"height":0.020933977455716457,"width":0.3881278538812786,"text":"의미합니다. 전통적으로 이들은 왕실 혈통과"},{"y":0.6634460545491143,"x":0.5205479473173515,"width":0.4178082191780822,"text":"씨족을 신중히 유지하며 왕족, 지도자, 전사로서","height":0.024154589371980784},{"width":0.3470319634703196,"x":0.5205479469406392,"y":0.6409017715619968,"text":"독립된 왕국을 통치하고 보호했습니다.","height":0.02254428341384862},{"y":0.616747182173913,"text":"1970년에 인도는 그들의 지위와 재산권올","x":0.5205479415296804,"width":0.3721461187214612,"height":0.02093397745571668},{"width":0.3744292237442922,"height":0.019323671497584516,"y":0.5925925925120773,"text":"폐지했지만 라자스탄에서는 여전히 그들의","x":0.5205479428652969},{"x":0.5205479416894978,"height":0.02093397745571668,"width":0.35159817351598166,"y":0.5652173912560385,"text":"왕조가 알려져 있고 가문이 구별됩니다."},{"y":0.5120772944847021,"x":0.5205479467846271,"height":0.024154589371980784,"text":"오늘날 라즈푸트는 정치, 군대, 경찰에서","width":0.3538812785388128},{"text":"중요한 위치를 유지합니다. 리더십, 용기,","width":0.363013698630137,"y":0.4879227053240741,"x":0.520547947474315,"height":0.024154589371980673},{"y":0.4653784216908212,"height":0.02093397745571668,"text":"충성심으로 존경받으며 지도와 보호의 유산올","width":0.4018264840182648,"x":0.5205479490867579},{"text":"이어가고 있습니다.","x":0.5205479434246576,"width":0.17808219178082185,"y":0.43961352652173913,"height":0.020933977455716568},{"y":0.3880837359299517,"x":0.5228310527254566,"text":"라즈푸트는 보통 시바(Shiva), 수리야(Surya),","width":0.3995433789954338,"height":0.02254428341384862},{"text":"두르가(Durga)를 숭배하며 수호신에게 보호를","y":0.3639291466317768,"width":0.408675799086758,"height":0.020933977455716568,"x":0.5205479486111111},{"width":0.35159817351598166,"text":"구하고 힌두 구루에게 지도를 받습니다.","height":0.02254428341384862,"y":0.3365539450617284,"x":0.5205479480974124},{"x":0.520547948306697,"height":0.024154589371980784,"y":0.3107890499329039,"text":"힌디어로 된 경전과 가르침이 존재하지만,","width":0.3721461187214612},{"height":0.009661835748792313,"width":0.1917808219178082,"y":0.2979066023081052,"text":"Photo Source: Wikime dia","x":0.2534246607305935},{"y":0.2898550725532296,"x":0.5205479475393201,"height":0.019323671497584516,"width":0.4200913242009132,"text":"상위 카스트로서의 지위와 다른 카스트로부터의"},{"width":0.3881278538812786,"text":"고립으로 인해 복음을 접한 기회가 제한되어","y":0.26247987126945793,"x":0.5205479484398782,"height":0.020933977455716568},{"text":"• 인구: 31,894,000명","width":0.2534246575342466,"y":0.243156199452496,"x":0.043378996643835606,"height":0.02254428341384862},{"x":0.5205479459474885,"width":0.09360730593607303,"height":0.02254428341384862,"text":"있습니다.","y":0.23671497565754163},{"x":0.08904109623287672,"y":0.230273752173913,"text":"(2025년 8월 기준)","height":0.01610305958132041,"width":0.16666666666666669},{"y":0.20128824494363928,"x":0.045662100913242,"text":"• 종교: 힌두교","width":0.1643835616438356,"height":0.017713365539452464},{"text":"• 언어: 힌디어","y":0.1702040803383129,"x":0.04554953958619484,"height":0.02030037374696103,"width":0.1646086810386344},{"x":0.045662102602739674,"width":0.2146118721461187,"height":0.019323671497584627,"text":"• 기독교인: 0.01%","y":0.14170692434782606},{"x":0.0456621015068493,"width":0.2968036529680365,"height":0.020933977455716568,"text":"• 성경: 신약 있음, 완역 있음","y":0.10950080494363934}]