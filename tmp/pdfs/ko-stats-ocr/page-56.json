[{"width":0.14155251141552508,"text":"56 인도 - 셰이크","height":0.01449275362318847,"x":0.0296803635273973,"y":0.9613526569444444},{"x":0.5205479473458904,"text":"셰이크는 파키스탄과 인도의 큰 무슬림","y":0.919484702173913,"width":0.34246575342465746,"height":0.019323671497584627},{"x":0.05936073009417811,"width":0.07990867579908675,"height":0.019323671497584516,"text":"20일차","y":0.90177133647343},{"height":0.020933977455716568,"width":0.3447488584474886,"text":"공동체입니다. 인도 무슬림들은 정치적.","x":0.5205479445015221,"y":0.8921095006307032},{"width":0.36757990867579915,"height":0.019323671497584516,"text":"사회적으로 고립되어 있어 매우 큰 인구를","x":0.52054794724759,"y":0.8695652174628735},{"text":"인도","x":0.05479452102739725,"height":0.019323671497584516,"y":0.84380032215781,"width":0.04794520547945205},{"height":0.024154589371980673,"x":0.5205479477168949,"text":"가지고 있음에도 정치적 영향력은 적고,","y":0.8405797101564297,"width":0.35159817351598166},{"x":0.5205479424657534,"y":0.8164251207154359,"width":0.38356164383561653,"height":0.020933977455716568,"text":"그들의 목소리는 무시되거나 침묵당합니다."},{"text":"셰이크","x":0.04526203696892269,"width":0.2428092608168789,"y":0.7721051786680294,"height":0.059654377124927604},{"text":"파키스탄과의 긴장은 인도 무슬림들에게","y":0.7681159421095007,"width":0.3561643835616438,"x":0.5205479471841704,"height":0.02093397745571668},{"text":"긴 그림자를 드리웁니다. 힌두 민족주의자들은","x":0.5205479455251142,"height":0.02254428341384862,"width":0.40639269406392686,"y":0.7407407405152979},{"height":0.02254428341384851,"y":0.7149758454106281,"width":0.365296803652968,"text":"사람들에게 그들을 의심하라고 가르치며,","x":0.5205479482496195},{"x":0.5205479482115676,"y":0.6924315620504562,"width":0.36073059360730597,"height":0.02254428341384873,"text":"무슬림 공동체는 \" 미니 파키스탄\"이라고"},{"y":0.665056360735373,"width":0.408675799086758,"x":0.5228310536339421,"text":"불리거나 심지어 스파이로 간주되기도 합니다.","height":0.02254428341384873},{"y":0.6392914654911432,"height":0.024154589371980784,"text":"이러한 생각은 교육, 미디어, 그리고 일상적인","x":0.5228310542009131,"width":0.3972602739726028},{"text":"사회화를 통해 더욱 강화됩니다. 실제로 많은","x":0.5182648416856925,"height":0.02254428341384851,"width":0.39497716894977164,"y":0.6135265698604402},{"text":"힌두교인들은 어린 시절부터 무슬림이","height":0.019323671497584516,"x":0.5205479485844748,"y":0.5925925926570048,"width":0.3378995433789954},{"y":0.5619967795330113,"text":"도둑이고, 부도덕하며, 신뢰할 수 없다고","height":0.024154589371980673,"width":0.3561643835616438,"x":0.5205479487671233},{"y":0.537842189983897,"x":0.5205479415525115,"height":0.02254428341384851,"text":"배웁니다. 이로 인해 이웃, 학교, 관계에서","width":0.365296803652968},{"height":0.02254428341384851,"text":"깊은 사회적 분리를 당합니다.","x":0.5228310523972601,"width":0.2648401826484019,"y":0.5136876004562534},{"height":0.02254428341384873,"text":"인도 무슬림의 약 90%는 저임금, 저숙련","x":0.5205479468851925,"y":0.4637681157809983,"width":0.35844748858447495},{"x":0.5205479470091324,"width":0.3995433789954338,"text":"직종에 종사하며 양질의 교육에서 배제되기에","y":0.4396135263607086,"height":0.020933977455716568},{"y":0.4122383252818036,"x":0.5228310532534246,"text":"대부분이 무학이며 가난하다고 인식되고,","height":0.02254428341384862,"width":0.363013698630137},{"width":0.3105022831050228,"x":0.5228310527777779,"text":"이에 따라 교육에서 더 소외됩니다.","height":0.02254428341384873,"y":0.38808373572195376},{"text":"Photo Source: Mikhail Nilov - Pexels","x":0.16438356433789947,"width":0.2694063926940639,"height":0.009661835748792202,"y":0.31884057977455726},{"y":0.23832528196457325,"x":0.08675799185346612,"width":0.226027397260274,"text":"20258288272100명","height":0.03864734299516903},{"text":"종교: 이슬람","y":0.2107735562472247,"x":0.09126802490497431,"width":0.12111691688293737,"height":0.019676719118815522},{"text":"• 언어: 우르두어","width":0.18741600698532038,"height":0.02184947485317157,"y":0.17828621206111472,"x":0.04556140299341483},{"height":0.019323671497584516,"text":"• 기독교인: 0.00%","x":0.045662099497716914,"width":0.21917808219178084,"y":0.1513687598711756},{"text":"• 성경: 신약 있음, 완역 있음","width":0.2968036529680365,"y":0.11916264067632854,"height":0.02254428341384862,"x":0.0456621015068493}]