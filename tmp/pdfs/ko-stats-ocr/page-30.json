[{"y":0.961352657105475,"height":0.01449275362318847,"x":0.03196347191780819,"text":"30 수단 아랍인","width":0.1278538812785388},{"width":0.33105022831050224,"x":0.520547942840835,"height":0.019323671497584627,"text":"수단 아랍인들은 사우디아라비아에서","y":0.9194847020013802},{"y":0.9049919485507246,"x":0.05936073090182647,"width":0.06164383561643836,"height":0.019323671497584516,"text":"8일차"},{"x":0.5205479449391172,"height":0.02093397745571668,"y":0.8937198069377348,"text":"이 지역으로 이주한 베두인 유목민들의","width":0.34246575342465757},{"x":0.5205479436643835,"width":0.36757990867579904,"height":0.024154589371980673,"text":"후손으로, 현지 아프리카 종족들과의 혼혈","y":0.86473429931562},{"y":0.8486312401449275,"width":0.1095890410958904,"height":0.020933977455716568,"text":"아랍문화권","x":0.05251141584474885},{"y":0.8421900160547504,"x":0.5205479412557077,"height":0.020933977455716568,"text":"혈통입니다. 그들이 이 지역의 다른 종족들과","width":0.39497716894977175},{"width":0.36986301369863017,"x":0.5205479425636008,"height":0.02254428341384873,"text":"구별되는 점이 모국어가 수단 아랍어이며,","y":0.8148148147458016},{"y":0.7938808372785829,"width":0.34246575342465746,"text":"현지 종족어를 전혀 사용하지 않는다는","height":0.019323671497584516,"x":0.5205479423515983},{"text":"수단","x":0.04109588980756687,"height":0.06119162640901776,"y":0.7793880836553945,"width":0.1689497716894977},{"width":0.3926940639269406,"height":0.024154589371980673,"text":"것입니다. 그들 중 일부는 여전히 유목생활올","y":0.7648953299114332,"x":0.520547943455099},{"y":0.7391304345813206,"height":0.02415458937198056,"x":0.520547944197108,"text":"하고 있으며, 많은 이들이 시골 지역에서","width":0.3538812785388128},{"text":"농업에 종사합니다.","y":0.7165861513821793,"x":0.5205479466894978,"height":0.020933977455716568,"width":0.17808219178082185},{"x":0.04109588981877854,"height":0.06602254428341381,"text":"아랍인","width":0.2442922374429224,"y":0.7085346217844203},{"x":0.5205479424983692,"text":"수단은 2018년부터 내전 상태에 있습니다.","width":0.3789954337899544,"height":0.02254428341384873,"y":0.6650563606395214},{"width":0.365296803652968,"x":0.5228310522577371,"text":"두 파벌이 구호 자금의 대부분을 자신들을","height":0.019323671497584516,"y":0.6425120773841474},{"text":"위해 빼돌려, 대부분의 주민들은 물이나","width":0.34931506849315064,"height":0.02254428341384851,"x":0.5205479473886987,"y":0.6135265701489534},{"y":0.5893719806226516,"height":0.02254428341384873,"width":0.36757990867579915,"x":0.5205479421423136,"text":"전기를 공급받지 못하고 있습니다. 극심한"},{"width":0.36073059360730586,"text":"불안정으로 인해 많은 사람들이 국내외로","height":0.019323671497584405,"x":0.5228310528049576,"y":0.5668276973544975},{"y":0.5394524957997853,"x":0.5228310518645357,"width":0.2009132420091324,"height":0.02093397745571668,"text":"난민이 되어 떠돕니다."},{"text":"수단 밖에서 가장 큰 수단 아랍인 집단은","width":0.3538812785388128,"height":0.019323671497584627,"y":0.4911433171382562,"x":0.5205479426777561},{"text":"이집트에 거주하며 그 숫자는 400만 명에","y":0.46698872792730606,"x":0.5228310528212654,"height":0.019323671497584627,"width":0.363013698630137},{"y":0.43800322042404716,"width":0.3378995433789954,"text":"이릅니다. 수단 내 인구의 절반이 18세","x":0.5228310488964993,"height":0.02254428341384873},{"y":0.428341384863124,"text":"Photo Source; David Haberlah - wikimedia,","x":0.12328767528538803,"width":0.3242009132420091,"height":0.012882447665056307},{"y":0.41706924308910354,"x":0.21917808030821925,"text":"Licensed under CC BY-SA 3.0","width":0.22602739726027396,"height":0.011272141706924366},{"y":0.41223832509393454,"text":"미만이지만, 정치적 혼란으로 인해 모든","width":0.3470319634703196,"height":0.02254428341384862,"x":0.5228310491628616},{"y":0.3896940417874396,"width":0.3538812785388128,"x":0.5205479426777561,"height":0.020933977455716568,"text":"세대가 학교 교육을 거의 또는 전혀 받지"},{"x":0.5202877191026035,"height":0.02236318434686091,"text":"못했습니다.","y":0.3632145427295773,"width":0.11239259972419913},{"height":0.02254428341384862,"text":"인구: 15,087,000명 (2025년 8월","y":0.3140096618089103,"x":0.07305935804794525,"width":0.32191780821917815},{"height":0.024154589371980673,"text":"수단 아랍인들은 무슬림이지만,","y":0.31078904971819654,"x":0.5205479475076102,"width":0.2808219178082192},{"y":0.2995169081521739,"width":0.04794520547945205,"text":"기준)","x":0.07305936043093608,"height":0.01610305958132041},{"height":0.019323671497584627,"text":"주술사들이 여전히 그들의 일상생활에서","width":0.3561643835616438,"y":0.2898550723832527,"x":0.5205479422374429},{"height":0.020521796651892354,"width":0.16693747533510808,"y":0.26993233859161936,"x":0.029544962261090317,"text":"• 종교: 이슬람"},{"text":"주요 역할을 합니다. 점진적이지만,","x":0.5205479477739726,"y":0.259259259057971,"width":0.31278538812785384,"height":0.024154589371980673},{"x":0.02739726210045658,"height":0.020933977455716568,"width":0.2191780821917808,"y":0.24154589384057967,"text":"• 언어: 수단 아랍어"},{"width":0.3812785388127854,"x":0.5205479413926941,"y":0.23832528181964574,"text":"관계전도와 일대일 제자훈련을 통해 소수가","height":0.020933977455716568},{"y":0.21256038666666666,"x":0.027397259041095887,"text":"• 기독교인: 0.05% 미만","width":0.2694063926940639,"height":0.019323671497584516},{"x":0.5205479466133941,"text":"그리스도께 나아오고 있습니다. 수단에 많은","height":0.02254428341384862,"width":0.3881278538812786,"y":0.2109500803274289},{"y":0.18035426743156202,"width":0.2968036529680365,"height":0.02254428341384862,"x":0.029680369006849207,"text":"• 성경: 신약 있음, 완역 없음"},{"height":0.024154589371980673,"text":"그리스도인들이 있지만, 교회는 정부의","width":0.34246575342465746,"y":0.18518518494363934,"x":0.5205479460730593},{"width":0.3881278538812786,"text":"반발을 두려워해 무슬림 전도에 신중합니다.","y":0.16103059581320456,"x":0.5228310534627092,"height":0.02254428341384862},{"width":0.37671232876712324,"height":0.02254428341384862,"x":0.520547946037182,"y":0.1352657003220611,"text":"수단이 남북으로 분리될 때, 60%의 기독교"},{"y":0.11111111090177139,"x":0.5205479483561642,"text":"지도자들이 남쪽으로 이동했습니다.","width":0.3196347031963471,"height":0.020933977455716568}]