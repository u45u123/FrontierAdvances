[{"height":0.01449275362318836,"x":0.03196347180365294,"text":"16 아프리카 - 오로모 가레","y":0.9613526570853462,"width":0.20776255707762556},{"x":0.5159817309075343,"width":0.34018264840182655,"height":0.017713365539452575,"text":"오로모 가레 사람들은 소말리와 오로모","y":0.9194847020330112},{"y":0.9066022545088567,"width":0.06392694063926942,"x":0.06621004630136985,"height":0.017713365539452464,"text":"2일차"},{"y":0.8921095008051529,"width":0.35159817351598166,"x":0.5159817380898021,"text":"공동체의 혼합 역사를 가지고 있습니다.","height":0.02254428341384862},{"width":0.3812785388127854,"x":0.5159817324363993,"y":0.8695652172992869,"text":"전통적으로 소말리 부족의 일부로 여겨졌고","height":0.019323671497584516},{"x":0.054716258991151026,"width":0.08919762040926442,"height":0.021267550003125413,"text":"아프리카","y":0.8452438415685324},{"height":0.019323671497584516,"x":0.5182648382876713,"width":0.37899543378995426,"text":"남부 소말리아의 큰 도시(바라웨, 키스마요)","y":0.8438003219806763},{"y":0.8164251209608159,"text":"건설에 중요한 역할을 했습니다.","height":0.02254428341384862,"x":0.5159817345890412,"width":0.28767123287671237},{"text":"오로모","height":0.05152979066022545,"y":0.7793880836714976,"x":0.052511414315068505,"width":0.2420091324200913},{"y":0.7681159419484702,"text":"그러나 대부분(특히 에티오피아와 케냐)의","height":0.020933977455716568,"x":0.5159817325342466,"width":0.36757990867579904},{"y":0.7439613527375202,"text":"사람들은 오로모 종족 간에 결혼하며","height":0.019323671497584405,"x":0.5159817371718036,"width":0.32191780821917815},{"height":0.020933977455716568,"y":0.7165861513553409,"x":0.5159817370243531,"text":"그들의 전통을 따릅니다.","width":0.22374429223744297},{"y":0.7053140095770827,"x":0.05022831008171112,"width":0.1598173515981735,"height":0.06119162640901776,"text":"가레"},{"height":0.019323671497584627,"x":0.5159817380327245,"width":0.3447488584474886,"y":0.6682769727053139,"text":"오늘날 그들은 소말리아와 케냐에 살고"},{"y":0.6409017715619968,"text":"있으며 정체성과 언어는 지역에 따라 다릅니다.","width":0.41552511415525106,"height":0.02254428341384862,"x":0.515981734109589},{"y":0.6167471818955601,"text":"그래서 많은 사람들이 그들을 그 지역의","x":0.5159817326810175,"height":0.019323671497584627,"width":0.3470319634703196},{"y":0.5909822866183575,"width":0.319634703196347,"text":"'다리 역할을 하는 사람들'로 봅니다.","x":0.5205479484018264,"height":0.020933977455716568},{"text":"주요 생계는 공동체와 가축(낙타, 염소, 소,","y":0.5378421900391075,"width":0.3744292237442922,"x":0.5159817378343118,"height":0.02254428341384851},{"height":0.02254428341384851,"width":0.3744292237442922,"x":0.5159817348336594,"y":0.5136876004830919,"text":"양)에 의존합니다. 전통적으로 유목 생활올"},{"text":"하며, 이동식 오두막에서 살고, 원형으로","x":0.5159817316210046,"height":0.02254428341384873,"y":0.48792270524959735,"width":0.3538812785388128},{"width":0.36986301369863017,"height":0.02254428341384873,"y":0.46376811594202894,"x":0.5182648438812785,"text":"배치된 오두막 가운데에 가축을 키웁니다."},{"y":0.43639291441223826,"x":0.5159817351598174,"text":"소규모 거래를 하며, 주로 가축을 곡물 등","width":0.36073059360730586,"height":0.024154589371980784},{"width":0.3881278538812786,"y":0.41384863127012883,"x":0.5182648426084475,"height":0.020933977455716568,"text":"다른 물품으로 교환하며 생계를 이어갑니다."},{"height":0.02254428341384862,"text":"1400년대에 이슬람으로 개종했으며,","width":0.33105022831050224,"y":0.3623188405797102,"x":0.5159817379185692},{"text":"오늘날 대부분이 무슬림으로서 매우","height":0.019323671497584627,"x":0.5182648421518264,"y":0.33977455724637684,"width":0.31506849315068486},{"width":0.2191780821917808,"y":0.32528180348899627,"x":0.22602740091324192,"text":"Photo Source: Erik Laursen,","height":0.012882447665056307},{"x":0.2534246594292237,"y":0.31239935592592594,"height":0.011272141706924366,"width":0.18949771689497713,"text":"New Covenant Missions"},{"width":0.24200913242009137,"y":0.3123993558776168,"text":"엄격하게 신앙을 지킵니다.","height":0.02254428341384862,"x":0.51598173717656},{"height":0.019323671497584627,"text":"복음을 들어본 적이 없고 복음을 들은","x":0.5159817324200914,"width":0.3287671232876712,"y":0.2898550723832527},{"height":0.020933977455716568,"text":"인구: 741,000명","y":0.2769726246491834,"width":0.1689497716894977,"x":0.08675799116112198},{"width":0.1643835616438356,"height":0.017713365539452464,"y":0.25925925908212566,"x":0.08447488447488587,"text":"(2025년 8월 기준)"},{"width":0.33105022831050224,"height":0.02254428341384862,"text":"사람조차도 기독교가 정체성, 공동체,","x":0.5159817379185692,"y":0.26086956521739135},{"y":0.23510466980676326,"height":0.011272141706924255,"x":0.043378994786910215,"text":"•","width":0.03881278538812786},{"x":0.5159817385388128,"width":0.3378995433789954,"y":0.23832528191626412,"height":0.020933977455716568,"text":"전통을 약화시킬 것이라는 두려움으로"},{"height":0.021170020295418035,"x":0.08671716567397396,"text":"종교: 이슬람","y":0.230155730418397,"width":0.12108621640836813},{"width":0.20319634703196354,"text":"마음을 닫고 있습니다.","x":0.5159817334665144,"height":0.020933977455716568,"y":0.2125603864063339},{"width":0.3858447488584475,"y":0.196457326677402,"text":"• 언어: 가레어, 일부는 소말리어 사용","x":0.041095890125570744,"height":0.025764895330112725},{"x":0.04109588778538819,"y":0.1739130433655396,"height":0.017713365539452464,"width":0.2625570776255708,"text":"• 기독교인: 0.01% 미만"},{"height":0.019323671497584516,"text":"• 성경 번역 상태: 시작됨","y":0.1433172301771336,"x":0.04109588778538819,"width":0.2625570776255708}]