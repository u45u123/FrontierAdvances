[{"height":0.01449275362318836,"x":0.03196347121656881,"text":"58 인도- 텔리","width":0.12557077625570778,"y":0.9613526570853462},{"width":0.30365296803652975,"x":0.5205479473744291,"text":"인도의 텔리는 전통적인 기름 짜는","height":0.019323671497584516,"y":0.9194847021624108},{"x":0.05936073122146117,"text":"21일차","width":0.07534246575342467,"height":0.019323671497584516,"y":0.9049919485507246},{"y":0.8921095006307032,"text":"공동체입니다. 그들의 이름은 산스크리트어로","width":0.3995433789954338,"height":0.020933977455716568,"x":0.5205479440449011},{"width":0.3287671232876712,"y":0.8695652174047236,"text":"기름'을 의미하는 단어에서 유래하며","height":0.020933977455716568,"x":0.5205479424657534},{"y":0.8502415459742351,"width":0.04794520547945205,"x":0.05479452102739725,"text":"인도","height":0.017713365539452464},{"x":0.5228310473287672,"width":0.3264840182648402,"height":0.020933977455716568,"y":0.8438003222705314,"text":"전통적으로 카스트 제도의 네 단계 중"},{"width":0.182648401826484,"text":"세 번째에 속합니다.","y":0.8164251208031401,"x":0.5205479463470319,"height":0.020933977455716568},{"x":0.04566210102739726,"y":0.7745571659477801,"text":"텔리","width":0.1598173515981735,"height":0.0628019323671497},{"text":"기름 짜기가 기계화되면서 텔리는","y":0.7681159419599723,"width":0.29680365296803657,"x":0.5205479430854534,"height":0.019323671497584627},{"y":0.7423510466827696,"width":0.30593607305936077,"x":0.5228310532876712,"text":"이제 농업과 노동직에 종사합니다.","height":0.02093397745571668},{"height":0.019323671497584516,"text":"델리는 소유한 토지가 없기에 정부 지원을","width":0.365296803652968,"x":0.5228310522577371,"y":0.7181964573984613},{"height":0.02093397745571668,"width":0.3812785388127854,"text":"받기 위해 '기타 후진계급(Other Backward","y":0.692431562258454,"x":0.5228310476312786},{"width":0.363013698630137,"text":"Castes)'으로 등록했습니다. 일부 텔리는","x":0.5205479462654925,"y":0.665056360547504,"height":0.02254428341384862},{"x":0.5182648369178082,"width":0.3264840182648402,"height":0.02254428341384862,"y":0.6392914653462158,"text":"사업, 정부, 정치 분야에서 일합니다."},{"width":0.3561643835616438,"height":0.024154589371980784,"x":0.522831053196347,"y":0.5877616747316157,"text":"텔리 공동체는 인도 전역에 살고 있으며,"},{"y":0.5636070853462158,"text":"소수는 방글라데시, 네팔, 스리랑카,","height":0.02254428341384851,"x":0.520547947869102,"width":0.319634703196347},{"text":"파키스탄에도 거주합니다. 텔리 장로들은","height":0.02093397745571668,"y":0.5394524960777547,"x":0.5205479477984345,"width":0.3630136986301369},{"height":0.011272141706924255,"y":0.5297906601247987,"text":"Photo Source: wikimedia","x":0.2511415501426941,"width":0.1894977168949772},{"height":0.024154589371980673,"width":0.36986301369863017,"text":"공동체 내에서 결혼을 주선하며, 지참금은","y":0.5120772948309179,"x":0.5205479489041095},{"text":"현금이나 귀중품으로 오가는 전통을 가지고","height":0.019323671497584627,"width":0.3812785388127854,"x":0.5205479413926941,"y":0.49114331716586146},{"width":0.2488584474885845,"y":0.4718196454710145,"height":0.020933977455716568,"text":"• 인구: 21,850,000명","x":0.0525114156678082},{"width":0.16666666666666669,"height":0.01610305958132041,"y":0.4573268921739131,"text":"(2025년 8월 기준)","x":0.09589041262557074},{"y":0.4621578099335749,"x":0.5205479429794521,"width":0.3561643835616439,"height":0.024154589371980673,"text":"있습니다. 여성은 사회적 지위가 낮지만,"},{"text":"종교 및 사회 활동에서 중요한 역할을 하고,","width":0.3812785388127854,"height":0.024154589371980784,"y":0.4363929145833333,"x":0.5205479428224886},{"height":0.017713365539452464,"x":0.05022830911339424,"width":0.16666666666666666,"y":0.4283413847691895,"text":"• 종교: 힌두교"},{"y":0.4138486312533548,"x":0.5205479479832572,"height":0.020933977455716568,"width":0.33333333333333326,"text":"부업을 통해 가계 소득에 기여합니다."},{"text":"• 언어: 힌디어","width":0.1643835616438356,"y":0.39935587769726255,"height":0.017713365539452464,"x":0.05251141716894975},{"y":0.3687600645088567,"width":0.2168949771689498,"text":"• 기독교인: 0.01%","height":0.019323671497584516,"x":0.050228312671232844},{"width":0.363013698630137,"text":"대부분 텔리는 힌두교도이며, 결혼, 출산,","x":0.5205479415753425,"height":0.02254428341384862,"y":0.36231884054750396},{"width":0.3013698630136986,"text":"• 성경: 신약 있음, 완역 있음","height":0.024154589371980673,"y":0.3365539453703704,"x":0.05022831301369861},{"y":0.3397745570853463,"width":0.3470319634703197,"text":"장례를 위한 특별한 의식을 가지고 있어","height":0.019323671497584516,"x":0.5205479430365297},{"y":0.3140096617552335,"x":0.52054794173516,"width":0.3470319634703196,"text":"죽은 자를 화장하고 재를 성스러운 강에","height":0.02093397745571668},{"width":0.36073059360730597,"y":0.28824476643854,"height":0.020933977455716568,"text":"뿌립니다. 조상을 존중하고 악령으로부터","x":0.5205479421993913},{"x":0.520547948173516,"height":0.02254428341384862,"width":0.4155251141552512,"y":0.26086956524039573,"text":"보호를 구합니다. 영적으로 그들은 실용적이며,"},{"y":0.23510466983896938,"height":0.024154589371980673,"width":0.33333333333333337,"text":"소원을 이루어 주는 여신을 숭배하며,","x":0.5205479418721461},{"x":0.5205479486681888,"height":0.02093397745571668,"text":"그 여신이 그들의 기도를 들어준다고 믿습니다.","y":0.21256038648684916,"width":0.41552511415525106}]