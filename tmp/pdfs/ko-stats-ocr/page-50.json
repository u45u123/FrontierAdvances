[{"y":0.9613526570853462,"height":0.01449275362318836,"text":"50 인도 - 마라타","width":0.1415525114155251,"x":0.03196347133072407},{"width":0.18036529680365299,"height":0.019323671497584516,"y":0.9194847021900161,"x":0.5228310520319633,"text":"마라타(Mahratta)는"},{"x":0.05936073095890411,"width":0.07305936073059362,"y":0.9066022546215781,"height":0.019323671497584516,"text":"17일차"},{"height":0.019323671497584516,"x":0.5205479425608829,"y":0.8953301126409018,"text":"마하라슈트라(Maharashtra) 출신의","width":0.317351598173516},{"width":0.3972602739726028,"height":0.02254428341384862,"y":0.8679549114533011,"x":0.5205479476883561,"text":"자랑스러운 크샤트리야(Kshatrilya) 종족으로,"},{"width":0.04794520547945205,"height":0.017713365539452464,"text":"인도","y":0.8502415459742351,"x":0.05479452102739725},{"y":0.8454106280032205,"width":0.3470319634703196,"text":"주로 마라티어(Marathi)를 사용합니다.","height":0.02093397745571668,"x":0.520547948675799},{"width":0.363013698630137,"x":0.5205479426125245,"y":0.8228663445134575,"text":"그들은 마라타와다(Marathwada) 전역에","height":0.019323671497584516},{"text":"거주하며 일부는 카르나타카(Karnataka)의","y":0.7987117551529791,"width":0.37671232876712324,"x":0.52054794206621,"height":0.019323671497584516},{"height":0.06441223832528187,"y":0.7745571659372927,"text":"마라타","x":0.04566210118184258,"width":0.24657534246575344},{"x":0.5205479458675799,"y":0.7713365537198068,"width":0.3721461187214612,"height":0.02254428341384862,"text":"국경 지역에도 있습니다. 소수는 더 서쪽의"},{"x":0.5205479454147641,"text":"파키스탄에서 삽니다. 그들은 대부분 농촌","height":0.020933977455716568,"width":0.36757990867579904,"y":0.7487922703569512},{"width":0.26712328767123283,"x":0.5205479473934551,"y":0.7230273750134192,"height":0.02254428341384862,"text":"사회의 상위 계층에 속합니다."},{"width":0.3972602739726028,"text":"주로 \"쿤비(kunbi, 농부)\" 계급이며, 거의 모든","x":0.5205479418949771,"y":0.6988727857487923,"height":0.025764895330112725},{"text":"농촌 마라타 가정은 토지를 소유하고 농작물을","y":0.6779388082662372,"width":0.406392694063927,"height":0.019323671497584627,"x":0.5205479418188736},{"x":0.5205479420852359,"width":0.3744292237442923,"height":0.020933977455716568,"text":"재배합니다. 토지는 보통 환금 작물과 식량","y":0.6521739129763822},{"y":0.6264090176811594,"x":0.520547941369863,"text":"작물을 모두 재배할 수 있을 만큼 넓습니다.","height":0.02254428341384873,"width":0.38356164383561653},{"text":"다른 인도 집단에 비해 그들은 자유롭습니다.","width":0.39726027397260266,"height":0.02254428341384851,"y":0.5780998389049921,"x":0.5205479412328768},{"y":0.5555555556199678,"height":0.009661835748792313,"text":"Photo Source: Wikimedia","x":0.25114155440639263,"width":0.1894977168949772},{"x":0.5205479474505326,"height":0.02254428341384862,"y":0.5539452494095545,"text":"중매 결혼이 엄격히 강요되지 않으며, 남자는","width":0.39269406392694073},{"width":0.3721461187214612,"height":0.019323671497584516,"y":0.5330112722222222,"x":0.5205479475313928,"text":"자신의 선택에 따라 브라만(Brahmin)이나"},{"width":0.3744292237442922,"text":"마라타 계급의 여자와 결혼할 수 있습니다.","height":0.020933977455716568,"x":0.522831052902805,"y":0.5072463768230964},{"y":0.49758454118357487,"height":0.024154589371980673,"width":0.2146118721461187,"x":0.09132420270167424,"text":"인구: 36,204,000명"},{"text":"<2025년 8월 기준)","height":0.016103059581320522,"x":0.08904109757990865,"width":0.16894977168949776,"y":0.48148148154589365},{"y":0.4814814814814815,"x":0.5205479482496195,"text":"마라타들은 타문화에 다소 포용적이지만,","width":0.365296803652968,"height":0.02254428341384862},{"x":0.5205479438356164,"y":0.4589371978582931,"width":0.34246575342465746,"text":"자신들을 상위 카스트로 여겨 동등하지","height":0.020933977455716568},{"x":0.045662098373287725,"text":"• 종교: 힌두교","width":0.16666666666666666,"height":0.017713365539452464,"y":0.4524959741344605},{"width":0.410958904109589,"x":0.5205479493150684,"height":0.020933977455716568,"text":"않다고 생각하는 사람들을 대체로 경멸합니다.","y":0.4347826086795491},{"text":"• 언어: 마라티어","width":0.1894977168949772,"height":0.019323671497584516,"x":0.04566209910306589,"y":0.42351046689671035},{"height":0.020933977455716568,"text":"중산충 마라타 가정의 주요 목표는 자신과","y":0.41062801914922176,"x":0.5205479424467276,"width":0.36757990867579915},{"height":0.019323671497584516,"x":0.04566210125570775,"y":0.3929146535426731,"text":"• 기독교인: 0.00%","width":0.2191780821917808},{"height":0.019323671497584627,"y":0.38808373582930755,"x":0.5205479429509132,"text":"자녀의 안정된 미래이므로 재정적 성공이","width":0.36073059360730597},{"x":0.04566210135083712,"text":"• 성경: 신약 있음, 완역 있음","y":0.36070853442028994,"width":0.2990867579908676,"height":0.024154589371980673},{"height":0.020933977455716568,"x":0.5205479466894978,"y":0.36231884056629093,"text":"주된 관심사입니다.","width":0.17808219178082185},{"x":0.5205479430365297,"y":0.3140096616264091,"width":0.38584474885844755,"text":"힌두 마라타들은 보통 시바(Shiva)를 가문의","height":0.020933977455716568},{"x":0.5205479431316592,"text":"신으로 숭배하며 시바지(Shivai)를 지도자로","width":0.3904109589041096,"height":0.020933977455716568,"y":0.28985507263821797},{"text":"여깁니다. 대부분 땅과 대지를 어머니로","height":0.02254428341384873,"x":0.5205479438165906,"y":0.2640901769457863,"width":0.34931506849315064},{"width":0.37899543378995426,"x":0.5205479420471842,"y":0.23832528173644651,"height":0.024154589371980784,"text":"숭배합니다. 마라타들은 문화, 언어, 역사를"},{"height":0.020933977455716568,"y":0.21739130427737519,"text":"치열하게 방어하는데, 이는 많은 것을","x":0.520547943150685,"width":0.3287671232876712},{"height":0.02254428341384862,"y":0.19162640882984427,"x":0.5205479438546423,"text":"의미합니다. 이처럼 힌두교는 그들의 문화의","width":0.38584474885844755},{"width":0.32420091324200906,"text":"중요한 요소이기 때문에 이러한 신들","x":0.5205479483105023,"y":0.16908212539452494,"height":0.020933977455716568},{"x":0.5205479468797564,"y":0.14492753605743425,"text":"숭배하기를 멈추라고 말하는 것은 보통","width":0.34246575342465757,"height":0.020933977455716568},{"width":0.37046381980861165,"height":0.02409617413261278,"x":0.5202991480234935,"y":0.11902846716345417,"text":"그들의 문화에 대한 공격으로 여겨집니다."},{"width":0.3835616438356164,"x":0.522831047108067,"height":0.019323671497584516,"text":"힌두 마라타 사람들은 예수 그리스도를 그분","y":0.09822866360708549},{"text":"본연의 모습으로 알아보는 데 필요한 영적","height":0.019323671497584516,"width":0.36757990867579915,"x":0.5205479421423136,"y":0.07407407399355892},{"x":0.5205479477625571,"y":0.046698872576489525,"text":"분별력과 겸손이 필요합니다.","width":0.26027397260273966,"height":0.020933977455716568}]