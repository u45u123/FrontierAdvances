[{"x":0.03196347173842137,"y":0.9613526570853462,"text":"82 기타 아시아 - 실헤티","width":0.1986301369863014,"height":0.01449275362318836},{"y":0.9194847021739131,"width":0.363013698630137,"text":"실헤티 사람들은 방글라데시 북동부 실렛","x":0.5205479482305936,"height":0.019323671497584516},{"x":0.07065252580558692,"y":0.9015361497935711,"width":0.07330681961965343,"text":"31일차","height":0.01979404486319869},{"text":"지역과 인도 아삼주 카림간지 지역에","x":0.520547947694064,"y":0.8937198069726248,"width":0.32191780821917804,"height":0.020933977455716568},{"text":"거주합니다. 아삼의 바라크 계곡에 사는","y":0.8663446054213634,"x":0.5205479422945206,"height":0.02254428341384862,"width":0.34931506849315064},{"y":0.8454106279388084,"height":0.019323671497584516,"text":"기타 아시아","x":0.06621004494863016,"width":0.11415525114155252},{"height":0.019323671497584516,"y":0.843800322150653,"text":"실헤티는 지리적 고립으로 경제적 어려움을","x":0.5205479473236935,"width":0.3812785388127854},{"height":0.02415458937198056,"width":0.3926940639269406,"x":0.522831047716895,"y":0.8148148150563608,"text":"겪는 반면, 방글라데시 북동부는 차 농장, 숲,"},{"x":0.5228310520738203,"y":0.7922705314143854,"text":"벼농사로 더 번영합니다.","width":0.22146118721461194,"height":0.020933977455716568},{"width":0.24200913242009134,"y":0.771336554025765,"height":0.0628019323671497,"x":0.05479452135464228,"text":"실헤티"},{"text":"실로트(Sibt)는 성장하는 대도시로, 발전된","x":0.5205479476484018,"width":0.37671232876712324,"y":0.7391304345410628,"height":0.024154589371980784},{"x":0.5205479428082193,"height":0.02254428341384873,"width":0.3835616438356164,"text":"경제를 가지고 있습니다. 영국, 미국, 중동에","y":0.7149758453502415},{"y":0.6924315622061191,"text":"거주하는 많은 실헤티 가정은 고향 공동체를","width":0.3881278538812786,"height":0.020933977455716568,"x":0.5205479470319635},{"y":0.6682769727053139,"text":"지원하기 위해 도시에 투자했으며","x":0.5205479470605022,"height":0.019323671497584627,"width":0.29680365296803657},{"x":0.5205479425608829,"y":0.6425120774691357,"width":0.3721461187214612,"height":0.02093397745571668,"text":"또한 이 도시는 고대 브라만 왕국 시대부터"},{"width":0.19634703196347025,"text":"상업 중심지였습니다.","height":0.020933977455716568,"y":0.6151368760179434,"x":0.5205479466079582},{"y":0.5636070851851853,"text":"14세기 이후, 수피 성인(Pir)은 실헤티","width":0.33105022831050235,"x":0.5205479445694716,"height":0.02254428341384851},{"width":0.3264840182648402,"y":0.5394524960044285,"height":0.020933977455716457,"text":"사람들에게 강한 영향을 미쳤습니다.","x":0.5205479472460045},{"y":0.5120772944847021,"text":"그들은 죽은 후에도 영적 지도자로 존경받으며,","x":0.520547948630137,"height":0.024154589371980784,"width":0.4155251141552512},{"width":0.3904109589041096,"height":0.019323671497584516,"x":0.5182648369292239,"y":0.49114331717659676,"text":"사람들은 그들의 신당을 방문하고 연례 축제"},{"text":"(우르스)를 개최합니다. 많은 실헤티는","height":0.02254428341384862,"y":0.4637681160386473,"x":0.5182648435844749,"width":0.34018264840182644},{"text":"신당 방문, 주술, 악한 눈을 믿으며, 의사 대신","height":0.024154589371980673,"x":0.5205479491780821,"y":0.43639291476650566,"width":0.3972602739726028},{"y":0.41384863117283954,"height":0.020933977455716568,"text":"종교 지도자에게 도움을 구합니다.","x":0.5205479426560121,"width":0.30593607305936077},{"height":0.009661835748792313,"text":"VAN을","y":0.37359098228663445,"x":0.3607305928082192,"width":0.04794520547945208},{"height":0.019323671497584516,"text":"실헤티의 결혼은 일반적으로 이슬람과 힌두","x":0.5205479490410958,"y":0.3655394525925926,"width":0.3835616438356164},{"y":0.3574879227657005,"text":"Photo Source: Adam Jones - Flickr","x":0.18493151015981726,"width":0.2648401826484018,"height":0.011272141706924255},{"text":"Licensed under CC BY 2.0","height":0.011272141706924366,"width":0.2009132420091324,"x":0.24885844414003055,"y":0.3429951690016102},{"x":0.5205479463470319,"width":0.3926940639269406,"y":0.3365539450617284,"height":0.02254428341384862,"text":"전통이 혼합된 의식을 따르며, 중매로 결혼이"},{"y":0.3107890500100645,"text":"이루어집니다. 가족 유대, 공동체 참여, 문화","x":0.5228310526255707,"width":0.3835616438356164,"height":0.024154589371980673},{"text":"• 인구: 약 13,406,000명","width":0.2808219178082192,"y":0.28824476664653786,"x":0.05479452405821911,"height":0.020933977455716568},{"height":0.019323671497584627,"y":0.28985507239475494,"text":"보존이 매우 중요하며 여성은 가부장적 규범과","x":0.5205479423026745,"width":0.40639269406392686},{"y":0.27375201279043015,"text":"(2025년 8월 기준)","x":0.09817351479125899,"width":0.16666666666666666,"height":0.01610305958132041},{"text":"시집살이로 인해 사회적 어려움을 겪습니다.","x":0.520547947645548,"y":0.2624798712057166,"width":0.3904109589041096,"height":0.020933977455716568},{"height":0.017713365539452464,"y":0.24476650578099834,"x":0.05479452223744288,"text":"• 종교: 이슬람","width":0.16894977168949774},{"x":0.5205479464992389,"y":0.2351046696859903,"text":"계급에 따라 지위가 달라지며, 결혼은 많은","width":0.3744292237442923,"height":0.024154589371980784},{"height":0.020933977455716568,"x":0.054794518619989886,"width":0.3470319634703196,"text":"• 언어: 실헤티어(고유 문자 사용)","y":0.2141706923510467},{"y":0.21095008028985507,"text":"여성에게 스트레스가 됩니다.","x":0.5205479477625571,"width":0.26027397260273966,"height":0.02254428341384862},{"height":0.020933977455716568,"width":0.24657534246575344,"y":0.1835748789653785,"text":"• 기독교인: 0.1% 미만","x":0.05479452094748858},{"text":"실헤티어는 고유한 문자를 가지고 있으며","height":0.02093397745571668,"y":0.16264090185185187,"x":0.5205479472095383,"width":0.36073059360730586},{"height":0.020629207101229174,"y":0.15554691033041423,"x":0.054623991406374604,"text":"• 성경: 있음","width":0.1441766747600956},{"y":0.13526570050993025,"width":0.33333333333333326,"height":0.02254428341384873,"x":0.5205479479832572,"text":"전 세계 약 1,300만 명이 사용합니다."},{"height":0.020933977455716568,"text":"이는 강한 지역 정체성과 글로벌 실헤티","width":0.3470319634703196,"y":0.11272141698872784,"x":0.52054794173516},{"width":0.2808219178082192,"height":0.02093397745571668,"text":"공동체와의 연결을 제공합니다.","x":0.5205479475456621,"y":0.08695652175254964}]