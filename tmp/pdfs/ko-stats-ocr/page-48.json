[{"x":0.0319634717351598,"height":0.01449275362318836,"y":0.9613526570853462,"text":"48 인도 - 쿠르미","width":0.1415525114155251},{"x":0.5205479475313928,"height":0.019323671497584627,"y":0.919484702173913,"text":"쿠르미(Kurmi)는 인도와 네팔의 힌두 농업","width":0.3721461187214612},{"width":0.07534246575342467,"height":0.017713365539452464,"y":0.9082125604569243,"x":0.0593607310644977,"text":"16일차"},{"x":0.5205479435502284,"width":0.3812785388127854,"text":"카스트로, 방글라데시와 파키스탄에도 일부","height":0.02254428341384862,"y":0.890499194659152},{"y":0.8663446054951691,"text":"거주합니다. 우타르프라데시(500만 명 이상),","height":0.02254428341384862,"width":0.3972602739726028,"x":0.5228310527111871},{"x":0.05479452094748858,"text":"인도","width":0.047945205479452045,"height":0.017713365539452464,"y":0.851851851918948},{"x":0.5228310540410958,"text":"비하르, 마디아프라데시, 펀자브, 자르칸드,","y":0.8405797101449275,"width":0.3812785388127854,"height":0.02254428341384873},{"x":0.5205479487899544,"text":"아삼, 서벵골 일부 지역에서 거주합니다.","height":0.02254428341384862,"width":0.35844748858447484,"y":0.8148148148470209},{"text":"쿠르미는 인도에서 가장 오래된 농업","y":0.7938808372670807,"height":0.019323671497584627,"width":0.32191780821917804,"x":0.5205479429060667},{"x":0.04566210098934552,"width":0.2420091324200913,"text":"쿠르미","height":0.06441223832528187,"y":0.77616747208803},{"y":0.7655936692629726,"text":"카스트입니다.","x":0.5202701875758186,"height":0.02275790953213852,"width":0.13297560879084613},{"width":0.2990867579908676,"text":"이들은 여러 방언을 가진 쿠르말리","y":0.7439613527375202,"x":0.5228310517237443,"height":0.019323671497584405},{"height":0.019323671497584627,"x":0.518264837195586,"y":0.7181964572463768,"width":0.35844748858447495,"text":"(Kurmali)어를 사용하는데 서벵골에서는"},{"y":0.6892109500268384,"text":"방글라 문자, 지르칸드에서는 데바나가리","width":0.36073059360730597,"x":0.5205479421993913,"height":0.02254428341384873},{"y":0.6634460545088567,"height":0.024154589371980673,"x":0.5228310471004566,"text":"문자, 오디샤에서는 오디아 문자를 사용합니다.","width":0.41324200913242015},{"x":0.5205479452815829,"text":"쿠르미 사람들은 힌두교도입니다.","width":0.3013698630136987,"height":0.02254428341384851,"y":0.6151368761943103},{"height":0.02254428341384873,"y":0.5893719806226516,"text":"그들은 정의와 덕행, 법(dharma)올 상징하는","x":0.5205479419140031,"width":0.39497716894977164},{"text":"Photo Source: Wikime dia","x":0.255707764925799,"y":0.5748792271135266,"width":0.1894977168949772,"height":0.011272141706924366},{"height":0.019323671497584405,"x":0.5205479418759513,"text":"이상적인 왕이자 완전한 인간인 라마(Ram)과","width":0.3995433789954338,"y":0.5668276971819646},{"y":0.5410628018679549,"height":0.019323671497584627,"width":0.38584474885844755,"x":0.520547941347032,"text":"힌두교 주요 신 중 하나인 비슈누(Vishnu)를"},{"x":0.5205479417123289,"text":"숭배합니다. 칼리(Kali), 두르가(Duga),","height":0.02254428341384862,"y":0.5136876005797102,"width":0.34931506849315064},{"width":0.25114155251141557,"x":0.05022830840943687,"text":"• 인구: 15,630,000명","height":0.020933977455716568,"y":0.5072463767444981},{"height":0.017713365539452575,"y":0.4879227050925925,"x":0.0981735142123288,"text":"(2025년 8월 기준)","width":0.1689497716894977},{"x":0.5205479413926941,"y":0.4879227052818035,"width":0.3812785388127854,"height":0.02254428341384862,"text":"하누만(Hanuman) 등 다른 신들도 섬기며,"},{"text":"• 종교: 힌두교","y":0.4605475039222452,"x":0.05022830932811482,"height":0.017713365539452575,"width":0.1643835616438356},{"width":0.24828765381416773,"text":"디왈리(Diwall), 홀리(Hol),","x":0.5228310515601217,"y":0.4621578100107354,"height":0.024154589371980673},{"text":"시바라트리(Shivaratri), 두세라(Dussehra)와","x":0.5205479453957382,"height":0.024154589371980673,"width":0.3972602739726028,"y":0.43639291445249606},{"y":0.4251207726892109,"height":0.025764895330112725,"text":"• 언어: 쿠르말리(지역별로 방글라,","width":0.36301369863013705,"x":0.050228314086757944},{"text":"같은 주요 힌두 축제를 기념합니다.","y":0.41384863106548575,"height":0.020933977455716568,"x":0.5205479477739726,"width":0.31278538812785384},{"y":0.40579710143317227,"text":"데바나가리, 오디아 문자 사용)","x":0.07077625251141559,"width":0.319634703196347,"height":0.024154589371980673},{"y":0.38003220587761677,"x":0.05022831132990868,"height":0.019323671497584516,"width":0.2123287671232877,"text":"• 기독교인: 0.01%"},{"text":"대부분 힌두교를 따르기에 이들 중","y":0.3655394524154588,"x":0.5205479426750381,"height":0.019323671497584627,"width":0.30365296803652964},{"text":"• 성경: 신약 있음, 완역 있음","width":0.2990867579908676,"y":0.34782608678398896,"height":0.024154589371980673,"x":0.05022831126875405},{"x":0.5202768824570688,"width":0.24257661653980267,"text":"기독교인은 매우 적습니다.","height":0.024433659662563056,"y":0.3364318156657691},{"width":0.34018264840182644,"height":0.02093397745571668,"text":"여호수아 프로젝트(Joshua Project)에","x":0.520547941803653,"y":0.3140096617552335},{"y":0.2866344604938271,"text":"따르면, 쿠르미 공동체는 강한 힌두교","x":0.5205479424657534,"width":0.3287671232876712,"height":0.02254428341384873},{"y":0.2640901772141707,"width":0.4018264840182648,"x":0.5205479485540334,"text":"정체성을 가지고 있으며 힌두교에 머무르라는","height":0.019323671497584627},{"y":0.23671497584541068,"text":"사회적 압박을 느낍니다.","x":0.5205479474429223,"width":0.22374429223744297,"height":0.02254428341384862}]