[{"height":0.01449275362318836,"y":0.9613526570853462,"text":"74 기타 아시아 - 말레이시아 말레이","width":0.2831050228310502,"x":0.03196347315068491},{"text":"말레이시아 인구의 60%는 말레이입니다.","width":0.36757990867579915,"height":0.020933977455716568,"x":0.5228310532914763,"y":0.9178743961486849},{"text":"27일차","width":0.0776255707762557,"y":0.9033816426865271,"x":0.059360730898021304,"height":0.020933977455716568},{"width":0.3082191780821918,"text":"비말레이계 말레이시아인 중 9%는","x":0.5228310524298759,"y":0.8953301127904302,"height":0.019323671497584516},{"y":0.8679549112453033,"width":0.3538812785388128,"text":"기독교인이지만, 말레이인의 복음화율은","x":0.5228310497526636,"height":0.02254428341384862},{"text":"기타 아시아","x":0.05455662415992384,"y":0.8462657650153976,"height":0.020834008276750526,"width":0.11919725322287919},{"y":0.8454106280308259,"width":0.2009132420091324,"height":0.020933977455716568,"x":0.5205479466405741,"text":"0.08%에 불과합니다."},{"x":0.5205479476170091,"height":0.019323671497584516,"y":0.7987117553140097,"text":"15세기에 말레이인들 사이에 이슬람이 자리","width":0.38584474885844744},{"y":0.7729468598228664,"text":"말레이시아","x":0.043378993974233525,"height":0.06441223832528176,"width":0.40867579908675805},{"x":0.5205479443574691,"width":0.34246575342465757,"height":0.020933977455716568,"text":"잡았습니다. 16세기부터 말레이시아는","y":0.7729468597538532},{"text":"포르투갈, 네덜란드, 영국의 식민지가 되었지만","height":0.024154589371980673,"x":0.520547944805936,"y":0.7455716584138486,"width":0.41324200913242004},{"height":0.019323671497584516,"width":0.36073059360730597,"y":0.7262479870370371,"text":"네덜란드와 영국은 정치적 긴장을 피하기","x":0.5205479421993913},{"height":0.06441223832528176,"text":"말레이","y":0.7053140099302201,"x":0.04337899600456621,"width":0.24200913242009134},{"width":0.34246575342465746,"height":0.019323671497584516,"text":"위해 말레이인에게 복음을 전하는 것을","x":0.5205479430650686,"y":0.7020933976650564},{"height":0.024154589371980673,"x":0.5228310506523157,"y":0.6731078903266621,"width":0.35159817351598166,"text":"억제했습니다. 그 결과, 선교는 비말레이"},{"y":0.6489533010869565,"height":0.024154589371980673,"width":0.38812785388127846,"text":"인에게(중국인, 인도인, 토착민> 집중되었고,","x":0.5205479419710808},{"text":"말레이인은 복음에서 소외되었습니다.","height":0.02254428341384862,"x":0.5228310530060882,"y":0.6264090175254965,"width":0.3378995433789954},{"x":0.5205479427266797,"y":0.6054750401886358,"width":0.3470319634703196,"height":0.019323671497584516,"text":"이는 교회가 그들을 돌보지 않는 것처럼"},{"text":"나타났습니다.","width":0.13065118659032537,"y":0.5773371918283858,"height":0.02406957721556635,"x":0.522573951334044},{"height":0.02254428341384862,"y":0.5297906602455716,"text":"말레이시아는 정치적으로 독립했지만,","x":0.5228310523401827,"width":0.3378995433789954},{"text":"말레이인과 이슬람의 관계는 계속되었습니다.","height":0.02254428341384862,"x":0.5228310535388127,"width":0.40182648401826493,"y":0.5056360706655931},{"width":0.3356164383561644,"text":"법적으로 말레이인이라는 정의에는 무","x":0.5228310526255707,"y":0.48470209346675863,"height":0.019323671497584516},{"x":0.2671232904109588,"y":0.46698872802751257,"text":"Photo Source; PiXabay","width":0.16894977168949776,"height":0.012882447281129528},{"height":0.024154589371980673,"x":0.5205479415981735,"y":0.4589371979549114,"text":"슬림이어야 한다는 조건이 포함됩니다.\"","width":0.36073059360730597},{"x":0.5222707656203256,"width":0.40065406555454486,"text":"말레이 세계, 무슬림 세계\",\" 이슬람이 없으면","y":0.4292448973786215,"height":0.03230883034723009},{"y":0.41062801915113867,"x":0.08675799163405086,"width":0.2351598173515982,"text":"인구: 약 14,258,000명","height":0.024154589371980784},{"x":0.5228310495053272,"y":0.4090177131642512,"height":0.024154589371980673,"width":0.3926940639269406,"text":"말레이가 아니다.\"와 같은 구호는 말레이인의"},{"text":"(2025년 8월 기준)","x":0.08447488705153296,"width":0.1689497716894977,"height":0.01610305958132041,"y":0.3961352657694963},{"text":"이슬람에 대한 깊은 헌신올 보여줍니다.","x":0.522831053675799,"width":0.34931506849315064,"height":0.02254428341384862,"y":0.38486312376811593},{"y":0.36714975854612375,"x":0.043378996624266135,"height":0.019323671497584627,"width":0.16666666666666669,"text":"• 종교: 이슬람"},{"width":0.1872146118721461,"x":0.043378995509893443,"height":0.020933977455716568,"y":0.3365539450751477,"text":"• 언어: 말레이어"},{"height":0.019323671497584516,"x":0.5228310523338408,"width":0.37899543378995426,"y":0.33977455723743066,"text":"말레이시아 법은 무슬림에게 복음을 전하는"},{"text":"• 기독교인: 0.08% (복음주의)","x":0.04337899714611868,"y":0.30756843776167475,"height":0.019323671497584516,"width":0.32420091324200906},{"width":0.3744292237442922,"text":"것을 금지하며, 징역과 태형과 같은 처벌올","x":0.5205479478799738,"height":0.024154589371980673,"y":0.3107890500230044},{"width":0.410958904109589,"height":0.02254428341384862,"x":0.5228310495759948,"y":0.2882447663446054,"text":"받을 수 있습니다. 기독교로 개종한 말레이인은"},{"width":0.15296803652968038,"x":0.034246576872146085,"height":0.017713365539452464,"y":0.280193236795491,"text":"• 성경: 있음"},{"height":0.024154589371980673,"y":0.2624798712882448,"x":0.5228310539041096,"text":"낙인 찍히고, 이슬람으로 돌아오도록 압박","width":0.36757990867579904},{"height":0.02254428341384862,"y":0.23993558757380562,"width":0.35159817351598166,"text":"받으며 재활센터에 보내질 수 있습니다.","x":0.5205479480974124},{"text":"이런 정치적 사회적 상황은 말레이인이 복음에","width":0.40410958904109584,"height":0.02093397745571668,"y":0.19323671489533,"x":0.5205479411643836},{"text":"마음을 열기 어렵게 만들며, 말레이시아","x":0.5228310514079147,"width":0.3470319634703196,"height":0.024154589371980784,"y":0.16586151348631228},{"x":0.52054794173516,"y":0.1449275364412238,"text":"기독교인들이 자유롭게 신앙을 나누는 데","width":0.36073059360730586,"height":0.020933977455716568},{"width":0.34931506849315075,"text":"장애가 됩니다. 중국계 말레이시아 목사","x":0.5205479446673189,"height":0.02254428341384873,"y":0.11916264074074057},{"height":0.020933977455716568,"text":"Raymond Koh는 말레이인에게 복음을 전하는","x":0.5205479468721461,"y":0.09661835769726246,"width":0.41324200913242015},{"y":0.0692431563123993,"width":0.3721461187214612,"height":0.024154589371980673,"x":0.5205479489269406,"text":"과정에서 2017년 2월 납치되었고, 가족은"},{"text":"아직도 그의 행방을 알지 못합니다.","y":0.04830917867954909,"x":0.5205479420776257,"width":0.31278538812785395,"height":0.019323671497584516}]