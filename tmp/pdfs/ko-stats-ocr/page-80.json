[{"width":0.2511415525114155,"text":"80 기타 아시아 - 파타니 말레이","height":0.01449275362318836,"y":0.9613526570853462,"x":0.03196347283105021},{"y":0.9194847021900161,"text":"파타니 말레이는 14세기부터 이슬람을","height":0.019323671497584516,"x":0.520547948630137,"width":0.34246575342465757},{"y":0.9013356311025412,"width":0.08028832527056132,"height":0.018584776615750975,"text":"30일차","x":0.0705864315409637},{"height":0.02254428341384862,"text":"받아들인 말레이 무슬림의 후손입니다.","x":0.5228310531012177,"y":0.8921095008051529,"width":0.3447488584474885},{"text":"그들의 이슬람 신앙은 불교 국가인 태국에서","y":0.8695652172992869,"x":0.5205479424494455,"height":0.019323671497584516,"width":0.38584474885844755},{"x":0.06387608153240777,"height":0.019630888234014043,"y":0.8436467136217689,"text":"기타 아시아","width":0.11654007271544577},{"width":0.3561643835616438,"height":0.019323671497584516,"y":0.8438003219921785,"text":"파타니인들에게 뚜렷한 정체성을 부여해","x":0.5205479426614481},{"y":0.816425120598497,"text":"왔습니다. 그들은 매우 결속력이 강한","x":0.5205479439687977,"width":0.33105022831050224,"height":0.020933977455716568},{"y":0.7906602252818036,"x":0.5205479442106979,"width":0.363013698630137,"height":0.02254428341384862,"text":"공동체이며, 말레이인이라는 정체성에 큰"},{"height":0.06441223832528176,"width":0.2420091324200913,"text":"파타니","y":0.769726248071467,"x":0.052511416101326355},{"width":0.24200913242009137,"height":0.02254428341384862,"y":0.7665056362587225,"x":0.5205479457762556,"text":"자부심을 가지고 있습니다."},{"y":0.7133655392512077,"text":"대부분은 태국 남부의 세 개 주(파타니, 얄라,","x":0.5228310534627092,"width":0.3926940639269406,"height":0.024154589371980784},{"height":0.06441223832528176,"y":0.702093397993311,"width":0.23972602739726026,"text":"말레이","x":0.05479451983667019},{"width":0.38584474885844744,"x":0.5228310503234399,"text":"나라티왓)에 거주하며, 이 지역 인구의 80%","height":0.02415458937198056,"y":0.6876006439210951},{"text":"이상을 차지합니다. 일부는 송클라 주와","height":0.02254428341384851,"y":0.6650563605206656,"width":0.3470319634703196,"x":0.5228310502283106},{"x":0.522831050293542,"text":"방콕에도 거주합니다. 태국에서 나라티왓은","width":0.3789954337899544,"height":0.02093397745571668,"y":0.6409017711870255},{"x":0.5205479444444444,"text":"가장 가난한 주 중 하나입니다.","height":0.02254428341384851,"width":0.273972602739726,"y":0.6151368761943103},{"y":0.5636070853692201,"width":0.3561643835616438,"text":"많은 파타니 말레이는 시골 마을에 살며,","x":0.5228310527723419,"height":0.02254428341384873},{"width":0.39774660432719755,"y":0.5342121037507933,"text":"어업, 콜라에'라 불리는 전통 배를 그리거나,","x":0.5224145914260168,"height":0.030014987153131556},{"width":0.34246575342465757,"height":0.02254428341384873,"y":0.5136876006709608,"x":0.5228310530821917,"text":"고무 채취, 과일과 채소 재배를 합니다."},{"text":"파타니 말레이 민족혁명전선 (BRN)과 관련된","x":0.5205479423515983,"height":0.019323671497584627,"width":0.3995433789954338,"y":0.4911433171612607},{"text":"지속적인 불안과 무장 갈등으로 인해 정부의","height":0.019323671497584627,"x":0.5205479484398782,"y":0.4669887279388083,"width":0.3881278538812786},{"x":0.5228310521917808,"text":"억압을 받아왔습니다.","width":0.19634703196347036,"height":0.02254428341384873,"y":0.4380032206119162},{"text":"19세기 초, 서구 선교 운동이 태국 전역에서","x":0.5205479479452054,"width":0.3835616438356164,"height":0.02254428341384873,"y":0.3880837360018403},{"text":"시작되었고, 선교사들은 국경 지역에서 의료,","width":0.3972602739726028,"height":0.024154589371980673,"y":0.3607085346618357,"x":0.5205479485159816},{"height":0.025764895330112725,"width":0.38584474885844744,"y":0.3349436395491143,"x":0.5228310526712328,"text":"교육, 종교 분야에 기여를 했습니다. 1953년"},{"height":0.009661835748792202,"text":"Photo Source: Flickr","x":0.2899543398116438,"y":0.30917874404186796,"width":0.15296803652968033},{"width":0.41552511415525106,"text":"한 선교사가 얄라주에 들어와 사역을 시작했고,","y":0.31078904967793874,"height":0.024154589371980784,"x":0.5205479493150684},{"x":0.5205479426027397,"height":0.020933977455716568,"width":0.3881278538812786,"y":0.28985507267310784,"text":"1960~70 년대에는 많은 선교사들이 파타니"},{"text":"지역에서 사역했습니다. 이런 지속적인 선교","x":0.5205479479778212,"y":0.26247987127904304,"height":0.020933977455716568,"width":0.3881278538812786},{"width":0.2579908675799087,"x":0.052511416780821905,"text":"• 인구: 약 1,567,000명","height":0.020933977455716568,"y":0.25120772925925927},{"width":0.1643835616438356,"height":0.017713365539452464,"text":"(2025년 8월 기준)","y":0.23510466966586152,"x":0.09589040918949775},{"width":0.3470319634703196,"x":0.5205479423135464,"height":0.024154589371980784,"text":"노력에도 불구하고, 파타니 말레이는 왜","y":0.23510466984702094},{"height":0.02254428341384862,"x":0.520547942214612,"y":0.21256038624798712,"width":0.4178082191780822,"text":"여전히 최전방 미전도 종족으로 남아 있을까요?"},{"y":0.20554485821681023,"text":"• 종교: 이슬람","width":0.16692660606070742,"height":0.020472280837103507,"x":0.05009834140120018},{"width":0.2602739726027397,"y":0.17713365546162108,"text":"• 언어: 파타니 말레이어","x":0.050228312671232844,"height":0.020933977455716568},{"width":0.2146118721461187,"x":0.050228312290715345,"text":"• 기독교인: 0.01%","height":0.017713365539452464,"y":0.14814814824208278},{"height":0.02254428341384862,"x":0.05022831351598166,"text":"• 성경: 신약 있음, 완역 없음","y":0.1159420291143316,"width":0.3013698630136986}]