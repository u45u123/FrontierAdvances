[{"text":"26 아랍 - 알제리 아랍어 사용 집단","width":0.2648401826484018,"height":0.01449275362318847,"x":0.03196347252663618,"y":0.961352657071927},{"width":0.31506849315068497,"text":"알제리의 아랍 인구는 7세기 이슬람","height":0.019323671497584516,"x":0.5205479432363014,"y":0.9194847020128825},{"height":0.017713365539452464,"y":0.9033816425925926,"width":0.0639269406392694,"x":0.061643836073059365,"text":"6일차"},{"y":0.8921095010305958,"width":0.33105022831050235,"height":0.02254428341384862,"x":0.520547946826484,"text":"정복자들에 그 뿌리를 두고 있습니다."},{"height":0.019323671497584516,"text":"무함마드 선지자의 침략으로 아라비아 반도는","x":0.5205479418569255,"y":0.8695652173107891,"width":0.4018264840182648},{"text":"아랍문화권","x":0.0547441502920534,"y":0.8452759105983061,"width":0.11197288722208101,"height":0.021203412717859083},{"x":0.520547946826484,"text":"통합되었고, 아랍이슬람 제국은 급속도로","y":0.8405797103864734,"width":0.36757990867579915,"height":0.024154589371980784},{"x":0.520547946651446,"width":0.17808219178082196,"height":0.020933977455716568,"text":"확장되어 갔습니다.","y":0.816425120598497},{"y":0.7697262482171613,"x":0.043378995898564914,"width":0.2442922374429224,"height":0.06441223832528176,"text":"알제리"},{"x":0.5205479474315069,"y":0.7681159421095007,"width":0.3561643835616438,"height":0.019323671497584627,"text":"아랍인들이 정복하기 전의 북아프리카는"},{"x":0.5228310501141553,"width":0.33333333333333326,"text":"베르베르(Berber, 이마지겐) 사람들이","y":0.7391304345813206,"height":0.02415458937198056},{"width":0.3378995433789954,"height":0.024154589371980673,"x":0.520547944018265,"text":"거주했으며, 이들은 아프로아시아어족","y":0.7133655392109501},{"y":0.6985027510509656,"x":0.04259625227084007,"width":0.32804950731530036,"height":0.06998322589769834,"text":"아랍어권"},{"x":0.518264837671233,"text":"(Afroasiatic) 언어를 사용하고 구별되는","width":0.35159817351598166,"y":0.6924315619277663,"height":0.019323671497584405},{"x":0.5228310521261414,"width":0.30365296803652975,"text":"문화 정체성을 가지고 있었습니다.","height":0.02254428341384851,"y":0.6650563607286635},{"text":"시간이 지나면서 이슬람의 영향으로","width":0.317351598173516,"height":0.02093397745571668,"x":0.5205479468987824,"y":0.6425120774691357},{"text":"점차적으로 아랍화(아랍어•문화 수용)가","x":0.5205479477005871,"y":0.6167471820335864,"width":0.34931506849315064,"height":0.019323671497584627},{"text":"진행되었습니다.","width":0.15296803652968027,"y":0.5893719806763285,"x":0.5205479467351599,"height":0.02254428341384873},{"text":"알제리 아랍어는 베르베르어의 어휘와","width":0.3378995433789955,"height":0.019323671497584627,"x":0.5205479480213089,"y":0.5410628020128825},{"width":0.38584474885844744,"height":0.024154589371980784,"y":0.5120772944847021,"text":"문장구조가 포함되어 있으며, 다른 언어에서","x":0.5205479463280062},{"y":0.48953301127214166,"height":0.02254428341384873,"text":"유래한 단어들도 함께 쓰입니다.","width":0.28767123287671226,"x":0.5205479476027397},{"x":0.520547948630137,"y":0.46376811594202894,"width":0.410958904109589,"height":0.02254428341384873,"text":"고전 아랍어와 베르베르어도 함께 사용됩니다."},{"height":0.019323671497584516,"width":0.30593607305936077,"y":0.41545893727858285,"x":0.5205479471175799,"text":"특히 카빌족(Kabyle Berbers)내의"},{"text":"기독교는 심각한 박해를 받고 있으며,","x":0.5205479475864319,"width":0.33333333333333337,"y":0.3864734299861974,"height":0.024154589371980673},{"width":0.3447488584474886,"height":0.020933977455716568,"text":"대부분의 복음주의 교회가 정부에 의해","x":0.5205479486529679,"y":0.36392914665056364},{"text":"폐쇄되었습니다.","width":0.15296803652968038,"height":0.02254428341384862,"x":0.5251141565258752,"y":0.3365539452764359},{"x":0.15981735440639266,"text":"Photo Source: Basel 2019- Wikimedia","y":0.30917874402576495,"height":0.009661835748792313,"width":0.2808219178082192},{"text":"인구: 36,947,700명","y":0.25603864746376814,"x":0.08904109764079146,"width":0.21004566210045664,"height":0.024154589371980673},{"width":0.228310502283105,"height":0.02254428341384862,"y":0.23510466982286649,"text":"(8개국, 2025년 8월 기준)","x":0.08675798858447492},{"height":0.017713365539452464,"width":0.1643835616438356,"x":0.04566210182648399,"text":"• 종교: 이슬람","y":0.21095008060923248},{"x":0.04566209849695592,"height":0.020933977455716568,"width":0.2351598173515982,"y":0.18035426721685455,"text":"• 언어: 알제리 아랍어"},{"text":"• 기독교인: 0.1% 미만","width":0.2465753424657534,"height":0.019323671497584627,"x":0.04337899296803659,"y":0.15136875996779375},{"text":"• 성경: 신약 있음, 완역 없음","x":0.045662101331811256,"y":0.11916264071390226,"height":0.02254428341384862,"width":0.2968036529680365}]