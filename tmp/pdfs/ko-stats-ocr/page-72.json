[{"width":0.31278538812785384,"height":0.01449275362318836,"text":"72 기타 아시아 - 이란 최전방 미전도종족","x":0.03196347344748854,"y":0.9613526570853462},{"x":0.5205479474315068,"height":0.02254428341384862,"y":0.9162640899892647,"width":0.3538812785388128,"text":"루리족은 주로 이란 서부와 남서부, 특히"},{"text":"26일차","x":0.05936072994672756,"height":0.017713365539452464,"width":0.0776255707762557,"y":0.9033816424449812},{"y":0.8904991949505406,"width":0.39497716894977175,"height":0.024154589371980673,"x":0.520547948026745,"text":"자그로스 산맥 주변 지역에 거주하며, 일부는"},{"text":"이라크에 살고 있습니다. 유목민으로서 목자로","width":0.40410958904109584,"y":0.8663446052495974,"x":0.5228310505251141,"height":0.02254428341384862},{"y":0.8468259090316915,"x":0.05244821510547123,"height":0.019713721221579772,"text":"기타 아시아","width":0.118847860048895},{"y":0.8405797099033816,"x":0.5205479431963471,"height":0.024154589371980784,"text":"일하며, 1년에 6~8 개월 동안 이동하며","width":0.34246575342465757},{"width":0.38812785388127846,"height":0.020933977455716568,"y":0.816425120598497,"text":"검은 염소털 텐트에서 생활합니다. 겨울에는","x":0.5205479470700153},{"x":0.5228310529870625,"height":0.02254428341384862,"y":0.7906602252549652,"width":0.3356164383561644,"text":"몇 달 동안 영구 거주지에서 지냅니다."},{"text":"이란의","width":0.2146118721461187,"height":0.056360708534621606,"y":0.777777777703972,"x":0.043378994539573834},{"x":0.5205479424494455,"height":0.020933977455716568,"y":0.7681159419484702,"text":"일부는 정착하여 목축 대신 농업을 선호하며","width":0.38584474885844755},{"width":0.2648401826484018,"text":"밀과 보리가 주요 작물입니다.","x":0.5228310521200261,"y":0.742351046710375,"height":0.020933977455716568},{"y":0.7165861514492753,"height":0.06119162640901776,"x":0.043378995993150676,"width":0.22374429223744294,"text":"최전방"},{"y":0.6924315622061191,"width":0.34246575342465757,"height":0.020933977455716568,"text":"루리족은 목자의 성공이 개인의 자질과","x":0.5205479431050228},{"text":"행운에 달려 있다고 믿습니다. 가장 많은","x":0.5205479469406392,"width":0.3561643835616438,"y":0.6650563604830918,"height":0.02254428341384862},{"text":"미전도 종족","x":0.0455382716835969,"height":0.058791714973879694,"width":0.38380930303982946,"y":0.658204786370163},{"x":0.5205479486681888,"width":0.41552511415525106,"height":0.020933977455716568,"y":0.6409017713499732,"text":"가축과 돈을 가진 사람들이 사회를 지배합니다."},{"text":"상류층은 하류층을 고용해 가축을 돌보며,","width":0.3721461187214612,"y":0.6135265698470209,"x":0.5205479482686453,"height":0.024154589371980784},{"x":0.522831053675799,"y":0.5909822866183575,"height":0.020933977455716568,"width":0.3447488584474886,"text":"대부분의 루리족은 하류층에 속합니다."},{"x":0.5205479424820614,"y":0.5410628018403496,"width":0.3812785388127854,"text":"루리족은 시아파 무슬림으로 비교적 단순한","height":0.019323671497584627},{"height":0.019323671497584627,"x":0.5228310523972601,"y":0.5169082126409017,"width":0.3470319634703197,"text":"종교 의례를 중심으로 한 매우 실용적인"},{"x":0.5205479479778212,"text":"신앙 체계를 받아들였습니다. 그들은 다양한","width":0.3881278538812786,"y":0.4895330113756613,"height":0.02093397745571668},{"x":0.5228310530821917,"width":0.3995433789954338,"height":0.019323671497584627,"text":"이슬람 공동체의 창시자들에게 헌정된 성소를","y":0.46698872792730606},{"width":0.27853881278538817,"x":0.15525114223744288,"y":0.4412238323671498,"text":"Photo Source; Shadegan - Wikimedia","height":0.012882447665056418},{"width":0.33333333333333326,"y":0.43639291445249606,"height":0.024154589371980673,"text":"사랑하며, 이를 순례지로 사용합니다.","x":0.5205479439497718},{"height":0.011272141706924255,"text":"Licensed under CC BY-SA 4.0","x":0.20776255425228313,"y":0.42834138480273753,"width":0.226027397260274},{"text":"이러한 성소들에 치유의 능력이 있다고 믿기","width":0.38584474885844755,"height":0.019323671497584516,"x":0.520547941347032,"y":0.41545893713365534},{"x":0.520547943150685,"width":0.3926940639269406,"text":"때문에, 육체적:정신적 질병을 가진 사람들은","y":0.38647342975040266,"height":0.024154589371980673},{"height":0.024154589371980673,"x":0.04337899210045667,"width":0.33333333333333337,"y":0.3735909822383252,"text":"루리족, 이란의 최전방 미전도 종족"},{"width":0.3555935724685181,"x":0.520547948675799,"height":0.02254428341384862,"text":"치유를 기대하며 매년 이곳 찾습니다.","y":0.3623188403542673},{"width":0.4383561643835616,"y":0.32689210943179214,"text":"• 인구: 약 2,588,000명 (2025년 8월 기준)","x":0.0433789923026745,"height":0.02254428341384862},{"height":0.020933977455716568,"x":0.5205479423026745,"y":0.3140096617552335,"text":"루리족 가운데 알려진 기독교인은 거의 없으며","width":0.40639269406392686},{"x":0.04328076296949038,"text":"• 종교: 이슬람","width":0.1645800272623698,"y":0.2990921197787898,"height":0.02017324711773516},{"text":"그들의 언어로 된 일부 전도 자료만 있습니다.","width":0.4018264840182648,"x":0.5205479418569255,"y":0.28824476643854,"height":0.020933977455716568},{"width":0.16666666666666666,"height":0.020933977455716568,"y":0.2705314007568438,"x":0.043378995730593596,"text":"• 언어: 루리어"},{"width":0.26712328767123283,"height":0.020933977455716568,"text":"• 기독교인: 0.01% 미만","y":0.24154589389694037,"x":0.04337899810502281},{"text":"• 성경: 신약","y":0.21200458466694672,"x":0.04323306440790374,"width":0.14412747561659445,"height":0.020435274895070688}]