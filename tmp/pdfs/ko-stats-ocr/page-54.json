[{"x":0.0319634717351598,"text":"54 인도- 사타니","y":0.9613526570853462,"width":0.1415525114155251,"height":0.01449275362318836},{"width":0.3789954337899544,"text":"사타니는 텔루구 종족 중 하나로, 이 종족은","height":0.02254428341384862,"x":0.5205479466731897,"y":0.9162640900161031},{"text":"19일차","x":0.05936073012271691,"height":0.019323671497584516,"y":0.90177133647343,"width":0.07534246575342465},{"height":0.024154589371980673,"width":0.4018264840182648,"text":"남아시아 사람들이며 인도에서만 존재합니다.","y":0.8904991950483092,"x":0.522831052435312},{"y":0.8470209338969403,"text":"인도","x":0.05479452022178734,"height":0.017713365539452575,"width":0.045662100456621},{"width":0.36757990867579904,"y":0.8438003219921785,"height":0.019323671497584516,"text":"일부는 전통적인 직업인 사원의 사제 또는","x":0.5205479425799087},{"width":0.35844748858447495,"y":0.8164251207058508,"x":0.520547942218417,"height":0.020933977455716568,"text":"섬기는 사람 등 종교 전문가로 일합니다."},{"x":0.5205479420852359,"height":0.019323671497584516,"width":0.3744292237442923,"y":0.7938808372785829,"text":"힌두교 바이슈나바파에 속하며 라마누자의"},{"height":0.0628019323671497,"width":0.2420091324200913,"text":"사타니","x":0.04337899644216132,"y":0.7729468599906065},{"x":0.5205479445205479,"width":0.39269406392694073,"height":0.024154589371980673,"text":"가르침올 따르고, 종교 의식은 공동체 출신의","y":0.7648953299114332},{"x":0.5205479425799087,"width":0.36757990867579904,"text":"종교 전문가가 모두 집행합니다. 사타니는","y":0.7423510466183575,"height":0.020933977455716568},{"width":0.37671232876712324,"x":0.5228310482686453,"y":0.7133655392512077,"height":0.024154589371980784,"text":"비슈누, 락슈미, 그리고 지역 신올 숭배하며"},{"y":0.6924315619323672,"x":0.5205479413242009,"text":"이들 가운데 예수 그리스도를 따르는 사람은","width":0.3881278538812786,"height":0.019323671497584516},{"width":0.3926940639269406,"y":0.665056360547504,"x":0.5205479450097847,"height":0.02254428341384862,"text":"알려진 바 없습니다. 그러나 자신을 드러내지"},{"text":"않은 신자가 있을 가능성은 있습니다.","y":0.6409017713667472,"width":0.33105022831050224,"height":0.020933977455716568,"x":0.5205479472745433},{"text":"그리스도를 받아들이고 따르는","y":0.5925925925235795,"width":0.271689497716895,"x":0.5205479432648402,"height":0.019323671497584516},{"height":0.019323671497584405,"y":0.5668276973544975,"text":"힌두교인은 큰 불이익과 심지어 적대감을","x":0.5228310528049576,"width":0.36073059360730586},{"x":0.5205479457049087,"text":"경험할 가능성이 큽니다. 공동체 안에서의","width":0.36757990867579915,"height":0.02093397745571668,"y":0.5394524958433977},{"y":0.5120772944847021,"height":0.024154589371980784,"x":0.52054794815449,"width":0.35844748858447495,"text":"우정과 지위를 잃는 일이 흔히 일어나며,"},{"width":0.33105022831050224,"text":"이는 감당하기 매우 어려운 일입니다.","y":0.4895330112855609,"height":0.020933977455716457,"x":0.5228310529870623},{"y":0.4653784216908212,"width":0.31506849315068497,"height":0.02093397745571668,"x":0.5228310478082193,"text":"이들에게는 어떤 대가를 치르더라도"},{"text":"그리스도를 받아들일 수 있는 영적 힘이","width":0.34931506849315064,"x":0.5205479481164383,"y":0.43961352663714437,"height":0.020933977455716568},{"text":"필요합니다.","x":0.5200383337921788,"width":0.11517447205983333,"height":0.023896242685364166,"y":0.4123674981989395},{"y":0.3574879228126677,"x":0.0913242067351596,"text":"mage generated by Al using Microsoft Copilot","width":0.3493150684931507,"height":0.012882447665056307},{"x":0.04337899437785392,"width":0.39041095890410954,"y":0.2930756840982287,"text":"• 인구: 489,000명 (2025년 8월 기준)","height":0.02254428341384862},{"width":0.3219178082191781,"text":"• 종교: 힌두교 (바이슈나바파)","y":0.26409017687600644,"x":0.04337899586757993,"height":0.025764895330112725},{"y":0.23993558797101444,"x":0.0433789960958904,"width":0.1894977168949772,"text":"• 언어: 텔루구어","height":0.020933977455716568},{"x":0.04337899326484022,"width":0.21689497716894976,"y":0.21095008043478258,"height":0.017713365539452464,"text":"• 기독교인: 0.00%"},{"x":0.045662101484018267,"text":"• 성경: 신약 있음, 완역 있음","height":0.02254428341384873,"y":0.17713365516908208,"width":0.2945205479452055}]