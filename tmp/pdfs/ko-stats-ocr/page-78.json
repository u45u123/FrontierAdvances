[{"width":0.228310502283105,"text":"78 기타 아시아 - 누리스타니","x":0.03196347195042398,"height":0.01449275362318836,"y":0.9613526570853462},{"x":0.5205479480756686,"height":0.019323671497584516,"width":0.4018264840182648,"text":"누리스타니'는 아프가니스탄 북동부 누리스탄","y":0.9194847021854152},{"x":0.07077625624048706,"width":0.07762557077625573,"height":0.019323671497584627,"text":"29일차","y":0.9001610304347826},{"text":"주와 파키스탄 북부 지역의 외딴 지역에 사는","width":0.39269406392694073,"y":0.8937198066942719,"x":0.5205479424005218,"height":0.019323671497584627},{"y":0.8679549112587225,"width":0.3812785388127854,"text":"사람들을 가리킵니다. 그들은 누리스타니어","x":0.5205479453006088,"height":0.020933977455716568},{"text":"기타 아시아","width":0.11655892846791167,"height":0.01968837974536053,"x":0.06386665365537629,"y":0.8436179674869707},{"x":0.5205479468525765,"width":0.34018264840182655,"text":"계열의 다양한 언어를 사용하며, 8개의","y":0.840579709983897,"height":0.02254428341384862},{"width":0.3561643835616438,"text":"민족으로 구성됩니다. 아슈쿠니-와마이,","height":0.02254428341384862,"y":0.8148148148505994,"x":0.5228310522070015},{"x":0.5228310522260273,"height":0.02254428341384873,"y":0.7906602254629629,"text":"나리사티, 그랑갈리, 캄비리, 말라,","width":0.32762555335754673},{"y":0.7697262480676328,"height":0.06441223832528187,"width":0.3995433789954338,"x":0.05479452165778794,"text":"누리스타니"},{"x":0.5205479440258752,"y":0.7648953303140096,"width":0.273972602739726,"text":"와이겔리, 프라수니, 트레가미.","height":0.024154589371980784},{"width":0.38584474885844755,"height":0.019323671497584627,"text":"기독교 사역자와 누리스탄 사람들 간의 초기","x":0.5205479424494455,"y":0.7439613525649873},{"text":"접촉은 간접적으로 이루어졌습니다.","height":0.02093397745571668,"x":0.5205479429223744,"width":0.3196347031963471,"y":0.7165861512882448},{"text":"당시 누리스탄은 '카피르스탄'(카피르의 땅,","y":0.6892109501163,"height":0.02254428341384851,"width":0.37899543378995426,"x":0.5228310523338408},{"text":"즉 비무슬림의 땅)으로 알려졌으며 그들의","y":0.6682769725327813,"width":0.36757990867579904,"x":0.5205479425799087,"height":0.019323671497584516},{"y":0.6392914654857755,"width":0.3744292237442922,"x":0.5205479483257229,"height":0.02254428341384873,"text":"접촉은 영국 식민지군, 특히 가이드 부대를"},{"text":"통해 이루어졌습니다. 페샤와르에서 모집된","height":0.020933977455716457,"y":0.6151368758319915,"width":0.3812785388127854,"x":0.5205479453006088},{"y":0.5925925925031311,"height":0.019323671497584516,"text":"병사들 중에 카피르스탄 출신이 있었는데","x":0.5228310482369356,"width":0.35844748858447495},{"x":0.5205479422048273,"text":"그들은 군 복무 중 기독교를 접하게 되었습니다.","width":0.4200913242009132,"height":0.020933977455716457,"y":0.565217391246837},{"x":0.5205479421042619,"height":0.019323671497584405,"width":0.3721461187214612,"text":"기독교에 대해 더 배우고 싶었던 한 병사가","y":0.5169082124798712},{"width":0.29680365296803646,"height":0.020933977455716568,"text":"기독교 사역자들에게 자신의 고향","x":0.5228310528310502,"y":0.4911433174396135},{"y":0.46376811571658616,"text":"카피르스탄올 방문하라고 부탁했습니다.","x":0.5205479487214612,"height":0.02254428341384862,"width":0.36073059360730586},{"width":0.317351598173516,"text":"1864년, 두 명의 파슈툰 기독교인이","height":0.024154589371980673,"y":0.43639291445249606,"x":0.5205479439307458},{"width":0.363013698630137,"height":0.019323671497584627,"x":0.5205479421803654,"text":"이 병사들의 초청에 따라 카피르스탄으로","y":0.41545893714439075},{"y":0.38808373584541067,"text":"첫 선교 여행을 떠났습니다. 그들의 사역은","height":0.02254428341384862,"width":0.3744292237442922,"x":0.5205479414611873},{"x":0.5205479457436399,"y":0.36231884041867957,"width":0.36757990867579915,"height":0.02254428341384862,"text":"기독교 진리를 가르치고, 교역어로 번역된"},{"x":0.5205479427592956,"height":0.019323671497584627,"text":"성경을 배포하고 지역 공동체에 의료를","y":0.33977455709684834,"width":0.34246575342465757},{"y":0.31561996787439606,"text":"Photo Source: Wikimedia","height":0.009661835748792202,"x":0.255707764925799,"width":0.1894977168949772},{"x":0.5205479424820614,"width":0.3812785388127854,"y":0.3140096617552335,"height":0.020933977455716568,"text":"제공하는 것이었습니다. 그들은 긍정적으로"},{"x":0.5205479440449011,"text":"환영받았으며, 떠날 때 지역 사람들이 더 많은","height":0.024154589371980784,"y":0.2850241543880837,"width":0.3995433789954338},{"width":0.2488584474885845,"x":0.050228312990867545,"y":0.2592592593880837,"height":0.02254428341384873,"text":"• 인구: 약 356,300명"},{"text":"가르침을 위해 꼭 다시 돌아오라는 편지를","height":0.019323671497584516,"y":0.26409017720522454,"width":0.36757990867579915,"x":0.52054794724759},{"y":0.24315619972624802,"width":0.16894977168949776,"height":0.017713365539452464,"x":0.09360730762557075,"text":"(2025년 8월 기준)"},{"width":0.3538812785388128,"height":0.024154589371980784,"text":"보냈지만, 그들은 돌아올 수 없었습니다.","y":0.2351046696859903,"x":0.5228310487633182},{"x":0.05251141796803649,"text":"• 종교: 이슬람(시아파)","y":0.21256038626409024,"width":0.2488584474885845,"height":0.020933977455716568},{"x":0.5228310521816336,"width":0.35159817351598177,"y":0.2141706925210235,"text":"이후 몇 십 년 간 사람들이 카피르스탄을","height":0.019323671497584516},{"height":0.019323671497584627,"text":"• 언어: 누리스타니어 계열(8개 하위","y":0.1851851852657005,"x":0.05251141864535765,"width":0.37442922374429227},{"x":0.5228310526969178,"height":0.020933977455716568,"text":"방문했다는 기록이 있습니다. 그러나 1896년","width":0.39497716894977175,"y":0.188405797192029},{"width":0.05707762557077625,"y":0.1642512076489534,"height":0.019323671497584516,"x":0.09589041060216896,"text":"그룹)"},{"width":0.3447488584474885,"text":"이들은 강제로 이슬람으로 개종되었고,","x":0.5228310531012177,"y":0.15942028986849155,"height":0.024154589371980673},{"width":0.2214611872146119,"x":0.05022830865677326,"text":"• 기독교인: 0.00%","y":0.13365539444444452,"height":0.019323671497584627},{"x":0.5205479474172374,"text":"카피르스탄은 '누리스탄 (빛의 땅)이라는","height":0.019323671497584627,"width":0.3538812785388128,"y":0.1384863124798712},{"text":"이름으로 개명되었습니다.","x":0.5205479458447488,"height":0.02254428341384862,"y":0.11111111133655394,"width":0.2374429223744292},{"text":"• 성경: 없음","width":0.14412853815784193,"height":0.018937777397905142,"x":0.05236495610224318,"y":0.1056679866324014}]