[{"y":0.9613526569243156,"text":"68 기타 아시아 - 다게스탄","x":0.02968036319634707,"width":0.2100456621004566,"height":0.01449275362318847},{"y":0.9162640900161031,"width":0.3013698630136986,"height":0.02254428341384862,"text":"다게스탄, 또는 다게스탄 공화국은","x":0.5228310493476842},{"y":0.9017713363794955,"height":0.020933977455716568,"x":0.05936073114535769,"text":"24일차","width":0.07990867579908675},{"text":"러시아 연방에 속한 22개의 자치공화국","x":0.52054794173516,"width":0.3470319634703196,"y":0.8937198066827697,"height":0.020933977455716568},{"width":0.3721461187214612,"text":"가운데 하나로, 카스피해 서쪽 해안 인근의","height":0.024154589371980673,"y":0.86473429931562,"x":0.5205479443493151},{"width":0.11902000914969946,"x":0.05464524755726138,"y":0.846553992990674,"text":"기타 아시아","height":0.020257553616583657},{"width":0.3246219582753639,"y":0.8420992237728102,"x":0.5226301651400926,"height":0.02280367822078888,"text":"북코카서스 지역에 위치해 있습니다."},{"height":0.019323671497584516,"y":0.818035426831723,"width":0.34246575342465757,"text":"이 지역은 세계에서 민족적 언어적으로","x":0.5228310523687214},{"text":"가장 다양한 지역 중 하나로, 30개 이상의","height":0.02254428341384862,"y":0.7906602252549652,"x":0.5205479463660577,"width":0.363013698630137},{"width":0.329538040509507,"height":0.06639805853654801,"text":"다게스탄","y":0.7703436420410573,"x":0.045276640929232094},{"height":0.02093397745571668,"width":0.36757990867579915,"x":0.5205479488812784,"text":"언어와 14개의 공식적으로 인정된 민족이","y":0.7681159421095007},{"height":0.02254428341384862,"text":"거주하고 있습니다. 이들 언어 중 상당수는","x":0.520547944977169,"width":0.3744292237442922,"y":0.7407407405152979},{"y":0.7181964572463768,"text":"소규모 산악 공동체에서만 사용되는 고유한","width":0.3812785388127854,"x":0.5205479420281585,"height":0.019323671497584627},{"x":0.5228310485920853,"height":0.02254428341384873,"y":0.6892109498926462,"text":"언어들로, 수세기 동안 보존되어 왔습니다.","width":0.3744292237442922},{"height":0.02254428341384851,"text":"다양성에도 불구하고, 다게스탄 사람들은","x":0.5228310528049576,"width":0.36073059360730586,"y":0.6392914654934438},{"height":0.02254428341384851,"y":0.615136875942029,"text":"매우 밀접한 역사를 공유합니다.","x":0.5205479423515983,"width":0.28538812785388123},{"y":0.5877616747316157,"text":"이슬람은 15세기에 자리 잡았으며,","x":0.5228310528158295,"width":0.3105022831050228,"height":0.024154589371980784},{"text":"지역 전통과 결합되었습니다. 18세기에","x":0.5205479480974124,"width":0.3470319634703196,"height":0.02093397745571668,"y":0.5652173913982823},{"y":0.5378421901449275,"text":"러시아의 영향이 시작되었고, 1921년","x":0.5205479485388127,"width":0.33333333333333337,"height":0.02254428341384873},{"y":0.5136876004562534,"x":0.5228310530631658,"width":0.3447488584474886,"text":"다게스탄은 소련의 일부가 되었습니다.","height":0.02254428341384851},{"x":0.5205479437024354,"height":0.02254428341384873,"text":"1991년 소련 붕괴 이후 불안정과 부패가","width":0.36073059360730586,"y":0.48953301120504555},{"text":"증가했습니다.","x":0.5204015331931604,"y":0.46490760241630524,"width":0.13271291724078738,"height":0.021875615665110204},{"width":0.18493150684931503,"height":0.011272141706924255,"x":0.25570776563926934,"y":0.4283413849436394,"text":"Photo Source: Wikipedia"},{"width":0.3972602739726028,"text":"체첸 전쟁과 2000년대 초반 동안 다게스탄은","x":0.5205479480430528,"y":0.4154589372900851,"height":0.019323671497584627},{"x":0.5205479478881277,"width":0.32191780821917815,"y":0.38647342996511,"height":0.024154589371980784,"text":"무장세력과 극단주의에 직면했으며,"},{"text":"2017년에 러시아는 이를 진압했다고","x":0.5205479435730593,"width":0.3264840182648402,"y":0.36553945243156205,"height":0.019323671497584516},{"width":0.3127853881278539,"y":0.3574879228059582,"text":"인구: 3,182,054명 (2025년 8월","x":0.09132420286815064,"height":0.025764895330112725},{"y":0.346215781199678,"text":"기준)","width":0.047945205479452066,"height":0.01610305958132041,"x":0.08904109546232879},{"text":"주장했습니다.","y":0.3376794038048798,"height":0.02190367227207246,"x":0.5203972657671263,"width":0.13272145240818523},{"text":"• 종교: 이슬람","x":0.04794520712328765,"width":0.1643835616438356,"height":0.017713365539452575,"y":0.31561996787439617},{"x":0.04794520787671228,"text":"• 언어: 다양한 언어(30개 이상)","y":0.28663446060501496,"width":0.33561643835616434,"height":0.020933977455716568},{"x":0.5205479425608829,"height":0.019323671497584627,"width":0.317351598173516,"y":0.2898550723832527,"text":"오늘날 대부분의 다게스탄 사람들은"},{"y":0.25603864714975844,"text":"• 기독교인: 0.01%","width":0.2168949771689498,"x":0.04566210111872143,"height":0.019323671497584627},{"text":"무슬림이며, 다양한 민족 집단이 공통된","y":0.259259259057971,"width":0.34931506849315075,"x":0.5205479441210046,"height":0.024154589371980673},{"text":"종교로 평화롭게 함께 살고 있습니다.","x":0.5228310525929549,"y":0.23671497586841506,"width":0.33105022831050235,"height":0.02254428341384862},{"y":0.22866344595410626,"text":"• 성경: 일부 있음","x":0.045662098030821975,"width":0.1940639269406393,"height":0.017713365539452464},{"text":"수도 마하치칼라는 중요한 이슬람","width":0.2990867579908676,"y":0.21417069252818022,"height":0.019323671497584516,"x":0.5205479481963471},{"text":"중심지입니다. 그러나 산악 유대인과 기독교","x":0.5205479484398782,"width":0.3881278538812786,"y":0.18679549125067096,"height":0.02254428341384873},{"text":"카자크인도 다게스탄에 거주합니다.","y":0.16103059581320456,"x":0.5205479484246575,"width":0.32191780821917815,"height":0.02254428341384862},{"x":0.520547945738204,"text":"외부 압력에도 불구하고, 각 민족은 고유한","y":0.13365539432367146,"height":0.024154589371980673,"width":0.3744292237442922},{"height":0.024154589371980673,"y":0.10950080498044634,"width":0.3378995433789954,"text":"언어, 문화, 전통을 유지하며 강한 민족","x":0.5228310485322897},{"x":0.5205479466894978,"height":0.02093397745571668,"text":"정체성을 지킵니다.","y":0.08695652175254964,"width":0.17808219178082185}]