[{"text":"42 인도 - 칼랄 이디가","width":0.18036529680365296,"height":0.01449275362318836,"x":0.031963472123287644,"y":0.9613526570853462},{"text":"칼랄 이디가 종족은 인도에서 전통적으로","x":0.5205479439497718,"height":0.020933977455716568,"width":0.36073059360730586,"y":0.9178743959608159},{"width":0.07534246575342465,"height":0.019323671497584516,"x":0.057077625989345494,"text":"13일차","y":0.9017713366255145},{"y":0.8953301126409018,"height":0.019323671497584516,"x":0.5205479422945206,"text":"토디 나무 수액을 채취하여 술을 만드는","width":0.34931506849315064},{"y":0.8679549116586152,"text":"토디 채취(Toddy Tapping)자들로 알려진","x":0.5205479434018265,"width":0.3630136986301369,"height":0.02254428341384862},{"y":0.8470209338969403,"x":0.05251141519895629,"width":0.045662100456621,"height":0.017713365539452575,"text":"인도"},{"x":0.5205479437214612,"y":0.8421900158776168,"width":0.36757990867579904,"height":0.02254428341384862,"text":"계급입니다. 인도 사회에서 술은 경멸받기"},{"y":0.8164251209742351,"x":0.5205479446347032,"height":0.024154589371980673,"text":"때문에, 칼랄 이디가 종족은 다른 사람들에게","width":0.39269406392694073},{"y":0.793880837345679,"x":0.5205479470129376,"width":0.21689497716894968,"height":0.020933977455716568,"text":"하층민으로 여겨집니다."},{"height":0.06280193236714982,"width":0.16894977168949774,"y":0.7713365540200138,"x":0.04109589101435093,"text":"칼랄"},{"text":"정부는 칼랄 이디가를 하위 계급으로","height":0.019323671497584516,"width":0.32420091324200906,"y":0.7455716587224906,"x":0.5205479479071538},{"width":0.38584474885844755,"y":0.7214170693121693,"text":"분류하여 대학 입학 정원을 할당하지만 이는","x":0.5228310529843443,"height":0.019323671497584516},{"x":0.04109588953033268,"y":0.7037037036174374,"width":0.24657534246575347,"height":0.0628019323671497,"text":"이디가"},{"x":0.5205479480430528,"y":0.694041867989418,"width":0.3972602739726028,"height":0.020933977455716568,"text":"그들 사회적 지위가 낮다는 것올 의미합니다."},{"text":"최근 일부 칼랄 이디가 사람들은 전통 직업에서","y":0.6457326891419369,"x":0.5205479422700588,"width":0.410958904109589,"height":0.019323671497584516},{"text":"벗어나 사업과 심지어 정치에 진출했습니다.","x":0.5228310530060882,"width":0.3881278538812786,"height":0.024154589371980784,"y":0.6183574881239935},{"y":0.5958132046008742,"x":0.5205479477005871,"width":0.34931506849315064,"text":"그러나 시골에 여전히 사는 많은 이들은","height":0.019323671497584516},{"y":0.5700483091116478,"text":"극빈 상태에서 하루하루를 보냅니다.","x":0.5205479424847793,"height":0.020933977455716568,"width":0.3264840182648401},{"width":0.408675799086758,"text":"카르나타카, 안드라프라데시, 랑가나와 같은","y":0.5169082123590982,"height":0.024154589371980673,"x":0.5205479436263317},{"height":0.024154589371980784,"width":0.3972602739726028,"text":"남부 주들이 칼랄 이디가의 주요 거주지이며,","x":0.5205479490867579,"y":0.49275362294685987},{"y":0.4685990335909823,"height":0.02254428341384862,"x":0.5205479487899544,"width":0.363013698630137,"text":"인도 남부 다른 주에서도 볼 수 있습니다."},{"y":0.4460547502281267,"text":"이들 주 중 일부는 종교 변경을 금지하는 법올","height":0.020933977455716568,"x":0.522831047564688,"width":0.39726027397260266},{"y":0.41867954922935346,"x":0.5205479475212003,"text":"제정했는데, 카르나타카도 그런 법올","width":0.32420091324200917,"height":0.02254428341384873},{"y":0.39613526571390234,"height":0.020933977455716568,"text":"통과시켰으나 나중에 폐지되었습니다.","x":0.5205479480403349,"width":0.34018264840182644},{"width":0.35159817351598166,"y":0.34460547485238857,"x":0.5205479480974124,"text":"인도 정부는 힌두교를 강력히 장려하며,","height":0.02254428341384862},{"y":0.32206119170692415,"width":0.31278538812785384,"height":0.02093397745571668,"x":0.5205479483333334,"text":"누군가를 그리스도인으로 개종하는"},{"y":0.31239935581723033,"text":"Photo Source: Negliea - Wikimedia","height":0.011272141706924366,"width":0.2648401826484018,"x":0.16894976837899553},{"x":0.21004566396499239,"width":0.22374429223744294,"text":"Licensed under CC BY-SA 3.0","y":0.2995169082796565,"height":0.011272141706924366},{"width":0.3082191780821917,"text":"기독교인들은 투옥될 수 있습니다.","x":0.5205479477739726,"height":0.02254428341384862,"y":0.29468599036500265},{"x":0.5205479418188736,"width":0.406392694063927,"height":0.020933977455716568,"text":"현지인과 외국인 거주자에 대한 여행 제한으로","y":0.2721417068572195},{"y":0.2415458938348286,"x":0.08447488747553814,"width":0.22831050228310504,"height":0.02254428341384862,"text":"인구: 약 2,000,000명"},{"x":0.5205479485616438,"text":"칼랄 이디가가 사는 외딴 지역은 접근이","height":0.020933977455716568,"width":0.34931506849315064,"y":0.24637681138486311},{"width":0.16666666666666666,"y":0.22705314016818756,"x":0.08447488677067475,"height":0.01610305958132041,"text":"(2025년 8월 기준)"},{"text":"어렵지만, 인도 기독교인들은 여전히 복음을","x":0.5205479434931507,"height":0.024154589371980673,"y":0.2190016101046699,"width":0.3881278538812786},{"text":"• 종교: 힌두교","y":0.198067632756307,"height":0.017713365539452464,"width":0.16438356164383564,"x":0.04337899406392696},{"x":0.520547945711024,"y":0.19484702076144467,"text":"전파하기 위해 들어 가며, 일부 칼랄 이디가","height":0.024154589371980673,"width":0.3812785388127854},{"x":0.5205479473458904,"width":0.34246575342465746,"height":0.019323671497584516,"y":0.17391304355877624,"text":"사람들이 교회가 있는 마을과 도시에서"},{"width":0.3105022831050228,"height":0.02254428341384862,"text":"• 언어: 텔루구어와 칸나다어","y":0.1658615137842191,"x":0.04337899853881275},{"height":0.02254428341384862,"x":0.5205479469341161,"text":"예수님을 믿게 되었습니다.","y":0.14653784221302035,"width":0.24200913242009137},{"text":"• 기독교인: 0.01%","x":0.04337899620433786,"height":0.019323671497584627,"width":0.21232876712328766,"y":0.13848631215780993},{"text":"• 성경: 신약 있음, 완역 있음","height":0.02254428341384862,"y":0.10628019301127212,"width":0.29452054794520555,"x":0.043378996461187216}]