[{"y":0.9613526569377349,"x":0.03196346889269409,"text":"14 아프리카 - 풀라니","height":0.01449275362318836,"width":0.17123287671232879},{"y":0.9178743961191627,"x":0.5205479489041095,"width":0.36986301369863017,"height":0.020933977455716568,"text":"풀라니는 세계에서 가장 큰 유목민입니다."},{"x":0.07534246612442923,"y":0.9098228664251208,"width":0.059360730593607317,"text":"1일차","height":0.019323671497584516},{"height":0.02254428341384873,"x":0.5182648430365296,"y":0.8921095006172839,"text":"1,000년 이상 동안 서아프리카의 정치,","width":0.3470319634703196},{"y":0.8695652173376275,"text":"무역, 종교에 영향을 끼쳤습니다.","x":0.5182648377473364,"width":0.2922374429223744,"height":0.02254428341384862},{"text":"아프리카","x":0.06370608511103405,"height":0.020361553259709786,"y":0.8497226050742285,"width":0.08948280822196507},{"y":0.8486312400250492,"text":"서아프리카에서 처음으로 이슬람을 따른","height":0.019323671497584516,"width":0.3561643835616438,"x":0.5182648421613394},{"height":0.02254428341384862,"x":0.5182648421946348,"y":0.8228663447061192,"width":0.32191780821917804,"text":"사람들이며, 지하드를 통해 이슬람을"},{"height":0.020933977455716568,"x":0.5182648388698632,"y":0.8019323673242083,"text":"퍼뜨리고 1800년대에 강력한 제국을","width":0.3264840182648401},{"text":"풀라니 \/","y":0.7729468596282877,"width":0.3219178082191781,"height":0.06602254428341381,"x":0.05936072976598176},{"width":0.11218144142464415,"y":0.7757485246943763,"text":"세웠습니다.","height":0.021771870949418126,"x":0.5181101933289021},{"y":0.7310789052012883,"height":0.020933977455716568,"x":0.5205479426712329,"text":"풀라니는 다양한 이름으로 알려져","width":0.29452054794520544},{"width":0.1643835616438356,"x":0.059360731107305956,"y":0.7069243157055153,"height":0.06280193236714982,"text":"풀베"},{"height":0.024154589371980673,"x":0.5182648435844748,"y":0.7037037034621578,"width":0.3447488584474885,"text":"있습니다: 풀라니 또는 풀라(하우사어),"},{"height":0.024154589371980673,"x":0.5182648424983692,"text":"푀울 또는 푀울(프랑스어, 월로프어),","y":0.6811594203013572,"width":0.32420091324200906},{"height":0.023441893658968205,"y":0.6565560258261088,"width":0.18970822199294557,"text":"풀베(풀풀데\/풀라어),","x":0.5204426937095775},{"text":"팔라타\/멜라타(카누리어, 차드와 수단).","width":0.3470319634703196,"height":0.024154589371980784,"y":0.6328502413043477,"x":0.5182648411872146},{"text":"전통적으로 목축업을 하며, 신선한 풀과","height":0.02254428341384851,"y":0.5877616746491834,"x":0.5182648377038487,"width":0.3470319634703196},{"text":"물을 따라 가축과 함께 이동합니다.","x":0.5205479477549467,"width":0.3105022831050228,"height":0.020933977455716457,"y":0.5652173911298981},{"x":0.5182648429223744,"y":0.5442834139291466,"width":0.3287671232876712,"height":0.019323671497584627,"text":"자연에 대한 깊은 지식을 가진 것으로"},{"height":0.02254428341384851,"x":0.51826483902207,"y":0.5169082123725175,"text":"알려져 있고, 많은 사람들이 여전히 이렇게","width":0.3721461187214612},{"width":0.37671232876712335,"y":0.4927536232344144,"x":0.5182648428734508,"height":0.02254428341384862,"text":"살고 있지만, 일부는 도시에 정착했습니다."},{"y":0.4702093397208803,"x":0.5182648370814308,"width":0.3721461187214612,"height":0.02254428341384862,"text":"그들은 검소한 집에 살지만, 화려한 무늬의"},{"height":0.02254428341384862,"y":0.4460547502147074,"width":0.31506849315068486,"text":"옷을 입습니다. 오늘날 그들 중 많은","x":0.5182648398401827},{"height":0.02254428341384862,"width":0.2808219178082192,"text":"사람들이 유능한 상인들입니다.","x":0.5182648424847792,"y":0.4235104668008588},{"text":"Photo Source: Dan Lundber, Flickr, CC BY-SA 2.0","width":0.3926940639269406,"x":0.059360732511415486,"y":0.40740740758454097,"height":0.017713365539452575},{"y":0.3752012882677709,"text":"풀라니 가족들은 자녀들에게 예의, 근면,","height":0.02254428341384862,"width":0.3561643835616438,"x":0.5205479477495109},{"y":0.35426731056360705,"x":0.05022831166666665,"text":"• 인구: 13,877,900명","width":0.24885844748858454,"height":0.02254428341384862},{"text":"문화적 자부심을 가르침으로써 서로","x":0.5182648370091325,"width":0.317351598173516,"height":0.020933977455716568,"y":0.3542673107085347},{"x":0.09360730257990874,"text":"(2025년 8월 기준, 최전방 미전도 종족)","width":0.3356164383561644,"height":0.019323671497584627,"y":0.33494363922705306},{"width":0.3812785388127854,"x":0.5182648370053273,"height":0.024154589371980673,"y":0.3268921094605476,"text":"긴밀하게 연결되어 있습니다. 음악, 이야기,"},{"y":0.30917874386741817,"width":0.16666666666666666,"x":0.05022830911339424,"text":"• 종교: 이슬람","height":0.017713365539452464},{"y":0.3075684379898014,"width":0.2922374429223744,"height":0.020933977455716568,"text":"춤은 삶에 중요한 역할을 합니다.","x":0.5182648426179604},{"height":0.017713365539452464,"x":0.05022830931180692,"y":0.28019323661145623,"text":"• 언어: 풀라어","width":0.16666666666666666},{"text":"슬프게도 수세기 동안 정착 농부들과","width":0.32420091324200917,"height":0.020933977455716568,"y":0.2834138486983361,"x":0.5182648428843226},{"text":"유목민들 사이에 갈등이 있었습니다.","y":0.2592592592937659,"width":0.3264840182648402,"x":0.5182648425146771,"height":0.020933977455716568},{"text":"• 기독교인: 0.1% 미만","height":0.020933977455716568,"y":0.24959742368491677,"width":0.2488584474885845,"x":0.05022831227168944},{"y":0.23671497591586155,"text":"농부들은 유목민들의 가축으로 농작물이","width":0.3561643835616438,"height":0.020933977455716568,"x":0.5182648424086758},{"x":0.05251141799847789,"y":0.21739130445517973,"text":"• 성경: 부분 있음, 신약 있음","width":0.29680365296803646,"height":0.02254428341384873},{"height":0.02254428341384862,"text":"훼손된다고 비난하는 반면, 유목민들은","x":0.5182648426451402,"width":0.3447488584474886,"y":0.21095008063031973},{"y":0.19001610313003225,"x":0.5182648422089041,"width":0.32420091324200906,"height":0.020933977455716568,"text":"가축이 약탈되거나 물을 못 마시거나"},{"height":0.02093397745571668,"y":0.1658615136205045,"text":"이동의 제한에 대해 불평합니다.","x":0.518264837804414,"width":0.28538812785388123}]