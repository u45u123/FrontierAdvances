[{"text":"24 아랍 - 예멘인","y":0.961352657105475,"height":0.01449275362318847,"width":0.1415525114155251,"x":0.03196347208904106},{"text":"서쪽으로는 홍해, 남쪽으로는 아라비아해와","width":0.3812785388127854,"y":0.9178743959608159,"x":0.5205479446156773,"height":0.020933977455716568},{"width":0.06164383561643835,"x":0.06164383523116439,"height":0.019323671497584627,"text":"5일차","y":0.904991948389694},{"width":0.36757990867579904,"y":0.8937198066827697,"text":"접한 전략적 위치에 있는 예멘은 수천년의","height":0.020933977455716568,"x":0.5205479425799087},{"y":0.8663446052495974,"height":0.02254428341384862,"x":0.5205479476255708,"text":"긴 역사를 가지고 있습니다.","width":0.2465753424657534},{"x":0.05704834540616348,"width":0.10964760279546588,"height":0.019489551703902985,"y":0.8485482995279797,"text":"아랍문화권"},{"width":0.3972602739726028,"x":0.5205479485159816,"text":"성경의 스바\/시바 왕국을 포함하여 고대 예멘","height":0.019323671497584516,"y":0.8438003221417069},{"height":0.02254428341384851,"x":0.5205479490410958,"y":0.8148148148148149,"text":"왕국들은 아라비아, 이집트, 걸프만 국가들,","width":0.3835616438356164},{"width":0.3013698630136986,"text":"인도와의 무역으로 번영했습니다.","height":0.020933977455716568,"x":0.5205479477168949,"y":0.7922705314143854},{"height":0.0628019323671497,"width":0.24657534246575344,"y":0.7729468598228664,"x":0.04337899461187214,"text":"예멘인"},{"width":0.3538812785388127,"height":0.019323671497584627,"x":0.5205479432394725,"y":0.7439613525854356,"text":"6세기에는 예멘 일부 지역에서 기독교가"},{"width":0.36073059360730597,"height":0.024154589371980784,"text":"왕성했으나, 이후 예멘인들은 무함마드의","y":0.7133655392799632,"x":0.5205479442270059},{"y":0.6924315620862408,"x":0.5205479473110096,"width":0.3789954337899544,"text":"632년 사망 이전부터 이슬람의 자랑스럽고","height":0.019323671497584516},{"width":0.27853881278538817,"height":0.02254428341384851,"x":0.5228310525114155,"y":0.6650563605206656,"text":"맹렬한 추종자들이 되었습니다."},{"height":0.019323671497584516,"x":0.5205479419634703,"text":"그 이후 예멘인이라는 것은 무슬림을","width":0.32420091324200917,"y":0.6425120772302738},{"width":0.19634703196347025,"height":0.020933977455716568,"text":"의미하게 되었습니다.","x":0.5205479466079582,"y":0.6151368760179434},{"width":0.36073059360730597,"text":"후티족과 같이 자이디 예멘인은 시아파에","height":0.019323671497584405,"y":0.5668276973544975,"x":0.5205479477821264},{"text":"속하며 주로 북서부 구릉 지역에 살고,","width":0.3378995433789955,"y":0.537842190016103,"height":0.02254428341384873,"x":0.5205479480213089},{"y":0.5152979063929146,"height":0.02093397745571668,"x":0.5205479488812784,"text":"수니파 예멘인들은 해안 도시들을 포함하여","width":0.3812785388127854},{"x":0.5228310522260273,"y":0.4895330112855609,"text":"남부와 동부에 거주합니다.","height":0.020933977455716457,"width":0.23972602739726023},{"height":0.020933977455716568,"text":"종족들은 일상생활과 정치에서 여전히","y":0.46537842198067636,"x":0.5205479476190477,"width":0.3378995433789954},{"height":0.02254428341384873,"width":0.20319634703196354,"text":"중요한 역할올 합니다.","y":0.43800322042404716,"x":0.5205479468607306},{"x":0.5205479464421613,"y":0.3896940416935051,"width":0.3264840182648401,"text":"1990년 남예멘과 북예멘이 통합되어","height":0.020933977455716568},{"height":0.012882447665056418,"y":0.3607085344605475,"x":0.07305936141552508,"text":"Photo Source: Rod Waddington - Flickr Licensed","width":0.3789954337899544},{"text":"예멘 공화국을 형성했습니다.","x":0.5205479478310501,"y":0.3623188405797102,"height":0.02254428341384862,"width":0.2625570776255708},{"y":0.3478260868558777,"text":"under CC BY-SA 2.0","x":0.2899543359018265,"width":0.1598173515981735,"height":0.011272141706924255},{"text":"그러나 갈등은 계속되었고, 2014년에 시작된","height":0.02254428341384873,"x":0.5228310507562786,"width":0.39497716894977164,"y":0.33655394510869563},{"text":"내전이 대부분의 예멘인들에게 믿을 수 없는","y":0.31400966176865275,"height":0.020933977455716568,"x":0.5205479419710808,"width":0.38812785388127846},{"width":0.2557077625570776,"height":0.02254428341384862,"text":"• 인구: 34,350,000명","x":0.03652968356164377,"y":0.2962962964170692},{"width":0.1689497716894977,"y":0.28180354273752006,"height":0.016103059581320522,"text":"(2025년 8월 기준)","x":0.0776255724657534},{"width":0.3744292237442923,"height":0.02254428341384862,"y":0.2866344605475041,"x":0.522831053348554,"text":"불행을 가져왔습니다. 수만 명이 사망하고,"},{"y":0.2592592592431562,"x":0.5205479420776257,"text":"더 많은 사람들이 난민이 되었으며,","width":0.31278538812785395,"height":0.024154589371980673},{"y":0.25281803550724635,"x":0.03652968153946509,"text":"• 종교: 이슬람","width":0.16438356164383564,"height":0.017713365539452464},{"text":"수많은 아이들이 영양실조에 걸렸습니다.","y":0.23656696285988943,"x":0.5202780133445171,"height":0.024407412118957805,"width":0.36592596742116157},{"height":0.020933977455716568,"y":0.22222222214170695,"x":0.03652967871638765,"width":0.29680365296803657,"text":"• 언어: 아랍어(다양한 방언)"},{"x":0.5205479490410958,"height":0.019323671497584516,"y":0.21417069252818022,"text":"2022년 휴전이 더 나은 미래에 대한 희망을","width":0.3835616438356164},{"width":0.2442922374429224,"text":"• 기독교인: 0.1% 미만","y":0.1948470208400428,"height":0.017713365539452575,"x":0.036529678329528206},{"x":0.5228310497336378,"y":0.1851851849838969,"text":"불러 일으켰으나, 후티족이 가자 전쟁에서","width":0.365296803652968,"height":0.024154589371980784},{"text":"• 성경: 있음, 배포는 어려움","width":0.2899543378995434,"y":0.16103059594202895,"x":0.03652968326484015,"height":0.02254428341384862},{"y":0.1626409017042405,"width":0.38584474885844744,"text":"하마스를 지지한 후 서방 군대와 이스라엘이","x":0.5205479419901066,"height":0.020933977455716568},{"x":0.5205479464326485,"text":"예멘을 공습했습니다.","width":0.19634703196347025,"y":0.13687600647141696,"height":0.020933977455716568}]