[{"x":0.031963471314416174,"height":0.01449275362318836,"width":0.13926940639269406,"text":"46 인도 - 쿰하르","y":0.9613526570853462},{"text":"쿰하르(Kumhar)들은 고대 인도 이야기에서","x":0.522831052597032,"width":0.37899543378995426,"y":0.9194847021638486,"height":0.017713365539452575},{"width":0.07534246575342467,"height":0.019323671497584516,"y":0.9066022545088567,"x":0.05707762619863012,"text":"15일차"},{"height":0.02093397745571668,"text":"브라흐마(프라자파티, Prajapati) 신의 자녀로","width":0.39497716894977175,"y":0.8921095009178743,"x":0.5228310541780821},{"x":0.5228310493150685,"y":0.8663446053140097,"text":"여겨집니다. 이 때문에 일부 쿰하르들은","width":0.3470319634703196,"height":0.02254428341384862},{"y":0.8518518519323671,"height":0.017713365539452464,"text":"인도","width":0.04566210045662101,"x":0.05251141585127201},{"y":0.8421900163285024,"height":0.02254428341384862,"text":"프라자파티를 성으로 사용합니다. 그들은","x":0.5205479484703195,"width":0.363013698630137},{"height":0.02254428341384862,"width":0.3721461187214612,"text":"바퀴를 처음 만든 사람들이라고 주장하며,","x":0.5205479482686453,"y":0.8148148146269458},{"x":0.5228310488584474,"y":0.7938808375201288,"width":0.35159817351598177,"text":"쿰하르는 \"진흙 항아리를 만드는 사람\"을","height":0.02254428341384862},{"x":0.04109588938356164,"y":0.7761674717190017,"height":0.0628019323671497,"text":"쿰하르","width":0.24657534246575347},{"height":0.02153490898881749,"width":0.11437380368306749,"text":"의미합니다.","x":0.5204386698858471,"y":0.7662051703227345},{"text":"쿰하르 사람들은 인도 전역에 거주하며","y":0.7181964573984613,"height":0.019323671497584516,"width":0.34018264840182644,"x":0.522831052118214},{"y":0.6892109498926462,"text":"현지 언어를 사용하며, 정직하고 근면하며","width":0.365296803652968,"height":0.02254428341384873,"x":0.5228310504946728},{"x":0.5205479459855402,"y":0.6634460545491143,"text":"영적입니다. 대부분 농사, 목축, 항아리와","height":0.024154589371980784,"width":0.35844748858447495},{"y":0.6392914654052604,"height":0.02254428341384851,"width":0.35159817351598177,"text":"점토 우상 제작으로 생계를 유지하지만,","x":0.5205479481354641},{"height":0.02093397745571668,"text":"이 일들은 계절적이고 불안정해 생계 수단으로","y":0.616747182173913,"x":0.5205479481278539,"width":0.406392694063927},{"text":"불충분합니다. 많은 쿰하르 농부들은 상위","height":0.02254428341384873,"x":0.5228310495719178,"y":0.5893719805354267,"width":0.365296803652968},{"y":0.5668276973429951,"x":0.5205479473458904,"width":0.34246575342465746,"height":0.019323671497584627,"text":"카스트 소유 토지에서 일하며 수확물의"},{"text":"Photo Source: Yann Forget - Wikimedia","width":0.29452054794520544,"y":0.553945249436393,"height":0.012882447665056307,"x":0.146118722402968},{"text":"Licensed under CC BY-SA 4.0","x":0.21461186988584477,"y":0.5426731078260869,"height":0.009661835748792313,"width":0.22602739726027396},{"height":0.021444331428662977,"x":0.5204805883314549,"width":0.15766896287055865,"y":0.5391973188091824,"text":"일부만 받습니다."},{"x":0.047945203405631694,"width":0.24885844748858443,"y":0.4879227052469136,"text":"• 인구: 18,279,000명","height":0.020933977455716568},{"text":"쿰하르들은 자녀들을 위한 새로운 직업","y":0.4911433174396135,"width":0.34246575342465746,"height":0.020933977455716568,"x":0.5205479460730593},{"width":0.16666666666666666,"y":0.47181964565217394,"x":0.09132419972276581,"text":"(2025년 8월 기준)","height":0.017713365539452464},{"height":0.02254428341384873,"x":0.5205479479452054,"width":0.33333333333333337,"y":0.4637681157541599,"text":"기술이나 더 나은 교육이 필요합니다."},{"x":0.047945207562785336,"height":0.017713365539452575,"width":0.16666666666666669,"text":"• 종교: 힌두교","y":0.4444444445048308},{"width":0.39726027397260266,"height":0.024154589371980673,"x":0.5205479412328768,"y":0.43639291460547514,"text":"많은 쿰하르들이 이주가 잦아 교육이 어렵고,"},{"y":0.4138486311594203,"x":0.047945203862252685,"text":"• 언어: 지역 언어","width":0.1940639269406393,"height":0.019323671497584627},{"width":0.3881278538812786,"height":0.019323671497584627,"text":"아이들은 부모의 생계 도우미로 일찍 학교를","x":0.5205479484398782,"y":0.41545893727858296},{"x":0.047945207012393985,"height":0.019323671497584516,"y":0.38486312406257184,"text":"• 기독교인: 0.01%","width":0.21461187214611874},{"width":0.3744292237442922,"height":0.02254428341384862,"y":0.3880837360171766,"text":"그만둡니다. 현대 의료와 깨끗한 물 공급도","x":0.5205479483257229},{"x":0.5205479461567732,"width":0.11415525114155256,"y":0.3639291465512614,"height":0.020933977455716568,"text":"부족합니다."},{"y":0.3510466986714976,"x":0.04794520637366818,"width":0.2990867579908676,"height":0.024154589371980673,"text":"• 성경: 신약 있음, 완역 있음"}]