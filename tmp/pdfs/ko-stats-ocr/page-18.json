[{"x":0.03196346889269409,"text":"18 아프리카 - 소말리","y":0.9613526569377349,"width":0.17123287671232879,"height":0.01449275362318836},{"x":0.5205479433980214,"height":0.020933977455716568,"y":0.9178743959608159,"text":"약 2,800만 명 이상의 소말리아인이","width":0.317351598173516},{"width":0.06392694063926939,"x":0.06849315110350075,"y":0.9098228661835749,"height":0.019323671497584516,"text":"3일차"},{"text":"약 35개국에 살고 있으며, 그중 절반이","width":0.3378995433789954,"y":0.8937198067057741,"height":0.020933977455716568,"x":0.5205479427919113},{"text":"소말리아에 살고 있습니다. 대부분의","height":0.020933977455716568,"y":0.871175523199908,"width":0.32191780821917815,"x":0.5205479463633399},{"text":"아프리카","y":0.8518518517713366,"width":0.08904109589041095,"height":0.017713365539452464,"x":0.054794519911937394},{"text":"소말리아인은 주요 다섯 씨족 중 하나에","x":0.5205479473744291,"height":0.019323671497584516,"y":0.8486312400161031,"width":0.3470319634703196},{"height":0.02254428341384873,"text":"속하며, 이는 그들의 사회적:정치적 삶을","width":0.3538812785388128,"y":0.8228663444444444,"x":0.5205479437214612},{"y":0.8003220612031285,"text":"형성합니다. 씨족 충성심이 매우 중요하며,","width":0.37671232876712335,"x":0.5205479478962818,"height":0.02093397745571668},{"text":"소말리","y":0.776167471745324,"width":0.24200913242009128,"x":0.05251141459430982,"height":0.06441223832528176},{"y":0.7777777777133655,"text":"많은 결정이 씨족 장로와 가족 관계 안에서","height":0.019323671497584516,"x":0.5205479414840183,"width":0.3721461187214612},{"y":0.7514663708143854,"text":"이루어집니다.","x":0.5226450847797834,"height":0.02363730628709293,"width":0.13050891928476827},{"text":"소말리아인의 약 60~70%가 유목민이거나","x":0.5205479483637747,"width":0.37899543378995426,"y":0.708534621658615,"height":0.019323671497584627},{"y":0.682769726199678,"text":"반유목민입니다. 그들은 물과 풀을 구하러","width":0.36757990867579915,"height":0.020933977455716568,"x":0.5205479415296804},{"text":"가축들과 함께 이동합니다. 시골 생활은","y":0.6586151367264781,"width":0.34931506849315064,"height":0.020933977455716457,"x":0.5205479461676452},{"x":0.5228310531202436,"height":0.019323671497584516,"text":"학교나 병원에 가기 어렵고 깨끗한 물을","y":0.6376811595008052,"width":0.3470319634703196},{"x":0.5205479461872146,"text":"구하기 어려워 매우 힘듭니다.","width":0.26712328767123295,"y":0.61191626431562,"height":0.02254428341384862},{"x":0.5205479436263319,"text":"국토의 1.6%만이 농사에 적합하며 가뭄이","width":0.3721461187214612,"y":0.5893719805018787,"height":0.02093397745571668},{"width":0.25114155251141557,"text":"Photo Source: Tosco.diaz - Flickr","y":0.5603864734836286,"x":0.18949772108066956,"height":0.012882447665056307},{"width":0.35159817351598166,"height":0.020933977455716457,"x":0.5205479480974124,"text":"자주 발생해 기아와 이주를 초래합니다.","y":0.5652173911298981},{"width":0.29680365296803657,"x":0.5205479430854534,"height":0.019323671497584516,"y":0.5201288244076375,"text":"소말리아는 수년간 전쟁과 갈등을"},{"width":0.37671232876712324,"text":"겪어왔습니다. 1991년 정부가 붕괴된 이후","y":0.4943639293719807,"height":0.02254428341384862,"x":0.522831049063927},{"text":"• 인구 : 16,288,200명","y":0.4863123991304348,"x":0.047945206666666636,"height":0.02254428341384862,"width":0.2511415525114155},{"height":0.019323671497584516,"y":0.4702093398013957,"x":0.09360730831430741,"width":0.2853881278538813,"text":"(16개국, 최전방 미전도 종촉 기준,"},{"x":0.5205479472602739,"y":0.4702093395866881,"width":0.3744292237442923,"height":0.02254428341384862,"text":"수백만 명이 집올 떠나야 했습니다. 일부는"},{"width":0.15981735159817353,"text":"2025년 8월 현재","height":0.017713365539452464,"x":0.09132420246575343,"y":0.4541062800161031},{"width":0.3926940639269406,"text":"소말리아 내부의 캠프에서 살고, 다른 이들은","height":0.024154589371980673,"y":0.4444444442431562,"x":0.520547946651446},{"x":0.04788650278697942,"y":0.4248691694499339,"text":"• 종교: 이슬람","height":0.019826878288133898,"width":0.1645009637423302},{"width":0.32420091324200917,"x":0.5205479427397262,"y":0.42512077273752014,"height":0.020933977455716568,"text":"에티오피아와 케냐 같은 주변 국가나"},{"height":0.020933977455716568,"x":0.5205479470700153,"y":0.40096618356145997,"text":"그 너머로 이동했습니다.","width":0.2263127679694188},{"y":0.391304347568438,"width":0.2671232876712329,"text":"• 언어: 소말리어, 아랍어","x":0.045662101757990826,"height":0.025764895330112725},{"x":0.5205479478310501,"y":0.378421900241546,"width":0.31506849315068497,"height":0.019323671497584516,"text":"북부의 소말릴란드(1991년 독립)와"},{"text":"• 기독교인: 0.03% 미만","x":0.045662098515981756,"y":0.367149758373591,"width":0.271689497716895,"height":0.020933977455716568},{"x":0.5228310523465246,"width":0.3812785388127854,"y":0.3542673108695653,"text":"분틀랜드(1998년 자치)는 강력한 씨족 조직","height":0.020933977455716568},{"x":0.04566209794520553,"width":0.30136986301369867,"text":"• 성경: 1970년대 중반 케냐","y":0.338164251113795,"height":0.017713365539452575},{"height":0.019323671497584516,"width":0.3904109589041096,"x":0.5228310523972601,"y":0.3317230274467705,"text":"덕분에 내전이 적고 인프라가 더 나아 비교적"},{"y":0.3172302738414744,"height":0.019323671497584516,"x":0.09360730720446471,"width":0.22831050228310507,"text":"성경공회에서 완역 출판"},{"y":0.3075684379327698,"height":0.020933977455716568,"x":0.5205479427511416,"text":"안정적이고 안전합니다. 이 두 지역은 남부를","width":0.3926940639269406},{"width":0.28767123287671237,"text":"복구하는 데 잠재력이 있습니다.","height":0.02254428341384862,"y":0.2818035426731079,"x":0.5205479480821917},{"x":0.5205479493150684,"text":"소말리아 기독교인들의 삶은 매우 어렵습니다.","height":0.02254428341384862,"y":0.23510466988727863,"width":0.410958904109589},{"text":"그들 대부분은 강한 사회적 압력과 위험","x":0.5205479423135464,"y":0.2141706923510467,"width":0.3470319634703196,"height":0.019323671497584627},{"x":0.5205479437785389,"text":"때문에 신앙을 비밀로 해야 합니다.","y":0.18840579728931828,"width":0.31278538812785384,"height":0.02254428341384873},{"text":"많은 이들이 교회나 기독교 친구 없이 고립되어","width":0.408675799086758,"height":0.019323671497584627,"x":0.5228310522716895,"y":0.16747181972624792},{"text":"있으며, 일부는 위협이나 폭력을 당합니다.","height":0.02254428341384862,"y":0.1400966183843264,"x":0.5205479483447489,"width":0.37671232876712324},{"x":0.5205479479288975,"text":"그럼에도 불구하고 온라인 미디어와 개인적","width":0.3812785388127854,"y":0.12077294694041851,"height":0.017713365539452575},{"width":0.35159817351598177,"text":"경험을 통해 기독교인이 늘고 있습니다.","x":0.5205479481354641,"y":0.0950080515432099,"height":0.020933977455716568},{"y":0.06924315615366916,"width":0.3538812785388128,"x":0.5205479426777561,"height":0.02254428341384862,"text":"그들은 배우고, 성장하며, 다른 사람들과"},{"height":0.020933977455716568,"x":0.5205479483447489,"text":"연결할 수 있는 안전한 방법이 필요합니다.","width":0.37671232876712324,"y":0.04830917875738061}]