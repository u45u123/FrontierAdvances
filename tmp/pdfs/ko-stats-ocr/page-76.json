[{"height":0.01449275362318836,"x":0.031963471852576635,"text":"76 기타 아시아 - 몰디브인","width":0.2146118721461187,"y":0.9613526570853462},{"x":0.5228310521974885,"text":"몰디브인은 여전히 지구상에서 가장","height":0.019323671497584627,"width":0.31506849315068497,"y":0.919484702173913},{"x":0.07070270585536632,"text":"28일차","width":0.07777267177355345,"height":0.019619617677157253,"y":0.904843974695552},{"text":"복음화되지 않은 민족 중 하나로,","height":0.024154589371980673,"width":0.2922374429223744,"x":0.5205479476027397,"y":0.8904991946457327},{"width":0.3972602739726028,"text":"선교 활동이나 기독교 문서가 거의 없습니다.","y":0.8679549113660763,"x":0.5205479418949771,"height":0.020933977455716568},{"x":0.06386298712099606,"width":0.11656626174439033,"height":0.019710762681208527,"y":0.8484376938817552,"text":"기타 아시아"},{"y":0.8438003221417069,"text":"정부는 몰디브인들 사이에 기독교가","x":0.520547947869102,"width":0.319634703196347,"height":0.019323671497584516},{"x":0.5205479420281585,"width":0.3812785388127854,"y":0.8180354266505636,"text":"존재한다는 사실을 부인하면서도 믿는 자를","height":0.019323671497584627},{"y":0.7906602252173913,"height":0.02254428341384862,"text":"체포합니다. 현재 몰디브어로는 누가복음과","x":0.5205479435844749,"width":0.3812785388127854},{"y":0.771987245398115,"x":0.052136075822855774,"text":"몰디브인","width":0.3272346949468464,"height":0.0663314671908023},{"x":0.5182648367960426,"height":0.020933977455716568,"y":0.7681159419618894,"width":0.406392694063927,"text":"사도행전만 번역되어 있고 어떤 성경도 국가에"},{"x":0.5228310519406393,"height":0.020933977455716568,"width":0.23972602739726034,"text":"반입이 허용되지 않습니다.","y":0.742351046710375},{"x":0.5205479417808221,"height":0.019323671497584516,"y":0.6924315619323672,"width":0.34246575342465746,"text":"몰디브는 세계에서 가장 높은 이혼율을"},{"x":0.5205479410502284,"y":0.6634460547020934,"width":0.4155251141552512,"height":0.024154589371980673,"text":"기록하고 있으며, 범죄 증가, 청소년 마약 문제,"},{"y":0.6409017713499732,"width":0.21689497716894968,"text":"아동학대가 만연합니다.","x":0.5205479470129376,"height":0.020933977455716568},{"y":0.5909822867149759,"text":"왜 오랫동안 이들은 이렇게 복음에서","x":0.5205479469939117,"width":0.32191780821917815,"height":0.020933977455716568},{"width":0.15753424657534243,"y":0.5652173914768805,"text":"소외되었을까요?","x":0.520547946037182,"height":0.024154589371980784},{"y":0.5426731078099839,"height":0.011272141706924366,"x":0.29680365136986303,"width":0.1598173515981735,"text":"Photo Source: Pexels"},{"x":0.5205479425038052,"text":"몰디브에서는 한 섬에서 다른 섬으로","y":0.5152979065083199,"height":0.02093397745571668,"width":0.32420091324200917},{"x":0.05022830693493156,"y":0.4847020936795491,"text":"• 인구: 529,676명 (2025년 8월 기준)","width":0.3904109589041096,"height":0.02254428341384862},{"height":0.02254428341384862,"text":"이동하려면 마을 지도자의 특별 허가가","x":0.5228310522146119,"y":0.4895330110466989,"width":0.34018264840182644},{"x":0.05022830931180692,"width":0.16666666666666666,"height":0.017713365539452575,"y":0.4605475039222452,"text":"• 종교: 이슬람"},{"y":0.4637681157809983,"text":"필요합니다. 평균적으로 한 섬에는","width":0.30365296803652975,"x":0.5205479446347032,"height":0.02254428341384873},{"text":"약 1,500명이 살고 있으며, 사람들이","x":0.5205479425038052,"width":0.32420091324200917,"y":0.4363929146001073,"height":0.025764895330112725},{"y":0.4283413846886742,"x":0.052511416400304406,"height":0.020933977455716568,"text":"• 언어: 몰디브어(디베히어)","width":0.2922374429223744},{"text":"5~10 번 결혼하기 때문에 결국 섬의 모든","height":0.020933977455716568,"y":0.4154589372555786,"width":0.3630136986301369,"x":0.5205479477984345},{"y":0.39935587768115943,"x":0.052511417671232824,"width":0.21461187214611874,"height":0.019323671497584516,"text":"• 기독교인: 0.01%"},{"width":0.3926940639269406,"text":"사람이 친척이 됩니다. 그러기에 외부 영향이","x":0.5205479453033268,"height":0.02254428341384862,"y":0.3880837357487922},{"height":0.024154589371980673,"y":0.36714975825281804,"text":"• 성경: 신약 중 누가복음, 사도행전만","x":0.05251141685692542,"width":0.3835616438356165},{"x":0.5205479430365297,"height":0.02254428341384873,"text":"들어오기가 매우 어렵습니다.","width":0.26027397260273977,"y":0.36231884052603325},{"text":"• 성경 전체: 없음","x":0.050228311377473356,"width":0.1963470319634703,"height":0.020933977455716568,"y":0.32045088549382716}]