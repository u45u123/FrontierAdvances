[{"text":"40 인도- 도비","x":0.03196347121656881,"width":0.12557077625570778,"y":0.9613526570853462,"height":0.01449275362318836},{"width":0.3881278538812786,"text":"도비는 전통적으로 옷 세탁과 다림질을 하는","height":0.019323671497584627,"y":0.9194847020289855,"x":0.5205479413242009},{"x":0.0593607310644977,"width":0.07534246575342467,"y":0.9033816425925926,"text":"12일차","height":0.019323671497584627},{"x":0.5205479450913243,"height":0.020933977455716568,"text":"직업 카스트입니다. 작업장 인근에서 살고","width":0.36757990867579904,"y":0.8921095006556246},{"x":0.520547943150685,"height":0.024154589371980673,"y":0.86473429931562,"width":0.3926940639269406,"text":"있으며, 종종 어둡고 더러우며 극도로 비좁은"},{"height":0.017713365539452575,"text":"인도","width":0.04794520547945205,"y":0.848631240016103,"x":0.05479452102739725},{"y":0.8438003221532091,"x":0.5205479479778212,"width":0.3881278538812786,"height":0.019323671497584516,"text":"환경에서 생활합니다. 물이나 다른 세척체로"},{"width":0.3356164383561643,"height":0.02415458937198056,"text":"넘쳐나는 곳일 수 있으며, 자주 욕실만","x":0.5205479450913243,"y":0.8148148150563608},{"x":0.5205479483561642,"text":"한 공간에 10명 이상이 살곤 합니다.","width":0.32420091324200917,"y":0.7906602252173913,"height":0.02254428341384862},{"height":0.05797101449275366,"text":"도비","y":0.7761674717230274,"width":0.15753424657534248,"x":0.04566209966894978},{"text":"도비는 인도 헌법에서 공식적으로 지정된","width":0.363013698630137,"height":0.019323671497584405,"x":0.5205479482305936,"y":0.7439613527375202},{"x":0.5205479459665144,"y":0.714975845222759,"text":"계층으로 인정받고 있지만, 일부 지역에서는","height":0.02254428341384851,"width":0.3881278538812786},{"y":0.6908212561513687,"x":0.5205479492922374,"height":0.02093397745571668,"text":"하위 계층으로 분류됩니다. 인도에서 도비들은","width":0.408675799086758},{"height":0.019323671497584627,"y":0.6682769725442834,"x":0.52054794238965,"text":"일상생활에서 사회적으로 배제된 채로","width":0.3378995433789954},{"x":0.5205479457762556,"width":0.36986301369863017,"text":"대부분 전통 직업인 세탁업에 종사합니다.","height":0.02254428341384873,"y":0.640901771524423},{"x":0.5205479426777561,"width":0.3538812785388128,"height":0.02254428341384851,"text":"그들은 \"불결한\" 직업과 연관된 카스트에","y":0.6167471818725558},{"height":0.019323671497584405,"y":0.5925925926616058,"x":0.5228310529354206,"text":"태어났기 때문에 불가촉천민 제도와 사회적","width":0.3789954337899544},{"width":0.25799086757990863,"height":0.02093397745571668,"text":"불평등에 희생되고 있습니다.","x":0.5228310518407535,"y":0.5652173913345411},{"width":0.38584474885844744,"x":0.5205479471004566,"y":0.5169082128019324,"height":0.02415458937198056,"text":"2017년 인도 대법원은 누군가를 \"도비\"라고"},{"width":0.365296803652968,"x":0.5205479415525115,"height":0.020933977455716568,"y":0.4895330111916264,"text":"부르는 것이 모욕적이라고 판결했습니다."},{"text":"오늘날 이 용어는 종종 카스트를","x":0.5228310517884323,"width":0.2808219178082192,"y":0.46698872792986224,"height":0.019323671497584516},{"text":"지칭하기보다는 의도적으로 모욕하거나","y":0.4412238326086956,"x":0.5205479474029681,"width":0.35159817351598166,"height":0.019323671497584516},{"width":0.26712328767123295,"text":"굴욕을 주기 위해 사용됩니다.","height":0.020933977455716568,"x":0.5205479429794521,"y":0.41384863117283954},{"x":0.2648401854261795,"y":0.3896940420371744,"text":"Photo Source: Pixabay","width":0.17123287671232879,"height":0.012882447281129528},{"height":0.020933977455716568,"x":0.5205479437899544,"text":"많은 고객들이 이제 세탁기를 사용함에 따라","y":0.3896940416586152,"width":0.3881278538812786},{"text":"수많은 도비들이 실업에 직면하고 있습니다.","y":0.36231884039184115,"x":0.5205479484208524,"width":0.3904109589041096,"height":0.02254428341384862},{"height":0.020933977455716568,"text":"제한된 교육과 직업 훈련 기회 때문에 다른","y":0.33977455737520124,"x":0.5205479459817353,"width":0.3744292237442922},{"x":0.5205479475076102,"text":"직업으로 전환하기 어렵습니다.","width":0.2808219178082192,"y":0.31078904971819654,"height":0.024154589371980673},{"y":0.3043478263123993,"text":"• 인구: 17,000,000명","x":0.050228312671232844,"width":0.2488584474885845,"height":0.02254428341384862},{"y":0.28985507254428333,"width":0.16666666666666666,"x":0.09589041234779297,"height":0.016103059581320522,"text":"(2025년 8월 기준)"},{"y":0.2898550725327812,"x":0.5205479477984345,"width":0.3630136986301369,"text":"그들의 사회경제적 지위를 개선하고 전통","height":0.019323671497584627},{"width":0.166772903372708,"y":0.26063897389603496,"text":"• 종교: 힌두교","x":0.05017519160837318,"height":0.019784853654207235},{"width":0.406392694063927,"y":0.259259259057971,"height":0.024154589371980673,"text":"직업의 대안을 모색하기 위해 교육, 직업 훈련,","x":0.5205479469939116},{"width":0.16438356164383564,"text":"• 언어: 힌디어","x":0.05251141415525116,"y":0.23188405787708,"height":0.017713365539452464},{"y":0.23671497565754163,"height":0.02254428341384862,"x":0.5205479471841704,"text":"경제적 지원이 필요합니다.","width":0.24200913242009137},{"x":0.050228311329908654,"width":0.21689497716894976,"height":0.019323671497584516,"text":"• 기독교인: 0.02%","y":0.20128824452495975},{"x":0.05251141641933028,"width":0.2945205479452055,"height":0.020933977455716568,"y":0.17069243138754697,"text":"• 성경: 신약 있음, 완역 있음"}]