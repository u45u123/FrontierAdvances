[{"width":0.22374429223744288,"y":0.9613526570853462,"height":0.01449275362318836,"text":"64 라틴 아메리카 - 마티스족","x":0.031963471917808205},{"width":0.365296803652968,"text":"마티스족은 17개의 아마존 최전방 미전도","x":0.5228310538812785,"y":0.9194847021900161,"height":0.019323671497584516},{"height":0.017713365539452575,"x":0.05936073113176777,"width":0.07534246575342465,"text":"23일차","y":0.9001610306763285},{"x":0.5205479459719504,"height":0.020933977455716568,"text":"종족(FPG) 중 하나입니다. 브라질 북동부","width":0.363013698630137,"y":0.8921095006556246},{"x":0.520547945913242,"width":0.36757990867579904,"height":0.024154589371980673,"text":"아마존의 작은 부족으로, 질병에 취약하고","y":0.8647342992753623},{"y":0.8432223839953861,"x":0.05463536230409484,"height":0.02047954626897297,"text":"라틴 아메리카","width":0.137304619567035},{"text":"타인에게 착취당하기 쉽습니다. 그들 언어로","width":0.38584474885844755,"y":0.8421900158776168,"height":0.02254428341384862,"x":0.5228310518949771},{"height":0.02254428341384862,"text":"된 기독교 자료가 없으며, 그리스도를 따르는","x":0.5228310506360079,"y":0.8148148146537842,"width":0.3904109589041096},{"y":0.7906602252549652,"text":"사람은 거의 없습니다.","width":0.20319634703196354,"height":0.02254428341384862,"x":0.5205479468607306},{"x":0.04337899611872149,"height":0.06441223832528176,"text":"아마존","y":0.7681159421005547,"width":0.2465753424657534},{"y":0.7439613525764894,"height":0.019323671497584627,"text":"약 절반은 교육과 일을 위해 도시로 이주하여","x":0.520547941933029,"width":0.3926940639269406},{"height":0.024154589371980784,"y":0.7133655392512077,"text":"보다 도시적인 생활 방식으로 살아가고 있으며,","width":0.4155251141552512,"x":0.520547948630137},{"text":"최전방","y":0.6988727855542136,"x":0.04337899620433786,"height":0.06602254428341381,"width":0.24885844748858446},{"width":0.3904109589041096,"y":0.689210950120773,"x":0.5228310526683789,"height":0.02254428341384851,"text":"밀림에 남아 있는 사람들은 사냥, 채집, 어업,"},{"y":0.6650563605206656,"x":0.5205479461377474,"text":"카사바 재배에 의존합니다. 질병과 제한된","width":0.36757990867579904,"height":0.02254428341384851},{"y":0.6425120773752013,"text":"의료 서비스로 인해 그들의 평균 기대수명은","width":0.3881278538812786,"height":0.019323671497584405,"x":0.5205479476312784},{"y":0.6325507204423718,"height":0.06501128093823916,"text":"미전도 종족","x":0.043287093155723565,"width":0.4202751264180223},{"height":0.020933977455716568,"text":"약 45세로 낮은 편입니다.","y":0.6151368760198604,"x":0.5205479471461187,"width":0.23287671232876705},{"text":"시골 마티스는 부족 내에서 결혼하며 많은","x":0.520547942908105,"width":0.36757990867579915,"height":0.019323671497584627,"y":0.5668276971819646},{"width":0.3721461187214612,"x":0.5205479441780821,"y":0.5378421897906602,"text":"자녀를 낳지만, 많은 아이들이 10세까지도","height":0.02254428341384862},{"y":0.5136876004562534,"height":0.02254428341384851,"width":0.3356164383561644,"x":0.5205479453386606,"text":"생존하지 못합니다. 점점 더 많은 젊은"},{"height":0.019323671497584516,"x":0.5228310523338408,"y":0.49114331731973526,"width":0.37899543378995426,"text":"마티스가 열대우림을 떠나 조상의 전통적인"},{"height":0.020933977455716568,"text":"생활 방식에서 멀어지고 있습니다.","x":0.520547948287671,"width":0.3082191780821918,"y":0.465378421884058},{"height":0.028445610869525906,"text":"마티스는 \"쇼(xo)\"라는 생명력을 믿으며,","y":0.41083779474609305,"width":0.3571740764461152,"x":0.5223669050832905},{"y":0.38969404188137413,"width":0.35159817351598177,"height":0.02093397745571668,"text":"의식과 제물을 통해 유지하려고 합니다.","x":0.5205479481354641},{"x":0.5205479418378997,"height":0.02254428341384873,"text":"일부는 강, 나무, 산, 동물, 하늘에 영이 있다고","y":0.36231884055287167,"width":0.40410958904109584},{"x":0.5228310496412264,"y":0.33655394508856684,"width":0.22374429223744285,"height":0.02254428341384862,"text":"믿으며, 해를 피하기 위해"},{"height":0.02254428341384862,"text":"그 영을 달래야 한다고 생각합니다.","x":0.5205479477739726,"width":0.31278538812785384,"y":0.31239935568974775},{"height":0.009661835748792202,"width":0.1963470319634703,"text":"Photo Source: Wikimedia","x":0.23744292433789954,"y":0.29951690827697264},{"height":0.02254428341384862,"text":"이런 생명력이나 영 두려워하지만,","x":0.5205479484246575,"width":0.3316209871475011,"y":0.2866344603220612},{"width":0.3264840182648402,"text":"영이나 조상을 숭배하지는 않습니다.","y":0.26247987118702554,"height":0.020933977455716568,"x":0.5205479475375081},{"height":0.024154589371980673,"y":0.24637681171497583,"width":0.3767123287671233,"text":"마티스족, 아마존의 최전방 미전도 종족","x":0.05251141866438349},{"width":0.3652968036529681,"height":0.019323671497584627,"text":"기독교 선교회는 현대 의학과 필터를 통해","x":0.5228310525114155,"y":0.21417069251207732},{"text":"• 인구: 약 400명 (2025년 8월 기준)","width":0.3675799086757991,"height":0.019323671497584516,"y":0.20772946884057975,"x":0.045662098544520587},{"x":0.04794520616438354,"width":0.0410958904109589,"height":0.009661835748792202,"y":0.18357487933440686,"text":"."},{"height":0.024154589371980673,"y":0.18518518494363934,"width":0.3744292237442922,"text":"깨끗한 물을 제공하지만, 가장 중요한 것은","x":0.5205479458447488},{"height":0.02162480085560281,"y":0.1783985490889295,"width":0.1508747954346818,"x":0.0889461651044653,"text":"종교: 토착 신앙"},{"y":0.16264090184178748,"width":0.34018264840182644,"x":0.522831052354452,"text":"마티스가 예수 그리스도의 복음을 듣는","height":0.020933977455716568},{"y":0.14975845417673106,"text":"• 언어: 마티스어","height":0.017713365539452464,"width":0.18493150684931506,"x":0.04566210161244291},{"height":0.020933977455716568,"text":"것입니다. 예수님만이 죄를 용서하고 악령의","y":0.1368760065351583,"width":0.38584474885844744,"x":0.5228310534436834},{"width":0.2146118721461187,"x":0.045662102245053245,"y":0.1207729468733224,"height":0.017713365539452575,"text":"• 기독교인: 0.01%"},{"text":"두려움에서 자유롭게 할 수 있습니다.","y":0.11111111133655394,"width":0.33333333333333337,"x":0.5205479457990867,"height":0.02254428341384862},{"width":0.1917808219178082,"x":0.08904109469178084,"y":0.09178743953301116,"height":0.019323671497584627,"text":"성경: 번역이 시작됨"}]