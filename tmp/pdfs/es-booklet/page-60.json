[{"x":0.02283105216894972,"text":"60 India - Yadav","height":0.011272141706924366,"y":0.9694041868558776,"width":0.1552511415525114},{"x":0.077544373736694,"y":0.9047992987741483,"height":0.01970897127848692,"width":0.0914865955370202,"text":"DÍA 22"},{"x":0.06164383608936724,"height":0.017713365539452575,"y":0.8518518519093627,"text":"India","width":0.06621004566210045},{"y":0.7832430718664467,"height":0.053481650237300005,"x":0.06581087948372051,"text":"Yadau","width":0.2496567817583476},{"width":0.2054794520547945,"x":0.23515981400304425,"text":"Fuente de foto: Wikimedia","y":0.4541062803811058,"height":0.011272141706924255},{"y":0.3929146535587762,"width":0.3493150684931507,"height":0.02254428341384862,"text":"• Población: 57,595,000","x":0.05707762796803652},{"y":0.3735909824637681,"width":0.18264840182648404,"x":0.09589040922374434,"text":"(en agosto 2025)","height":0.017713365539452464},{"y":0.3429951689076758,"width":0.3105022831050228,"text":"• Religión: Hinduismo","height":0.020933977455716568,"x":0.05707762480974125},{"width":0.22146118721461186,"y":0.31400966161433164,"x":0.05707762639840183,"height":0.017713365539452575,"text":"• Idioma: Hindi"},{"width":0.2899543378995434,"x":0.057077626461187206,"text":"• Cristianos: 0-0.1%","y":0.2834138484380032,"height":0.019323671497584516},{"y":0.25442834131776704,"x":0.057077622298325775,"text":"• Biblia: Nuevo Testamento:","width":0.39269406392694073,"height":0.017713365539452464},{"height":0.020933977455716568,"x":0.10958904457762551,"y":0.23027375227455715,"width":0.29680365296803646,"text":"Sí; Biblia Completa: Sí"},{"height":0.01610305958132041,"x":0.5616438316971083,"y":0.9291465375738057,"text":"Los yadav eran tradicionalmente","width":0.33105022831050224},{"x":0.561643839012557,"height":0.016103059581320522,"text":"pastores y vendedores de leche, quizá","y":0.9098228661433172,"width":0.3904109589041096},{"y":0.8921095008534622,"width":0.3105022831050228,"x":0.55936073369863,"text":"de Asia Central. Se identifican","height":0.01449275362318836},{"text":"estrechamente con su deidad de","height":0.011272141706924255,"x":0.561643832260274,"y":0.8743961351851852,"width":0.3356164383561644},{"width":0.317351598173516,"x":0.5616438324429225,"text":"casta, Krishna. Sin embargo, la","y":0.8534621577133655,"height":0.01610305958132041},{"y":0.8341384863768115,"height":0.016103059581320522,"text":"mayoría de los yadav hoy en día","x":0.5616438388584475,"width":0.32420091324200906},{"x":0.5616438417047181,"width":0.365296803652968,"height":0.01449275362318836,"text":"cultivan, mientras que menos de un","y":0.8148148148953301},{"height":0.016103059581320522,"x":0.5593607269634704,"text":"tercio trabaja con vacas. Viven casi","y":0.795491143252818,"width":0.363013698630137},{"height":0.01610305958132041,"text":"por toda la India y en el sur de Nepal.","x":0.5616438403538813,"y":0.7761674718196457,"width":0.3789954337899544},{"width":0.38584474885844755,"x":0.5616438325057078,"text":"La mayor concentración se encuentra","y":0.7568438001207729,"height":0.016103059581320522},{"y":0.7375201285560924,"text":"en los estados de Uttar Pradesh y","x":0.5616438412100454,"height":0.01610305958132041,"width":0.3447488584474886},{"y":0.7159130056658263,"height":0.021281094942691814,"text":"Bihar (norte de la India). Los yadav","width":0.3589906387677476,"x":0.559113565840957},{"height":0.01449275362318836,"x":0.5593607265125572,"text":"viven en familias extendidas. La","y":0.7004830916867956,"width":0.3264840182648402},{"x":0.5590826621268338,"text":"mayoría son vegetarianos, pero","height":0.021735788735406603,"width":0.32470243271083044,"y":0.6763053134761496},{"width":0.3287671232876712,"x":0.5616438358447488,"height":0.01449275362318836,"y":0.6618357485507247,"text":"muchos han empezado a comer"},{"x":0.5593607330397912,"width":0.34246575342465757,"y":0.6392914654819415,"text":"pescado, cordero, pollo y a veces","height":0.017713365539452575},{"x":0.5570776240011417,"text":"cerdo, pero no res.","width":0.1986301369863014,"y":0.6199677941022544,"height":0.017713365539452464},{"text":"Los yadav son vistos como social y","y":0.5829307567862894,"height":0.017713365539452575,"x":0.5593607280332681,"width":0.35844748858447495},{"text":"educativamente atrasados. Son uno","y":0.566827697020934,"height":0.014492753623188248,"width":0.36986301369863006,"x":0.5616438387366819},{"x":0.5593607305479452,"text":"de los pueblos más numerosos de","height":0.017713365539452464,"y":0.5458937199838969,"width":0.35159817351598166},{"text":"otras castas atrasadas (OBC).","height":0.017713365539452464,"width":0.31278538812785395,"x":0.5593607328277885,"y":0.5265700483436854},{"x":0.5614022042726612,"text":"Los yadav tienen tradiciones orales","height":0.019227972353138112,"y":0.48902036474440314,"width":0.36570384404430645},{"width":0.3926940639269406,"text":"expertas y cantos grupales sobre sus","y":0.46859903389694046,"x":0.5593607338660578,"height":0.016103059581320522},{"y":0.4492753622383253,"height":0.017713365539452464,"text":"dioses: Krishna, Vishnu y otros. Ellos","x":0.5593607279028051,"width":0.37671232876712324},{"x":0.5593607257420093,"y":0.43478260857487927,"text":"reclaman a Krishna como su ancestro","width":0.38812785388127846,"height":0.012882447665056418},{"text":"de sangre y por eso le están","width":0.28538812785388123,"y":0.41223832536231886,"height":0.016103059581320522,"x":0.5616438379946727},{"width":0.29452054794520555,"height":0.01449275362318847,"x":0.5616438380707762,"text":"especialmente devotos. Para","y":0.39452495980944713},{"x":0.5570776299942922,"y":0.37198067638888876,"height":0.017713365539452575,"width":0.3538812785388128,"text":"protegerse de las maldiciones, los"},{"x":0.5570776286986302,"height":0.019323671497584516,"width":0.31278538812785384,"text":"yadav confiaban en amuletos,","y":0.3526570048309179},{"text":"astrólogos y sanadores tradicionales.","x":0.5570776304223742,"height":0.019323671497584516,"width":0.3881278538812786,"y":0.33333333333333337},{"y":0.2962962962157809,"x":0.5570776221689498,"text":"Sus vidas y niveles de vida están","width":0.34018264840182644,"height":0.017713365539452575},{"width":0.39726027397260266,"y":0.2769726247020935,"x":0.5570776215981736,"text":"cambiando en todo el país. La próxima","height":0.019323671497584516},{"text":"generación necesitará buscar otros","height":0.020933977455716568,"y":0.2576489533715781,"x":0.55707762788242,"width":0.36986301369863017},{"text":"tipos de empleos, pero falta una","x":0.5570776239916285,"y":0.23832528199141167,"height":0.02254428341384873,"width":0.3356164383561644},{"text":"educación adecuada en muchos","width":0.3378995433789955,"y":0.22061191645732692,"x":0.5570776222831051,"height":0.019323671497584516},{"x":0.5570044878984977,"width":0.08690426447620136,"y":0.20110837114934244,"height":0.018073112684363513,"text":"lugares."}]