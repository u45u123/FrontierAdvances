[{"height":0.011272141706924366,"x":0.022831052425799046,"width":0.17579908675799086,"y":0.9694041868558776,"text":"38 India - Brahmin"},{"width":0.0821917808219178,"x":0.0776255700913242,"height":0.017713365539452464,"y":0.9049919484031133,"text":"DÍA 11"},{"x":0.06164383603025114,"width":0.06621004566210045,"text":"India","height":0.017713365539452464,"y":0.8518518519021739},{"x":0.059031378731509085,"width":0.37052171959724595,"text":"Brahmin","y":0.7814795545298017,"height":0.057008684929250375},{"text":"Fuente de foto: Wikimedia","x":0.2420091349600456,"width":0.20319634703196343,"height":0.011272141706924255,"y":0.5330112722020934},{"height":0.01610305958132041,"text":"Los brahman son uno de los grupos","y":0.48309178752012893,"width":0.3744292237442922,"x":0.0456621035768645},{"text":"más influyentes de la India, pero se han","x":0.04337899737442917,"width":0.4155251141552512,"y":0.462157809742351,"height":0.019323671497584627},{"width":0.4155251141552512,"height":0.017713365539452464,"y":0.44444444429683305,"text":"hecho pocos esfuerzos misioneros para","x":0.04566210331050221},{"y":0.42351046674718196,"width":0.3447488584474886,"height":0.019323671497584516,"text":"alcanzarios. Sin embargo, varios","x":0.04337899803082187},{"y":0.4039890279291901,"height":0.02385283975401553,"text":"hindúes de las castas superiores,","x":0.04305271092610779,"width":0.35241810698487447},{"height":0.019323671497584516,"x":0.04566210208333326,"width":0.4178082191780822,"text":"seculares y educados, están mostrando","y":0.38647343019323677},{"text":"signos de apertura al cambio.","y":0.36714975869565214,"height":0.019323671497584627,"width":0.31278538812785384,"x":0.04337899688926936},{"x":0.03881278242009137,"y":0.30273752007514765,"width":0.3561643835616438,"text":"• Población: 48,000,000","height":0.02254428341384862},{"text":"(en agosto 2025)","y":0.2818035429146538,"x":0.07762556860730596,"width":0.182648401826484,"height":0.019323671497584516},{"height":0.020933977455716568,"width":0.3127853881278539,"x":0.03652967913812792,"y":0.25120772920692436,"text":"• Religión: Hinduismo"},{"text":"• Idioma: Hindi, dialectos","x":0.038812788972602694,"y":0.22061191634460553,"width":0.3584474885844749,"height":0.020933977455716568},{"x":0.07074511845253183,"y":0.2027969214082196,"height":0.01630631813872463,"width":0.10508510293481556,"text":"locales"},{"x":0.03652967748858453,"height":0.019323671497584516,"y":0.1706924314975845,"width":0.2876712328767123,"text":"• Cristianos: 0.04%"},{"y":0.14170692455716583,"width":0.3926940639269407,"text":"• Biblia: Nuevo Testamento:","x":0.038812781678082296,"height":0.019323671497584627},{"y":0.11755233520531394,"width":0.29452054794520544,"height":0.02093397745571668,"text":"Sí; Biblia completa: Sí","x":0.08219178421803647},{"x":0.5342465749543378,"y":0.9597423508695653,"height":0.017713365539452464,"width":0.3264840182648402,"text":"Los brahman, tradicionalmente"},{"height":0.020735617037172638,"text":"sacerdotes, maestros y guardianas del","x":0.5318080088360577,"y":0.9380036541072573,"width":0.4204447498060253},{"y":0.9194847018518518,"text":"conocimiento sagrado, por milenios han","width":0.4292237442922374,"height":0.019323671497584516,"x":0.5319634711757991},{"width":0.3835616438356164,"text":"tenido un papel respetado en la vida","height":0.016103059581320522,"x":0.5319634688584475,"y":0.9017713363929146},{"y":0.8824476650724637,"text":"cultural y espiritual de la India.","x":0.5319634735616439,"width":0.32420091324200906,"height":0.017713365539452575},{"width":0.3274119128919628,"x":0.5360521208962263,"text":"Históricamente, sirvieron como","height":0.024289026736445285,"y":0.8611295781801169},{"y":0.8454106279656468,"x":0.5342465806697106,"text":"consejeros a los gobernantes,","height":0.016103059581320522,"width":0.319634703196347},{"width":0.410958904109589,"height":0.017713365539452575,"x":0.5319634737442921,"y":0.8244766506307031,"text":"administradores bajo el colonialismo, y"},{"y":0.8051529793075685,"x":0.531963473458904,"text":"siguieron en el gobierno después de la","width":0.40639269406392686,"height":0.019323671497584516},{"y":0.7890499195920558,"height":0.01610305958132041,"width":0.3013698630136986,"text":"independencia. Sus deberes","x":0.5342465803652966},{"height":0.017713365539452464,"x":0.5319634744977169,"width":0.4178082191780822,"y":0.768115942141707,"text":"tradicionales incluyen el sacerdocio del"},{"text":"templo, oficiando ritos de pasaje, y","x":0.5318348503525379,"width":0.3701220299010952,"y":0.7467739787286864,"height":0.01995821045216728},{"text":"sirviendo como maestros espirituales,","y":0.7309652523470408,"x":0.5340854301183349,"width":0.4022441846594963,"height":0.018830284020367016},{"y":0.7133655396537841,"width":0.43150684931506855,"x":0.5342465759417808,"text":"aunque muchos también se ocupan en la","height":0.016103059581320522},{"width":0.3287671232876713,"y":0.6924315620504562,"text":"agricultura, el comercio u otras","x":0.5342465808219176,"height":0.016103059581320522},{"y":0.6747181966384863,"text":"ocupaciones.","x":0.5342465754851599,"height":0.01449275362318847,"width":0.14383561643835618},{"x":0.5319634708447489,"text":"A pesar de su posición ritual alta, la","y":0.6328502417391304,"width":0.3812785388127854,"height":0.019323671497584627},{"height":0.01449275362318836,"text":"India moderna ha visto un declive en el","width":0.408675799086758,"y":0.6167471819070623,"x":0.5319634674005219},{"width":0.4337899543378996,"height":0.017713365539452464,"y":0.5958132045893719,"text":"privilegio brahmán debido a la política de","x":0.5319634746575341},{"y":0.5797101449919484,"width":0.363013698630137,"height":0.012882447665056418,"x":0.5342465789726026,"text":"acciones afirmativas a favor de las"},{"text":"castas más bajas. Alguna vez","width":0.3105022831050228,"x":0.5319634717808219,"y":0.557165861336554,"height":0.017713365539452575},{"x":0.534246568340944,"text":"dominantes en la política, la economía y","y":0.5394524959205582,"height":0.016103059581320522,"width":0.42009132420091333},{"width":0.4155251141552512,"height":0.01610305958132041,"x":0.5319634633942164,"y":0.5201288244766505,"text":"la cultura, los brahman ahora enfrentan"},{"x":0.5319634719939117,"text":"lo que muchos describen como","y":0.502415459178744,"width":0.33333333333333326,"height":0.01449275362318847},{"y":0.4814814813472893,"text":"discriminación a revés. Movimientos","x":0.5319634712328767,"width":0.3835616438356164,"height":0.01610305958132041},{"height":0.012882447665056418,"y":0.46537842195383783,"x":0.5342465807838659,"text":"contra los brahmanes han sido","width":0.3264840182648402},{"x":0.5342465722602739,"width":0.38584474885844755,"height":0.01449275362318836,"y":0.444444444299517,"text":"especialmente fuertes en el sur de la"},{"y":0.4235104670692431,"text":"India, una reflexión del resentimiento de","height":0.017713365539452464,"x":0.5342465823820394,"width":0.42237442922374424},{"x":0.5319634734208523,"width":0.3721461187214612,"y":0.4041867955716587,"height":0.01610305958132041,"text":"mucho tiempo de su influencia. Sin"},{"height":0.017713365539452575,"width":0.40410958904109584,"x":0.5342465768264839,"y":0.384863123698336,"text":"embargo, en promedio, los brahmanes"},{"width":0.41358696924496996,"height":0.01829194945797641,"y":0.36703977217591766,"x":0.5340900404024211,"text":"aún son relativamente bien educados y"},{"y":0.3424921755685283,"x":0.5339087400411453,"text":"seguros económicamente, con acceso a","width":0.42525537917603096,"height":0.02388871234396228},{"y":0.3285024151905529,"x":0.5342465802511415,"width":0.36757990867579904,"text":"escuelas de calidad para sus hijos.","height":0.01610305958132041},{"text":"La comunidad es diversa: los subgrupos","y":0.2898550724235105,"width":0.43150684931506855,"x":0.5319634649257993,"height":0.016103059581320522},{"y":0.2705314010466988,"width":0.27625570776255703,"x":0.5319634726217656,"text":"brahmanes pueden diferir","height":0.016103059581320522},{"x":0.5319634661529681,"text":"teológicamente, y los individuos pueden","width":0.4246575342465754,"y":0.24959742375201288,"height":0.019323671497584516},{"text":"ir desde hindúes devotos hasta","y":0.23510466994478962,"x":0.5319634726842791,"height":0.01449275362318836,"width":0.33105022831050235},{"text":"secularistas o ateos. Esta diversidad","y":0.21417069252818044,"x":0.5319634741780821,"width":0.38584474885844755,"height":0.01610305958132041},{"y":0.19279067633802416,"x":0.5318538578660684,"text":"dificulta generalizar sobre sus creencias.","width":0.43397020313837764,"height":0.01995366552601696},{"y":0.15780998395732704,"x":0.5365296853881277,"text":"Comprender los valores brahmanes: la","width":0.4018264840182648,"height":0.01449275362318836},{"y":0.13687600661835742,"width":0.410958904109589,"text":"disciplina, el aprendizaje y la búsqueda","x":0.5319634726484018,"height":0.017713365539452575},{"x":0.5316367850265719,"height":0.026239565605126747,"y":0.11422123138881757,"width":0.4001503513283925,"text":"de sabiduría, sigue siendo importante"},{"y":0.09822866366747185,"x":0.5319634705479451,"text":"para una conexión significativa","height":0.017713365539452464,"width":0.3287671232876712},{"height":0.01610305958132041,"y":0.0789049916800858,"x":0.5342465824200912,"width":0.4292237442922374,"text":"misionera. Para el evangelismo cristiano,"},{"y":0.06280193234031128,"x":0.5319634636605786,"width":0.3995433789954338,"text":"los enfoques que suelen ser efectivos","height":0.01449275362318836},{"width":0.41826532093901614,"text":"con grupos marginados parecen menos","x":0.5340068385358402,"y":0.039478119935175804,"height":0.021710587776417545},{"text":"adecuados para los brahman.","y":0.022544283172302726,"width":0.31278538812785395,"height":0.01449275362318836,"x":0.534246574543379}]