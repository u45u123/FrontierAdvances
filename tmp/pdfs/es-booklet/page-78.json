198069565218,"height":0.019323671497584516,"width":0.39497716894977164},{"x":0.5591384753811127,"text":"Afganistán y en las regiones del norte","y":0.8741406068816676,"width":0.3885375767537993,"height":0.021993723084577255},{"text":"de Pakistán. Hablan varias lenguas del","x":0.5593607355308219,"height":0.017713365539452575,"width":0.39497716894977164,"y":0.8566827698671498},{"width":0.27853881278538817,"y":0.8325281800724638,"text":"grupo lingüistico nuristani.","height":0.02254428341384862,"x":0.5593607273972603},{"y":0.8180354269082126,"text":"Etnicamente, el grupo de nuristanes","height":0.017713365539452464,"x":0.5593607268949772,"width":0.3744292237442923},{"y":0.7987117553301127,"text":"abarca ocho grupos: los ashkuni-","x":0.5593607340410958,"width":0.3447488584474886,"height":0.01610305958132041},{"width":0.36073059360730586,"height":0.017713365539452464,"text":"wamayi, narisati, grangali, kambiri,","y":0.7793880836755234,"x":0.557077621061644},{"x":0.5593607323344749,"text":"malakhel, waigeli, prasuni y tregami.","width":0.3721461187214612,"height":0.019323671497584516,"y":0.7600644124798712},{"y":0.7246376810923242,"height":0.01449275362318836,"text":"El contacto inicial entre los obreros","width":0.36073059360730586,"x":0.5593607275875192},{"text":"cristianos y el pueblo de Nuristán","x":0.5592156752352782,"y":0.7027949291797984,"width":0.34274619463916234,"height":0.018764666313134448},{"height":0.016103059581320522,"text":"ocurrió de forma indirecta. En aquel","width":0.36757990867579904,"x":0.5593607275304415,"y":0.6859903380568975},{"text":"entonces, Nuristán era conocido como","x":0.5613876033276106,"width":0.3977288372440425,"height":0.020344709620575552,"y":0.6655442410857567},{"height":0.017713365539452464,"text":"Kafiristán (tierra de los Kafires). Kafires","y":0.6457326889895331,"width":0.40639269406392686,"x":0.5593607337899543},{"text":"significa no musulmanes. El contacto","height":0.017713365539452464,"y":0.6264090178073001,"x":0.557077628805175,"width":0.3881278538812786},{"width":0.34529040610953554,"y":0.6067231708757558,"height":0.022700779679892702,"text":"llegó a través del ejército colonial","x":0.5567642862377974},{"y":0.5893719809715512,"text":"británico, especialmente del Cuerpo de","width":0.4018264840182648,"x":0.5616438301369865,"height":0.017713365539452575},{"text":"Guías. Entre sus reclutas, en Peshawar,","y":0.5688126597242329,"x":0.5614392021971611,"width":0.404567317875553,"height":0.01990339951814657},{"width":0.34931506849315064,"x":0.5570776282248858,"height":0.017713365539452575,"y":0.5507246379025765,"text":"había individuos de Kafiristán que"},{"x":0.5570776214897261,"y":0.5314009664251208,"text":"habían estado expuestos a enseñanzas","width":0.408675799086758,"height":0.019323671497584516},{"y":0.5152979068706387,"x":0.5593607332952816,"text":"cristianas mientras servían en el","width":0.33105022831050224,"height":0.016103059581320522},{"height":0.017713365539452575,"x":0.5593607313165906,"y":0.49275362320182503,"text":"ejército.","width":0.08675799086757985},{"x":0.559360730194064,"y":0.45410627995169084,"width":0.3972602739726028,"height":0.019323671497584516,"text":"Un soldado kafir que mostró interés en"},{"text":"aprender más sobre el cristianismo","height":0.017713365539452464,"x":0.5593607290810503,"width":0.363013698630137,"y":0.4363929148752014},{"x":0.5570776214897261,"height":0.01610305958132041,"text":"instó a los obreros cristianos a visitar su","y":0.4186795493156199,"width":0.41324200913242015},{"width":0.39574143222477887,"text":"tierra natal en Kafiristán. En 1864, dos","height":0.02500916448768209,"y":0.3937445344309377,"x":0.5589452946858482},{"y":0.37278669990960644,"x":0.5567454000292308,"width":0.38869504188293735,"height":0.023986073123852036,"text":"pastunes convertidos al cristianismo,"},{"text":"actuando por invitación de soldados","x":0.5593607343378996,"width":0.3744292237442922,"y":0.35909822871175523,"height":0.017713365539452575},{"text":"kafir, realizaron el primer viaje misionero","x":0.556927060368122,"y":0.33781544942143127,"width":0.4158372225826734,"height":0.02081130975302481},{"text":"registrado a Kafiristán. Su misión incluía","width":0.41552511415525106,"y":0.32045088573537306,"height":0.017713365539452464,"x":0.5570776290334856},{"x":0.5593607348458903,"width":0.38584474885844755,"y":0.2995169084541063,"height":0.019323671497584516,"text":"la enseñanza cristiana, la distribución"},{"width":0.39269406392694073,"text":"de escrituras traducidas (en un idioma","height":0.01610305958132041,"x":0.5616438375190257,"y":0.28502415485775634},{"width":0.40706178151309214,"x":0.5589959476340142,"text":"comercial) y la prestación de asistencia","y":0.26024275903761807,"height":0.024425870554458662},{"height":0.019753740221597926,"y":0.24305151922643187,"text":"médica a las comunidades locales.","width":0.36118226073103954,"x":0.5591518684908934},{"text":"Fueron recibidos positivamente. Al","width":0.35844748858447484,"y":0.22383252829307565,"x":0.5593607341780822,"height":0.017713365539452575},{"width":0.3610754143701841,"x":0.5591713145685318,"y":0.20381888759278888,"height":0.02033804465031286,"text":"partir ellos, la gente local envió una"},{"text":"carta solicitando que regresaran con","x":0.5616438376712328,"width":0.3744292237442922,"y":0.18679549087493297,"height":0.016103059581320522},{"width":0.408675799086758,"text":"más enseñanzas. No pudieron regresar.","x":0.5616438424277014,"height":0.016103059581320522,"y":0.16908212555018776},{"width":0.3721461187214612,"height":0.017713365539452575,"x":0.5593607276027398,"text":"Hay registros de otras personas que","y":0.14653784201288245},{"x":0.5570776247431506,"width":0.408675799086758,"y":0.13204508876811605,"height":0.01610305958132041,"text":"visitaron Kafiristán durante las décadas"},{"y":0.10732716819326538,"height":0.021623579200339194,"text":"siguientes, pero en 1896 la población","width":0.3838556368057042,"x":0.5592159417876856},{"width":0.38584474885844755,"height":0.017713365539452464,"y":0.09017713357487933,"text":"fue convertida por la fuerza al islam y","x":0.5570776217123288},{"y":0.0740740741223831,"x":0.5593607339497716,"width":0.3356164383561644,"text":"Kafiristán fue renombrado como","height":0.01449275362318847},{"width":0.24200913242009137,"y":0.05152979066022545,"text":"Nuristán, 'tierra de luz'.","x":0.5593607336187214,"height":0.019323671497584516}]