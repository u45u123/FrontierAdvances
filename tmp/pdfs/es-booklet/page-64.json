14024},{"height":0.016103059581320522,"text":"Hay 17 PF en las Amazonas. La gente","x":0.5730593654109587,"y":0.9436392911969941,"width":0.37671232876712335},{"height":0.012882447665056307,"x":0.5707762594063926,"text":"matis es uno de ellos. Los matis son","width":0.36986301369863017,"y":0.9275362319484702},{"x":0.5705509225220923,"text":"una pequeña tribu en el noreste de las","y":0.9061057825768943,"height":0.019278709055336907,"width":0.39310322940077413},{"x":0.5684931508675799,"height":0.019323671497584516,"text":"Amazonas brasileño, vulnerable a","y":0.8840579712077294,"width":0.3470319634703196},{"width":0.39497716894977164,"text":"enfermedades y a menudo explotados","x":0.5707762622907152,"y":0.8679549114868491,"height":0.016103059581320522},{"y":0.8486312397342995,"x":0.5707762573059361,"text":"por forasteros. No hay recursos","width":0.32420091324200906,"height":0.01610305958132041},{"y":0.8293075685024155,"width":0.3538812785388128,"text":"cristianos en su idioma, y hay muy","height":0.01610305958132041,"x":0.5707762592465753},{"text":"pocos, si es que hay alguno,","x":0.570776265330359,"width":0.2922374255036655,"height":0.01610305958132041,"y":0.809983897208803},{"width":0.33333333333333337,"height":0.01610305958132041,"text":"seguidores de Cristo entre ellos.","x":0.5707762523972604,"y":0.7906602252415459},{"text":"Aproximadamente la mitad de los","y":0.7520128822705314,"width":0.3447488584474886,"height":0.017713365539452464,"x":0.5684931477853882},{"x":0.5705724643383561,"width":0.3885907386535924,"height":0.020009990667567368,"text":"matis se ha trasladado a pueblos para","y":0.7326332586103232},{"height":0.017713365539452464,"x":0.5684931512557077,"width":0.34246575342465757,"text":"estudiar y trabajar, adoptando un","y":0.7117552332729469},{"y":0.6943068821380751,"height":0.019641901559875774,"x":0.5705687719747258,"text":"estilo de vida más urbano. Los que","width":0.35664273614752773},{"x":0.5703927030129227,"y":0.6727035034379611,"width":0.37738601475545797,"height":0.02286643797648713,"text":"permanecen en el bosque dependen"},{"y":0.6570048310466989,"text":"de la caza, la recolección, la pesca y el","x":0.5707762596575343,"width":0.39497716894977164,"height":0.01610305958132041},{"text":"cultivo de yuca. Su esperanza de vida","x":0.5707762530060883,"y":0.6376811591519056,"width":0.38584474885844755,"height":0.01610305958132041},{"text":"es baja, alrededor de 45 años, debido","width":0.3904109589041095,"height":0.017713365539452575,"y":0.6167471820585078,"x":0.5684931539383562},{"text":"a enfermedades y atención médica","x":0.5681128505376074,"y":0.5950557665373841,"width":0.3637439954226419,"height":0.025031949778877793},{"x":0.5707762617960424,"width":0.365296803652968,"text":"limitada. Los matis rurales se casan","y":0.5829307568706388,"height":0.01449275362318836},{"width":0.3538812785388128,"x":0.5684931509703196,"y":0.5603864732957595,"height":0.01610305958132041,"text":"dentro de la tribu y tienen muchos"},{"text":"hijos, aunque muchos no llegan a los","x":0.5683424006030903,"width":0.3815942703316746,"height":0.0206290274234594,"y":0.5390733141440789},{"height":0.019323671497584516,"width":0.34018264840182644,"text":"diez años. Cada vez más jóvenes","x":0.568493153053653,"y":0.5217391301932367},{"x":0.5684931497716895,"width":0.31506849315068497,"text":"matises están dejando la selva","height":0.017713365539452464,"y":0.5040257651167472},{"text":"tropical y alejándose del modo de vida","y":0.48138377639736885,"height":0.02422077529096367,"x":0.5681732095829787,"width":0.39553947971291736},{"width":0.27919692644789884,"height":0.019211213177912856,"text":"tradicional de sus abuelos.","y":0.4636298162864855,"x":0.5681790267292579},{"y":0.4299516907568437,"height":0.012882447665056418,"x":0.5707762521461187,"text":"Los matis creen en una fuerza vital","width":0.3561643835616439},{"height":0.017713365539452464,"text":"llamada \"xo\", que intentan influir","width":0.3378995433789954,"x":0.5684931500456621,"y":0.4074074072302738},{"height":0.016103059581320522,"text":"mediante rituales y ofrendas. Algunos","width":0.3904109589041095,"y":0.3880837359903382,"x":0.5684931539383562},{"y":0.36876006433172304,"x":0.5662100431669929,"text":"también piensan que los espíritus","height":0.017713365539452464,"width":0.34931506849315064},{"width":0.3356164383561643,"text":"habitan ríos, árboles, montañas,","x":0.5684931499143837,"y":0.3478260872181964,"height":0.020933977455716568},{"width":0.317351598173516,"text":"animales y el cielo, y que estos","x":0.5684931515696346,"y":0.3285024152173913,"height":0.019323671497584516},{"text":"espiritus deben ser apaciguados para","y":0.31078904985238864,"width":0.3881278538812786,"x":0.5684931474505328,"height":0.017713365539452464},{"x":0.5684931496289954,"text":"evitar daño. Viven con miedo de","width":0.3356164383561644,"height":0.017713365539452575,"y":0.291465378200483},{"x":0.5684931547374428,"y":0.2753623189009662,"text":"ofender esta fuerza vital o a los","width":0.32420091324200917,"height":0.01449275362318836},{"height":0.017713365539452464,"y":0.252818035205314,"x":0.5684931492865297,"text":"espiritus, aunque no adoran a","width":0.3082191780821917},{"text":"espíritus ni antepasados.","y":0.23510467010869573,"x":0.5684931483162102,"height":0.017713365539452464,"width":0.2625570776255707},{"height":0.01449275362318847,"x":0.5707762517579908,"y":0.1980676328019323,"text":"Los equipos cristianos pueden ofrecer","width":0.39497716894977164},{"width":0.3292528265687429,"x":0.5682599130288478,"y":0.17696981940613632,"height":0.018969409131773363,"text":"a los matis medicina moderna y"},{"text":"proporcionar filtros de agua para agua","height":0.016103059581320522,"x":0.5684931467351599,"y":0.15780998380032196,"width":0.39497716894977164},{"width":0.39497716894977175,"x":0.5684931502511414,"y":0.1384863125925926,"text":"limpia. Pero, lo más importante es que","height":0.019323671497584516},{"y":0.12399355866881379,"x":0.5684931450913244,"text":"los matis necesitan escuchar las","width":0.3356164383561644,"height":0.012882447665056307},{"text":"Buenas Nuevas de Jesucristo, que es","height":0.01610305958132041,"x":0.5730593636415525,"y":0.10144927516103053,"width":0.37899543378995426},{"y":0.0837359100241547,"x":0.5707762521404111,"width":0.3356164383561644,"height":0.01610305958132041,"text":"el único que puede perdonar sus"},{"width":0.36073059360730597,"text":"pecados y liberarlos del temor a los","y":0.06441223821256048,"x":0.5707762521004566,"height":0.01449275362318836},{"x":0.5684931519121005,"height":0.017713365539452575,"width":0.1986301369863014,"text":"espiritus malignos.","y":0.04186795469001603}]