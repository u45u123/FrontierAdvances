[{"x":0.022831052482876667,"y":0.9694041868558776,"height":0.011272141706924366,"width":0.18036529680365299,"text":"50 India - Mahratta"},{"width":0.08447488584474884,"height":0.017713365539452464,"y":0.9066022545189211,"x":0.0753424662813927,"text":"DíA 17"},{"text":"India","x":0.06164383603025114,"height":0.017713365539452464,"y":0.8518518519021739,"width":0.06621004566210045},{"x":0.06325736687753968,"height":0.05977915642534093,"width":0.3963163192958048,"text":"Mahratta","y":0.7800943187442573},{"height":0.011272141706924255,"x":0.24200913038812794,"y":0.5507246376006442,"width":0.2031963470319635,"text":"Fuente de foto: Wikimedia"},{"text":"• Población: 36,204,000","y":0.49114331718426496,"width":0.3561643835616438,"x":0.057077623026744954,"height":0.02254428341384873},{"y":0.47181964567230283,"width":0.19178082191780824,"height":0.017713365539452464,"text":"(en agosto 2025)","x":0.08904109349315073},{"height":0.020933977455716568,"width":0.3127853881278539,"x":0.05707762479071538,"y":0.4412238323537305,"text":"• Religión: Hinduismo"},{"y":0.4122383250402576,"width":0.2557077625570776,"height":0.019323671497584627,"text":"• Idioma: Marathi","x":0.05707762597031963},{"text":"• Cristianos: 0.00%","y":0.3816425121846484,"x":0.05707762796803648,"width":0.2876712328767123,"height":0.019323671497584516},{"height":0.017713365539452464,"y":0.35265700475040274,"text":"• Biblia: Nuevo Testamento:","x":0.054794516575342525,"width":0.3972602739726028},{"x":0.10273972719748857,"y":0.32850241519726253,"text":"Sí; Biblia completa: Sí","width":0.29452054794520544,"height":0.020933977455716568},{"text":"Los mahratta son orgullosos kshatriyas","y":0.9427620498218054,"x":0.550119677311589,"width":0.3997530654140804,"height":0.01702145716226422},{"height":0.01610305958132041,"y":0.9227053141170156,"width":0.28767121545800334,"text":"de Maharashtra, que hablan","x":0.5502283240061581},{"width":0.3953372136642944,"height":0.019107023874918694,"y":0.9044941412914512,"text":"principalmente maratí. Están ubicados","x":0.5500218394041844},{"x":0.5502283120243531,"height":0.01610305958132041,"width":0.36986301369863017,"y":0.8856682767042405,"text":"en todo Marathwaada, mientras que"},{"y":0.8679549115136875,"x":0.5502283144977168,"text":"algunos se encuentran a lo largo de las","width":0.3995433789954338,"height":0.01449275362318847},{"text":"fronteras con Karnataka. Un número","width":0.37671232876712324,"y":0.8486312397342995,"height":0.01610305958132041,"x":0.5479452072203197},{"y":0.8276972624597423,"height":0.017713365539452575,"width":0.3881278538812786,"x":0.5502283153538811,"text":"menor vive más al oeste, en Pakistán."},{"y":0.7906602256441224,"width":0.408675799086758,"height":0.01610305958132041,"text":"Pertenecen principalmente a los niveles","x":0.5525114104737444},{"text":"superiores de una sociedad rural.","x":0.5502283066971082,"width":0.3470319634703196,"y":0.7729468601449275,"height":0.01449275362318836},{"x":0.550228311849315,"text":"Principalmente \"kunbi\" (agricultores) de","width":0.41324200913242004,"height":0.017713365539452464,"y":0.7504025763123994},{"width":0.38620876503861656,"y":0.7321392474662813,"text":"clase, casi todas las familias mahratta","height":0.018622630268287255,"x":0.5523311888366936},{"height":0.01449275362318836,"text":"rurales poseen tierras y cultivan cultivos","y":0.7149758453099839,"x":0.550228305365297,"width":0.410958904109589},{"width":0.3470319634703196,"x":0.55022830673516,"text":"agrícolas. Las tierras suelen ser lo","y":0.6940418677536231,"height":0.016103059581320522},{"x":0.5502283103881279,"y":0.6747181961889426,"width":0.3721461187214612,"height":0.016103059581320522,"text":"suficientemente grandes como para"},{"y":0.6570048307367149,"height":0.01449275362318847,"text":"albergar tanto cultivos comerciales","x":0.5502283075627855,"width":0.35844748858447484},{"y":0.6366251353354067,"x":0.5498912489496975,"text":"como alimentarios.","width":0.19946069586766912,"height":0.018856077762425594},{"y":0.5990338162238324,"x":0.5502283110159818,"height":0.016103059581320522,"text":"Son liberales en comparación con otros","width":0.40639269406392686},{"y":0.5797101446591519,"text":"grupos indios. El matrimonio","x":0.5502283058980214,"width":0.29452054794520555,"height":0.01610305958132041},{"x":0.5502283209239663,"text":"concertado no se impone","width":0.26255706020686176,"y":0.5619967796296297,"height":0.01449275362318836},{"y":0.5410628020128825,"height":0.01610305958132041,"width":0.406392694063927,"text":"estrictamente, y un niño puede casarse","x":0.5502283155821917},{"height":0.012882447665056307,"width":0.3904109589041096,"y":0.5249597422302738,"x":0.5502283056221462,"text":"con una chica de su elección si ella es"},{"y":0.5040257647141707,"text":"brahmán o maratha. Los mahratta son","height":0.01449275362318836,"x":0.5502283108732876,"width":0.3904109589041096},{"y":0.4830917875201288,"text":"algo tolerantes con otras culturas. Pero","x":0.5479452105593606,"height":0.01610305958132041,"width":0.406392694063927},{"height":0.01610305958132041,"y":0.4637681156736446,"text":"al considerarse de casta alta, suelen","x":0.5502283143455098,"width":0.37671232876712324},{"text":"menospreciar a quienes consideran no","width":0.3995433789954338,"height":0.016103059581320522,"x":0.5502283171613392,"y":0.4460547504562533},{"text":"su igual. El objetivo principal de una","width":0.36986301369863017,"y":0.42351046676731074,"height":0.017713365539452464,"x":0.5479452045662101},{"text":"familia mahratta de clase media es un","width":0.3926940639269406,"y":0.4090177134138486,"height":0.01449275362318847,"x":0.5456621043835616},{"text":"futuro seguro para ellos y sus hijos, por","x":0.5479452095319634,"width":0.40639269406392686,"height":0.019323671497584516,"y":0.3848631237520129},{"width":0.3287671232876712,"y":0.3687600642780462,"text":"lo que el éxito financiero es una","x":0.5456620984018266,"height":0.01610305958132041},{"text":"preocupación dominante.","height":0.019323671497584516,"y":0.3478260871980676,"x":0.5479452051084475,"width":0.26712328767123295},{"height":0.01449275362318836,"x":0.5502283103881279,"width":0.38584474885844744,"y":0.31400966198067626,"text":"Los mahratta hindúes suelen adorar a"},{"width":0.3013698630136986,"height":0.016103059581320522,"text":"Shiva como su dios familiar y","x":0.5479452079908675,"y":0.2914653785024155},{"x":0.5479452084189497,"y":0.2721417071457327,"text":"consideran a Shivaji como su líder. La","width":0.38584474885844755,"height":0.017713365539452464},{"text":"mayoría venera su tierra y su tierra","y":0.2528180356481482,"height":0.017713365539452464,"width":0.3561643835616438,"x":0.5479452026255709},{"y":0.2367149757648953,"text":"como a su madre. Los mahratta","width":0.32420091324200917,"x":0.5502283064497718,"height":0.012882447665056307},{"y":0.21578099832528175,"width":0.4155251141552512,"text":"defienden ferozmente su cultura, lengua","x":0.550228306347032,"height":0.01610305958132041},{"y":0.1980676329106279,"text":"e historia. Esto plantea un punto","x":0.5502283146689496,"width":0.33333333333333326,"height":0.01449275362318847},{"x":0.5479452105878995,"text":"importante: el hinduismo es un aspecto","y":0.1787439614130435,"width":0.408675799086758,"height":0.01449275362318836},{"x":0.550228314589041,"height":0.01449275362318836,"y":0.15942028993558766,"text":"fundamental de su cultura. Decirles que","width":0.408675799086758},{"y":0.13848631219806762,"text":"dejen de dar lealtad a estos dioses suele","x":0.550228306107306,"width":0.41552511415525106,"height":0.01610305958132041},{"x":0.5502283143607305,"width":0.38584474885844755,"height":0.01449275362318836,"text":"verse como un ataque a su cultura. El","y":0.12077294697262475},{"x":0.5502283092180366,"text":"pueblo hindú mahratta necesita el","width":0.34931506849315075,"height":0.01610305958132041,"y":0.10144927556360717},{"width":0.39497716894977164,"y":0.08051529768518517,"height":0.017713365539452464,"x":0.5479452053938356,"text":"discernimiento espiritual y la humildad"},{"y":0.0644122382447666,"x":0.5502283056221462,"width":0.3904109589041096,"height":0.012882447665056418,"text":"necesaria para reconocer a Jesucristo"},{"width":0.16677398333266447,"text":"por lo que Él es.","height":0.019789599758031517,"y":0.04324529668034649,"x":0.5501746531948629}]