39452575,"y":0.4202898550241545},{"height":0.017713365539452464,"x":0.5593607336757991,"y":0.40418679558507786,"width":0.36986301369863017,"text":"el sur y luego en el este y norte. Los"},{"text":"misioneros indios también han","x":0.5570776275399543,"width":0.32191780821917815,"y":0.391304348047504,"height":0.017713365539452575},{"width":0.3812785388127854,"x":0.5593607306221462,"y":0.3719806761272142,"text":"desempenado un papel fundamental","height":0.01610305958132041},{"y":0.35853019185024004,"height":0.019095469980040303,"text":"en la difusión del evangelio. Sin","x":0.559265192333121,"width":0.3312085295376712},{"width":0.3812785388127854,"y":0.34299516916264083,"height":0.017713365539452575,"text":"embargo, el porcentaje de cristianos","x":0.5593607333170253},{"text":"entre los bagban sigue siendo del","y":0.3252818037681159,"height":0.02254428341384873,"x":0.5593607271461188,"width":0.3538812785388128},{"y":0.2769726246054751,"text":"Puesto que hay tan poca información","x":0.5593607285388128,"height":0.019323671497584516,"width":0.3881278538812786},{"y":0.26247987125603867,"text":"acerca de ellos, podría sentir que sea","x":0.5593607338089802,"height":0.016103059581320522,"width":0.38584474885844744},{"height":0.017713365539452464,"y":0.24798711756843805,"x":0.55707762956621,"text":"un pueblo olvidado. Oremos para que","width":0.3995433789954338},{"x":0.5547945238812785,"width":0.3835616438356164,"height":0.01610305958132041,"text":"los baghban sepa que Dios no los ha","y":0.23188405813204505},{"height":0.019323671497584627,"y":0.21417069245840048,"x":0.5593607314307458,"width":0.1004566210045662,"text":"dvidado."}]