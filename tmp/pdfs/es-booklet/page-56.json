318847,"x":0.5616438320776256},{"x":0.5616438321232877,"height":0.012882447665056307,"text":"musulmanes indios se encuentran","width":0.34931506849315075,"y":0.8937198066666667},{"height":0.01610305958132041,"x":0.5616438360730593,"text":"aislados política y socialmente.","width":0.319634703196347,"y":0.8711755231481482},{"x":0.5616438381563925,"text":"Aunque tienen una población muy","height":0.01610305958132041,"width":0.34931506849315075,"y":0.8534621580112721},{"height":0.017713365539452575,"x":0.5593607277397261,"width":0.3264840182648402,"y":0.8325281800590445,"text":"grande, su influencia política es"},{"text":"pequeña y sus voces a menudo son","x":0.5591008047517779,"width":0.36804004129209467,"y":0.8134889134363991,"height":0.02115545794967677},{"x":0.557077628795662,"height":0.016103059581320522,"text":"ignoradas o silenciadas.","width":0.25799086757990863,"y":0.7954911433172303},{"width":0.27853881278538806,"height":0.012882447665056307,"y":0.7600644123027376,"x":0.5616438384018264,"text":"Las tensiones con Pakistán"},{"x":0.5593607243911721,"height":0.01449275362318836,"text":"proyectaron una larga sombra sobre","width":0.3721461187214612,"y":0.7375201287439614},{"y":0.7198067630434782,"text":"los musulmanes indios. Los","x":0.5593607426515157,"width":0.2831050054123413,"height":0.01449275362318836},{"height":0.01449275362318847,"x":0.5616438391780821,"y":0.7020933977938808,"text":"nacionalistas hindúes enseñan a la","width":0.3561643835616438},{"text":"gente a desconfiar de ellos. Las","x":0.5616438382990867,"height":0.01449275362318836,"width":0.32191780821917804,"y":0.6811594203837896},{"width":0.35844748858447484,"x":0.5616438392009131,"height":0.012882447665056307,"text":"comunidades musulmanas a veces","y":0.6634460548148149},{"x":0.5570776264840184,"y":0.640901771095008,"text":"son llamadas \"mini pakistanies\" e","height":0.019323671497584627,"width":0.3470319634703196},{"text":"incluso consideradas espías. Esta","width":0.35159817351598177,"x":0.554794516152968,"y":0.6215780997987118,"height":0.019323671497584516},{"y":0.6054750403113258,"text":"idea se refuerza a través de la","height":0.01610305958132041,"x":0.5570776281392694,"width":0.3082191780821917},{"x":0.5616438382191781,"y":0.5845410628985508,"height":0.0161030595813203,"text":"educación, los medios de","width":0.26027397260273977},{"width":0.32191780821917804,"y":0.5652173911701557,"text":"comunicación y la socialización","height":0.01610305958132041,"x":0.5593607306126333},{"height":0.01449275362318847,"width":0.35844748858447484,"x":0.5616438386035008,"text":"cotidiana. A muchos hindúes se les","y":0.5475040258319914},{"text":"enseña desde pequeños que los","x":0.5616438389269406,"width":0.33105022831050224,"height":0.01449275362318836,"y":0.5281803543478262},{"y":0.507246377106817,"text":"musulmanes son ladrones, inmorales","width":0.3789954337899544,"height":0.017713365539452464,"x":0.5616438385844748},{"width":0.3158975888604987,"text":"y poco fiables. Esto conduce a","height":0.022133326568849143,"y":0.4865830599868505,"x":0.5588484930377748},{"x":0.5593607334284627,"width":0.34018264840182644,"y":0.46859903389694046,"height":0.016103059581320522,"text":"profundas divisiones sociales en"},{"y":0.4476650563808373,"width":0.3105022831050228,"text":"barrios, colegios y relaciones.","height":0.017713365539452464,"x":0.5570776294520547},{"x":0.5616438383751902,"y":0.41384863130703164,"text":"Aproximadamente el 90% de los","height":0.01449275362318847,"width":0.33105022831050224},{"width":0.32014636035379207,"y":0.39213953034909144,"text":"musulmanes indios trabajan en","height":0.020211215180475306,"x":0.5591576605222707},{"text":"empleos de baja calidad y con bajos","y":0.3719806762157809,"height":0.017713365539452464,"width":0.3721461187214612,"x":0.5570776218493151},{"y":0.3542673109822866,"width":0.37671232876712324,"text":"salarios. Muchos están excluidos de","x":0.5570776275570777,"height":0.019323671497584516},{"y":0.3333333331454643,"text":"una educación de calidad. Por eso, se","x":0.557077628348554,"width":0.3926940639269406,"height":0.02254428341384873},{"text":"les percibe ampliamente como sin","width":0.3561643835616438,"height":0.020933977455716568,"x":0.5570776230267449,"y":0.3156199677363699},{"height":0.02254428341384862,"text":"educación y pobres, y aún más","x":0.5570776265068493,"y":0.29468599011272145,"width":0.33105022831050224},{"x":0.559195706615669,"width":0.10991909079355733,"height":0.021810574616019096,"y":0.2781446319743167,"text":"excluidos!"}]