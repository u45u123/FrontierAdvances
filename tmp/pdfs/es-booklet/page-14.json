[{"y":0.969404187037037,"height":0.01449275362318847,"width":0.16666666666666663,"x":0.022831048820395786,"text":"14 | África - Fulani"},{"height":0.02134054217745529,"text":"DÍA 01","y":0.9047886659000048,"x":0.07981092200234226,"width":0.08695349845712043},{"height":0.020933977455716568,"width":0.07762557077625572,"x":0.0639269401826484,"text":"África","y":0.8518518519826892},{"width":0.31117182344062144,"height":0.05512115306516385,"x":0.06359217161607711,"y":0.7816181676630154,"text":"Fulani \/"},{"text":"Fulbe","height":0.054074703591265316,"width":0.22780231144874608,"y":0.7048467062122228,"x":0.06303948435391815},{"width":0.3789954337899543,"height":0.012882447665056307,"y":0.4074074075281804,"text":"PFuente de la foto: Dan Lundberg, Flickr, CC BY-","x":0.07534247049086744},{"y":0.39771028589569835,"width":0.054823618501288696,"height":0.011342713606338317,"x":0.3972457241583074,"text":"SA 2.0."},{"height":0.02254428341384862,"x":0.05479452340182641,"text":"• Población: 13,877,900","y":0.34621578110574336,"width":0.34246575342465757},{"y":0.32689210972222227,"height":0.017713365539452464,"x":0.09589041521118714,"width":0.363013698630137,"text":"(PF solamente desde agosto 2025)"},{"y":0.29629629636070853,"width":0.2397260273972603,"text":"• Religión: Islam","height":0.019323671497584627,"x":0.05479452294520543},{"x":0.05479452155251137,"text":"• Idioma: Fula","width":0.2054794520547945,"y":0.26892109518518537,"height":0.017713365539452464},{"y":0.23671497565217392,"text":"• Cristianos: Menos de 0.1%","width":0.3949771689497717,"x":0.0570776288356164,"height":0.019323671497584516},{"y":0.20450885674315622,"width":0.317351598173516,"height":0.020933977455716568,"x":0.054794524514840084,"text":"• Biblia-Porciones: Sí;"},{"text":"Nuevo Testamento: Sí","width":0.2968036529680365,"x":0.09817351227168958,"height":0.017713365539452575,"y":0.1867954910829308},{"text":"Los fulani son el grupo nómada más","x":0.5616438393835615,"width":0.37671232876712324,"y":0.9339774557809983,"height":0.016103059581320522},{"height":0.019543323731844753,"x":0.5613432681690417,"text":"grande del mundo. Durante más de","y":0.911850464365483,"width":0.3658327773281428},{"width":0.3972602739726028,"height":0.019323671497584627,"y":0.8904991948470209,"x":0.5593607355593606,"text":"1,000 años, han influido en la política,"},{"width":0.34550218277325917,"y":0.8691784391867088,"text":"el comercio y la religión de África","x":0.5590281724343827,"height":0.025597352720497013},{"x":0.5616438378995434,"y":0.855072463837129,"height":0.016103059581320522,"width":0.319634703196347,"text":"Occidental. Como los primeros"},{"text":"africanos occidentales en seguir el","x":0.5614336868017532,"y":0.8366915038059783,"width":0.3611789860137522,"height":0.020336495121512144},{"width":0.3634832025118614,"x":0.561381839441125,"text":"islam, lo difundieron a través de las","height":0.01995567269563292,"y":0.8173775552941958},{"y":0.7987117555018787,"text":"yihad y formaron un poderoso imperio","height":0.01610305958132041,"width":0.39726027397260266,"x":0.5593607345509893},{"width":0.15614113306890343,"x":0.5588386018841411,"height":0.020088652673742824,"y":0.7758611444222853,"text":"en el siglo XIX."},{"height":0.01610305958132041,"x":0.5616438416286147,"text":"Se les conoce por varios nombres:","width":0.36073059360730586,"y":0.7407407408480945},{"x":0.5593607354166665,"height":0.017713365539452464,"text":"fulani o fula (del hausa), peul o peulh","y":0.7198067633856683,"width":0.38584474885844744},{"width":0.271689497716895,"text":"(francés, del wolof), fulbe","y":0.6988727855676329,"height":0.020933977455716568,"x":0.5593607325057076},{"text":"(anglicanizado de fulfulde\/pulaar) y","x":0.5593607337442922,"height":0.019323671497584627,"y":0.6827697264412238,"width":0.3744292237442922},{"x":0.5570776247716895,"width":0.36073059360730586,"height":0.019323671497584516,"y":0.6618357490338165,"text":"fallata\/fellata (de kanuri, usado en"},{"width":0.16666666666666674,"y":0.6441223832326892,"text":"Chad y Sudán).","height":0.017713365539452464,"x":0.5593607326769406},{"y":0.603864734057971,"width":0.38812785388127846,"height":0.019323671497584516,"x":0.5593607353881278,"text":"Por tradición, los fulani son pastores,"},{"width":0.34763590494791663,"text":"desplazándose con su ganado en","x":0.5613149008889177,"height":0.022187537041263417,"y":0.5846498357533341},{"x":0.5593607338127854,"width":0.32191780821917804,"y":0.566827697278583,"text":"busca de hierba fresca y agua.","height":0.017713365539452464},{"height":0.016103059581320522,"x":0.5616438384703195,"y":0.5491143317874396,"text":"Conocidos por su profundo","width":0.28538812785388135},{"x":0.5591227642662083,"width":0.4091461390665133,"height":0.021171757180525663,"y":0.5271241517289995,"text":"conocimiento de la naturaleza, muchos"},{"x":0.559004889591452,"y":0.5054686878304688,"width":0.3751015510733269,"height":0.02470319320998149,"text":"aún viven así, mientras que otros se"},{"y":0.4911433173107891,"x":0.5593607336187214,"height":0.016103059581320522,"text":"han asentado en pueblos. Viven en","width":0.363013698630137},{"width":0.38584474885844744,"text":"casas sencillas y visten ropa colorida","x":0.5593607267351599,"height":0.01610305958132041,"y":0.47181964566827694},{"y":0.45088566803542673,"text":"con estampados. Hoy en día, muchos","x":0.559360733219178,"height":0.019323671497584516,"width":0.3926940639269406},{"y":0.43639291489533016,"width":0.3995433789954338,"height":0.01449275362318836,"text":"de ellos son comerciantes influyentes.","x":0.5616438304794522},{"x":0.5616438392465752,"width":0.363013698630137,"text":"Las familias fulani son muy unidas,","y":0.3961352657004831,"height":0.016103059581320522},{"x":0.5614900315007169,"height":0.021235633395528253,"text":"enseñando a los niños la cortesía, el","width":0.3770741501899615,"y":0.3764646594517975},{"height":0.01610305958132041,"y":0.35748792273752017,"text":"trabajo duro y el orgullo por su cultura.","x":0.5593607346575341,"width":0.406392694063927},{"text":"La música, la narración y la danza","height":0.019323671497584516,"x":0.5593607293835616,"y":0.3365539450563607,"width":0.34931506849315064},{"text":"desempeñan papeles importantes en","x":0.5616438324581432,"y":0.3204508859366614,"width":0.38584474885844755,"height":0.01610305958132041},{"x":0.561483314554336,"y":0.30052434841810305,"text":"sus vidas.","height":0.01569848513641603,"width":0.10534387527535494},{"y":0.25925925906602254,"text":"Lamentablemente, durante siglos ha","width":0.3789954337899544,"height":0.019323671497584627,"x":0.5593607307305936},{"text":"habido conflictos entre agricultores","x":0.5570776209189499,"width":0.3721461187214612,"height":0.017713365539452575,"y":0.24154589369967794},{"y":0.22383252840177137,"text":"sedentarios y pastores nómadas y","x":0.5616438376141552,"width":0.3561643835616438,"height":0.017713365539452464},{"x":0.5614570045974354,"y":0.20170391422619038,"text":"agricultores. Los agricultores acusan a","width":0.3998799084528397,"height":0.01917324895444128},{"y":0.18840579715512618,"text":"los nómadas de dañar sus cosechas","x":0.5616438387366819,"height":0.012882447665056307,"width":0.3744292237442922},{"y":0.1658615134192164,"x":0.5616438355783866,"text":"con sus rebaños, mientras que los","height":0.01610305958132041,"width":0.3538812785388128},{"width":0.33105022831050224,"y":0.14814814805152976,"text":"nómadas se quejan de robos de","height":0.01610305958132041,"x":0.5616438323059361},{"x":0.5616438326973255,"text":"ganado, problemas de acceso al agua y","width":0.408675799086758,"y":0.12721417060041407,"height":0.01610305958132041},{"y":0.10950080521739136,"text":"movimiento. Estos problemas pueden","width":0.3904109589041096,"x":0.561643839520548,"height":0.01610305958132041},{"x":0.5615164712226062,"y":0.08741513469160722,"width":0.3609958805450021,"height":0.01910037810099874,"text":"resolverse con paz, comprensión y"},{"y":0.06913776122063087,"height":0.01470354328984802,"text":"apoyo.","width":0.07314284860271303,"x":0.5593189869306768}]