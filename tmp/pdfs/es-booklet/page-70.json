04398098601},{"width":0.31735159817351605,"height":0.020933977455716568,"text":"No; Biblia completa: No","y":0.10144927515297908,"x":0.09817351376712331},{"width":0.37899543378995426,"x":0.5410958853120246,"text":"Hay 6 PF en Tukangbesi de Sulawesi,","height":0.01610305958132041,"y":0.9549114329039184},{"height":0.01449275362318847,"width":0.3812785388127854,"x":0.5433789926084475,"text":"Indonesia. Los wolio son uno de ellos.","y":0.9388083737721417},{"width":0.41324200913242015,"height":0.016103059581320522,"y":0.8985507247181964,"text":"El pueblo wolio (también conocido como","x":0.5410958938546422},{"y":0.8776167469887278,"width":0.363013698630137,"height":0.019323671497584627,"x":0.5410958885159818,"text":"Baubau, Buton o Butung) habita las"},{"text":"pequeñas islas de Buton, Muna y","y":0.8599033817230274,"width":0.34018264840182644,"x":0.5388127887899543,"height":0.017713365539452464},{"y":0.8421900158816426,"height":0.017713365539452464,"text":"Kabaena, en el sureste de Sulawesi. Son","width":0.408675799086758,"x":0.5433789927226027},{"y":0.8244766508319914,"text":"descendientes de inmigrantes del siglo","x":0.5433789962328767,"width":0.39497716894977175,"height":0.016103059581320522},{"text":"XV procedentes de Johor, Malasia, que","width":0.39497716894977164,"height":0.019323671497584516,"x":0.5410958920376712,"y":0.8019323669082126},{"width":0.39497716894977175,"height":0.019323671497584516,"y":0.7842190015458937,"text":"fundaron la dinastía Buton. En 1540, el","x":0.5388127814383561},{"text":"sexto rey se convirtió al islam,","height":0.017713365539452464,"x":0.5388127892694063,"y":0.7665056360507246,"width":0.3105022831050228},{"y":0.7520128823403114,"width":0.39497716894977164,"x":0.5410958838280064,"height":0.012882447665056307,"text":"transformando el reino en un sultanato"},{"text":"que duro hasta 1960. Hoy en dia, Buton","x":0.5410958937785387,"width":0.4018264840182648,"height":0.017713365539452353,"y":0.7278582928542674},{"y":0.7133655395128824,"height":0.01449275362318847,"x":0.5433790006563924,"width":0.4178082191780822,"text":"es conocida por su producción de asfalto"},{"width":0.34018264840182644,"height":0.01610305958132041,"x":0.5410958864440641,"y":0.6924315617954911,"text":"y se está explorando en busca de"},{"height":0.01449275362318847,"width":0.34018264840182655,"text":"recursos petrolíferos y minerales.","x":0.5433790011035005,"y":0.6747181964304885},{"text":"Muchos wolio han emigrado a otras","width":0.35844748858447484,"height":0.016103059581320522,"x":0.5433789968321918,"y":0.6553945247584541},{"y":0.63354227833392,"height":0.020457074262093755,"width":0.41805141919279754,"text":"regiones como Maluku y Papua en busca","x":0.5386957098225493},{"width":0.3680009885465718,"height":0.02098703307614047,"text":"de trabajo. Hablan el idioma wolio, y","x":0.5386179558172867,"y":0.6144860030778345},{"width":0.42009132420091333,"y":0.5990338163446055,"text":"algunos también entienden árabe, que se","height":0.01610305958132041,"x":0.5410958851598174},{"height":0.017713365539452464,"text":"utiliza en textos religiosos e históricos.","x":0.5388127855593607,"y":0.5797101451489534,"width":0.3972602739726028},{"y":0.5410628020128825,"text":"En los pueblos de los wolio, los mercados","width":0.42237442922374424,"x":0.5410958946347032,"height":0.017713365539452575},{"y":0.5217391305018787,"height":0.017713365539452464,"x":0.5388127887176559,"width":0.3995433789954338,"text":"venden tejidos como seda y algodón, y"},{"x":0.5409257671766726,"width":0.3771294720096676,"y":0.5055170525820964,"height":0.019123672479208764,"text":"son comunes las pequeñas tiendas y"},{"height":0.01449275362318847,"text":"vendedores ambulantes. Los wolio","y":0.48792270541465377,"width":0.35159817351598177,"x":0.541095894805936},{"height":0.016103059581320522,"x":0.5388127882705478,"width":0.3995433789954338,"text":"cultivan tanto tierra como mar: cultivan","y":0.4669887276570047},{"x":0.5388127833047945,"text":"arroz, maiz y yuca, y también algas","y":0.44605475064412237,"width":0.35844748858447484,"height":0.019323671497584516},{"y":0.4267657357561715,"width":0.3202603483853276,"x":0.538488995751537,"text":"marinas (agar-agar), de junio a","height":0.02329621338038057},{"text":"septiembre. Muchos también trabajan","y":0.4090177131441224,"x":0.5388127895833332,"width":0.3904109589041096,"height":0.017713365539452464},{"y":0.3905635479894076,"height":0.018670908302884537,"text":"como marineros y constructores navales,","x":0.5409932200966414,"width":0.42256753303144623},{"x":0.5388127896118721,"width":0.3378995433789955,"height":0.017713365539452575,"text":"aprovechando la rica vida marina","y":0.37198067638888876},{"text":"alrededor de Buton y Muna. Sus casas","width":0.39497716894977164,"x":0.5388127903253425,"y":0.3542673108494363,"height":0.017713365539452464},{"text":"tradicionales son elevadas, hechas de","y":0.3349436391143318,"width":0.3881278538812786,"x":0.5388127870776256,"height":0.017713365539452464},{"text":"tablas, con tejados de tablas de madera o","x":0.5388127896575341,"y":0.31561996787439617,"width":0.4269406392694064,"height":0.017713365539452575},{"y":0.2995169084138486,"text":"hojas de coco; los hombres trabajan al","height":0.01610305958132041,"width":0.39269406392694073,"x":0.5410958855593607},{"text":"aire libre mientras las mujeres manejan el","x":0.5410958957382038,"height":0.01610305958132041,"y":0.28019323644659155,"width":0.4200913242009132},{"text":"hogar y las finanzas. Baubau se ha","width":0.3538812785388128,"height":0.017713365539452464,"y":0.2592592590378422,"x":0.5388127819349315},{"x":0.541095893436073,"text":"convertido en una ciudad oficial, creando","height":0.017713365539452575,"y":0.24154589349838962,"width":0.4200913242009132},{"x":0.5388127886605782,"y":0.22383252826086963,"height":0.01610305958132041,"text":"oportunidades de desarrollo; el pueblo","width":0.39269406392694073},{"x":0.5385954176200961,"y":0.20413766544565093,"width":0.37485131390018556,"height":0.021019212289708822,"text":"wolio valora mucho la educación y el"},{"x":0.5384028448777969,"width":0.40492541169467033,"y":0.18098709144363,"text":"aprendizaje de idiomas, lo que conduce","height":0.02622731065980477},{"y":0.16908212557702618,"x":0.5410958932267884,"height":0.014492753623188581,"width":0.16894977168949765,"text":"al avance social."},{"y":0.13204508832528183,"x":0.5410958844368343,"text":"Casi todos los wolio tienen creencias","width":0.37671232876712335,"height":0.01449275362318836},{"y":0.11111111101449267,"height":0.01610305958132041,"x":0.5388127815981736,"width":0.3789954337899544,"text":"centradas en el islam sufi. Según sus"},{"text":"enseñanzas, practican la meditación","x":0.5410958857305938,"height":0.01610305958132041,"y":0.09339774549114344,"width":0.3744292237442923},{"width":0.36757990867579915,"x":0.538812782324962,"height":0.01610305958132041,"y":0.07407407396672039,"text":"para recibir visiones de Dios o para"},{"height":0.012882447665056418,"y":0.05797101439613517,"text":"encontrar verdades ocultas mucho más","x":0.54109588630137,"width":0.410958904109589},{"text":"allá de su propio razonamiento.","height":0.01610305958132041,"x":0.5388127886073059,"y":0.03703703703703709,"width":0.32191780821917815}]