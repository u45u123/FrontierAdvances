01449275362318836,"x":0.5616438394748858},{"text":"palabra sánscrita para aceite.","width":0.31506849315068497,"x":0.5593607345319633,"height":0.01610305958132041,"y":0.8711755233494364},{"width":0.33105022831050224,"text":"Tradicionalmente pertenecen al","height":0.01449275362318836,"x":0.5616438321537293,"y":0.8550724640096619},{"text":"tercer de los cuatro niveles del","x":0.5593607326864535,"y":0.8373590984433709,"width":0.32191780821917815,"height":0.012882447281129528},{"x":0.5591394489496149,"y":0.8146578054958743,"height":0.01751231686504562,"text":"sistema de castas.","width":0.1993332954302226},{"y":0.7777777775966184,"width":0.31506849315068486,"text":"A medida que la extracción de","height":0.01449275362318836,"x":0.5616438345319635},{"width":0.38584474885844755,"height":0.019323671497584516,"x":0.5616438367960426,"text":"petróleo se mecanizó, muchos de los","y":0.755233494041868},{"x":0.5570776258847032,"y":0.7359098226449275,"width":0.3082191780821918,"text":"teli ahora trabajan en labores","height":0.017713365539452464},{"x":0.5616438310882802,"text":"agrícolas y laborales. Muchos no","width":0.34018264840182644,"y":0.7181964576221149,"height":0.017713365539452353},{"text":"poseen tierras, y algunos se han","x":0.5616438412480973,"y":0.6988727858829844,"height":0.016103059581320522,"width":0.3378995433789954},{"y":0.6795491145249597,"width":0.3264840182648402,"x":0.5570776258675799,"height":0.019323671497584627,"text":"registrado como \"Otras Castas"},{"y":0.6602254430273752,"text":"Retrasadas\" para recibir apoyo","x":0.5593607297260275,"width":0.32420091324200917,"height":0.019323671497584516},{"y":0.639291465136876,"x":0.5593607347602739,"height":0.019323671497584627,"width":0.38812785388127846,"text":"gubernamental. Algunos teli trabajan"},{"width":0.3356164383561644,"text":"en los negocios, el gobierno y la","height":0.019323671497584405,"x":0.5593607271404112,"y":0.6199677941223833},{"y":0.6038647342592592,"text":"política.","width":0.08904109589041098,"x":0.5570776244577627,"height":0.01610305958132041},{"x":0.5593607351883559,"y":0.5636070853663446,"width":0.36757990867579915,"height":0.017713365539452464,"text":"El pueblo teli vive por toda la India."},{"text":"Un pequeño número vive en","height":0.017713365539452575,"x":0.559360734275114,"width":0.29452054794520555,"y":0.545893719826892},{"y":0.5249597424315621,"height":0.019323671497584516,"x":0.5593607332191781,"text":"Bangladés, Nepal, Sri Lanka o","width":0.31506849315068486},{"y":0.5067754112206246,"x":0.559197975734322,"text":"Pakistán.","width":0.10078213312854511,"height":0.01865529630111229},{"x":0.5593607332876712,"width":0.26940639269406386,"height":0.01610305958132041,"text":"Los ancianos teli arreglan","y":0.46859903388083746},{"width":0.3926940639269406,"height":0.01610305958132041,"text":"matrimonios dentro de la comunidad,","x":0.5616438420852357,"y":0.44927536205045626},{"text":"y las dotes se pagan en efectivo o","y":0.43156199694041864,"width":0.3561643835616438,"height":0.01610305958132041,"x":0.5593607330136986},{"width":0.3378995433789954,"text":"con objetos de valor. Aunque las","y":0.41223832536231886,"height":0.016103059581320522,"x":0.5616438384322678},{"width":0.3885401198853097,"y":0.39255741954490164,"text":"mujeres tienen un estatus social más","x":0.5614106050943534,"height":0.019742942662630658},{"width":0.3789954337899544,"text":"bajo, desempeñan papeles clave en","height":0.019323671497584627,"y":0.3703703704508855,"x":0.557077630308219},{"width":0.3561643835616438,"text":"actividades religiosas y sociales y","y":0.3542673107085347,"height":0.01610305958132041,"x":0.5570776211187216},{"width":0.38584474885844755,"x":0.5570776232591325,"height":0.017713365539452464,"text":"contribuyen a los ingresos familiares","y":0.33333333311191626},{"height":0.01610305958132041,"width":0.271689497716895,"x":0.5570776228538813,"text":"mediante trabajos extras.","y":0.3156199676972624},{"y":0.27554630773877997,"height":0.020975608180686445,"width":0.3610761111185431,"text":"Los teli son en su mayoría hindúes","x":0.5591854139484392},{"height":0.017713365539452464,"y":0.25764895336822335,"x":0.5593607336948249,"text":"que tienen rituales especiales para","width":0.3721461187214612},{"text":"bodas, partos y funerales. Incineran a","x":0.556883364152531,"height":0.026404649547140724,"y":0.23559067490960361,"width":0.3977458727414205},{"width":0.37265930872529607,"text":"sus muertos y esparcen las cenizas","y":0.2185327248508261,"height":0.020473466403242546,"x":0.5591241681836281},{"text":"en ríos sagrados. Honran a sus","width":0.32420091324200917,"height":0.017713365539452464,"y":0.20128824498792275,"x":0.5593607275684932},{"width":0.3561643835616439,"x":0.5593607344748858,"height":0.019323671497584516,"text":"antepasados y buscan protección","y":0.18196457351046702},{"x":0.5590264951308701,"text":"contra los espíritus malignos.","y":0.16026317696202663,"height":0.022098518992007876,"width":0.3112449123434825},{"width":0.3378995433789955,"text":"Espiritualmente, son prácticos y","y":0.14170692412238328,"height":0.019323671497584516,"x":0.5593607306849315},{"x":0.5593607334094368,"y":0.12399355884326357,"text":"adoran a una \"diosa que cumple","height":0.017713365539452464,"width":0.3378995433789954},{"x":0.5616438333561644,"height":0.017713365539452575,"text":"deseos\" y creen que responde a sus","y":0.10628019341384853,"width":0.37671232876712324},{"x":0.5615238117137752,"y":0.08810085431216264,"text":"oraciones.","height":0.015424700750820919,"width":0.10982908832428118}]