8264840182655,"text":"Los sylheti viven en el noreste de"},{"width":0.4200913242009132,"x":0.5433789933789955,"text":"Bangladesh, entre la División de Sylhet y","y":0.930756843578905,"height":0.017713365539452464},{"y":0.9130434782608696,"height":0.01610305958132041,"text":"el distrito de Karimganj en Assam, India.","width":0.4200913242009132,"x":0.5433790024353117},{"text":"Los sylheti, en el valle de Barak, Assam,","width":0.41552511415525106,"y":0.8921095008252818,"x":0.5410958956050227,"height":0.017713365539452464},{"width":0.35844748858447484,"y":0.8792270533548041,"x":0.5433789999619482,"text":"enfrentan dificultades económicas","height":0.012882447281129528},{"height":0.019323671497584516,"y":0.853462157568438,"width":0.3470319634703196,"x":0.5410958946917808,"text":"debido al aislamiento geográfico,"},{"height":0.01449275362318836,"width":0.40410958904109595,"y":0.8373590983413849,"x":0.5433789994748858,"text":"mientras que el noreste de Bangladesh"},{"text":"es más próspero con plantaciones de té,","y":0.8164251204777241,"width":0.42237442922374424,"height":0.017713365539452464,"x":0.5433790023972601},{"y":0.800322061164788,"width":0.28082190038951027,"height":0.01449275362318836,"x":0.5433790088235095,"text":"bosques y cultivo de arroz."},{"text":"Silôt es una ciudad metropolitana en","height":0.016103059581320522,"x":0.5433789918949772,"width":0.3789954337899544,"y":0.760064412037037},{"width":0.3972602739726028,"x":0.5433789988584473,"text":"crecimiento con una economía fuerte.","y":0.7423510469672572,"height":0.01610305958132041},{"height":0.0161030595813203,"text":"Muchas familias sylheti que viven en el","x":0.5433789987823439,"y":0.72141706935051,"width":0.4018264840182648},{"x":0.5410958935312024,"text":"extranjero, en Reino Unido, Estados","width":0.3744292237442923,"height":0.019323671497584516,"y":0.7004830918679549},{"width":0.4178082191780822,"height":0.017713365539452464,"x":0.5410958920376712,"text":"Unidos y el Medio Oriente, han invertido","y":0.6811594200684381},{"x":0.5433789997488584,"y":0.6650563607246377,"width":0.43150684931506844,"text":"en la ciudad para apoyar a su comunidad.","height":0.01449275362318836},{"x":0.5410958873515982,"text":"Silôt ha sido un centro comercial desde","width":0.410958904109589,"y":0.6457326890499195,"height":0.01610305958132041},{"x":0.5410958933463796,"text":"la época de los rajas en el antiguo reino","y":0.6247987118587531,"width":0.410958904109589,"height":0.017713365539452464},{"y":0.6067559264397,"height":0.018372205528468077,"x":0.5387053995351712,"width":0.10752070875472663,"text":"brahmán."},{"x":0.5410958942636985,"width":0.3721461187214612,"height":0.019323671497584405,"y":0.5668276975040258,"text":"Desde el siglo XIV, los santos sufies"},{"width":0.3812785388127854,"height":0.01610305958132041,"text":"(Pirs) han influido fuertemente en el","x":0.5410958931343769,"y":0.5507246377501726},{"y":0.5297906603059581,"text":"pueblo sylheti. Son respetados como","width":0.3881278538812786,"height":0.01610305958132041,"x":0.5410958952625569},{"width":0.4246575342465754,"y":0.5104669888083735,"x":0.5410958934442269,"text":"líderes espirituales incluso después de la","height":0.017713365539452575},{"height":0.017713365539452575,"x":0.5410958871575344,"y":0.48953301105072455,"text":"muerte, y la gente visita sus santuarios y","width":0.42465753424657526},{"x":0.5410958935216894,"text":"celebra festivales anuales (urs). Muchos","width":0.42237442922374435,"height":0.017713365539452464,"y":0.4718196455112721},{"height":0.02154004055520764,"width":0.36578477136620646,"y":0.4523046160153702,"x":0.5408195762204715,"text":"sylhetis también practican visitas a"},{"text":"santuarios, creen en la brujería y el mal","y":0.43478260861513685,"width":0.40639269406392686,"x":0.5433789920471842,"height":0.01610305958132041},{"text":"de ojo, y a menudo buscan ayuda de","y":0.41545893713365534,"width":0.3789954337899544,"height":0.01610305958132041,"x":0.5433789916438357},{"text":"curanderos en lugar de médicos.","width":0.3447488584474886,"height":0.017713365539452464,"y":0.3961352658776167,"x":0.541095892305936},{"text":"Los matrimonios sylheti suelen mezclar","x":0.5410958945205478,"width":0.410958904109589,"height":0.016103059581320522,"y":0.3574879228019324},{"height":0.017713365539452575,"x":0.5410958942922374,"text":"tradiciones islámicas e hindúes y son","y":0.3381642512882448,"width":0.3881278538812786},{"x":0.5410958933789954,"width":0.4155251141552512,"text":"concertados dentro de la comunidad de","y":0.32206119169542213,"height":0.012882447665056418},{"text":"habla sylheti. Los lazos familiares, la","x":0.5388127816210047,"y":0.29951690816425114,"width":0.37671232876712335,"height":0.017713365539452575},{"text":"implicación comunitaria y la preservación","width":0.43150684931506855,"height":0.017713365539452464,"x":0.5388127864155251,"y":0.2801932365378422},{"text":"cultural son muy valorados. Las mujeres","y":0.260869565136876,"width":0.4155251141552512,"height":0.017713365539452464,"x":0.5410958862557078},{"x":0.5410958932322244,"y":0.24476650569358172,"width":0.39497716894977175,"height":0.01449275362318847,"text":"a menudo enfrentan desafíos sociales"},{"y":0.22544283421900158,"height":0.01449275362318836,"text":"debido a las normas patriarcales y a vivir","width":0.42237442922374424,"x":0.5433789996575342},{"height":0.01610305958132041,"width":0.42922374429223753,"x":0.5433790020547943,"y":0.2061191629092861,"text":"con la familia del marido. Su estatus varía"},{"x":0.5410958873515982,"text":"según la clase social, y el matrimonio","y":0.18518518536231876,"width":0.3881278538812786,"height":0.017713365539452575},{"y":0.16747181972624803,"width":0.42922374429223753,"height":0.01449275362318847,"x":0.5410958975646877,"text":"puede suponer una transición estresante"},{"width":0.30365296803652975,"x":0.5433789984703196,"height":0.016103059581320522,"text":"para muchas mujeres sylheti.","y":0.14814814818035427},{"height":0.01610305958132041,"x":0.5433789997488584,"y":0.10950080515297911,"width":0.43150684931506844,"text":"La lengua sylheti, con su propia escritura,"},{"y":0.0884279949498078,"height":0.020804096535208094,"text":"es hablada por unos 13 millones de","width":0.36353427416657746,"x":0.5430799901731096},{"width":0.406392694063927,"y":0.07246376797101461,"x":0.5433789915981736,"height":0.01449275362318836,"text":"personas en todo el mundo. Les da una"},{"x":0.5388127892009131,"width":0.43150684931506855,"text":"fuerte identidad regional y una conexión","y":0.05152979083735909,"height":0.017713365539452464},{"x":0.5410958912385846,"width":0.3356164383561644,"text":"con la comunidad global sylheti.","y":0.030595812983091775,"height":0.017713365539452464}]