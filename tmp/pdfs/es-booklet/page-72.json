[{"text":"72 Asia otros - los PF en Irán","y":0.9694041870101986,"width":0.269406375275355,"x":0.022831055284697106,"height":0.012882447281129528},{"text":"DíA 26","x":0.07528122649934849,"height":0.019606303093706035,"width":0.08916357554257187,"y":0.9048506328635704},{"width":0.12563726346786708,"height":0.01794939225422587,"text":"Asia otros","x":0.05476127593405567,"y":0.8549544501763091},{"height":0.05581065806021812,"text":"PF en","width":0.24020854305458939,"x":0.04998705368714397,"y":0.7852991780126216},{"height":0.0531400966183575,"text":"Irán","y":0.7246376814251207,"width":0.182648401826484,"x":0.04794520550228311},{"text":"Fuente de foto: Shadegan - Wikimedia","x":0.1506849278253426,"y":0.47826086950483093,"height":0.011272141706924255,"width":0.2945205479452055},{"x":0.20547944917237454,"text":"Licensed under CC BY-SA 4.0","width":0.2305936073059361,"height":0.011272141706924366,"y":0.4637681158816426},{"y":0.4041867953032743,"height":0.02254428341384862,"x":0.05707762484779299,"text":"El luri feyli, uno de los PF en","width":0.3881278538812785},{"height":0.019323671497584627,"y":0.38486312380032206,"x":0.05479452102739725,"text":"trán","width":0.05707762557077625},{"height":0.024154589371980673,"text":"• Población: 2,588,000","x":0.05707762839611863,"y":0.32850241515700485,"width":0.3356164383561644},{"x":0.09360730339611878,"y":0.3075684379227054,"text":"(en agosto 2025)","width":0.2031963470319635,"height":0.019323671497584516},{"y":0.2753623187734836,"width":0.2420091324200913,"height":0.020933977455716568,"text":"• Religión: Islam","x":0.05479451853120248},{"y":0.24315619961084267,"height":0.020933977455716568,"x":0.05707762265981741,"width":0.34931506849315064,"text":"• Idioma: Luri (del norte)"},{"width":0.2831050228310502,"text":"• Cristianos: 0.01%","height":0.019323671497584516,"x":0.05707762840182646,"y":0.21095008061191634},{"x":0.05707762857686448,"width":0.4337899543378995,"height":0.019323671497584516,"text":"• Biblia: Nuevo Testamento: Sí","y":0.1787439611916265},{"width":0.3561643835616438,"height":0.01449275362318836,"text":"Los luri viven principalmente en las","y":0.9307568436553946,"x":0.5616438350228311},{"x":0.5593607255993152,"height":0.016103059581320522,"y":0.9098228662640901,"width":0.3995433789954338,"text":"regiones occidental y suroeste de Irán,"},{"height":0.01610305958132041,"width":0.4018264840182648,"text":"especialmente en las montañas Zagros","y":0.890499194916034,"x":0.5593607334637963},{"width":0.40410958904109584,"y":0.8711755230810521,"x":0.5593607313165906,"height":0.01610305958132041,"text":"y sus alrededores. Algunos luri viven en"},{"height":0.017713365539452464,"x":0.5593607347488584,"width":0.4155251141552512,"y":0.8518518519323671,"text":"Irak. Son pueblos nómadas que trabajan"},{"text":"como pastores y viajan de seis a ocho","x":0.5613058028413965,"width":0.3910348622221925,"y":0.8304449632201498,"height":0.02336991658725207},{"x":0.5616438335235922,"y":0.8132045091519056,"height":0.017713365539452464,"width":0.3447488584474886,"text":"meses al año, viviendo en tiendas"},{"x":0.5591546847337618,"height":0.019024953366093778,"text":"negras de pelo de cabra. Viven en","y":0.7940972741720224,"width":0.3474408850822275},{"height":0.017897492253646008,"x":0.5592367938199512,"text":"viviendas permanentes durante unos","y":0.774570689337474,"width":0.38152888049818057},{"width":0.3926940639269406,"x":0.5593607240487065,"text":"meses en invierno. Algunos luri se han","y":0.7584541061460011,"height":0.01449275362318847},{"height":0.01449275362318836,"text":"asentado en aldeas porque prefieren la","x":0.561643839611872,"y":0.739130434863124,"width":0.3995433789954338},{"height":0.017713365539452575,"x":0.5593607337519025,"text":"agricultura a la pastorela. El trigo y la","y":0.7165861514626946,"width":0.3789954337899544},{"height":0.016103059581320522,"y":0.6988727858293076,"text":"cebada son sus principales cultivos.","width":0.3721461187214612,"x":0.5616438418188735},{"text":"Los luri creen que el éxito de un pastor","x":0.5616438422374427,"y":0.6618357488996243,"width":0.3972602739726028,"height":0.016103059581320522},{"text":"depende de sus cualidades personales y","x":0.5616438390791476,"height":0.01449275362318847,"y":0.6425120773617821,"width":0.4155251141552512},{"y":0.6215780996618357,"text":"de su buena suerte. La sociedad luri","height":0.017713365539452464,"width":0.3744292237442922,"x":0.5570776259817353},{"height":0.017713365539452353,"x":0.5593607264840184,"y":0.603864734520934,"width":0.3972602739726028,"text":"está dominada por quienes poseen los"},{"height":0.017713365539452464,"width":0.40410958904109584,"x":0.5593607255422377,"text":"rebaños más grandes y que tienen más","y":0.5845410627012884},{"x":0.5616438338356164,"y":0.5684380033494364,"width":0.33333333333333337,"height":0.012882447665056307,"text":"dinero. Esta clase alta contrata a"},{"height":0.017713365539452464,"text":"miembros de la clase baja para cuidar","x":0.5593607335616438,"width":0.3881278538812786,"y":0.5458937199838969},{"y":0.5265700481749865,"text":"de sus rebaños. La mayoría de los luri","width":0.3835616438356164,"height":0.01610305958132041,"x":0.559360731392694},{"y":0.5072463768384328,"height":0.01610305958132041,"x":0.5593607340563166,"width":0.4155251141552512,"text":"pertenece a la clase baja de la sociedad."},{"width":0.3287671232876713,"height":0.01449275362318847,"x":0.5593607333333332,"text":"Los luri son musulmanes chiltas","y":0.47020933984165325},{"text":"practicantes. Han adoptado un sistema","width":0.4018264840182648,"y":0.45088566847826084,"height":0.01610305958132041,"x":0.5616438341324202},{"y":0.4315619968599035,"height":0.01610305958132041,"text":"de creencias muy práctico con prácticas","x":0.5616438390601217,"width":0.41324200913242004},{"text":"religiosas sencillas. Les encantan los","width":0.37711180943876643,"y":0.4118449315260049,"height":0.019891110787261135,"x":0.559147595403856},{"y":0.3961352655797101,"text":"santuarios dedicados a hombres santos","x":0.5593607254566212,"width":0.410958904109589,"height":0.012882447665056418},{"text":"(fundadores de varios grupos islámicos)","height":0.017713365539452464,"width":0.4178082191780822,"y":0.37198067624798714,"x":0.5570776225864319},{"x":0.5570776271118723,"y":0.3526570049194847,"height":0.020933977455716568,"width":0.3082191780821917,"text":"y los utilizan como lugares de"},{"width":0.4178082191780822,"text":"peregrinación. Debido a que se cree que","x":0.5570776220890411,"height":0.017713365539452464,"y":0.3349436392243693},{"height":0.017713365539452464,"width":0.3470319634703196,"text":"estos santuarios poseen poderes","y":0.31723027365807843,"x":0.5570776226788432},{"text":"curativos, personas con enfermedades","y":0.2935326480731165,"x":0.5567926631932825,"width":0.40699130541657746,"height":0.026744311174524804},{"text":"fisicas y psicológicas los visitan cada","y":0.2769726247504025,"height":0.020933977455716568,"width":0.3881278538812786,"x":0.5570776216894977},{"text":"año con la esperanza de ser curadas.","x":0.5593607261415526,"width":0.3835616438356164,"y":0.25764895354267314,"height":0.019323671497584516},{"text":"Solo se conocen unos pocos cristianos","y":0.22061191632850252,"x":0.5593607346347031,"width":0.40410958904109595,"height":0.01610305958132041},{"x":0.5570776288812784,"width":0.3972602739726028,"y":0.20128824483360175,"height":0.017713365539452464,"text":"luri. Hay algo de material evangelístico"},{"x":0.5593607331050228,"text":"disponible en su idioma.","y":0.18196457326892113,"height":0.019323671497584516,"width":0.25114155251141546}]