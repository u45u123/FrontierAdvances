 mayor parte de la ayuda","y":0.6256423503039487,"x":0.5705282859466693,"width":0.3589758677025363},{"x":0.5728078494938026,"height":0.02573680647329435,"y":0.6074283264029829,"text":"monetaria para sí mismas, dejando a","width":0.3795817823714862},{"height":0.017713365539452575,"y":0.5909822868115941,"text":"menudo a la población sin agua ni","x":0.573059361369863,"width":0.35159817351598177},{"text":"electricidad. Debido a la gran","height":0.017713365539452464,"y":0.5716586151851852,"x":0.5730593637442921,"width":0.3013698630136987},{"x":0.5730593573059362,"text":"inestabilidad, muchas personas han","width":0.36986301369863017,"y":0.5523349439345142,"height":0.017713365539452575},{"x":0.5730593627568492,"height":0.017713365539452575,"text":"sido desplazadas tanto interna","width":0.317351598173516,"y":0.533011272363124},{"text":"como externamente. Fuera de","height":0.01449275362318847,"x":0.5730593555555558,"width":0.3105022831050228,"y":0.5169082124798712},{"text":"Sudán, la mayor población de","height":0.02093397745571668,"width":0.3082191780821918,"y":0.4927536229267311,"x":0.5707762537385845},{"width":0.3470319634703196,"text":"árabes sudaneses (4 millones) se","y":0.4782608698336017,"x":0.5730593652968033,"height":0.01610305958132041},{"height":0.01610305958132041,"text":"encuentra en Egipto.","x":0.5730593643835615,"width":0.2191780821917808,"y":0.45732689210950084},{"y":0.41867954893719816,"height":0.017713365539452464,"x":0.5730593603881279,"text":"La mitad de la población de Sudán","width":0.3538812785388128},{"width":0.3561643835616438,"height":0.019323671497584516,"text":"tiene menos de 18 años, pero toda","x":0.5730593614726027,"y":0.397745571900161},{"text":"una generación ha recibido poca o","x":0.5707762548630138,"height":0.019323671497584516,"y":0.37842190035426726,"width":0.35844748858447495},{"height":0.01610305958132041,"x":0.5730593606164383,"text":"nada de educación debido al caos","y":0.36392914673913046,"width":0.35159817351598177},{"x":0.5730593617579909,"width":0.08675799086757996,"height":0.017713365539452575,"y":0.3413848629025764,"text":"político."},{"x":0.573059358390411,"width":0.2739726027397261,"height":0.01610305958132041,"text":"Los árabes sudaneses son","y":0.3059581322463768},{"width":0.35886644337275264,"height":0.021405972528380834,"y":0.28225904550016523,"text":"musulmanes, pero la brujería sigue","x":0.5728517797716111},{"text":"desempeñando un papel importante","width":0.37671232876712335,"height":0.016103059581320522,"y":0.26570048317230266,"x":0.5730593638698629},{"text":"en su vida diaria. Poco a poco,","y":0.244631678875311,"x":0.5727998700512306,"width":0.3157144833917488,"height":0.02170280788255774},{"text":"algunos están llegando a Cristo a","height":0.017713365539452464,"y":0.22705314031803547,"x":0.5730593594748858,"width":0.34246575342465757},{"x":0.5730593631767774,"width":0.34246575342465757,"text":"través de relaciones personales y","height":0.017713365539452464,"y":0.20772946865654474},{"y":0.19001610279119707,"text":"discipulado uno a uno. Sudán tiene","x":0.5753424616438357,"width":0.36073059360730597,"height":0.01610305958132041},{"height":0.016103059581320522,"text":"muchos cristianos, pero la Iglesia es","y":0.170692431626409,"x":0.5753424694520547,"width":0.36986301369863017},{"x":0.5750415087746812,"height":0.02158295973871449,"y":0.14963697700242107,"width":0.3202994359682684,"text":"cautelosa en el evangelismo de"},{"width":0.3013698630136986,"x":0.5753424671993911,"text":"musulmanes por miedo a una","height":0.01449275362318836,"y":0.13365539476650568},{"y":0.11101771888803358,"text":"reacción negativa del gobierno.","width":0.32919461324334687,"x":0.5706067982725475,"height":0.020052739387549035},{"width":0.36757990867579915,"x":0.5730593637937595,"text":"Cuando Sudán se dividió en norte y","y":0.09339774561191616,"height":0.017713365539452575},{"x":0.5707762511415526,"text":"sur, el 60% de los líderes cristianos","y":0.07246376805555543,"width":0.3652968036529681,"height":0.017713365539452575},{"y":0.0563607085144926,"width":0.2168949771689498,"height":0.01449275362318836,"x":0.5730593634417807,"text":"se trasladaron al sur."}]