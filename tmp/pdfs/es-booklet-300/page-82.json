th":0.41649483816964283},{"width":0.43298967633928576,"y":0.6642441860074322,"height":0.015988372200251955,"text":"en la ciudad para apoyar a su comunidad.","x":0.5422680527581921},{"height":0.021111529071325297,"y":0.6435139078705268,"x":0.5420562474163118,"text":"Silôt ha sido un centro comercial desde","width":0.4107092982700893},{"text":"la época de los rajás en el antiguo reino","y":0.6248992745830071,"height":0.017727639000805873,"x":0.5402061999528066,"width":0.4103092564174107},{"width":0.10146184430803573,"x":0.5420525834330429,"height":0.017401107370036972,"text":"brahmán.","y":0.6068517721023324},{"height":0.0189574231648042,"text":"Desde el siglo XIV, los santos sufíes","y":0.5668604656384142,"x":0.5422680421290501,"width":0.37319587053571424},{"text":"(Pirs) han influido fuertemente en el","y":0.5494186043976937,"height":0.015988372200251955,"x":0.5402061952637152,"width":0.3793814174107143},{"height":0.01750276321177524,"text":"pueblo sylheti. Son respetados como","x":0.5422680340538937,"y":0.5290088640203823,"width":0.3835051618303571},{"height":0.01617225382618137,"width":0.4268041294642857,"text":"líderes espirituales incluso después de la","x":0.5402061862472386,"y":0.5116279069836918},{"y":0.48982558172133084,"width":0.422680419921875,"height":0.01744185946431487,"text":"muerte, y la gente visita sus santuarios y","x":0.5422680348844234},{"height":0.016116035455278066,"y":0.473811442419212,"text":"celebra festivales anuales (urs). Muchos","x":0.5422680487360204,"width":0.42061854771205365},{"text":"sylhetis también practican visitas a","x":0.5402061857951721,"width":0.36494845145089294,"height":0.01750276321177513,"y":0.45348837281144727},{"x":0.5402061842720224,"y":0.43311845313253106,"width":0.40824741908482143,"text":"santuarios, creen en la brujería y el mal","height":0.018936341659951728},{"x":0.5422680583049521,"height":0.017503935132268778,"text":"de ojo, y a menudo buscan ayuda de","y":0.4141821110969818,"width":0.3793814174107143},{"text":"curanderos en lugar de médicos.","y":0.3940268742386849,"x":0.5400680438528466,"width":0.3445761021205357,"height":0.01930069058869366},{"x":0.5422680520232535,"y":0.3573730865034642,"width":0.4103092564174107,"height":0.01617342497820251,"text":"Los matrimonios sylheti suelen mezclar"},{"width":0.3876288713727679,"x":0.5422680417706607,"height":0.015988372200251955,"text":"tradiciones islámicas e hindúes y son","y":0.33866279070462213},{"text":"concertados dentro de la comunidad de","x":0.5402062015530076,"height":0.016116035455277955,"y":0.3211120063245827,"width":0.4185566755022321},{"height":0.01750510551581741,"text":"habla sylheti. Los lazos familiares, la","width":0.37319587053571435,"y":0.29935535892564236,"x":0.5422680474331737},{"width":0.4309278390066964,"height":0.01772763900080576,"x":0.5402061848007754,"y":0.28041901665019964,"text":"implicación comunitaria y la preservación"},{"x":0.5422680442141476,"width":0.41649483816964283,"text":"cultural son muy valorados. Las mujeres","y":0.2614826754860782,"height":0.01613360350406723},{"height":0.01463443746881854,"y":0.24563953522625004,"x":0.542268042245432,"width":0.3958762904575893,"text":"a menudo enfrentan desafíos sociales"},{"width":0.422680419921875,"y":0.22383720933349804,"height":0.015988372200251955,"text":"debido a las normas patriarcales y a vivir","x":0.5422680409840797},{"x":0.54226803999837,"height":0.015988372200251955,"width":0.4309278390066964,"y":0.20494186027826544,"text":"con la familia del marido. Su estatus varía"},{"y":0.18313953520956716,"width":0.3876288713727678,"x":0.5402061791074306,"height":0.020348837066330727,"text":"según la clase social, y el matrimonio"},{"width":0.42724975585937497,"x":0.5420086002513237,"y":0.16472283428544554,"height":0.020488022797344074,"text":"puede suponer una transición estresante"},{"text":"para muchas mujeres sylheti.","y":0.14665592231800717,"height":0.016134775424560654,"width":0.3051546456473214,"x":0.5422680410526279},{"height":0.01744185946431498,"y":0.10755814005604858,"x":0.5422680515210787,"text":"La lengua sylheti, con su propia escritura,","width":0.43298967633928576},{"y":0.09011627888291662,"width":0.3628865792410715,"text":"es hablada por unos 13 millones de","x":0.5422680497265433,"height":0.015988372200251955},{"y":0.07122093033882748,"width":0.40824741908482143,"height":0.015988372200251955,"text":"personas en todo el mundo. Les da una","x":0.5422680448493419},{"text":"fuerte identidad regional y una conexión","x":0.5402061949226229,"y":0.05076551183577538,"width":0.42886596679687505,"height":0.01772763900080576},{"y":0.03182916979243944,"height":0.016135946576581794,"x":0.5422680470768708,"text":"con la comunidad global sylheti.","width":0.33402061244419645}]