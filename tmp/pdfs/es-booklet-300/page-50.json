[{"text":"50 | India - Mahratta","y":0.966559226284355,"width":0.1814432896205357,"height":0.01454542453590657,"x":0.020618560035093002},{"width":0.08453608049665182,"text":"DíA 17","height":0.017488709387521784,"x":0.07422680564084935,"y":0.9069298956043872},{"y":0.8517441861749936,"height":0.018895348265322798,"width":0.06804123796735491,"x":0.06185567020876241,"text":"India"},{"x":0.059507959304401635,"width":0.40057170758928573,"text":"Mahratta","y":0.7809566900206468,"height":0.058726154730072144},{"height":0.010174418533165364,"width":0.20412370954241074,"x":0.24329897337312442,"text":"Fuente de foto: Wikimedia","y":0.5523255814553165},{"y":0.49113618040667395,"text":"• Población: 36,204,000","x":0.05773196874661724,"width":0.35463916015625,"height":0.02194521486711165},{"height":0.017727639000805873,"x":0.09896907467426828,"y":0.4721998384857822,"width":0.18144328962053569,"text":"(en agosto 2025)"},{"text":"• Religión: Hinduismo","width":0.3113401925223214,"height":0.01905814838639963,"y":0.44186046547489666,"x":0.05773196781836798},{"y":0.4127906981965537,"text":"• Idioma: Marathi","width":0.2536082414899553,"height":0.018895348265322798,"x":0.05773196464162022},{"width":0.28659793526785715,"text":"• Cristianos: 0.00%","y":0.3835616441551546,"x":0.05773196306710231,"height":0.01772763900080576},{"y":0.3531976748463309,"height":0.017471140570260224,"x":0.057731953700486394,"text":"• Biblia: Nuevo Testamento:","width":0.39175258091517856},{"text":"Sí; Biblia completa: Sí","y":0.32836422247254593,"x":0.10309278449376383,"height":0.023379962930364262,"width":0.29484535435267856},{"height":0.017446544840871936,"x":0.5484536115690007,"width":0.4041237095424107,"text":"Los mahratta son orgullosos kshatriyas","y":0.941860465834703},{"text":"de Maharashtra, que hablan","y":0.9229651167213309,"x":0.5484536072485101,"height":0.01744185946431498,"width":0.2886597900390624},{"width":0.3958762904575893,"y":0.9055232559202229,"height":0.015988372200251955,"x":0.548453608833061,"text":"principalmente maratí. Están ubicados"},{"height":0.01772763900080576,"text":"en todo Marathwaada, mientras que","y":0.8835616438499221,"width":0.37319587053571424,"x":0.548453612232143},{"x":0.548453620766695,"y":0.8662369059962121,"text":"algunos se encuentran a lo largo de las","width":0.40206183733258927,"height":0.016116035455277955},{"text":"fronteras con Karnataka. Un número","height":0.016116035455277955,"y":0.8473005637764863,"x":0.5484536157959891,"width":0.37731958007812505},{"y":0.8255439162284955,"height":0.018936341659951617,"text":"menor vive más al oeste, en Pakistán.","x":0.5505154627156779,"width":0.3876288713727679},{"y":0.7906976742741473,"width":0.4144329659598215,"height":0.015988372200251955,"text":"Pertenecen principalmente a los niveles","x":0.5484536149324605},{"text":"superiores de una sociedad rural.","y":0.7703464946917621,"height":0.016116035455277955,"x":0.5484536030294782,"width":0.34845361328125},{"height":0.017485195162985967,"text":"Principalmente \"kunbi\" (agricultores) de","y":0.7514101532319621,"x":0.5505154799273057,"width":0.4144329659598215},{"x":0.5484536113947441,"y":0.7311046514451681,"text":"clase, casi todas las familias mahratta","height":0.017485195162985967,"width":0.38969070870535716},{"text":"rurales poseen tierras y cultivan cultivos","width":0.4144329659598214,"y":0.7122093021120832,"x":0.5484536207520481,"height":0.015988372200252066},{"width":0.3488971470424107,"y":0.6930910918833234,"x":0.5482211647289394,"height":0.020514851707685966,"text":"agrícolas. Las tierras suelen ser lo"},{"x":0.5482157217188453,"width":0.373679443359375,"height":0.020520086542048066,"text":"suficientemente grandes como para","y":0.6723371038106782},{"y":0.6555197423648378,"height":0.016116035455278066,"x":0.548453620620014,"width":0.3628865792410715,"text":"albergar tanto cultivos comerciales"},{"width":0.20000000000000007,"text":"como alimentarios.","height":0.016116035455277955,"y":0.6365834006410556,"x":0.5484536106958762},{"y":0.5987107170124699,"x":0.5484536195747998,"height":0.016116035455278066,"width":0.4103092564174107,"text":"Son liberales en comparación con otros"},{"y":0.5784883728114472,"width":0.29484535435267856,"x":0.5484536146535576,"height":0.01744185946431487,"text":"grupos indios. El matrimonio"},{"y":0.5610465117741472,"width":0.26391751534598207,"text":"concertado no se impone","height":0.015988372200252066,"x":0.5484536148012358},{"height":0.01772763900080576,"text":"estrictamente, y un niño puede casarse","y":0.5390813863531612,"width":0.4103092564174108,"x":0.5484536140851092},{"width":0.3917525809151786,"height":0.014616869420029266,"x":0.5484536025321015,"y":0.5232558140271222,"text":"con una chica de su elección si ella es"},{"width":0.38969070870535705,"y":0.5028203062615566,"x":0.5505154672194866,"text":"brahmán o maratha. Los mahratta son","height":0.016116035455278066},{"y":0.48235485267663314,"width":0.40433918108258937,"x":0.5483458384383186,"height":0.01785812254974095,"text":"algo tolerantes con otras culturas. Pero"},{"height":0.02383933501508717,"y":0.46102252237919406,"x":0.548151853900184,"text":"al considerarse de casta alta, suelen","width":0.37799958147321433},{"width":0.4,"height":0.01615117232132879,"text":"menospreciar a quienes consideran no","y":0.4447674417160077,"x":0.5484536032474228},{"y":0.4258662372822103,"x":0.5484536139157192,"text":"su igual. El objetivo principal de una","height":0.016116035455278066,"width":0.36907216099330353},{"text":"familia mahratta de clase media es un","width":0.38969070870535705,"y":0.4084302327674322,"height":0.014615698268008237,"x":0.5484536179669091},{"height":0.015988372200251955,"width":0.4103092564174108,"x":0.5484536233170678,"text":"futuro seguro para ellos y sus hijos, por","y":0.38662790702487404},{"x":0.546144875757033,"width":0.3282891322544642,"text":"lo que el éxito financiero es una","height":0.020179158348310966,"y":0.3673361853765994},{"x":0.5484536170403396,"text":"preocupación dominante.","width":0.2680412248883929,"height":0.015988372200251955,"y":0.34883720926324613},{"height":0.015988372200251955,"y":0.31250000014624035,"x":0.5484536054476367,"text":"Los mahratta hindúes suelen adorar a","width":0.3876288713727678},{"text":"Shiva como su dios familiar y","height":0.016116035455277955,"width":0.3010309361049107,"x":0.5484536003496066,"y":0.292103142375822},{"text":"consideran a Shivaji como su líder. La","y":0.2731668008761191,"width":0.38556699916294634,"height":0.016116035455277955,"x":0.5484536090010012},{"height":0.015988372200251955,"text":"mayoria venera su tierra y su tierra","width":0.3525773228236607,"y":0.2529069766300096,"x":0.5505154593613656},{"x":0.5484536127636114,"text":"como a su madre. Los mahratta","y":0.2340116279260368,"height":0.015988372200251955,"width":0.32577319335937494},{"width":0.41649483816964283,"height":0.017727639000805873,"y":0.21353747002906798,"text":"defienden ferozmente su cultura, lengua","x":0.5484536151935289},{"text":"e historia. Esto plantea un punto","x":0.5484536079634689,"y":0.1962127320130519,"width":0.33402061244419645,"height":0.016116035455277955},{"text":"importante: el hinduismo es un aspecto","height":0.016116035455278066,"y":0.17727638995563222,"x":0.5463917593977242,"width":0.41237112862723213},{"x":0.5484536227809853,"text":"fundamental de su cultura. Decirles que","y":0.15697674397254835,"height":0.015988372200252066,"width":0.4103092564174107},{"height":0.01611954967981377,"x":0.5505154780767904,"text":"dejen de dar lealtad a estos dioses suele","width":0.4144329659598214,"y":0.1394037063876089},{"y":0.11918604632477703,"x":0.5484536057225508,"width":0.3876288713727678,"text":"verse como un ataque a su cultura. El","height":0.01618865149142179},{"width":0.35051545061383926,"y":0.10029069742094954,"height":0.01614765886526548,"text":"pueblo hindú mahratta necesita el","x":0.5505154664456577},{"x":0.5505154727111676,"height":0.017727639000805873,"width":0.39381441824776786,"text":"discernimiento espiritual y la humildad","y":0.07977437529346465},{"x":0.5505154691009296,"y":0.0624496374289214,"height":0.014585246010041852,"text":"necesaria para reconocer a Jesucristo","width":0.38969070870535716},{"text":"por lo que Él es.","x":0.5483604183660521,"width":0.16719669015066962,"height":0.0211233673894915,"y":0.04176389829090654}]