[{"height":0.011725118331232909,"x":0.022680421164050977,"text":"72 Asia otros - los PF en Irán","y":0.9693795326841756,"width":0.2680412248883928},{"width":0.09102097865513394,"height":0.01823221647768236,"y":0.9051280777302753,"text":"DíA 26","x":0.0740771388889918},{"width":0.1260176478794643,"height":0.01834014074923429,"text":"Asia otros","y":0.8556555110626869,"x":0.053486022206611875},{"x":0.053140872849123624,"y":0.7867669985589989,"width":0.23392443847656252,"height":0.055826468394707396,"text":"PF en"},{"width":0.18350514439174107,"x":0.04742268461856247,"height":0.053779067193952756,"y":0.7238372104945934,"text":"Irán"},{"y":0.4781976745514519,"width":0.29484535435267856,"text":"Fuente de foto: Shadegan - Wikimedia","x":0.15051546346799075,"height":0.011729803323553667},{"width":0.228865966796875,"height":0.010475423045930743,"y":0.4649476227674173,"text":"Licensed under CC BY-SA 4.0","x":0.2061855710139337},{"x":0.05773195605787467,"width":0.39175258091517856,"y":0.40406976762034585,"height":0.023408072884288367,"text":"El luri feyli, uno de los PF en"},{"x":0.0556701048029947,"y":0.38517441847264855,"width":0.05567010062081473,"height":0.020348837066330727,"text":"Irán"},{"height":0.02470930193240939,"y":0.3299418608381972,"width":0.34020619419642856,"text":"• Población: 2,588,000","x":0.055670098439340954},{"x":0.09896906934436564,"y":0.30813953540585604,"width":0.19793814522879463,"text":"(en agosto 2025)","height":0.01901598460822218},{"x":0.055670105774823925,"height":0.019071031827104457,"y":0.2759871074945104,"text":"• Religión: Islam","width":0.24123711286272317},{"y":0.24415793688355003,"x":0.05773196858799695,"height":0.020547945205479423,"width":0.34639174107142856,"text":"• Idioma: Luri (del norte)"},{"text":"• Cristianos: 0.01%","x":0.05773196330837507,"y":0.21220930289865647,"width":0.2845360804966518,"height":0.017444202536829656},{"text":"• Biblia: Nuevo Testamento: Sí","x":0.0556701065662971,"y":0.17877906976625324,"height":0.020348837066330727,"width":0.4412370954241071},{"x":0.5587628893550373,"width":0.3608247419084821,"y":0.9286865433975267,"height":0.016116035455278066,"text":"Los luri viven principalmente en las"},{"x":0.5567010443491691,"text":"regiones occidental y suroeste de Irán,","height":0.019047607249737197,"y":0.9084302330802746,"width":0.4020618373325894},{"width":0.4041237095424107,"x":0.5587628916205469,"y":0.8895348840033076,"height":0.01744185946431498,"text":"especialmente en las montañas Zagros"},{"x":0.5587628895586916,"width":0.4041237095424107,"y":0.8706395353586176,"height":0.018965621997424464,"text":"y sus alrededores. Algunos luri viven en"},{"y":0.8517324737077795,"x":0.5567010343687868,"width":0.41649483816964283,"text":"Irak. Son pueblos nómadas que trabajan","height":0.01745357252147095},{"text":"como pastores y viajan de seis a ocho","y":0.8305470471058143,"width":0.3943992396763394,"x":0.5584495763408572,"height":0.022154581345059432},{"text":"meses al año, viviendo en tiendas","x":0.558762891773564,"y":0.8125000003259821,"height":0.01747582594681707,"width":0.34639174107142856},{"height":0.01612306313587708,"width":0.3484536132812499,"text":"negras de pelo de cabra. Viven en","x":0.5587628869848046,"y":0.7949234486062062},{"x":0.5587628868373987,"height":0.016164055762033502,"y":0.7759871071258831,"text":"viviendas permanentes durante unos","width":0.3835051618303571},{"width":0.3965014299665178,"x":0.5584577949640208,"height":0.02386747263401967,"text":"meses en invierno. Algunos luri se han","y":0.7523538563975789},{"width":0.3999999999999999,"text":"asentado en aldeas porque prefieren la","y":0.7369057211604095,"x":0.5587628895876289,"height":0.0174547436734922},{"width":0.37731958007812505,"height":0.016116035455278066,"x":0.5587628876781687,"text":"agricultura a la pastorela. El trigo y la","y":0.7179693796208035},{"y":0.6990330382446472,"text":"cebada son sus principales cultivos.","width":0.3752577078683035,"height":0.016116035455278066,"x":0.5587629023957451},{"text":"Los luri creen que el éxito de un pastor","y":0.6598837216050518,"width":0.4,"height":0.01744185946431498,"x":0.5587628868453608},{"height":0.01744185946431509,"text":"depende de sus cualidades personales y","width":0.42061854771205354,"y":0.6409883727024355,"x":0.5587628963501587},{"text":"de su buena suerte. La sociedad luri","x":0.5587628898661634,"width":0.37319587053571424,"height":0.014648492061544394,"y":0.6235465116434011},{"text":"está dominada por quienes poseen los","x":0.5587628905979382,"y":0.6031426269897902,"width":0.4,"height":0.01749690745166954},{"y":0.584206285610068,"x":0.5567010286431563,"text":"rebaños más grandes y que tienen más","width":0.40824741908482143,"height":0.016116035455277844},{"width":0.3360824846540178,"height":0.01612540543991936,"text":"dinero. Esta clase alta contrata a","x":0.5587628795080426,"y":0.5652699432910206},{"text":"miembros de la clase baja para cuidar","y":0.5463336019027518,"width":0.38969070870535716,"x":0.5587628898225793,"height":0.016166398066075782},{"x":0.5587628933308979,"height":0.01744185946431498,"y":0.5261627909800518,"text":"de sus rebaños. La mayoría de los luri","width":0.38556699916294646},{"x":0.5587628943584774,"y":0.5072522160766387,"width":0.41649483816964283,"text":"pertenece a la clase baja de la sociedad.","height":0.016116035455277955},{"text":"Los luri son musulmanes chiitas","x":0.5587628846831278,"height":0.014565334888738013,"y":0.4709302329006686,"width":0.32989690290178575},{"width":0.4044619489397321,"text":"practicantes. Han adoptado un sistema","x":0.558560968207681,"y":0.44904875248270315,"height":0.019779982247917438},{"text":"de creencias muy práctico con prácticas","width":0.41649483816964283,"height":0.01744185946431498,"x":0.5587628929151786,"y":0.4302325588143542},{"x":0.5567010326948868,"y":0.4113372090888274,"text":"religiosas sencillas. Les encantan los","height":0.016140631184666243,"width":0.38144328962053564},{"height":0.014646149757502114,"text":"santuarios dedicados a hombres santos","width":0.4103092564174108,"x":0.558762900495271,"y":0.39389534906034473},{"y":0.3720930234872514,"width":0.4185566755022322,"height":0.018895348265322798,"x":0.5567010384602243,"text":"(fundadores de varios grupos islámicos)"},{"height":0.017471140570260224,"x":0.5567010295474732,"text":"y los utilizan como lugares de","y":0.35319767470098196,"width":0.3051546456473214},{"y":0.33430232615447053,"text":"peregrinación. Debido a que se cree que","x":0.5587628936643193,"width":0.41649483816964283,"height":0.01744185946431487},{"text":"estos santuarios poseen poderes","y":0.31273962563658164,"x":0.5584285392455237,"width":0.34300917271205356,"height":0.02351902032647757},{"text":"curativos, personas con enfermedades","x":0.558762894168757,"width":0.40206183733258927,"y":0.29651162772012596,"height":0.016139460032645214},{"width":0.38144328962053575,"text":"físicas y psicológicas los visitan cada","height":0.01745942828157654,"x":0.5587628906021033,"y":0.2775987108982553},{"x":0.5587628969906916,"y":0.25866236871735715,"height":0.016116035455278066,"width":0.38556699916294646,"text":"año con la esperanza de ser curadas."},{"text":"Solo se conocen unos pocos cristianos","width":0.4041237095424106,"height":0.01612891889598267,"y":0.2207896858523991,"x":0.558762891538073},{"y":0.20058139595824953,"width":0.40206183733258927,"height":0.01744185946431487,"x":0.5567010451223651,"text":"luri. Hay algo de material evangelístico"},{"text":"disponible en su idioma.","x":0.5587628916303156,"width":0.25154638671875007,"y":0.1816860464725485,"height":0.016138288880624074}]