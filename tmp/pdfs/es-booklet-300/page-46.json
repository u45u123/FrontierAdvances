"width":0.3628865792410715,"height":0.01612189198385605},{"text":"Brahma (Prajapati). Por ello,","height":0.01744185946431498,"x":0.5587628927824235,"y":0.8895348842213309,"width":0.29484535435267856},{"y":0.8706395352387728,"width":0.3195876116071429,"height":0.01744185946431487,"x":0.55876289307959,"text":"algunos kumhar usan Prajapati"},{"width":0.35463916015624997,"x":0.5587628911933528,"text":"como apellido. Afirman que fueron","y":0.8517324736436517,"height":0.016116035455277955},{"x":0.5567010476637864,"text":"los primeros en fabricar la rueda. Su","width":0.3752577078683036,"height":0.017494565147627372,"y":0.832796132099065},{"y":0.8138597902395558,"width":0.331958740234375,"height":0.018989046574791613,"text":"nombre significa \"personas que","x":0.5587628951577266},{"y":0.7949234490124499,"height":0.01772763900080576,"x":0.5567010300723492,"text":"fabrican vasijas de barro\". La gente","width":0.37319587053571435},{"height":0.01744185946431498,"text":"kumhar vive por toda la India y habla","y":0.7747093026515635,"x":0.5587629011173945,"width":0.3752577078683036},{"text":"lenguas locales.","x":0.556701035494034,"height":0.016144144640729663,"y":0.7558139534529263,"width":0.17113401576450893},{"x":0.5586091512258184,"height":0.01901539365290439,"y":0.7165151262888906,"width":0.3075551060267857,"text":"El pueblo kumhar es honesto,"},{"width":0.34845361328125,"height":0.016116035455278066,"y":0.6990330375343143,"text":"trabajador y espiritual. La mayoría","x":0.5587628875655606},{"x":0.5587628862700298,"y":0.6800966958650378,"width":0.2762886614118304,"height":0.01612423428789822,"text":"de los Kumhar gana dinero"},{"x":0.5587628840772275,"width":0.31340206473214294,"y":0.6583400479871115,"text":"cultivando, criando animales y","height":0.01772763900080576},{"text":"fabricando vasijas e ídolos de barro.","width":0.37565691266741075,"y":0.6409021764682881,"height":0.019125155342095912,"x":0.5565120516422775},{"x":0.558762898744995,"y":0.6204673648277541,"text":"Sin embargo, este trabajo es","width":0.2969071916852679,"height":0.019067518371041037},{"width":0.29072164481026785,"text":"estacional y no constante. A","y":0.6031426271496739,"height":0.017496907451669652,"x":0.5587628866928043},{"y":0.5838186066358462,"x":0.5585726556458659,"width":0.3056037248883928,"height":0.018694858412700244,"text":"menudo no es suficiente para"},{"width":0.37731958007812505,"height":0.01612540543991936,"y":0.5652699435235786,"x":0.5587628930684485,"text":"ganarse la vida. Muchos agricultores"},{"y":0.5463336018276549,"text":"kumhar trabajan en tierras","x":0.5587628937742889,"height":0.016166398066075782,"width":0.2721649344308036},{"text":"propiedad de castas superiores y","y":0.5261627914160983,"width":0.34226803152901786,"x":0.5587628939777591,"height":0.01744185946431498},{"x":0.5587628823476161,"width":0.2969072265624999,"text":"solo reciben una parte de las","height":0.016116035455277955,"y":0.50725221590222},{"x":0.5587426905748446,"text":"cosechas.","width":0.10931874302455358,"height":0.01612613933111373,"y":0.48830320960435736},{"text":"Los kumhar necesitan nuevas","x":0.5587628932110756,"width":0.30721648297991067,"y":0.4520348840271221,"height":0.014534883399244136},{"width":0.3241962890625,"y":0.4277300516659984,"height":0.0219777396952886,"text":"habilidades laborales y mejores","x":0.5585413941334939},{"text":"escuelas para sus hijos. La","height":0.016140631184666243,"y":0.4113372093213856,"width":0.2762886614118304,"x":0.5587628885518168},{"x":0.5587628852281619,"width":0.36494845145089294,"y":0.39242546351829977,"text":"educación es difícil porque muchos","height":0.0174582571295554},{"width":0.3487075544084822,"y":0.3732794981649752,"text":"kumhar se trasladan de un lugar a","height":0.016330115743263596,"x":0.5586273252695838},{"text":"otro. Los niños suelen abandonar la","y":0.3561046513527035,"x":0.5587629005154753,"width":0.3670102887834822,"height":0.014564163736716873},{"height":0.015988372200251955,"y":0.3343023253678973,"text":"escuela antes de tiempo para","x":0.5587628939616625,"width":0.3030927734375001},{"x":0.5587628916511146,"width":0.36907216099330353,"height":0.016180452658801636,"y":0.31540697672690887,"text":"ayudar a sus padres a ganar dinero."},{"y":0.29492344912139357,"height":0.019030039200948035,"text":"Además, suelen carecer de","x":0.5587628847806115,"width":0.2804123709542411},{"x":0.5587628948746662,"width":0.34226803152901786,"y":0.27759871075290654,"text":"medicina moderna y agua limpia.","height":0.01745942828157654},{"text":"Los kumhar son hindúes y rezan al","x":0.5587628874080296,"width":0.3567010323660714,"height":0.016116035455277955,"y":0.23972602713892366},{"height":0.01744185946431498,"text":"señor Shiva, el dios destructor y","x":0.5587628781142995,"width":0.3319587751116072,"y":0.21947674462415478},{"text":"diosa Madre Mata","x":0.5587628930783207,"y":0.20346494782184799,"width":0.1855669991629464,"height":0.014558307976611284}]