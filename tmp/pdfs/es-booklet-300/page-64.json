909551082},{"width":0.38144328962053564,"text":"Hay 17 PF en las Amazonas. La gente","y":0.9431909746460332,"x":0.571134030060866,"height":0.01772763900080576},{"height":0.016116035455278066,"y":0.925866236640918,"x":0.5711340256631419,"width":0.36907216099330353,"text":"matis es uno de ellos. Los matis son"},{"height":0.01752267433307908,"text":"una pequeña tribu en el noreste de las","y":0.9055232564887727,"x":0.5690721706080749,"width":0.39381441824776786},{"y":0.8851732477350075,"width":0.3443299037388393,"height":0.017443030616336008,"text":"Amazonas brasileño, vulnerable a","x":0.5690721625893432},{"width":0.3958762904575893,"height":0.015988372200252066,"text":"enfermedades y a menudo explotados","x":0.5690721606268754,"y":0.8677325582458042},{"y":0.8473005640398037,"height":0.01752501663712125,"x":0.5690721678048485,"width":0.32577319335937505,"text":"por forasteros. No hay recursos"},{"x":0.5690721695438681,"text":"cristianos en su idioma, y hay muy","height":0.016116035455278066,"y":0.8283642221798841,"width":0.3546391601562501},{"height":0.01901598460822218,"width":0.29072164481026785,"text":"pocos, si es que hay alguno,","x":0.5711340214350722,"y":0.808139535405856},{"y":0.7906976743831589,"x":0.5690721813744936,"width":0.3360824497767858,"text":"seguidores de Cristo entre ellos.","height":0.015988372200252066},{"text":"Aproximadamente la mitad de los","height":0.015988372200252066,"x":0.5690721586254258,"y":0.7529069765306879,"width":0.3443299037388393},{"x":0.5711340151530859,"y":0.7340116279847633,"width":0.3876288713727678,"text":"matis se ha trasladado a pueblos para","height":0.014578219097915124},{"text":"estudiar y trabajar, adoptando un","y":0.7122093023753328,"x":0.5690721703695115,"width":0.34226803152901786,"height":0.019055806082357463},{"text":"estilo de vida más urbano. Los que","height":0.016154685777392097,"y":0.6946011281449237,"width":0.3567010323660714,"x":0.5690721612568268},{"height":0.015988372200251844,"text":"permanecen en el bosque dependen","x":0.5690721640073294,"width":0.37731958007812494,"y":0.6758720928787985},{"y":0.6555197420413688,"x":0.5690721607505869,"width":0.3958762904575893,"text":"de la caza, la recolección, la pesca y el","height":0.017445373688850685},{"x":0.5690721753174244,"y":0.6380813959073774,"text":"cultivo de yuca. Su esperanza de vida","width":0.38969070870535716,"height":0.01744185946431487},{"y":0.6162790698644316,"x":0.5690721737916513,"text":"es baja, alrededor de 45 años, debido","width":0.38969070870535716,"height":0.01909562832496514},{"text":"a enfermedades y atención médica","x":0.5690721743382272,"width":0.3628865792410715,"height":0.01772763900080576,"y":0.5987107175253027},{"text":"limitada. Los matis rurales se casan","y":0.579774375482486,"width":0.36907216099330353,"x":0.5670103089105648,"height":0.016155856929413348},{"y":0.5595930235381914,"x":0.5690721728600193,"text":"dentro de la tribu y tienen muchos","height":0.01744185946431487,"width":0.3546391601562501},{"y":0.5406929897604716,"x":0.5690721735111378,"height":0.017446544840871936,"text":"hijos, aunque muchos no llegan a los","width":0.3793814174107143},{"x":0.5690721640358063,"text":"diez años. Cada vez más jóvenes","width":0.3402061941964286,"y":0.5232558139434786,"height":0.015988372200251955},{"y":0.5028203063976937,"width":0.3134020647321428,"height":0.017727639000805873,"text":"matises están dejando la selva","x":0.5711340197473306},{"y":0.4838839646710108,"text":"tropical y alejándose del modo de vida","height":0.016116035455277955,"x":0.5690721751323753,"width":0.39381441824776786},{"text":"tradicional de sus abuelos.","x":0.5690721673723996,"width":0.27835051618303575,"y":0.46494762314950544,"height":0.016157028081434377},{"y":0.4286865434666354,"x":0.5690721704084015,"width":0.3587628696986608,"height":0.014627409788219303,"text":"Los matis creen en una fuerza vital"},{"y":0.4069298954953756,"text":"llamada \"xo\", que intentan influir","x":0.5670103090066966,"height":0.017488708619049387,"width":0.33814432198660715},{"x":0.5690721675236101,"y":0.38799355344165765,"text":"mediante rituales y ofrendas. Algunos","height":0.016116035455278066,"width":0.38969070870535716},{"x":0.5690721596222617,"text":"también piensan que los espíritus","y":0.36905721205453224,"width":0.34845361328125,"height":0.017727639000805873},{"width":0.33402061244419634,"y":0.34883720953376307,"x":0.5690721638294483,"height":0.019011300000137732,"text":"habitan ríos, árboles, montañas,"},{"y":0.3299418608928425,"height":0.01744185946431487,"text":"animales y el cielo, y que estos","width":0.31752577427455364,"x":0.5690721617630669},{"x":0.5690721733019605,"text":"espíritus deben ser apaciguados para","width":0.38969070870535716,"height":0.018936341659951617,"y":0.3110394839970593},{"x":0.5690721638294483,"text":"evitar daño. Viven con miedo de","width":0.33402061244419634,"y":0.29360465101833344,"height":0.015988372200251955},{"y":0.2759871074094492,"x":0.5690721620915179,"height":0.013295729250604404,"width":0.32164948381696434,"text":"ofender esta fuerza vital o a los"},{"text":"espíritus, aunque no adoran a","y":0.25290697726632116,"x":0.5690721680203541,"width":0.30721648297991067,"height":0.019051120705800506},{"x":0.5690721692383847,"text":"espíritus ni antepasados.","width":0.2618556605747768,"height":0.01772763900080576,"y":0.23529411800019195},{"x":0.5690721705997561,"width":0.39793812779017856,"height":0.017450058296935134,"text":"Los equipos cristianos pueden ofrecer","y":0.19621273172592002},{"x":0.5687874073467303,"text":"a los matis medicina moderna y","width":0.3284719935825893,"height":0.021702215423706983,"y":0.17567305586615545},{"y":0.15834004809612323,"height":0.01772763900080576,"x":0.5690721673967348,"width":0.39381441824776786,"text":"proporcionar filtros de agua para agua"},{"height":0.019049949553779477,"y":0.13808139587097212,"width":0.3958762904575892,"text":"limpia. Pero, lo más importante es que","x":0.5670103085856384},{"height":0.01454893799196999,"text":"los matis necesitan escuchar las","y":0.1220789688862236,"x":0.5670103156488172,"width":0.33814432198660715},{"width":0.3821542619977678,"height":0.023123997819702313,"text":"Buenas Nuevas de Jesucristo, que es","y":0.09754506386877826,"x":0.5707366621935006},{"width":0.3384836774553571,"height":0.019092073371389184,"y":0.07999871074391851,"x":0.5689046379814897,"text":"el único que puede perdonar sus"},{"text":"pecados y liberarlos del temor a los","width":0.36494845145089294,"y":0.06244963724474484,"height":0.016116035455278066,"x":0.5690721614652753},{"text":"espíritus malignos.","x":0.5690721630041594,"width":0.19793814522879472,"height":0.01772763900080576,"y":0.043513295875788116}]