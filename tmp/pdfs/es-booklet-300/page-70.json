090328,"height":0.02338230600287894,"width":0.3175257742745536,"text":"No; Biblia completa: No","x":0.09896907559468192},{"x":0.5422680459403189,"height":0.017508619740353226,"y":0.9548751008638973,"text":"Hay 6 PF en Tukangbesi de Sulawesi,","width":0.37731958007812494},{"y":0.9374999999282171,"width":0.38556699916294634,"text":"Indonesia. Los wolio son uno de ellos.","x":0.5402061959597638,"height":0.01616639806607567},{"x":0.5402061932881305,"y":0.8996776795577777,"text":"El pueblo wolio (también conocido como","width":0.4144329659598215,"height":0.016116035455277955},{"text":"Baubau, Buton o Butung) habita las","x":0.5422680519052374,"y":0.8793604657910983,"height":0.017496907451669652,"width":0.36288657924107137},{"height":0.01745591482551323,"x":0.5402061861407171,"text":"pequeñas islas de Buton, Muna y","y":0.8604651166631914,"width":0.33814432198660715},{"y":0.8415697679131914,"height":0.01744185946431498,"text":"Kabaena, en el sureste de Sulawesi. Son","width":0.4103092564174108,"x":0.54020619243047},{"text":"descendientes de inmigrantes del siglo","width":0.39793812779017856,"x":0.5402061971530205,"y":0.8239323123006065,"height":0.016183966883337342},{"x":0.5402061879670816,"width":0.3958762904575892,"height":0.01744185946431487,"y":0.803779070340517,"text":"XV procedentes de Johor, Malasia, que"},{"x":0.5402061889980093,"y":0.7832393233013624,"width":0.3958762904575893,"height":0.01908625757185134,"text":"fundaron la dinastía Buton. En 1540, el"},{"y":0.7659145851872358,"text":"sexto rey se convirtió al islam,","x":0.5402061952883951,"width":0.30721648297991067,"height":0.017515646652479844},{"x":0.5402061847196589,"y":0.7514101530159512,"text":"transformando el reino en un sultanato","width":0.3958762904575893,"height":0.014578219097915124},{"y":0.728041901492032,"width":0.40206183733258927,"x":0.5402061980605093,"height":0.01772763900080576,"text":"que duró hasta 1960. Hoy en día, Buton"},{"x":0.5402061858553135,"width":0.42061854771205354,"y":0.7122093023992152,"height":0.014623896332155994,"text":"es conocida por su producción de asfalto"},{"text":"y se está explorando en busca de","x":0.5402061772574559,"y":0.6917808219145396,"width":0.3402061941964286,"height":0.016116035455277955},{"x":0.5402061938437385,"y":0.6728444804656408,"text":"recursos petrolíferos y minerales.","height":0.017727639000805873,"width":0.34226803152901786},{"width":0.3608247419084821,"y":0.6539081387987868,"text":"Muchos wolio han emigrado a otras","x":0.5402061868808105,"height":0.01772763900080576},{"width":0.4185567103794643,"height":0.017486366315007107,"text":"regiones como Maluku y Papúa en busca","x":0.5402061774047696,"y":0.6365834005295534},{"text":"de trabajo. Hablan el idioma wolio, y","y":0.6149862017179428,"width":0.3674513113839285,"x":0.5399674970022957,"height":0.02106331049867638},{"y":0.5987107172183808,"width":0.42061854771205354,"height":0.016116035455277844,"x":0.5402061930659173,"text":"algunos también entienden árabe, que se"},{"text":"utiliza en textos religiosos e históricos.","width":0.39381441824776786,"height":0.016155856929413348,"y":0.5797743756968754,"x":0.5402061968761159},{"height":0.018936341659951728,"text":"En los pueblos de los wolio, los mercados","width":0.42061854771205354,"x":0.5402061914635609,"y":0.5406929899075099},{"height":0.01744185946431487,"width":0.39793812779017856,"text":"venden tejidos como seda y algodón, y","x":0.5402061971530205,"y":0.5232558145023387},{"text":"son comunes las pequeñas tiendas y","y":0.5042476091012652,"x":0.5400448203177177,"height":0.019879473302750417,"width":0.3777230050223215},{"text":"vendedores ambulantes. Los wolio","y":0.4869186047974031,"width":0.3505154506138394,"height":0.015988372200251955,"x":0.540206188868338},{"x":0.5402061966976941,"y":0.4680232555604845,"text":"cultivan tanto tierra como mar: cultivan","width":0.39793812779017856,"height":0.015988372200251955},{"y":0.4476228846609699,"width":0.3567010323660714,"x":0.5402061884149025,"height":0.017493393995606232,"text":"arroz, maíz y yuca, y también algas"},{"height":0.018987875422770473,"text":"marinas (agar-agar), de junio a","x":0.5422680471892835,"y":0.4286865431321293,"width":0.3154639020647322},{"x":0.540206178901245,"text":"septiembre. Muchos también trabajan","y":0.411337209584703,"width":0.3876288713727679,"height":0.01744185946431498},{"text":"como marineros y constructores navales,","x":0.5402061859772067,"y":0.3908138600092449,"width":0.422680419921875,"height":0.01772763900080576},{"y":0.375000000039719,"width":0.3360824846540179,"text":"aprovechando la rica vida marina","height":0.014605157131345692,"x":0.5402061779650873},{"text":"alrededor de Buton y Muna. Sus casas","y":0.3545527797794912,"width":0.3917525809151785,"x":0.5402061843052973,"height":0.017727639000805873},{"x":0.5381443238496986,"height":0.01904175148963161,"text":"tradicionales son elevadas, hechas de","width":0.3876288713727679,"y":0.3343023261035304},{"text":"tablas, con tejados de tablas de madera o","y":0.3166800967510156,"width":0.4268041294642857,"x":0.5381443305771354,"height":0.017727639000805873},{"height":0.017506277436310946,"y":0.2979651165614472,"text":"hojas de coco; los hombres trabajan al","x":0.5402061825836478,"width":0.3917525809151786},{"text":"aire libre mientras las mujeres manejan el","x":0.5402061912986122,"width":0.42061854771205365,"y":0.27906976772423786,"height":0.017465284810154524},{"x":0.540206180469613,"width":0.3525773228236607,"text":"hogar y las finanzas. Baubau se ha","y":0.26017441888702864,"height":0.01744185946431487},{"text":"convertido en una ciudad oficial, creando","y":0.2405528777906646,"x":0.5400478115816251,"width":0.4209686453683036,"height":0.021149935787671326},{"width":0.3917525809151786,"x":0.54020618050461,"y":0.22383720916392447,"height":0.015988372200251955,"text":"oportunidades de desarrollo; el pueblo"},{"text":"wolio valora mucho la educación y el","y":0.2049418602516182,"width":0.3711339983258929,"x":0.5402061998885999,"height":0.015988372200251955},{"width":0.4041237095424107,"height":0.018959766237318876,"y":0.18452860580595298,"text":"aprendizaje de idiomas, lo que conduce","x":0.5402061838885885},{"x":0.5402061888332451,"text":"al avance social.","y":0.16841257085048134,"width":0.16907216099330358,"height":0.016180452658801525},{"x":0.5402061770464762,"width":0.3752577427455357,"text":"Casi todos los wolio tienen creencias","y":0.1321514909822914,"height":0.014650834365586451},{"width":0.37731958007812494,"x":0.5402061917135148,"y":0.1103948428729502,"text":"centradas en el islam sufí. Según sus","height":0.017512133196416535},{"text":"enseñanzas, practican la meditación","width":0.3752577078683036,"y":0.09145850140958467,"height":0.01772763900080576,"x":0.5402061964576008},{"height":0.01612189198385605,"y":0.07412790682969128,"text":"para recibir visiones de Dios o para","width":0.36494845145089283,"x":0.540206184038913},{"text":"encontrar verdades ocultas mucho más","y":0.05668604657557186,"width":0.41237112862723213,"height":0.014627410556691811,"x":0.5402061848272774},{"height":0.016116035455278066,"text":"allá de su propio razonamiento.","y":0.03626107977103887,"x":0.5402061973923049,"width":0.3195876116071428}]