066,"width":0.08659793526785708,"x":0.5587628889021539},{"y":0.5652699434654391,"text":"El pueblo teli vive por toda la India.","width":0.3670102887834822,"height":0.01612540543991936,"x":0.5587629005154753},{"width":0.29484535435267856,"text":"Un pequeño número vive en","height":0.016166398066075782,"y":0.5463336020481007,"x":0.5587628922910145},{"height":0.019027696896905755,"text":"Bangladés, Nepal, Sri Lanka o","y":0.5245769537437499,"width":0.3154639020647322,"x":0.558762893323304},{"y":0.5072674418213856,"x":0.5587628878329718,"height":0.015988372200252066,"text":"Pakistán.","width":0.1010309273856026},{"y":0.46937953297548873,"text":"Los ancianos teli arreglan","height":0.016116035455277955,"x":0.5587628947310613,"width":0.2680412248883929},{"height":0.018946882028141654,"width":0.3958762904575892,"x":0.558762890647494,"y":0.447622885109607,"text":"matrimonios dentro de la comunidad,"},{"x":0.5567010415939686,"text":"y las dotes se pagan en efectivo o","y":0.43023255885795886,"width":0.3587628696986608,"height":0.01744185946431498},{"y":0.4113372093213856,"text":"con objetos de valor. Aunque las","height":0.016140631184666243,"width":0.34226803152901786,"x":0.5587628948746662},{"x":0.5585723516327062,"text":"mujeres tienen un estatus social más","y":0.39209849753988113,"height":0.019306691590093128,"width":0.39005203683035716},{"y":0.3720930235817961,"width":0.3752577078683036,"x":0.5587628959627553,"height":0.017512133196416535,"text":"bajo, desempeñan papeles clave en"},{"y":0.3531976749812976,"height":0.017471140570260224,"x":0.558762896681816,"text":"actividades religiosas y sociales y","width":0.35463916015624997},{"text":"contribuyen a los ingresos familiares","y":0.3343023261440884,"height":0.01744185946431487,"x":0.5587628949251542,"width":0.38556699916294634},{"text":"mediante trabajos extras.","width":0.2701030796595981,"y":0.3166800963241809,"height":0.01616874113859046,"x":0.5587628937526751},{"width":0.3608247419084821,"x":0.558762887788027,"text":"Los teli son en su mayoría hindúes","height":0.016116035455277955,"y":0.2775987108074802},{"width":0.3711339983258929,"text":"que tienen rituales especiales para","height":0.016116035455278066,"y":0.2586623694192114,"x":0.5587628946514867},{"x":0.5587628905979382,"width":0.4,"height":0.017469969418239084,"text":"bodas, partos y funerales. Incineran a","y":0.23837209361086575},{"y":0.21816127287432574,"text":"sus muertos y esparcen las cenizas","width":0.373574951171875,"x":0.5585816785795867,"height":0.019140523254246977},{"y":0.20058139567481936,"width":0.32577319335937505,"x":0.5587628868667042,"height":0.01744185946431487,"text":"en ríos sagrados. Honran a sus"},{"text":"antepasados y buscan protección","width":0.3567010323660714,"height":0.01744185946431487,"y":0.18168604723005188,"x":0.558762889461294},{"text":"contra los espíritus malignos.","width":0.31134019252232137,"y":0.16277195842355974,"x":0.5587628932491485,"height":0.01746059943359768},{"width":0.33814432198660715,"height":0.017509790892374366,"text":"Espiritualmente, son prácticos y","y":0.1424418609239887,"x":0.5587628881377716},{"width":0.33814432198660715,"height":0.01772763900080576,"y":0.12489927468475148,"x":0.5587628900170057,"text":"adoran a una \"diosa que cumple"},{"y":0.10465116313720302,"text":"deseos\" y creen que responde a sus","height":0.01903940918558933,"width":0.38144328962053575,"x":0.5587628944509004},{"x":0.5587295854142951,"width":0.11140680803571423,"height":0.016220484694389414,"text":"oraciones.","y":0.08709324622421488}]