7628899312715,"width":0.4,"height":0.017727639000805873},{"width":0.3876288713727678,"x":0.5587628866700225,"height":0.01613243235204609,"y":0.876309428239359,"text":"Afganistán y en las regiones del norte"},{"width":0.4,"y":0.8573730860438581,"text":"de Pakistán. Hablan varias lenguas del","height":0.016173425746674908,"x":0.5587628899312715},{"text":"grupo lingüistico nuristaní.","y":0.8356164385067685,"x":0.5587628828446359,"width":0.27422680664062493,"height":0.019034723809032483},{"width":0.3752577078683036,"x":0.5587628974060544,"height":0.019075716435188794,"y":0.8166800969961645,"text":"Etnicamente, el grupo de nuristanes"},{"height":0.016116035455277955,"width":0.3443299037388393,"x":0.5587628860515426,"y":0.7993553586308328,"text":"abarca ocho grupos: los ashkuni-"},{"text":"wamayi, narisati, grangali, kambiri,","x":0.5587628823118097,"width":0.3567010323660714,"y":0.7790697678841216,"height":0.017465284810154635},{"text":"malakhel, waigeli, prasuni y tregami.","x":0.5608247547751979,"width":0.3711339983258929,"height":0.019035894961053623,"y":0.7601744190795479},{"height":0.014603985979324663,"y":0.7252215952842509,"x":0.5587628995753405,"width":0.36288657924107137,"text":"El contacto inicial entre los obreros"},{"x":0.5586514583298371,"height":0.01812360826564552,"width":0.3445430036272321,"y":0.7029250024435298,"text":"cristianos y el pueblo de Nuristán"},{"width":0.3694919782366072,"height":0.01968998413331846,"y":0.6842047258221295,"x":0.558579410877786,"text":"ocurrió de forma indirecta. En aquel"},{"height":0.016116035455277955,"text":"entonces, Nuristán era conocido como","width":0.3999999999999999,"y":0.665592264402074,"x":0.5587628850171822},{"y":0.646655922639464,"height":0.01772763900080576,"width":0.40824741908482143,"text":"Kafiristán (tierra de los Kafires). Kafires","x":0.5587628861792389},{"height":0.01744185946431509,"text":"significa no musulmanes. El contacto","y":0.626453488698075,"x":0.5587628797446152,"width":0.3835051618303572},{"y":0.6075581398608658,"x":0.5567010248109927,"width":0.3443299037388393,"height":0.01744185946431487,"text":"llegó a través del ejército colonial"},{"height":0.017727639000805873,"width":0.4041237095424107,"y":0.5870265914382524,"x":0.5587628858129872,"text":"británico, especialmente del Cuerpo de"},{"height":0.020581195471653713,"x":0.5586292820823331,"width":0.4064953264508928,"y":0.5668120143474307,"text":"Guías. Entre sus reclutas, en Peshawar,"},{"height":0.016116035455277955,"text":"había individuos de Kafiristán que","x":0.5587628870294782,"y":0.5507655118280568,"width":0.3484536132812499},{"width":0.40618554687499997,"y":0.5318291698106081,"x":0.5587629017429122,"height":0.016135946576581794,"text":"habían estado expuestos a enseñanzas"},{"text":"cristianas mientras servían en el","x":0.5587628951577266,"width":0.331958740234375,"height":0.01456533565721041,"y":0.5145044315269077},{"text":"ejercito.","y":0.49256030170897325,"x":0.5586995329270414,"height":0.01633288454951831,"width":0.08672464425223214},{"text":"Un soldado kafir que mostró interés en","x":0.5587628902061855,"width":0.4,"height":0.017508619740353115,"y":0.45487510090750205},{"text":"aprender más sobre el cristianismo","x":0.5586136551954511,"width":0.36312576729910717,"y":0.43591455032260096,"height":0.018861650748179803},{"x":0.5567010301881022,"height":0.014534883399244136,"text":"instó a los obreros cristianos a visitar su","y":0.41860465125095936,"width":0.41237112862723213},{"y":0.3952457692919784,"width":0.3958762904575892,"height":0.018998416559433018,"x":0.558762890647494,"text":"tierra natal en Kafiristán. En 1864, dos"},{"height":0.01903940918558933,"y":0.37630942776502263,"x":0.5587628945808979,"width":0.38556699916294646,"text":"pastunes convertidos al cristianismo,"},{"x":0.5584694851874464,"height":0.021345981564087624,"text":"actuando por invitación de soldados","y":0.35771037801047056,"width":0.37372014508928575},{"width":0.41237112862723224,"x":0.5587628922401394,"y":0.3400483484292406,"height":0.016116035455277955,"text":"kafir, realizaron el primer viaje misionero"},{"y":0.3211120061282938,"x":0.5567010392656939,"text":"registrado a Kafiristán. Su misión incluía","width":0.41649483816964283,"height":0.017727639000805873},{"height":0.01744185946431498,"text":"la enseñanza cristiana, la distribución","y":0.3008720933492378,"width":0.38969070870535705,"x":0.5567010382864968},{"height":0.016179281506780496,"width":0.4,"x":0.5587628879896906,"text":"de escrituras traducidas (en un idioma","y":0.2832393233978514},{"y":0.26308139577656353,"text":"comercial) y la prestación de asistencia","x":0.5587628932807132,"height":0.01744185946431498,"width":0.40618554687499997},{"width":0.3589722028459821,"y":0.2455876266974355,"x":0.5586769600472604,"height":0.01616989692116244,"text":"médica a las comunidades locales."},{"x":0.5587628995321128,"height":0.016116035455278066,"y":0.2252215951315668,"width":0.35876286969866067,"text":"Fueron recibidos positivamente. Al"},{"width":0.36288657924107137,"height":0.01745942828157654,"y":0.2049418610236564,"x":0.5587628995753405,"text":"partir ellos, la gente local envió una"},{"y":0.18454835507187717,"x":0.5585296864303559,"text":"carta solicitando que regresaran con","width":0.3777813197544644,"height":0.02023058452498616},{"height":0.01744185946431487,"y":0.16715116329109836,"x":0.5587629016675832,"text":"más enseñanzas. No pudieron regresar.","width":0.4103092564174107},{"y":0.1482558146719123,"text":"Hay registros de otras personas que","x":0.5587628849125553,"width":0.37319587053571424,"height":0.01744185946431487},{"x":0.5587628932807132,"y":0.1308139535765408,"width":0.40618554687499997,"height":0.014633266316797289,"text":"visitaron Kafiristán durante las décadas"},{"x":0.5587628784662648,"text":"siguientes, pero en 1896 la población","width":0.3835051618303572,"height":0.01889534826532291,"y":0.10901162842911172},{"text":"fue convertida por la fuerza al islam y","height":0.0174582571295554,"y":0.09011627935214483,"x":0.5567010412174958,"width":0.38556699916294646},{"y":0.07412790731927321,"x":0.5587628862521288,"text":"Kafiristán fue renombrado como","width":0.33402061244419634,"height":0.014534883399244136},{"width":0.2412371128627232,"x":0.5587628863933807,"text":"Nuristán, 'tierra de luz'.","height":0.019001930015496327,"y":0.050765511370072125}]