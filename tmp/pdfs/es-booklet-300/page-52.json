y":0.6017441866341215,"height":0.017514475500458815,"width":0.32989690290178564},{"x":0.5567010294549661,"text":"títulos y derechos de propiedad. En","y":0.5828488374916797,"height":0.017473482874302393,"width":0.36494845145089283},{"text":"Rajasthan sus dinastías aún se","x":0.5587628978819955,"y":0.5652699434544701,"height":0.01772763900080576,"width":0.3195876116071428},{"width":0.37796146065848213,"y":0.5414417313789768,"x":0.5584807878728144,"text":"conocen, y sus clanes siguen siendo","height":0.023336259901859835},{"text":"identificables.","width":0.15051546805245541,"height":0.015988372200251955,"x":0.5567010307418135,"y":0.5276162789979846},{"text":"Hoy en día, los rajput continuan","width":0.32577319335937505,"height":0.017513304348437675,"x":0.5587628905711715,"y":0.4869186052242379},{"x":0.5587628878570278,"y":0.4693795325667547,"width":0.36494845145089283,"text":"ocupando cargos destacados en la","height":0.016116035455277955},{"text":"política, el ejército y la policía.","x":0.5587628874566802,"y":0.4491279074988792,"width":0.30927835518973223,"height":0.01904292264165275},{"width":0.3876288713727678,"x":0.5587628806710045,"y":0.43023255804958327,"height":0.016181623810822665,"text":"Respetados por su liderazgo, coraje y"},{"text":"lealtad, continúan su legado de guía","x":0.5567010310981223,"width":0.37319587053571424,"y":0.40975020119637984,"height":0.019028868048926895},{"text":"y protección.","x":0.5586632208625165,"width":0.13834366280691968,"y":0.392040645517836,"height":0.01824429148536455},{"height":0.017471140570260113,"y":0.35319767491900533,"text":"Los rajput suelen adorar a Shiva,","width":0.33814432198660715,"x":0.5587628939345315},{"width":0.37731958007812505,"x":0.5587628895227933,"y":0.3327961323442138,"height":0.018948053180162794,"text":"Surya y Durga, buscando protección"},{"height":0.02354760289096136,"width":0.3387607770647322,"text":"de sus dioses patronos y guía de","x":0.5584839703659907,"y":0.31429995263453314},{"x":0.558762897