8936151279,"height":0.016162884610012362},{"text":"estrechamente con su deidad de","x":0.5587628877352189,"width":0.33814432198660715,"height":0.013295729250604404,"y":0.8734891216270237},{"text":"casta, Krishna. Sin embargo, la","width":0.32164948381696423,"y":0.8517324735624306,"x":0.5587628896379097,"height":0.01745357252147095},{"height":0.017494565147627372,"x":0.5587628845986631,"width":0.32577319335937505,"text":"mayoría de los yadav hoy en día","y":0.8327961319391812},{"x":0.5584705650151837,"height":0.021534304192333265,"text":"cultivan, mientras que menos de un","y":0.811365450751901,"width":0.3675854143415178},{"x":0.5567010455051662,"width":0.3670102887834821,"y":0.79492344854921,"height":0.01772763900080576,"text":"tercio trabaja con vacas. Viven casi"},{"height":0.01744185946431498,"y":0.7747093026515635,"text":"por toda la India y en el sur de Nepal.","x":0.5587628877051962,"width":0.38144328962053564},{"text":"La mayor concentración se encuentra","y":0.7551498170994446,"x":0.558520756137116,"width":0.39012112862723214,"height":0.02167661299540291},{"x":0.5587628811772445,"text":"en los estados de Uttar Pradesh y","width":0.3484536132812499,"height":0.016116035455277955,"y":0.7369057210962817},{"height":0.0174957362996484,"text":"Bihar (norte de la India). Los yadav","y":0.717969379304602,"width":0.35876286969866067,"x":0.5587628976042779},{"y":0.6990330380702287,"x":0.5587628905368073,"height":0.016116035455277955,"text":"viven en familias extendidas. La","width":0.32577319335937494},{"text":"mayoría son vegetarianos, pero","height":0.01744185946431487,"x":0.5587628920798625,"width":0.3237113211495535,"y":0.6787790701951681},{"height":0.0149073327961321,"text":"muchos han empezado a comer","y":0.661160354628242,"x":0.558762898113053,"width":0.331958740234375},{"x":0.5587628860515426,"width":0.3443299037388393,"height":0.01772763900080576,"text":"pescado, cordero, pollo y a veces","y":0.6394037068386683},{"x":0.5587628844413084,"text":"cerdo, pero no res.","width":0.19587629045758925,"height":0.01772763900080576,"y":0.6204673646843496},{"x":0.5587628985939684,"height":0.017473482874302282,"text":"Los yadav son vistos como social y","y":0.5828488375352845,"width":0.3587628696986608},{"text":"educativamente atrasados. Son uno","height":0.01612540543991936,"y":0.5652699433176678,"width":0.3711339983258929,"x":0.5587628993593904},{"y":0.5442224741723074,"text":"de los pueblos más numerosos de","x":0.5585135238993753,"height":0.020544662291152482,"width":0.3510146833147322},{"y":0.5261627911980751,"width":0.3154639020647322,"height":0.01744185946431498,"text":"otras castas atrasadas (OBC).","x":0.5587628974830977},{"text":"Los yadav tienen tradiciones orales","height":0.016116035455277955,"x":0.5587628916511146,"width":0.36907216099330353,"y":0.48831587465930015},{"text":"expertas y cantos grupales sobre sus","y":0.4668702066367787,"height":0.020602767261932442,"x":0.5585333179467876,"width":0.39425575474330354},{"width":0.3793814522879465,"text":"dioses: Krishna, Vishnu y otros. Ellos","x":0.5587628858972638,"height":0.01744185946431498,"y":0.4491279075352844},{"text":"reclaman a Krishna como su ancestro","height":0.014555965672569116,"y":0.4331184528003087,"x":0.558762896966909,"width":0.38969070870535716},{"y":0.4113372093213856,"text":"de sangre y por eso le están","x":0.5587628918422887,"height":0.016140631184666243,"width":0.29072164481026785},{"y":0.39242546358740826,"x":0.5587628836848767,"text":"especialmente devotos. Para","height":0.016116035455277955,"width":0.2969072265625},{"x":0.5587628957534632,"width":0.35051545061383926,"text":"protegerse de las maldiciones, los","height":0.017512133196416535,"y":0.3720930238392711},{"width":0.3113401925223215,"text":"yadav confiaban en amuletos,","height":0.017471140570260113,"y":0.35319767491900533,"x":0.5567010403539595},{"height":0.01744185946431498,"width":0.38556699916294646,"y":0.33430232610602084,"x":0.5587628953841625,"text":"astrólogos y sanadores tradicionales."},{"y":0.2959728648961425,"width":0.3383392857142856,"text":"Sus vidas y niveles de vida están","x":0.5586674020533184,"height":0.01809587255780687},{"x":0.5587628879381443,"text":"cambiando en todo el país. La próxima","y":0.2775987109709298,"width":0.4,"height":0.01745942828157654},{"width":0.36494845145089294,"height":0.017510962044395395,"text":"generación necesitará buscar otros","x":0.5587628842745536,"y":0.25726744218644715},{"width":0.3322464425223215,"x":0.5565529280711251,"text":"tipos de empleos, pero falta una","y":0.2375337628462152,"height":0.018335918761567704},{"y":0.22238372112014537,"x":0.558762884745156,"text":"educación adecuada en muchos","height":0.014534883399244136,"width":0.3360824846540179},{"y":0.20058139527705432,"width":0.08865979003906255,"text":"lugares.","x":0.5567010317072729,"height":0.015988372200252066}]