99,"width":0.30721648297991067,"height":0.015988372200251955,"text":"idea se refuerza a través de la"},{"y":0.5828488374916797,"x":0.5587628909754982,"width":0.2618556605747768,"height":0.017473482874302393,"text":"educación, los medios de"},{"width":0.3237113211495536,"x":0.5587628988238486,"text":"comunicación y la socialización","y":0.5652699435114663,"height":0.01612540543991936},{"height":0.016166398066075782,"width":0.3628865792410715,"x":0.5587628929224197,"text":"cotidiana. A muchos hindúes se les","y":0.5463336019027518},{"height":0.01744185946431498,"text":"enseña desde pequeños que los","y":0.5261627910236564,"x":0.5587628895304791,"width":0.33402061244419645},{"width":0.3835051618303572,"text":"musulmanes son ladrones, inmorales","height":0.017727639000805873,"y":0.5056406125130102,"x":0.5587628851157492},{"text":"y poco fiables. Esto conduce a","y":0.48831587465930015,"x":0.5587628969573247,"width":0.31546390206473207,"height":0.016116035455277955},{"x":0.5587628796887274,"y":0.4693795330021361,"text":"profundas divisiones sociales en","width":0.3402061941964285,"height":0.016116035455277955},{"width":0.30721648297991067,"y":0.44762288459549493,"height":0.018946882796614162,"text":"barrios, colegios y relaciones.","x":0.5587628947213849},{"x":0.5587628869737782,"width":0.33402061244419645,"height":0.015988372200251955,"text":"Aproximadamente el 90% de los","y":0.4127906978206589},{"x":0.5587628842770849,"text":"musulmanes indios trabajan en","width":0.32164948381696423,"y":0.3938953489011531,"height":0.014646149757502003},{"text":"empleos de baja calidad y con bajos","width":0.3711339983258928,"height":0.017512133964889043,"x":0.5587629017648885,"y":0.3720930235381914},{"y":0.35455278038814786,"text":"salarios. Muchos están excluidos de","x":0.5587628961689411,"height":0.016116035455277955,"width":0.3752577078683036},{"x":0.5587628963174245,"height":0.01744185946431487,"width":0.38969070870535716,"text":"una educación de calidad. Por eso, se","y":0.33430232615447053},{"text":"les percibe ampliamente como sin","y":0.3166800968201243,"width":0.3525773228236607,"x":0.5567010267914096,"height":0.01616874037011795},{"text":"educación y pobres, y aún más","width":0.32577319335937494,"x":0.5587628855294436,"height":0.01744185946431498,"y":0.2965116283243209},{"y":0.27885975071293034,"height":0.016408405411541205,"width":0.10528153773716509,"x":0.5586994365653074,"text":"excluidos!"}]