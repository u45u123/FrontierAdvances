n diferir"},{"height":0.018895348265322798,"x":0.5319587563761047,"y":0.2500000005221351,"width":0.4268041294642857,"text":"teológicamente, y los individuos pueden"},{"width":0.331958740234375,"height":0.015988372200251955,"x":0.5298969148570394,"text":"ir desde hindúes devotos hasta","y":0.2340116276535077},{"x":0.5340206181569863,"height":0.016116035455277955,"width":0.3835051618303571,"text":"secularistas o ateos. Esta diversidad","y":0.21353746977786314},{"x":0.5339329458396063,"text":"dificulta generalizar sobre sus creencias.","y":0.19293529280057453,"width":0.43108297293526776,"height":0.01942838535109037},{"text":"Comprender los valores brahmanes: la","width":0.4041237095424107,"x":0.5340206154968359,"y":0.1569767442923159,"height":0.015988372200251955},{"x":0.5340206336263461,"height":0.016116035455277955,"width":0.4103092564174107,"y":0.13658340014511205,"text":"disciplina, el aprendizaje y la busqueda"},{"width":0.39793812779017856,"y":0.1162790703550518,"text":"de sabiduría, sigue siendo importante","height":0.017484024010964827,"x":0.5340206308059415},{"height":0.01905463493033621,"x":0.5340206200213434,"width":0.32577319335937505,"y":0.09738372145236762,"text":"para una conexión significativa"},{"y":0.07848837255708685,"width":0.4309278390066964,"height":0.01744185946431487,"x":0.5340206219657239,"text":"misionera. Para el evangelismo cristiano,"},{"y":0.057747566617764146,"width":0.4004701799665179,"height":0.021847414451679037,"x":0.5317325401960807,"text":"los enfoques que suelen ser efectivos"},{"width":0.41907202148437506,"x":0.5337534658298856,"height":0.02252496969882367,"y":0.0385444363536801,"text":"con grupos marginados parecen menos"},{"width":0.3134020647321428,"height":0.016116035455277955,"x":0.5340206210359902,"text":"adecuados para los brahman.","y":0.021756647506899096}]