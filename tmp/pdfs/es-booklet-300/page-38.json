5424107,"text":"siguieron en el gobierno después de la","height":0.01752033202903669,"x":0.5340206160879012,"y":0.8066075743746324},{"text":"independencia. Sus deberes","x":0.5319587660853737,"y":0.7876712330385147,"width":0.30309277343749996,"height":0.016116035455278066},{"width":0.41649483816964283,"text":"tradicionales incluyen el sacerdocio del","y":0.7687348915751491,"x":0.5340206220285806,"height":0.01614882924881411},{"x":0.5319587611734513,"height":0.01744185946431498,"width":0.36907216099330353,"y":0.7485465120992378,"text":"templo, oficiando ritos de pasaje, y"},{"width":0.40061600167410716,"text":"sirviendo como maestros espirituales,","x":0.533790934228547,"y":0.7280817323703853,"height":0.021684537483356636},{"y":0.7122093021871803,"width":0.4309278390066965,"height":0.015988372200251955,"x":0.5340206129880607,"text":"aunque muchos también se ocupan en la"},{"height":0.020348837066330727,"text":"agricultura, el comercio u otras","y":0.6904069770700323,"width":0.3278350306919642,"x":0.5340206306076262},{"text":"ocupaciones.","x":0.5340206196036364,"height":0.015988372200251955,"y":0.6729651164253101,"width":0.1443298950195313},{"height":0.01744185946431487,"y":0.6337209305585403,"text":"A pesar de su posición ritual alta, la","x":0.5340206174024186,"width":0.3793814522879464},{"text":"India moderna ha visto un declive en el","x":0.5319587610472089,"y":0.6176470590052154,"height":0.014620382876092686,"width":0.41237112862723213},{"text":"privilegio brahmán debido a la política de","x":0.5340206219657239,"height":0.017481681706922547,"y":0.595890410888607,"width":0.4309278390066964},{"x":0.5340206291938973,"height":0.014581732553978544,"width":0.3628865792410715,"text":"acciones afirmativas a favor de las","y":0.5784883720721803},{"text":"castas más bajas. Alguna vez","x":0.5340206179721442,"y":0.5566860467940054,"height":0.017447715992892965,"width":0.3092783551897321},{"width":0.42061854771205354,"height":0.01744185946431498,"y":0.5377906980004006,"text