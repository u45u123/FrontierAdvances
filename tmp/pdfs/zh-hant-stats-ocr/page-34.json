[{"height":0.014693534844668399,"width":0.3072164989653088,"x":0.020618557201194373,"y":0.9664147773843581,"text":"34 | 印度-印度前沿民族群體"},{"x":0.07623606007615519,"width":0.10732169378371464,"height":0.017766094928424292,"y":0.9300704414819163,"text":"DAY 09"},{"x":0.5587628962983894,"text":"印度是世界上族群最多元的國家","height":0.020348836352703015,"width":0.383505140032087,"y":0.9084302330591136},{"text":"之一。","width":0.07628865923200323,"height":0.016160447691589974,"x":0.5587628874237627,"y":0.8879093195436191},{"width":0.06185567038399832,"y":0.871956339426483,"text":"印度","x":0.06185566957604208,"height":0.02193900940300142},{"width":0.383505140032087,"text":"印度前沿民族群體是指那些至今","y":0.8255813956075632,"x":0.5587628969942657,"height":0.020348836352703126},{"height":0.04796511620458288,"x":0.06391752948583047,"width":0.4103092738560268,"y":0.8110465117430159,"text":"印度前沿民族"},{"x":0.5587628892539686,"y":0.8052057093561227,"height":0.020570948782535736,"width":0.38556700206938244,"text":"仍舊極少接觸福音的族群。這些"},{"x":0.5587628949736472,"width":0.383505140032087,"height":0.02196951977451944,"y":0.7819767439121581,"text":"群體通常只有不到0.1%的人口是"},{"y":0.7630813955241577,"height":0.019034473761903592,"width":0.383505140032087,"text":"基督徒，並且尚未建立能夠自發","x":0.5587628962983894},{"y":0.757267441970383,"text":"群體","width":0.1402061825706845,"x":0.06185567206860962,"height":0.04796511620458288},{"y":0.7412790699518466,"height":0.019006404828665002,"width":0.3793814522879464,"x":0.5587628842111242,"text":"倍增的本土教會運動。印度擁有"},{"height":0.020348836352703126,"width":0.3938144138881139,"y":0.7194767446870205,"x":0.5587628986100667,"text":"全球數量最多的前沿民族群體。在"},{"height":0.03343023240916576,"x":0.04948453527476544,"y":0.7093023255624437,"text":"FPGs in India","width":0.3752577282133557},{"width":0.3752577282133557,"y":0.6960537367143473,"text":"全球約4，800個前沿民族群體中，","height":0.021969518973785185,"x":0.5587628870960712},{"x":0.5587629008995113,"height":0.021997588707758142,"width":0.3814432779947917,"text":"超過1,700個位於印度，使其成為","y":0.6742233416824094},{"width":0.3628865923200335,"x":0.5587628916750348,"height":0.020570948782535625,"text":"當今世上最大的福音禾場之一。","y":0.655331654256613},{"x":0.5587629004345822,"height":0.020570948782535625,"text":"這些群體大多屬於印度教種姓體系、","width":0.4164948236374628,"y":0.594458438314345},{"x":0.5587629032498483,"y":0.5741279071611489,"text":"穆斯林群體，或部落原住民族群。","width":0.3917525518508185,"height":0.01907108492655074},{"width":0.3958762759254093,"text":"根據我們在15個城市的研究，當地","height":0.01904301599331204,"x":0.5587628969238932,"y":0.5523255815797535},{"text":"約有50%至95%的人口屬於前沿民族","height":0.01901494706007334,"width":0.3979381379627046,"x":0.5567010380908127,"y":0.5305232559983583},{"width":0.3917525518508185,"height":0.018994200840204534,"text":"群體。雖然他們居住在城市之中，","y":0.5100755665626,"x":0.5587629032498483},{"x":0.5587628969238932,"text":"卻仍與家鄉的農村社區保持緊密聯","height":0.019022269773443234,"y":0.4882451720479659,"width":0.3958762759254093},{"x":0.5587628936873863,"height":0.020570948782535625,"width":0.3938144138881138,"text":"繫。仍舊使用少數民族語言，並持","y":0.4664147777045523},{"x":0.5587628867648575,"y":0.4462209304290753,"text":"守傳統宗教信仰和文化習俗，這成","height":0.018934401216675112,"width":0.4020618620372953},{"text":"為傳福音很大的挑戰。此外，種姓","y":0.4244186048355676,"x":0.5587628969238932,"width":0.3958762759254093,"height":0.01890633228343641},{"x":0.5587628986100667,"text":"制度帶來的不平等、對其他宗教信","y":0.40260285446277444,"width":0.3938144138881139,"height":0.020570948782535625},{"width":0.3938144138881139,"y":0.38226744204486995,"x":0.5587628983365844,"height":0.01907596700237535,"text":"仰者的排斥，以及普遍存在的貧窮"},{"width":0.3938144138881138,"height":0.01904789806913676,"text":"問題，也進一步造成他們與外界的","y":0.3604651163181257,"x":0.5587628933357665},{"x":0.5587628882041578,"width":0.07422680173601426,"height":0.019019829135897948,"y":0.3386627908820792,"text":"隔閡。"},{"text":"Photo Source: Adnan Mughal - Pexels","x":0.1690721688425828,"y":0.2979651161621065,"width":0.28659793308803017,"height":0.013118007221109895},{"y":0.2863140218639797,"x":0.2701030968003603,"text":"Licensed under CCO 1.0","width":0.18556700206938243,"height":0.010197606234866763},{"y":0.27749790129784047,"text":"然而，神渴望萬族、萬民、萬方","height":0.020570948782535736,"width":0.383505140032087,"x":0.558762891504575},{"width":0.38556700206938244,"height":0.018971013182056407,"y":0.2572674418874086,"text":"都能認識祂。要接觸這些前沿民","x":0.5567010318347246},{"text":"族群體，需要更多專注而恆切的","y":0.23546511647558688,"x":0.5587628939309445,"width":0.38556700206938244,"height":0.018942944248817706},{"text":"禱告、跨文化工人、長期委身的","x":0.5587628962983894,"height":0.020348836352703015,"y":0.21366279119864862,"width":0.383505140032087},{"text":"• 人口：1,051,877,000","y":0.20639534938861104,"width":0.34432987031482515,"height":0.023255813432080052,"x":0.05360825780650507},{"x":0.5587628829287983,"width":0.3773195902506511,"y":0.19311502954739335,"height":0.01909427258469898,"text":"服事、對當地文化的深入理解，"},{"height":0.020350057472209748,"x":0.12371134320157054,"text":"（截至2025年8月）","y":0.17296389552179503,"width":0.22680411565871464},{"width":0.35670104253859747,"y":0.1715116279369484,"x":0.5587628785631755,"height":0.019084510034517832,"text":"以及本地屬靈領袖的培育與發"},{"y":0.14970930250998615,"text":"展。","x":0.5587628868490827,"width":0.05154639198666522,"height":0.019056440300545097},{"width":0.3752577282133556,"height":0.021990265994388136,"x":0.05360824941909536,"text":"• 宗教：印度教\/伊斯蘭教","y":0.13643996640159328},{"height":0.021875549623888157,"text":"• 基督徒比例：未知","y":0.10029069753679454,"width":0.28247422717866444,"x":0.05360824546994617}]