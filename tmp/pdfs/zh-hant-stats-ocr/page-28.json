[{"text":"28| 阿拉伯世界- 費扎拉人","width":0.27628865923200335,"height":0.014693534844668399,"x":0.020618559284341944,"y":0.9664147773843581},{"y":0.9302325583239397,"height":0.018969792863283708,"text":"費扎拉人是蘇丹境內的一個阿拉","x":0.5587628903030676,"width":0.38762886410667785},{"height":0.018941723930045007,"text":"伯族群，其祖先由阿拉伯半島遷","x":0.5587628896877835,"y":0.9084302327425443,"width":0.38762886410667785},{"height":0.01813309538974972,"text":"DAY 07","width":0.10743852342878067,"x":0.06999207815005466,"y":0.9022706618602572},{"height":0.020348836352703015,"y":0.8866279073323694,"text":"往埃及，後來再遷居蘇丹。現今","x":0.5587628851116095,"width":0.38762886410667785},{"y":0.8660789256500112,"x":0.5587628892646346,"height":0.019095492903471678,"text":"費扎拉人主要分佈於蘇丹境內。","width":0.3649484543573288},{"text":"阿拉伯世界","x":0.05560751203081827,"width":0.14651693616594588,"height":0.02365057854768504,"y":0.8471863387038334},{"y":0.8444767443704513,"text":"他們過著傳統的遊牧生活，居住","height":0.01908328891501121,"x":0.5587628903030676,"width":0.38762886410667785},{"y":0.8226744187981402,"height":0.01905521998177251,"x":0.5587628899569703,"text":"在稱為 furgan 的圓頂帳篷中。這","width":0.38762886410667785},{"width":0.38762886410667785,"y":0.8008720935242298,"text":"些可移動的帳篷通常圍繞牛群搭","height":0.020348836352703126,"x":0.5587628899569703},{"text":"費扎拉人","height":0.049418605545005545,"x":0.053608246782623735,"width":0.27628865923200335,"y":0.7877906971596678},{"y":0.7804366076059296,"height":0.018981996851744065,"x":0.5587628851116095,"text":"建。費扎拉人的生活方式和文化","width":0.38762886410667785},{"text":"習俗與蘇丹北部其他阿拉伯部族","height":0.019010065784982766,"y":0.7586062131094642,"width":0.38762886410667785,"x":0.5587628851116095},{"height":0.020570948782535625,"width":0.40824741181873136,"y":0.7367758183438291,"x":0.558762892338057,"text":"相似，比如巴加拉人（Baggara）。"},{"x":0.05350846410986082,"y":0.7293375891761307,"width":0.23731297084263392,"height":0.038417844988537064,"text":"Fezara"},{"height":0.018918536271896658,"y":0.69476744204487,"text":"蘇丹是全球最貧窮、發展程度最","width":0.38762886410667785,"x":0.5587628896877835},{"width":0.38762886410667785,"y":0.672963896144702,"x":0.5587628903030676,"height":0.01889656893252112,"text":"低的國家之一。在2024年人類發"},{"height":0.01892463786575993,"text":"展指數（HDI）排名中位列第170","x":0.5587628815671887,"y":0.651133501484719,"width":0.38969072614397315},{"x":0.5587628899569703,"y":0.6308139536636925,"height":0.019060102057597117,"text":"位，人均國內生產總值（GDP）則","width":0.38762886410667785},{"width":0.38762886410667785,"y":0.6090116280913815,"x":0.5587628896877835,"height":0.01903203232362416,"text":"排名第185位。當地經濟高度依賴"},{"height":0.019003964191119715,"x":0.5587628847655123,"y":0.5872093023646373,"text":"農業，卻長期受到國際制裁以及","width":0.38762886410667785},{"text":"國內衝突的影響。","x":0.5587628844115492,"height":0.01900518370915827,"width":0.2061855679466611,"y":0.5667506300478129},{"height":0.019061322376369705,"x":0.5608247491420392,"y":0.523089840375272,"width":0.38556700206938244,"text":"目前，蘇丹正經歷全球最嚴重的"},{"x":0.5587628896877835,"height":0.019089391309608406,"text":"人口流失危機，同時也面臨嚴峻","y":0.501259445860638,"width":0.38762886410667785},{"text":"的糧食短缺問題。根據世界糧食","y":0.4796511630155089,"x":0.558762890132228,"width":0.38762886410667785,"height":0.02034883715343716},{"width":0.38762886410667785,"text":"計畫署（WFP）2024年2月發佈的","height":0.018919756590669468,"x":0.5587628903030676,"y":0.4592779177888793},{"text":"報告，全國超過95%的人口甚至無","y":0.43744752313798074,"width":0.38762886410667785,"x":0.5587628851116095,"height":0.018947825523908057},{"height":0.01903691439944888,"width":0.33814432053338916,"x":0.5587628940975665,"text":"力負擔一天一餐的基本開銷。","y":0.41715116296299004},{"width":0.38762886410667785,"y":0.37354651167604713,"x":0.5587628851116095,"text":"在費扎拉人當中開展福音工作極","height":0.01898077653297159},{"y":0.3517441862400007,"width":0.38762886410667785,"x":0.5587628899569703,"height":0.01895270679899863,"text":"具挑戰。他們對伊斯蘭教有堅定"},{"height":0.020348836352703015,"x":0.5587628851116095,"width":0.38762886410667785,"text":"的認同，加上遊牧生活方式，使","y":0.3299418608207414},{"width":0.35670100620814726,"y":0.31234256943719974,"x":0.09896909046980931,"text":"Image generated by Al using Microsoft Copilot","height":0.013434088600472571},{"y":0.30813953548159423,"width":0.38762886410667774,"height":0.020348836352703015,"x":0.5587628853693416,"text":"長期接觸和門徒培育工作十分困"},{"y":0.28779069772255883,"height":0.01909427258469898,"text":"難。目前沒有宣教士或信徒在那","x":0.5587628851116095,"width":0.38762886410667785},{"text":"•人口：407,000","x":0.05154639552556512,"y":0.2615449205627063,"width":0.24536081949869792,"height":0.02350965575146935},{"y":0.26598837244864837,"x":0.5587628851116095,"text":"裡服事，也沒有具有規模的海外","width":0.38762886410667785,"height":0.020348836352703015},{"x":0.5587628860482288,"text":"散居群體可以被接觸。","y":0.24418604673643918,"width":0.2597938174293154,"height":0.020348836352703015},{"text":"（截至2025年8月）","height":0.020348836352703126,"y":0.2281976749438035,"x":0.09278350726883348,"width":0.22886597769601003},{"width":0.37525772821335557,"y":0.200581395271614,"text":"根據敞開的門（Open Doors）","height":0.018981996851744176,"x":0.5587628895015696},{"x":0.049484534265716834,"text":"• 宗教：伊斯蘭教","y":0.19311502908269484,"height":0.020570948782535736,"width":0.24123711358933222},{"text":"2025年《全球守望名單》（World","x":0.5567010397446939,"width":0.3917525518508185,"height":0.019027151048533697,"y":0.18010075574380557},{"y":0.1569767442119402,"width":0.3216494968959263,"text":"• 語言：蘇丹阿拉伯語","x":0.05154638758296464,"height":0.021864565954200277},{"y":0.15827036124128402,"width":0.38969072614397327,"height":0.019055219981772398,"text":"Watch List），蘇丹位列全球基","x":0.5567010254331681},{"height":0.020570948782535625,"text":"督徒受逼迫最嚴重國家的第五位。","width":0.40824741181873136,"x":0.5587628930940707,"y":0.13643996613347353},{"x":0.051546400442526195,"width":0.3113401867094494,"height":0.02195487434777965,"text":"• 基督徒比例：0.00%","y":0.12048698599151575},{"width":0.38762886410667785,"x":0.5587628899569703,"y":0.11627906996093107,"text":"持續不斷的衝突，使當地信徒本","height":0.018901451008345838},{"width":0.33814432053338916,"x":0.5587628936950139,"height":0.020570948782535625,"text":"已艱難的處境更加雪上加霜。","y":0.09445843831434497},{"height":0.021915822545587327,"y":0.08564231711783588,"width":0.2618556613013858,"text":"• 新約聖經：已有","x":0.05154639760818449},{"width":0.21237113589332215,"text":"• 全本聖經：無","height":0.020570948782535625,"y":0.05079764926431285,"x":0.05154639233316218}]