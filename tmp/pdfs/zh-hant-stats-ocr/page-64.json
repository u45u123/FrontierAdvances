[{"x":0.02061856323281507,"y":0.9664147778281076,"width":0.41649482363746276,"text":"64 | 拉丁美洲 - 亞馬遜地區前沿民族群體","height":0.016143361627304897},{"x":0.558762894945829,"height":0.01909305226592639,"text":"馬蒂斯人是亞馬遜地區17 前沿","width":0.36907214210146944,"y":0.9607558139804319},{"x":0.5608247439209919,"height":0.01906498333268769,"width":0.3649484543573288,"text":"民族群體之一，屬於巴西東北部","y":0.9389534885564977},{"height":0.020348836352703015,"text":"亞馬遜雨林中的一個小型部族。","width":0.3628865923200335,"x":0.5587628880461688,"y":0.9171511634224857},{"width":0.10525529952276322,"text":"DAY 23","y":0.9068105970142777,"height":0.016320666578214293,"x":0.07830018587481369},{"x":0.55876290065766,"text":"他們的人口不多，容易受到疾病","y":0.8953488373937071,"width":0.36907214210146955,"height":0.019008845466210178},{"y":0.8735465119835322,"x":0.558762877549504,"height":0.020348836352703126,"text":"威脅，也時常遭受外來人士的剝","width":0.36907217843191964},{"height":0.019028371367306507,"x":0.55876290065766,"y":0.8530646518494516,"text":"削。目前，他們的語言中尚無基","width":0.36907214210146955},{"text":"拉丁美洲","width":0.11958762577601842,"height":0.02350965575146935,"y":0.847187237930206,"x":0.0618556722460114},{"text":"督教資源，據已知資料顯示，在","height":0.019056440300545097,"y":0.8312342570731897,"x":0.5587628839470177,"width":0.36701031639462434},{"y":0.8110465116578786,"text":"他們當中幾乎沒有跟隨耶穌基督","x":0.5587628807459869,"width":0.36701031639462434,"height":0.01892829962281195},{"x":0.5587628874237627,"width":0.07628865923200323,"height":0.018900229888839104,"text":"的人。","y":0.7892441862309164},{"text":"亞馬遜地區前","y":0.7819767441724178,"width":0.40412372407459074,"height":0.047998066412912155,"x":0.06391751738538506},{"text":"近年約有一半馬蒂斯人遷往城鎮","x":0.55876290065766,"width":0.36907214210146955,"y":0.7455919397392439,"height":0.020570948782535736},{"width":0.36907214210146944,"x":0.5587629010970315,"text":"接受教育或尋找工作，並逐漸適","height":0.019041795674539452,"y":0.725290697846711},{"y":0.7143273370448151,"width":0.3406331743512835,"text":"沿民族群體","height":0.04808951345038559,"x":0.06164217429289561},{"x":0.5587628953852004,"width":0.36907214210146955,"y":0.7034883721320793,"height":0.01901372674130064,"text":"應城市生活。留在雨林中的族人"},{"x":0.5587629010970315,"text":"則主要靠狩獵、採集、捕魚和種","y":0.6816860470126019,"height":0.020348836352703015,"width":0.36907214210146944},{"y":0.6757051850429088,"x":0.06178684479279471,"height":0.02795009468904963,"text":"FPGs","width":0.13415827069963726},{"y":0.6598837214312065,"height":0.020348836352703126,"x":0.5587629010970315,"width":0.36907214210146944,"text":"植木薯維生。由於醫療資源有限"},{"text":"in the Amazon","x":0.059793815102263385,"y":0.6351744184701991,"width":0.36494845435732887,"height":0.033591324095962216},{"height":0.019051559025454634,"y":0.6393786735057414,"text":"及疾病影響，他們的平均壽命僅","width":0.36907214210146944,"x":0.5587629010970315},{"y":0.6175482784802953,"text":"約45歲。居住在森林中的馬蒂斯","x":0.5587629017121517,"width":0.36907214210146955,"height":0.020570948782535736},{"x":0.5587628807459869,"y":0.5959302329137648,"height":0.020358599703618196,"text":"人大多在族內通婚，並育有較多","width":0.36701031639462434},{"y":0.5755667508951239,"x":0.5587628877647385,"text":"子女。然而，由於醫療條件不","height":0.018909993239754286,"width":0.34226804460798},{"height":0.018938062172992987,"text":"足，不少兒童無法活過十歲。與","width":0.36701031639462434,"x":0.5587628850787474,"y":0.5537363563926022},{"height":0.018966131106231687,"width":0.36701031639462434,"y":0.5319059617417037,"x":0.5587628807459869,"text":"此同時，越來越多年輕人離開雨"},{"text":"林，漸漸遠離祖輩所傳承的傳統","height":0.020570948782535736,"width":0.36907217843191964,"y":0.5100755668791693,"x":0.558762882162906},{"text":"生活方式。","height":0.018990539083152513,"width":0.12989690871465776,"y":0.48982558157975353,"x":0.5587628871478258},{"x":0.5587629017121517,"y":0.4475230896524405,"text":"在信仰方面，馬蒂斯人相信一種","width":0.36907214210146955,"height":0.01904667775036406},{"x":0.5587628850787474,"text":"被稱為 “xo” 的生命力量，並","height":0.0219817237629798,"y":0.42569269495406103,"width":0.36701031639462434},{"x":0.558762880418299,"height":0.01931150293870698,"y":0.40386230047782345,"text":"透過各種儀式和獻祭試圖影響這","width":0.3670103163946242},{"text":"種力量。他們也相信河流、樹","x":0.5587628870516802,"width":0.3422680446079799,"height":0.020348836352703015,"y":0.38226744236143917},{"height":0.018933180897902524,"x":0.5587629010970315,"width":0.36907214210146944,"text":"木、山嶺、動物和天空中居住著","y":0.3618807725393013},{"y":0.34005037800044247,"width":0.36907214210146944,"height":0.018961249831141225,"x":0.5587629010970315,"text":"各種靈體，因此需要設法安撫這"},{"x":0.55876290065766,"y":0.3182199830275986,"text":"些靈體，以避免災禍臨到。雖然","width":0.36907214210146955,"height":0.020570948782535736},{"x":0.25360825299197826,"height":0.011627906716040082,"y":0.3037790699559335,"width":0.19175257001604357,"text":"Photo Source: Wikimedia"},{"width":0.3628865923200335,"text":"他們並不直接崇拜祖先或靈體，","height":0.01899542115897712,"y":0.29796511645136214,"x":0.5587628924310485},{"height":0.01896735222573842,"x":0.5587629017121517,"y":0.2761627908820792,"text":"但許多人長期活在對未知靈界力","width":0.36907214210146955},{"x":0.0639175305858363,"height":0.018939282491765685,"width":0.38762886410667785,"y":0.2543604653006838,"text":"馬蒂斯人，亞馬遜地區前沿民"},{"width":0.18144329616001675,"text":"量的憂懼之中。","x":0.5587628891364864,"y":0.2543604656172531,"height":0.020348836352703015},{"y":0.2303151951374819,"width":0.1570981161934989,"height":0.021927749480048053,"x":0.06371898444410484,"text":"族群體之一"},{"y":0.21200671677289962,"x":0.5587628916750348,"text":"基督徒團隊可以透過醫療服務、","width":0.3628865923200335,"height":0.019097934341751},{"height":0.020570948782535625,"y":0.19605373665213843,"text":"• 口：400","width":0.19175257001604354,"x":0.05360825347135959},{"y":0.19040697692859088,"text":"乾淨飲水設備及其他實際幫助來","width":0.36907214210146955,"x":0.55876290065766,"height":0.019080848277465923},{"width":0.3670103163946242,"height":0.020348836352703015,"y":0.16860465179457873,"x":0.558762881142894,"text":"關懷馬蒂斯人。然而，他們最迫"},{"x":0.09690721285235261,"height":0.02350965575146935,"text":"（截至2025年8月）","width":0.2597938174293155,"y":0.1582703608826439},{"x":0.558762882162906,"y":0.14680232608236943,"height":0.020348836352703126,"width":0.36907217843191964,"text":"切的需要仍是聽見耶穌基督的福"},{"text":"• 宗教：部落宗教","x":0.053608246242454055,"y":0.12342569273427006,"width":0.27010309128534227,"height":0.021923144458223076},{"width":0.3628865923200335,"text":"音。惟有耶穌能夠赦免人的罪，","height":0.020570948782535736,"y":0.12636439929369148,"x":0.5587628908846568},{"height":0.020570948782535625,"text":"釋放他們脫離對邪靈和未知力量","x":0.5587628997740074,"y":0.10453400481297215,"width":0.36907214210146955},{"text":"• 語言：馬蒂斯語","width":0.27010309128534227,"height":0.02194267116005333,"y":0.08720930234239077,"x":0.05360825087279275},{"text":"的懼怕，並賜下真正的平安與自","y":0.08430232575368768,"height":0.018972233500828994,"width":0.36701031639462434,"x":0.5587628860982204},{"width":0.04742268153599327,"x":0.5608247414613848,"text":"由。","height":0.018944164567590294,"y":0.06250000022982627},{"text":"• 基督徒比例：0.01%","width":0.32164949689592637,"height":0.021876769942660856,"x":0.0536082439231708,"y":0.05079764880264226},{"y":0.015952980463223798,"x":0.05360824650019318,"text":"• 聖經翻譯已啟動","width":0.2721649533226377,"height":0.021837717339734275}]