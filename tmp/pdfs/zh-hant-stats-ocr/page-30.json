[{"text":"30 | 阿拉伯世界 - 蘇丹阿阿拉伯人","width":0.3670103163946242,"x":0.02061854943155393,"y":0.9664147778281076,"height":0.016143361627304897},{"text":"蘇丹阿拉伯人的祖先主要是從","y":0.9185558353933538,"x":0.5731958730311432,"width":0.35670104253859747,"height":0.018944164567590294},{"width":0.10735951378231957,"height":0.017884061478647628,"text":"DAY 08","x":0.0700315839845138,"y":0.9038486670105336},{"width":0.35670104253859747,"text":"阿拉伯半島遷入當地的貝都因","x":0.5731958730311432,"y":0.896725441184907,"height":0.020570948782535625},{"height":0.019012506422528164,"y":0.8764534883990365,"text":"遊牧民族，他們與本地非洲族","x":0.57319586751077,"width":0.35670104253859747},{"text":"群通婚，逐漸形成今日的蘇丹","x":0.573195872464951,"height":0.018984437489289352,"width":0.35670104253859747,"y":0.8546511629751025},{"y":0.847168267736421,"height":0.023686720482148038,"text":"阿拉伯世界","x":0.05560183539801767,"width":0.1465282894316174},{"text":"阿拉伯人群體。與當地其他民","y":0.8328488378071756,"x":0.5731958712908387,"width":0.35670104253859747,"height":0.020348836352703015},{"height":0.020348836352703015,"text":"族不同的是，他們以蘇丹阿拉","y":0.811046511886633,"x":0.5731958678544126,"width":0.35670104253859747},{"y":0.7863140212747755,"height":0.0495382031905961,"text":"蘇丹阿拉伯人","width":0.41237113589332214,"x":0.04948453652069286},{"width":0.35670104253859747,"y":0.790512174939292,"height":0.019080848277465923,"text":"伯語為母語，通常不再使用部","x":0.5731958730311432},{"width":0.35670104253859747,"x":0.5731958726654092,"height":0.02035737938484561,"y":0.7688953494350825,"text":"落語言。部分蘇丹阿拉伯人至"},{"y":0.74709302351454,"x":0.5731958701224539,"text":"今仍維持遊牧生活，但許多人","width":0.35670104253859747,"height":0.020348836352703015},{"y":0.7349003423063455,"text":"Sudanese","width":0.2868587130591983,"x":0.04935415084371071,"height":0.03455978156537387},{"text":"已定居鄉村地區，以農業和畜","width":0.35463918050130216,"y":0.7267002515521652,"x":0.5752577313071954,"height":0.01893928329249972},{"y":0.7045517606164013,"x":0.5730874011899548,"width":0.13423757098969957,"height":0.01967554949192718,"text":"牧業維生。"},{"height":0.03505091503024804,"width":0.1546391805013021,"x":0.047422678434915946,"text":"Arab","y":0.6960537366270074},{"height":0.020570948782535625,"y":0.6612090676549123,"text":"自2018年以來，蘇丹長期處於內","x":0.5752577403636072,"width":0.37113400413876485},{"width":0.37319586617606026,"height":0.018961249831141225,"y":0.640988372277428,"x":0.57319588341827,"text":"戰和動盪之中。衝突雙方往往掌"},{"width":0.37319586617606026,"y":0.619186046705117,"text":"控並挪用大量人道援助資源，使","x":0.5731958836774338,"height":0.018933180897902413},{"text":"許多民眾缺乏最基本的水電。持","x":0.5731958836774338,"y":0.5973837214312065,"width":0.37319586617606026,"height":0.020348836352703126},{"width":0.37319586617606026,"y":0.5768261965743852,"text":"續不斷的戰爭與不穩定局勢，也","x":0.5731958836774338,"height":0.01931150293870698},{"height":0.01907474668360276,"y":0.5552325583239397,"text":"導致大量人口流離失所。蘇丹境","width":0.37319586617606026,"x":0.57319588341827},{"text":"外最大的蘇丹阿拉伯人社群位於","x":0.5731958836774338,"height":0.01904667775036406,"width":0.37319586617606026,"y":0.5334302327516286},{"x":0.5731958769554454,"text":"埃及，約有四百萬人。","width":0.2597938174293154,"y":0.5116279074777181,"height":0.020348836352703126},{"text":"蘇丹約有一半人口年齡低於十八","y":0.46935348482245987,"width":0.37319586617606026,"height":0.019018608016391214,"x":0.5731958792716492},{"text":"歲。然而，由於長期戰亂，許多","y":0.44752308966152476,"x":0.5731958836774338,"width":0.37319586617606026,"height":0.01904667775036406},{"height":0.01309237892541637,"y":0.4302325580952462,"text":"Photo Source: David Haberlah - Wikimedia，","x":0.13402061689327766,"width":0.32783504667736235},{"height":0.020570948782535736,"y":0.4256926954543757,"text":"年輕人幾乎沒有機會接受正規的","x":0.5731958836774338,"width":0.37319586617606026},{"y":0.4185558353974407,"height":0.011754827875734675,"width":0.23298968360537572,"text":"Licensed under CC BY-SA 3.0","x":0.23092784093958016},{"width":0.37319586617606026,"height":0.018909993239754286,"text":"教育，整整一代人的成長因此受","x":0.5731958790124854,"y":0.405523255843925},{"text":"到嚴重影響。","width":0.15488455636160714,"x":0.573073186842209,"y":0.38320842695302326,"height":0.019920356327700617},{"y":0.34592779181022326,"text":"• 人口：15,087, 000","x":0.05154638960726205,"height":0.02183039462636438,"width":0.2989690689813523},{"width":0.3938144138881139,"text":"蘇丹阿拉伯人大多信奉伊斯蘭教，","y":0.34005037764951407,"x":0.5731958826951183,"height":0.020570948782535625},{"height":0.020570948782535625,"y":0.3182199830460558,"text":"但巫術和民間信仰仍舊存在。近","x":0.57319588341827,"width":0.37319586617606026},{"height":0.021867006591745675,"width":0.23298968360537575,"y":0.31104651173192555,"text":"（截至2025年8月）","x":0.1216494904241162},{"y":0.2979651163181257,"text":"年來，透過個人關係和一對一門","x":0.5731958792716492,"width":0.37319586617606026,"height":0.01899542115897712},{"y":0.27455919432528186,"text":"• 宗教：伊斯蘭教","height":0.021952433710234476,"width":0.2680412292480469,"x":0.053608253269938254},{"y":0.27616279129554755,"x":0.5731958841112825,"width":0.37319586617606026,"text":"徒栽培，已有少數人開始跟隨基","height":0.020348836352703126},{"text":"督。雖然蘇丹擁有一定規模的基","height":0.01904179567453934,"y":0.2556675066119861,"x":0.57319588341827,"width":0.37319586617606026},{"width":0.32989690871465777,"height":0.021913381107307894,"text":"• 語言：蘇丹阿拉伯語","x":0.05360824873545465,"y":0.23837209304914941},{"text":"督徒群體，但當地教會在穆斯林","width":0.37525772821335557,"height":0.019069865408512188,"y":0.23383711129661788,"x":0.5731958819139407},{"y":0.21200671722936704,"height":0.020570948782535736,"text":"事工上往往十分謹慎，因為擔心","width":0.37319586617606026,"x":0.5731958814892895},{"y":0.20193115009992846,"width":0.38144327799479166,"x":0.05360825552580006,"height":0.021906059194672145,"text":"• 基督徒比例：少於0.05%"},{"y":0.19185558321274676,"width":0.3752577282133557,"height":0.01890023068957325,"x":0.5731958812885112,"text":"遭受政府打壓和社會反彈。2005"},{"text":"• 新約聖經：已有","x":0.055670102604107916,"width":0.26597938537597654,"height":0.021867006591745564,"y":0.16708648190888697},{"y":0.17002518871022498,"height":0.01892829962281195,"width":0.37319586617606026,"text":"年蘇丹南北分治後，約有六成基","x":0.57319588341827},{"y":0.14819479418650683,"width":0.2577319553920201,"x":0.5731958795849177,"text":"督徒領袖遷往南蘇丹。","height":0.01895636855605065},{"text":"• 全本聖經：無","width":0.23711338951474142,"height":0.02350965575146935,"y":0.12930310695917502,"x":0.053608255861185936}]