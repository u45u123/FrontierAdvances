[{"x":0.022680415733662057,"width":0.31752577282133565,"height":0.014693534844668288,"text":"82 | 亞洲其他地區- 錫爾赫特人","y":0.966414777398893},{"height":0.020570948782535625,"x":0.5567010367880803,"y":0.9592779174016137,"width":0.383505140032087,"text":"錫爾赫特人主要居住在孟加拉東北部"},{"height":0.020570948782535625,"text":"的錫爾赫特專區以及印度阿薩姆邦的","y":0.9374475233146518,"x":0.5587628969407485,"width":0.3814432779947917},{"height":0.01903691439944888,"y":0.9171511628297536,"width":0.38350514003208713,"x":0.5567010343963276,"text":"卡里姆甘傑地區。居住在阿薩姆邦巴"},{"y":0.9038518986325277,"text":"DAY 31","x":0.06590752018595498,"height":0.01787759795297006,"width":0.10529836018880208},{"text":"拉克河谷 （Barak Valley）的錫爾赫","height":0.019008845466210178,"x":0.556701038903453,"width":0.38556700206938244,"y":0.8953488373937071},{"height":0.019000302434067584,"text":"特人，由於地理位置相對偏遠，經濟","x":0.5567010382608414,"y":0.8748950463519733,"width":0.38556700206938244},{"text":"亞洲其他地區","x":0.0515463969034531,"y":0.8501259445720236,"width":0.18556700206938248,"height":0.02350965575146935},{"text":"比較落後。相比之下，孟加拉東北部","x":0.5587628949659491,"y":0.8530646517041028,"width":0.3814432779947916,"height":0.019028371367306396},{"height":0.020570948782535736,"y":0.8312342569475519,"width":0.3814432779947916,"text":"的錫爾赫特地區擁有茶園、森林和稻","x":0.5587628991641163},{"y":0.8110465118123118,"text":"作農業，整體經濟條件較佳。","width":0.3072164989653088,"height":0.01892829962281195,"x":0.5587628867323677},{"width":0.33839056832449776,"text":"錫兩赫特人","x":0.04317585106636956,"y":0.7917160183573749,"height":0.04883540527446251},{"text":"錫爾赫特市是一座持續發展的都會","width":0.4020618620372953,"height":0.018914875315578894,"x":0.5587628867648575,"y":0.7674223339840279},{"height":0.020570948782535736,"width":0.4020618620372953,"text":"城市，經濟相當活躍。許多旅居英","x":0.5587628874349605,"y":0.7455919397641608},{"text":"Sylheti","y":0.7356265845284018,"x":0.05514050077504715,"width":0.20930662609281994,"height":0.04618869240197887},{"height":0.020570948782535625,"x":0.5587628936873863,"y":0.7237615450896431,"text":"國、美國和中東地區的錫爾赫特僑","width":0.3938144138881138},{"text":"民長期投資家鄉，支持當地發展。","height":0.01901372674130075,"x":0.5587628811032711,"y":0.7034883721199668,"width":0.38969072614397327},{"y":0.6816860466960326,"text":"自古代婆羅門王國時期以來，錫爾","height":0.01898565780806205,"width":0.38969072614397315,"x":0.5608247421857453},{"x":0.5567010385132255,"text":"赫特就是重要的商業中心。","y":0.6598837215281058,"width":0.3134020487467448,"height":0.020348836352703015},{"text":"自十四世紀以來，蘇菲派聖人深刻","y":0.617548278978995,"x":0.5608247451251841,"height":0.019079627958693224,"width":0.4},{"y":0.5959302330591136,"width":0.3938144138881139,"height":0.020358599703618196,"text":"影響著錫爾赫特人的宗教生活。這","x":0.5587628986100667},{"x":0.5587628989616868,"height":0.020348836352703015,"text":"些宗教領袖即使去世後，仍被許多","width":0.3938144138881138,"y":0.5741279074881003},{"width":0.39175258818126857,"y":0.5537363556039806,"x":0.5587628844317023,"height":0.018938062973727132,"text":"人尊崇，人們會前往其聖祠朝拜，"},{"width":0.3938144138881139,"y":0.5319059613938033,"x":0.5587628986100667,"text":"並舉行一年一度的紀念慶典。許多","height":0.020570948782535736},{"height":0.020570948782535736,"x":0.5587628989616868,"width":0.3938144138881138,"y":0.5100755668687872,"text":"錫爾赫特人也相信聖祠具有特殊能"},{"x":0.5587628989616868,"y":0.48982558157975353,"width":0.3938144138881138,"text":"力，相信巫術、邪眼等觀念，並習","height":0.018990539083152513},{"y":0.46802325616150375,"height":0.020348836352703015,"text":"慣向宗教治療者尋求幫助，而非優","x":0.5587628939608686,"width":0.3938144138881138},{"text":"先接受現代醫療服務。","height":0.020348836352703015,"x":0.5587628882318251,"width":0.2577319553920201,"y":0.4462209304912842},{"width":0.40206186203729544,"x":0.5587628859272286,"height":0.01931150293870698,"text":"錫爾赫特人的婚姻習俗通常融合伊","y":0.4038623006504253},{"y":0.3822674424583383,"x":0.5587628982277644,"text":"斯蘭和印度教文化傳統，大多數婚","width":0.3938144138881139,"height":0.020348836352703126},{"text":"Photo Source: Adam Jones - Flickr","x":0.18144329843439597,"width":0.26804122924804685,"height":0.010275711040352742,"y":0.35600335844026487},{"height":0.020348836352703015,"text":"姻安排都發生在錫爾赫特語群體內","y":0.3604651167945787,"x":0.5587628874349605,"width":0.4020618620372953},{"x":0.24536082599230513,"y":0.3386627908290155,"text":"Licensed under CC BY 2.0","width":0.2061855679466611,"height":0.013142414797663649},{"text":"部。家庭關係、社區參與以及文化","y":0.33866279117442366,"width":0.4020618620372953,"height":0.020348836352703015,"x":0.5587628867648575},{"height":0.020570948782535736,"x":0.5587628997327705,"y":0.31821998316879474,"width":0.36907214210146955,"text":"傳承在他們的社會中佔有重要地"},{"x":0.5587628862995864,"y":0.2979651161549801,"height":0.017441860874794157,"text":"位。","width":0.04742268153599327},{"width":0.29896906898135234,"height":0.02184259861482485,"y":0.27034883708076274,"x":0.0536082468789851,"text":"•口：13, 406,000"},{"y":0.25436046532144796,"width":0.4020618620372953,"text":"在傳統社會結構下，女性常面臨較","height":0.018939282491765685,"x":0.5587628862862124},{"x":0.12164948347158261,"y":0.23546511616264265,"text":"（截至2025年8月）","width":0.22886597769601003,"height":0.02188165121775132},{"x":0.5587628867862608,"text":"大的壓力。婚後入住夫家的習俗，","y":0.2325581397283728,"width":0.38969072614397315,"height":0.018911213558526874},{"height":0.01909793434175089,"y":0.2120067167819839,"text":"以及以男性為主導的社會文化，都","x":0.5587628983365844,"width":0.3938144138881139},{"y":0.19899244345710154,"text":"• 宗教：伊斯蘭教","x":0.053608246242454055,"width":0.27010309128534227,"height":0.02193778908422872},{"text":"使許多錫爾赫特婦女面對較多挑","width":0.36907214210146944,"height":0.019080848277465923,"y":0.19040697691647845,"x":0.5587629010970315},{"y":0.1686046513593078,"text":"戰。女性的社會地位也常因家庭和","width":0.3938144138881138,"height":0.019052779344227222,"x":0.5587628994305135},{"y":0.1627906974005301,"width":0.3010309128534226,"text":"• 語言：錫爾赫特語","x":0.05360825705782473,"height":0.021928026534047684},{"text":"經濟階層而有所不同，因此婚姻對","height":0.020348836352703015,"width":0.3938144138881139,"y":0.1468023260904443,"x":0.5587628983365844},{"text":"• 基督徒比例：少於0.1%","width":0.3670103163946243,"height":0.02350965575146935,"y":0.12636439952469825,"x":0.05360824539031673},{"height":0.018984437489289352,"text":"不少女性而言是一項重大的人生轉","width":0.3958762759254093,"y":0.12636439953560819,"x":0.5567010333362645},{"y":0.10453400517843547,"height":0.019012506422528053,"text":"變。","width":0.049484534490676135,"x":0.5587628878062082},{"text":"• 全本聖經：已有","height":0.02200613093916659,"x":0.05360824967233459,"width":0.27010309128534227,"y":0.09302325583076276},{"x":0.05360825521945571,"text":"• 錫爾赫特語耶穌傳已有","width":0.3608247302827381,"y":0.05667506286601687,"height":0.02183039462636438}]