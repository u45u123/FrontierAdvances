[{"x":0.0082474193686682,"text":"14 | 非洲- 富拉尼人","y":0.965116279548948,"width":0.21855670383998324,"height":0.015992032490689367},{"text":"富拉尼人是世界上最大的遊牧民族。","y":0.9491279070158001,"width":0.4164948236374628,"x":0.534020626443419,"height":0.018966131906965833},{"height":0.020570948782535736,"y":0.9256926954543757,"x":0.5340206282228623,"width":0.3958762759254093,"text":"過去一千多年來，他們對西非的政"},{"y":0.9035037291713959,"width":0.10346636999221073,"height":0.018573937147830843,"text":"DAY 01","x":0.07816372279162725},{"y":0.9038623008047749,"height":0.020570948782535625,"x":0.5237113438698627,"text":"治、貿易和宗教發展都產生了深遠影","width":0.4309278215680803},{"text":"響。作為西非最早接受伊斯蘭教的民","width":0.4268041338239398,"height":0.020348836352703015,"x":0.534020616167927,"y":0.8822674423614392},{"text":"族之一，他們透過數次聖戰推動伊斯","width":0.4268040974934896,"y":0.8604651169108578,"height":0.020348836352703015,"x":0.5340206354388221},{"height":0.02199880902653073,"y":0.8471872374610204,"x":0.07216494892712942,"text":"非洲","width":0.05979381288800921},{"y":0.8386627911986485,"text":"蘭教的傳播，並於十九世紀建立了強","width":0.4268041338239398,"height":0.020348836352703015,"x":0.534020616167927},{"x":0.5340206257229367,"width":0.2082474118187314,"y":0.8182199835100332,"text":"盛的富拉尼帝國。","height":0.018989318764379925},{"y":0.7877906977797943,"width":0.2639175233386812,"x":0.06391752781519548,"text":"富拉尼人","height":0.0480615277934936},{"y":0.7732558141669629,"width":0.4268040974934896,"height":0.01893562153544781,"text":"富拉尼人在各地有不同名稱。豪薩語","x":0.5340206359336676},{"width":0.42061854771205354,"y":0.7514534885474136,"text":"稱他們為Fulani或Fula；法語地區多","height":0.018907552602209,"x":0.5340206256800557},{"height":0.03064651553316544,"text":"Fdlanui\/Fulbe","x":0.059793818584274405,"width":0.2927835010346912,"y":0.7426532321081678},{"width":0.3814432779947917,"y":0.7296389589866421,"height":0.018907552602209,"text":"稱為Peul或Peulh；英語文獻常見","x":0.5340206311629706},{"x":0.5319587617145983,"text":"Fulbe；而在查德和蘇丹，則常被稱","width":0.4103092738560268,"height":0.0189356215354477,"y":0.7078085643387716},{"text":"為Fallata或Fellata。","height":0.017632241813602012,"x":0.5340206234637837,"y":0.6859781696408046,"width":0.2577319553920201},{"width":0.4329896836053757,"height":0.01901982913589806,"text":"傳統上，富拉尼人以放牧為生，帶領","y":0.6423173799820228,"x":0.5278350507746318},{"height":0.01904789806913676,"text":"牛群遷徙，尋找青草和水源。憑著豐","y":0.6204869856127376,"width":0.42061854771205354,"x":0.534020626055608},{"height":0.01907596700237535,"text":"富的自然知識，他們發展出獨特的遊","y":0.5986565909527548,"x":0.5340206200467714,"width":0.42061854771205354},{"x":0.5340206253879596,"text":"牧文化。雖然今日仍有許多人維持傳","y":0.5768261965834696,"width":0.42061854771205354,"height":0.01931150293870698},{"x":0.5340206165490021,"width":0.4268041338239398,"y":0.5552325583239397,"text":"統生活方式，但也有不少人已在城鎮","height":0.01907474668360276},{"y":0.5334302325971956,"text":"定居，並在商業貿易領域佔有重要地","height":0.01904667775036406,"x":0.5340206104518004,"width":0.4268041338239398},{"y":0.5116279068445797,"height":0.017441860874794157,"text":"位。","x":0.5340206196618785,"width":0.049484534490676135},{"y":0.4680232558530094,"height":0.018962470149913813,"x":0.5340206104518004,"text":"富拉尼人通常住著簡樸的住所，但穿","width":0.4268041338239398},{"x":0.5340206320214748,"y":0.4462209304078786,"height":0.018934401216675112,"text":"著色彩鮮豔、圖案豐富的傳統服飾。","width":0.4164948236374628},{"height":0.020359820022390784,"text":"他們家庭關係緊密，重視禮貌、勤奮","x":0.5340206256800557,"y":0.4229651167800438,"width":0.42061854771205354},{"width":0.1546391805013021,"y":0.4113372092580456,"text":"Photo Source: Flickr","x":0.2989690710895551,"height":0.00889788746933895},{"text":"和民族文化認同。音樂、口述故事和","y":0.4011627911986486,"x":0.5340206256800557,"height":0.020348836352703015,"width":0.42061854771205354},{"text":"舞蹈在他們的生活中佔有重要地位，","y":0.3793604653006838,"height":0.01904423631208474,"width":0.4164948236374628,"x":0.5340206323933452},{"y":0.35755814016667176,"width":0.4268040974934896,"x":0.5340206286346985,"text":"是傳承歷史、價值觀和身分認同的重","height":0.020348836352703015},{"y":0.3357558139884662,"text":"• 人口：13,877,900","height":0.02192680541454095,"width":0.3113401867094494,"x":0.05154640538238861},{"height":0.020348836352703015,"y":0.3357558143527183,"x":0.5319587629586737,"text":"要媒介。","width":0.10515463692801341},{"text":"（僅統計前沿民族群體，截","width":0.3443299066452753,"height":0.021867006591745564,"y":0.31104651149936735,"x":0.08865978703245976},{"text":"然而，數百年來，遊牧牧民與農民之","y":0.2921511633020538,"x":0.5340206165490021,"height":0.020348836352703015,"width":0.4268041338239398},{"x":0.08659793535577417,"y":0.2863140219998026,"text":"至2025年8月）","height":0.020570948782535736,"width":0.17731959025065105},{"x":0.5340206214360694,"y":0.27034883780717556,"height":0.020348836352703126,"text":"間持續存在張力與衝突。農民認為牧","width":0.42061854771205365},{"x":0.05360824821904985,"text":"• 宗教：伊斯蘭教","height":0.022012233333763787,"y":0.24979009212181058,"width":0.2762886592320033},{"y":0.2485306463729866,"height":0.020570948782535625,"text":"群損毀農作物；牧民則面臨牲畜被","x":0.5340206214138438,"width":0.4},{"height":0.01893928329249972,"y":0.22670025155216533,"x":0.5340206302953474,"text":"盜、水源不足及遷徒路線受限等問","width":0.3938144138881139},{"y":0.21494542419421392,"text":"• 語言：富拉語","height":0.021973180730837316,"width":0.24536081949869792,"x":0.05360824874549641},{"y":0.20486985704964356,"x":0.5340206170571024,"text":"題。這些處境需要透過和平、理解和","height":0.01896735222573842,"width":0.42680413382393967},{"text":"• 基督徒比例：少於 0.1%","y":0.17877906963890233,"height":0.02189263488743909,"x":0.05360825096218491,"width":0.39587627592540925},{"y":0.18303946252289727,"text":"彼此支援來化解。","height":0.01899542115897712,"x":0.5340206195612792,"width":0.20618556794666099},{"text":"• 聖經選段：已有","width":0.27628865923200335,"height":0.021926806215275096,"y":0.1423173799597761,"x":0.05567010490862602},{"text":"富拉尼人普遍以穆斯林身分為榮，但","y":0.13937867351439315,"width":0.4268041338239398,"height":0.019051559025454634,"x":0.5340206165490021},{"width":0.42061854771205365,"text":"因各地生活環境和教育背景不同，他","height":0.020348836352703015,"y":0.11627907012306704,"x":0.5340206195460351},{"x":0.05360825128301472,"y":0.10610465102213884,"height":0.02193900940300142,"text":"• 新約聖經：已有","width":0.27835050310407367},{"y":0.09593023274254442,"width":0.3134020487467448,"x":0.5340206273497498,"height":0.019099154660523587,"text":"們的身份認同也不盡相同。"}]