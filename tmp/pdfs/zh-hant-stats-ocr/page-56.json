[{"x":0.02061855309885288,"width":0.1896907261439732,"text":"56| 印度- 謝赫人","y":0.9664147772493913,"height":0.014693534844668399},{"width":0.36701031639462434,"height":0.01904301599331204,"x":0.5587628850787474,"text":"謝赫人是分佈於印度和巴基斯坦","y":0.9286314025722832},{"x":0.07625252633568497,"text":"DAY 20","y":0.9025052385800513,"height":0.017663941275262718,"width":0.10728876023065476},{"width":0.36907217843191964,"height":0.019071085727284887,"x":0.558762882162906,"text":"的大型穆斯林群體。其中，印度","y":0.9068010072659993},{"x":0.5587629017121517,"height":0.020570948782535736,"y":0.8849706130443153,"text":"的謝赫人及其他穆斯林群體長期","width":0.36907214210146955},{"text":"處於相對邊緣化的社會處境。雖","x":0.5587628807459869,"width":0.36701031639462434,"y":0.8633720933788811,"height":0.020348836352703015},{"width":0.059793812888009196,"height":0.02185968387837578,"y":0.8488372094281464,"x":0.0639175267003253,"text":"印度"},{"x":0.55876290065766,"text":"然他們人口眾多，但在政治和公","width":0.36907214210146955,"height":0.01892951994158465,"y":0.8429890846705222},{"height":0.020570948782535625,"x":0.5587629010970315,"text":"共事務上的影響力相對有限，其","y":0.8211586904724575,"width":0.36907214210146944},{"height":0.019027151048533808,"y":0.8008720931985762,"width":0.3463917323521206,"x":0.558762898875486,"text":"聲音常常難以被聽見或受到重"},{"x":0.06185566706381314,"text":"謝赫人","y":0.7892441861564296,"height":0.04796511620458277,"width":0.2082474299839565},{"x":0.5587628869963581,"text":"視。","height":0.018999082115294996,"y":0.7790697676262652,"width":0.05154639198666511},{"y":0.7354651165752049,"x":0.061855675117415215,"height":0.03783463190624836,"width":0.23298968360537572,"text":"Shaikh"},{"text":"印度與巴基斯坦之間長期緊張的關","width":0.3587628682454427,"y":0.7354651169108578,"x":0.5587628942484127,"height":0.020348836352703015},{"height":0.01906620365146028,"text":"係，也深刻影響著印度穆斯林的處","y":0.7149454242073763,"x":0.5587628980164538,"width":0.3587628682454427},{"text":"境。在某些民族主義思潮影響下，","x":0.5587628865092901,"y":0.6931150297018265,"width":0.35463918050130205,"height":0.01909427258469898},{"x":0.5587628935319179,"height":0.019084510034517943,"text":"部分人對穆斯林群體抱持懷疑和戒","y":0.671511627955117,"width":0.3587628682454428},{"y":0.6497093028410903,"text":"備態度。一些穆斯林聚居區甚至被","width":0.3608247302827381,"height":0.020348836352703126,"x":0.5587628961988371},{"y":0.6293031067934051,"x":0.5587628935319179,"width":0.3587628682454428,"text":"貼上“小巴基斯坦”的標籤，被視","height":0.02185968387837578},{"width":0.3587628682454428,"x":0.5587628935319179,"text":"為與主流社會格格不入。這些觀念","y":0.6090116279369484,"height":0.019032033124358305},{"y":0.5856423174566521,"x":0.5587628935319179,"text":"透過教育、媒體和社會環境不斷被","width":0.3587628682454428,"height":0.020570948782535625},{"x":0.5587628931582768,"height":0.01897589445714698,"y":0.5654069769285908,"text":"強化，加深了不同群體之間的隔","width":0.33814432053338916},{"width":0.3608247302827381,"x":0.5587628961988371,"y":0.5436046513471955,"height":0.018947825523908057,"text":"閡，使鄰里、學校和日常人際關係"},{"width":0.1405379885718936,"text":"都受到影響。","height":0.02151715865563575,"y":0.5212181649235872,"x":0.5585969859729439},{"text":"據估計，約九成印度穆斯林從事","height":0.019089391309608406,"y":0.47965116297510246,"x":0.55876290065766,"width":0.36907214210146955},{"x":0.5587628810008552,"y":0.45784883757300243,"height":0.020348836352703126,"width":0.3670103163946242,"text":"低薪、低技術門檻的工作。由於"},{"x":0.5587628916750348,"y":0.4374475232651609,"text":"缺乏優質教育資源和發展機會，","height":0.018947825523908057,"width":0.3628865923200335},{"x":0.5587628888301722,"y":0.4156171287596111,"height":0.01897589445714687,"text":"許多人長期處於經濟弱勢地位。","width":0.3649484543573288},{"y":0.39378673375310047,"text":"因此，他們常被貼上“貧窮”或","height":0.02350965575146935,"x":0.5587628993616363,"width":0.36907214210146955},{"text":"“教育程度偏低”的標籤，也因","width":0.35670104253859747,"height":0.02350965575146935,"x":0.5690721567547563,"y":0.3719563388121099},{"height":0.007273543891938683,"text":"m2","x":0.12989690776613114,"width":0.022632854325430718,"y":0.3648194793582721},{"y":0.3517441862309164,"x":0.558762886813994,"height":0.01895270679899863,"text":"此更容易被排除在社會資源之","width":0.34226804460798},{"x":0.5587628877031156,"height":0.01892463786576004,"width":0.049484534490676135,"text":"外。","y":0.3299418606586053},{"text":"Photo Source: Mikhail Nilov - Pexels","y":0.3211586901815553,"x":0.1711340245212027,"width":0.274226797194708,"height":0.013143635516803198},{"y":0.2863140217699982,"width":0.29896906898135234,"height":0.02183039462636438,"x":0.05360824745090464,"text":"•口：82,690,000"},{"x":0.5587628832630203,"y":0.28631402190290334,"text":"印度最低種姓群體同樣面臨貧","width":0.34226804460798,"height":0.020570948782535736},{"text":"窮、排斥和制度性歧視的問題，","width":0.3628865923200335,"height":0.019066203651460167,"y":0.265988372277428,"x":0.5587628919990406},{"y":0.2514534884979138,"text":"（截至2025年8月）","height":0.021846259571142723,"x":0.12164948384958953,"width":0.22886597769601003},{"height":0.020348836352703015,"x":0.5587629010970315,"text":"但他們至少享有某些政府提供的","width":0.36907214210146944,"y":0.24418604701260194},{"text":"保障措施和社會福利。相較之","width":0.3422680446079799,"x":0.5587628873572766,"y":0.22238372142082452,"height":0.020348836352703126},{"x":0.053608246242454055,"y":0.21494542390351623,"width":0.27010309128534227,"text":"• 宗教：伊斯蘭教","height":0.021973180730837316},{"y":0.2005813955736485,"width":0.36907214210146944,"height":0.020348836352703126,"text":"下，許多印度穆斯林在日常生活","x":0.5587628973410179},{"y":0.17877906965101475,"text":"• 語言：烏爾都語","x":0.05360824592090274,"width":0.27010309128534227,"height":0.02189263488743909},{"width":0.3649484543573288,"y":0.18010075588915442,"height":0.019027151048533697,"text":"中面對類似的挑戰，卻往往缺乏","x":0.5608247439209919},{"text":"相應的制度支持和保障。","x":0.5587628940880347,"width":0.28453607105073475,"height":0.020570948782535736,"y":0.15827036089035573},{"y":0.14389534933818326,"x":0.055670102759687944,"text":"• 基督徒比例：0.00%","height":0.020348836352703126,"width":0.31958763485863095},{"text":"• 新約聖經：已有","height":0.021887753612348626,"width":0.26804122924804685,"x":0.05567010851457908,"y":0.10747271163247007},{"y":0.07262804387749278,"x":0.05567010882222101,"height":0.02184870020868801,"text":"•全本聖經：已有","width":0.26804122924804685}]