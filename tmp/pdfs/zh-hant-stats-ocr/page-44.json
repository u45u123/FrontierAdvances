[{"x":0.028865978251681093,"y":0.9651162798836859,"width":0.19381443205333893,"text":"44| 印度-卡普人","height":0.017441859273325977},{"height":0.02190849983221732,"x":0.5587628870516802,"width":0.3422680446079799,"y":0.9302325581290912,"text":"在泰盧固語中，“卡普”意為"},{"text":"“農夫”或“保護者”。卡普人","y":0.9084302324918923,"x":0.5690721715621093,"width":0.3587628682454427,"height":0.02188043089897873},{"text":"DAY 14","x":0.06595300258282734,"height":0.017603733277340883,"width":0.10726925077892487,"y":0.9025353429926972},{"width":0.3422680446079799,"x":0.5587628820602712,"height":0.020348836352703015,"y":0.8866279073323694,"text":"內部包含多個支系，例如巴厘"},{"width":0.3670103163946242,"text":"賈、穆努魯卡普人、特拉加人和","x":0.5587628818439251,"height":0.020354938747300322,"y":0.8648194792255628},{"y":0.847187237930206,"width":0.061855670383998335,"height":0.02350965575146935,"text":"印度","x":0.06597938168944412},{"text":"東卡普人。他們也常被稱為“奈","x":0.5587629004441104,"width":0.36907214210146955,"height":0.02180232569312568,"y":0.8444767443118674},{"height":0.021993926950706122,"x":0.5587628914230302,"y":0.8226744186053105,"width":0.3628865923200335,"text":"杜”，意為“領袖”。歷史上，"},{"text":"卡普人主要從事農業和軍事，在","x":0.5587628810008552,"width":0.3670103163946242,"height":0.020348836352703015,"y":0.800872093386956},{"x":0.06185566927752859,"text":"卡普人","width":0.20618556794666107,"height":0.049418605545005434,"y":0.7877906970627686},{"x":0.5587628824677332,"text":"戰爭時期出征，在和平時期務","width":0.34226804460798,"height":0.018981996851744176,"y":0.7804366076150139},{"height":0.019010065784982766,"y":0.7586062130155931,"width":0.049484534490676135,"text":"農。","x":0.5587628873251087},{"text":"Kapu","x":0.06597938402977892,"height":0.04800905088333396,"y":0.7252906977035871,"width":0.1917525700160435},{"text":"如今，大多數卡普人居住在印度","y":0.7149454237322957,"width":0.36907217843191964,"x":0.558762882162906,"height":0.020570948782535736},{"width":0.3670103163946242,"height":0.01891853627189677,"text":"南部的安德拉邦、特倫甘納邦和","y":0.6947674420357856,"x":0.558762885