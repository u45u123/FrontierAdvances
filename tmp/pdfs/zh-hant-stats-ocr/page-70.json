[{"height":0.014721603777906989,"y":0.9634760707402334,"width":0.4185566856747582,"text":"70| 亞洲其他地區 - 圖康貝西前沿民族群體","x":0.02061856736880641},{"height":0.01894782552390817,"text":"印尼蘇拉威西圖康貝西地區共有","width":0.3979381379627046,"x":0.5628865982793252,"y":0.9374475231288963},{"text":"六個前沿民族群體，沃利奧人是","height":0.01897589445714687,"y":0.9156171286142624,"x":0.5628865982793252,"width":0.3979381379627046},{"x":0.06582713142192523,"y":0.8977783135039632,"text":"DAY 25","width":0.10752099355061848,"height":0.01839686120687456},{"height":0.019008845466210178,"text":"其中之一。","y":0.8953488373846228,"x":0.5628865993715153,"width":0.13195876166934062},{"text":"沃利奧人（又稱 Baubau、Buton","y":0.8517441858961785,"x":0.5628866067795634,"width":0.3958762759254093,"height":0.017441860874794157},{"text":"亞洲其他地區","height":0.021836497020961687,"x":0.05360825270242217,"y":0.842989084512011,"width":0.18556700206938243},{"width":0.3979381379627046,"x":0.5628865998330806,"text":"或 Butung）主要居住在東南蘇拉","height":0.020348836352703126,"y":0.8299418607238422},{"text":"威西的布頓島（Buton）、穆納","x":0.5628865986346272,"width":0.3979381379627046,"y":0.8094038626657504,"height":0.019084509233783797},{"text":"蘇拉威西圖康貝","width":0.41649485996791297,"height":0.04360465138625136,"x":0.05154638314748681,"y":0.7877906974809296},{"y":0.7877906974114401,"x":0.5628866003465738,"width":0.3958762759254092,"text":"島（Muna）和卡巴埃納島","height":0.017441860874794157},{"x":0.5711340144744051,"y":0.7659883724631834,"height":0.020348836352703015,"text":"（Kabaena）。他們的祖先據說","width":0.38969072614397327},{"y":0.7412790698010603,"x":0.05567011251485459,"text":"西前沿民族群體","width":0.4185566856747581,"height":0.04377550562322896},{"height":0.018942944248817595,"y":0.7455919392877078,"text":"于十五世紀從馬來西亞柔佛","x":0.5628865982793252,"width":0.3979381379627046},{"width":0.38969072614397327,"text":"（Johor）遷來，並建立了布頓","height":0.018971013182056295,"x":0.5711340144744051,"y":0.7237615447730739},{"y":0.7078085648062091,"text":"FPGs in Tukangbesi","width":0.39999999999999997,"x":0.0494845376730486,"height":0.029110039711799374},{"x":0.5628865982793252,"height":0.018999082115294996,"y":0.7019311502584398,"width":0.3979381379627046,"text":"王朝。1540年，布頓王朝的第六"},{"text":"ofSulavesi","height":0.02733311625111523,"x":0.049115403748024956,"width":0.235795647757394,"y":0.6795609277228274},{"width":0.3979381379627046,"height":0.019027151048533808,"text":"任國王歸信伊斯蘭教，使王國轉","y":0.6801007558982388,"x":0.5628866036088539},{"text":"變為蘇丹國，並持續存在至1960","width":0.3979381379627046,"height":0.01895758887482335,"x":0.5628865991320499,"y":0.6598837209765559},{"text":"年。今日的布頓地區以天然瀝青","y":0.6380813956899276,"width":0.4,"height":0.020348836352703015,"x":0.5608247382680414},{"y":0.616279070268416,"text":"資源聞名，同時也正在開發石油","height":0.020348836352703015,"width":0.3979381379627046,"x":0.5628866036088539},{"y":0.5959302327304319,"x":0.5628866091042015,"width":0.41855668567475823,"text":"和礦產資源。為了尋找工作機會，","height":0.0190991546605237},{"text":"許多沃利奧人遷往馬魯古群島","x":0.5628866039641558,"y":0.5741279071611489,"width":0.3979381379627046,"height":0.01907108492655074},{"y":0.5523255821002556,"text":"（Maluku）、巴布亞（Papua）","x":0.5731958852281953,"width":0.38556700206938244,"height":0.017441859273325977},{"x":0.5628865986346272,"width":0.3979381379627046,"height":0.020348836352703126,"y":0.5305232561695787,"text":"及印尼其他地區。他們使用沃利"},{"text":"奧語，部分人也懂得阿拉伯語，","width":0.3979381379627046,"x":0.5628866039641558,"y":0.5100755665625999,"height":0.018994200840204534},{"x":0.5628866036676864,"y":0.48824517249534927,"text":"主要用於宗教和歷史文獻。","width":0.3237113226027716,"height":0.020570948782535736},{"y":0.44622093042604727,"text":"在沃利奧人的村莊裡，市場上常","x":0.5628866036088539,"height":0.018934401216675112,"width":0.3979381379627046},{"y":0.4244186048355676,"text":"見絲綢和棉布等紡織品交易，小","x":0.562886603332508,"height":0.01890633228343641,"width":0.3979381379627046},{"width":0.3979381379627046,"text":"商店和流動攤販也十分普遍。沃","y":0.4026028551181595,"x":0.5628865986346272,"height":0.020570948782535736},{"y":0.3866279072344987,"text":"Source: Wikimedia","width":0.14226803552536738,"x":0.3051546434538111,"height":0.010174418176351563},{"width":0.3979381379627046,"height":0.01907596700237546,"x":0.5628866036088539,"y":0.38226744203578555,"text":"利奧人的生計與土地和海洋都密"},{"width":0.3979381379627046,"text":"切相關。他們種植稻米、玉米和","y":0.3604651163181257,"height":0.01904789806913676,"x":0.5628865982793252},{"width":0.3979381379627046,"x":0.562886603332508,"text":"木薯，也在每年六月至九月種植","y":0.3386627908820792,"height":0.019019829135897948},{"x":0.05567009957911213,"height":0.020570948782535736,"width":0.41237113589332214,"y":0.3312342567053038,"text":"沃利奧人，蘇拉威西圖康貝西（瓦卡"},{"text":"海藻。許多人從事航海和造船工","x":0.562886603332508,"y":0.3182199835059957,"width":0.3979381379627046,"height":0.018989318764379925},{"text":"托比）前沿民族群體之一","width":0.2886597951253255,"height":0.020570948782535736,"x":0.05567010484283548,"y":0.3094038623602434},{"x":0.5628866036088539,"height":0.01901738849835266,"text":"作，充分利用布頓島和穆納島周","y":0.2963895882158617,"width":0.3979381379627046},{"y":0.27325581374189234,"x":0.053608250607217384,"text":"• 人口：252,000","height":0.02187432930511546,"width":0.25154638744535895},{"y":0.27455919413952656,"text":"邊豐富的海洋資源。傳統的沃利","x":0.5628866006887507,"width":0.3979381379627046,"height":0.020570948782535736},{"height":0.020570948782535736,"width":0.3979381379627046,"y":0.2527287992179158,"x":0.5628866037815342,"text":"奧房屋通常架高建造，以木板為"},{"y":0.23677581827280147,"width":0.22886597769601003,"x":0.12164948630663412,"text":"（截至2025年8月）","height":0.021945111797598615},{"text":"牆，屋頂則使用木板或椰葉覆蓋。","y":0.2325581397192884,"width":0.4185566856747581,"height":0.018911213558526874,"x":0.562886607941544},{"width":0.40412368774414054,"text":"一般而言，男性負責戶外工作，","x":0.5567010443066238,"height":0.02035737938484561,"y":0.21074727151921913},{"x":0.05360824379397048,"text":"• 宗教：伊斯蘭教","width":0.26597938537597654,"y":0.20193115008175988,"height":0.021906059194672145},{"width":0.3979381379627046,"y":0.188916876751955,"x":0.5628865982793252,"height":0.020570948782535625,"text":"而女性負責家庭事務並管理家庭"},{"width":0.26597938537597654,"x":0.05360824379397048,"height":0.02195975642360426,"y":0.1656976742991494,"text":"• 語言：沃利奧人"},{"height":0.019052779344227222,"y":0.16860465120184653,"width":0.4144329979306175,"text":"財務。近年來，包包市（Baubau）","x":0.5608247340037635},{"width":0.3979381379627046,"y":0.1468023257748845,"height":0.01902471041098852,"text":"正式升格為城市，為當地帶來更","x":0.5628866036088539},{"width":0.31752577282133554,"y":0.1293031069569226,"x":0.053608249594486845,"text":"• 基督徒比例：0.01%","height":0.02185968387837578},{"x":0.5628866036088539,"y":0.1250000001934891,"height":0.01899664147774971,"width":0.3979381379627046,"text":"多發展的機會。沃利奧人非常重"},{"y":0.10319767491957876,"text":"視教育和語言學習，因此整體社","x":0.5628866036088539,"height":0.020348836352703126,"width":0.3979381379627046},{"y":0.09302325557640223,"x":0.053608255500361204,"width":0.23711338951474148,"height":0.022006131739900625,"text":"• 新約聖經：無"},{"text":"會流動性和發展潛力相對較高。","x":0.5628865961535231,"width":0.3793814522879464,"height":0.019040575355766864,"y":0.08270361065168896},{"x":0.05360824618947179,"width":0.23711340767996653,"height":0.02183039462636438,"text":"• 全本聖經：無","y":0.05667506263034394}]