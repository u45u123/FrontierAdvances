[{"y":0.9664147773843581,"x":0.0288659829646354,"width":0.21649484180268785,"text":"60| 印度- 亞達夫人","height":0.014693534844668399},{"width":0.4020618620372953,"x":0.5587628841188094,"y":0.925692695551275,"height":0.020570948782535625,"text":"亞達夫人傳統上以牧養牲畜和販售"},{"text":"DAY 22","x":0.07624828031004581,"y":0.9024920833298926,"width":0.10729725247337706,"height":0.017690251796411705},{"x":0.5587628874349605,"text":"乳製品為生，其祖先可能源自中亞","y":0.9038623009542766,"width":0.4020618620372953,"height":0.020570948782535625},{"text":"地區。他們與自己的種姓守護神黑","x":0.5587628983365844,"width":0.3938144138881139,"height":0.018905111964663712,"y":0.8837111670660478},{"width":0.3814432779947917,"height":0.018933180897902524,"y":0.8618807725514137,"x":0.5587628998096734,"text":"天（Krishna）有著非常緊密的認"},{"x":0.06804123831299096,"text":"印度","width":0.05979381288800921,"y":0.8488372093191348,"height":0.02185968387837578},{"width":0.3938144138881138,"height":0.019051559025454523,"y":0.8415697674601523,"x":0.5587628933357665,"text":"同關係。如今，大多數亞達夫人已"},{"text":"轉而從事農業生產，從事牧牛工作","width":0.3958762759254093,"y":0.8197674420448698,"height":0.019023490092215933,"x":0.5587628969238932},{"y":0.7979651164998117,"text":"的人已不到三分之一。他們廣泛分","height":0.01899542115897712,"width":0.4020618620372953,"x":0.5587628867648575},{"x":0.06391752424589768,"width":0.2721649533226376,"y":0.7892441861564294,"text":"亞達夫人","height":0.04796511620458288},{"y":0.7761627912131834,"width":0.3958762759254093,"height":0.020348836352703015,"x":0.5587628969238932,"text":"佈於印度各地及尼泊爾南部，其中"},{"height":0.019041795674539452,"x":0.5587628867648575,"text":"人口最集中的地區為印度北部的北","width":0.4020618620372953,"y":0.7556675066240984},{"y":0.7381873496333606,"height":0.03816018637041396,"width":0.20632120768229167,"text":"Yadaw","x":0.06384970538509045},{"width":0.4020618620372953,"text":"方邦和比哈爾邦。亞達夫人普遍維","height":0.019069865408512188,"y":0.7338371113087303,"x":0.5587628867648575},{"x":0.5587628862862124,"y":0.712006716802748,"height":0.019097934341751,"text":"持大家庭同住的傳統。許多人原本","width":0.4020618620372953},{"text":"奉行素食主義，但近年來已有不少","height":0.020348836352703126,"y":0.6904069772555421,"width":0.4020618620372953,"x":0.5587628862862124},{"text":"人開始食用魚、羊肉和雞肉，有時","y":0.6686046514166717,"x":0.5567010333362645,"width":0.3958762759254093,"height":0.020348836352703126},{"height":0.01895636855605065,"text":"也食用豬肉，但通常不食用牛肉。","width":0.38969072614397315,"y":0.6481947940502423,"x":0.5587628815671887},{"text":"在社會和教育層面，亞達夫人被視","y":0.6061046513562798,"x":0.5587628859272286,"height":0.019000302434067695,"width":0.40206186203729544},{"width":0.3938144138881138,"y":0.5843023256204514,"text":"為較弱勢的群體。他們是印度人數","x":0.5587628922105824,"height":0.018972233500828883},{"x":0.558762889872882,"width":0.3649484543573288,"y":0.5624999999877395,"height":0.021882871536523907,"text":"最多的“其他落後階層” 之一。"},{"width":0.36907214210146944,"x":0.5587629010970315,"y":0.5188916875811314,"text":"亞達夫人擁有豐富的口述文化傳","height":0.020352498109754924},{"x":0.5587628862862124,"width":0.4020618620372953,"height":0.01908573035329053,"y":0.4985465118123117,"text":"統，擅長群體歌唱和口傳故事，內"},{"text":"容多與黑天、毗濕奴以及其他神祇","x":0.5587628969238932,"width":0.3958762759254093,"height":0.019057660619317685,"y":0.4767441862309164},{"height":0.020348836352703015,"y":0.45494186096609035,"x":0.558762882162906,"text":"有關。他們相信自己是黑天的後","width":0.36907217843191964},{"text":"裔，因此對黑天懷有特別深厚的敬","y":0.4345088164951537,"width":0.3938144138881138,"height":0.018979555413464744,"x":0.5587628939608686},{"width":0.37113400413876485,"height":0.01900762514743759,"text":"虔和忠誠。為了尋求保護並避免咒","x":0.5587628921868768,"y":0.4126784211797856},{"x":0.2556701091414627,"text":"Photo Source: Wikimedia","y":0.4055232560826092,"width":0.1917525700160435,"height":0.010174418176351452},{"text":"詛，他們往往依靠護身符、占星師以","width":0.38350514003208713,"y":0.39084802679838804,"height":0.01903569408067629,"x":0.5587628970973584},{"x":0.558728191056574,"text":"及傳統醫治者。","y":0.36904534454837423,"height":0.020630242342112082,"width":0.16501784551711307},{"x":0.05360825389484716,"text":"• 人口：57,595,000","width":0.30309277489071806,"height":0.023255813432080163,"y":0.332848837573827},{"x":0.5587628960320663,"y":0.32703488390533497,"text":"近年來，亞達夫人的生活方式和社會","width":0.38350514003208713,"height":0.01889534861374864},{"y":0.3052057092979832,"x":0.5587628977182212,"text":"地位正經歷快速變化。隨著社會發","width":0.3587628682454427,"height":0.020570948782535736},{"x":0.12164948347158261,"width":0.22886597769601003,"height":0.021934128127910846,"text":"（截至2025年8月）","y":0.29796511616264254},{"width":0.383505140032087,"x":0.5587628966408047,"height":0.020570948782535625,"text":"展，年輕一代需要進入更多元的職業","y":0.28337531470029265},{"text":"•宗教：印度教","y":0.2615449205216943,"height":0.021885312174069194,"width":0.2371134076799665,"x":0.05567010176568684},{"x":0.5587628966408047,"y":0.26308139553324195,"text":"領域，但許多地區仍缺乏足夠的教育","width":0.383505140032087,"height":0.019034473761903703},{"x":0.5567010326620815,"y":0.24127906980649771,"height":0.019006404828665002,"text":"資源和培訓機會。","width":0.1917525700160435},{"y":0.22670025186873455,"width":0.23917525155203684,"text":"•語言：印地語","x":0.05360825250576849,"height":0.020570948782535625},{"text":"• 基督徒比例：0-0.1%","x":0.05567011389431217,"y":0.19040697690634423,"height":0.02180232569312568,"width":0.33402059645879834},{"width":0.26804122924804685,"y":0.15406976793512273,"height":0.023255813432080163,"x":0.05567010611824463,"text":"• 新約聖經：已有"},{"x":0.05567010882222101,"text":"•全本聖經：已有","y":0.11918604630003171,"height":0.021871887866836137,"width":0.26804122924804685}]