[{"text":"36| 印度-巴格班人","x":0.02061855744606614,"y":0.9664147772493913,"width":0.2103092738560268,"height":0.014693534844668399},{"height":0.01903691439944888,"y":0.9171511629751025,"width":0.38556700206938244,"text":"巴格班人是一個人口不足一百萬","x":0.5608247485300282},{"y":0.9039946368470725,"text":"DAY 10","x":0.07626368478425272,"width":0.10520459129696799,"height":0.017592121832116447},{"x":0.5587628882215752,"text":"的群體。其中約61.6萬人屬於印","y":0.8937867335185643,"height":0.020570948782535625,"width":0.38762886410667785},{"y":0.8719563390039302,"x":0.5587628845740615,"height":0.020570948782535625,"width":0.38969072614397315,"text":"度教背景，約26.8萬人屬於穆斯"},{"text":"印度","y":0.847187237940588,"height":0.02350965575146935,"width":0.06185567038399833,"x":0.06185567040446622},{"width":0.38762886410667785,"text":"林背景。由於印度人口超過十四","x":0.5587628879122969,"y":0.8517441863052376,"height":0.020348836352703015},{"width":0.38762886410667785,"y":0.8312342565340834,"text":"億，巴格班人在全國範圍內並不","height":0.019056441101279242,"x":0.5587628896877835},{"x":0.5587628929482751,"width":0.4103092738560269,"y":0.8094038620485191,"text":"特別顯眼。他們主要分佈於印度，","height":0.019084510034517943},{"width":0.26597938537597654,"height":0.049418605545005434,"y":0.7877906974745903,"x":0.06597937901304268,"text":"巴格班人"},{"width":0.38969072614397327,"height":0.01909427258469898,"x":0.5587628811032711,"y":0.7877906977255869,"text":"也有少數居住在尼泊爾和巴基斯"},{"x":0.5587628853807963,"y":0.7659883724567234,"width":0.38762886410667785,"text":"坦。在印度境內，他們主要集中","height":0.020348836352703126},{"height":0.018942944248817706,"x":0.558762887134199,"width":0.38969072614397327,"y":0.7455919394330567,"text":"在北方邦、馬哈拉斯特拉邦和卡"},{"text":"Baghban","height":0.041335308481724065,"x":0.05142666788593803,"width":0.21673429579961867,"y":0.7322393233625508},{"y":0.723761544930535,"width":0.38969072614397315,"text":"納塔克邦。巴格班人通常使用烏","x":0.5587628875981164,"height":0.018971013182056407},{"width":0.38969072614397315,"y":0.7019311499196237,"x":0.5587628875981164,"text":"爾都語和印地語，這兩種語言都","height":0.020570948782535736},{"text":"已擁有完整聖經譯本和豐富的基","y":0.6816860465385715,"width":0.38969072614397327,"height":0.01898565780806205,"x":0.5587628811032711},{"width":0.12789263952346075,"text":"督教資源。","y":0.6597864343336528,"height":0.019089922196318554,"x":0.5587340934081203},{"text":"巴格班一詞的意思是”看守花園","y":0.6175482786297134,"x":0.5587628843040494,"width":0.38762886410667785,"height":0.021986605038070373},{"x":0.5587628875981164,"y":0.5959302325386115,"text":"的人”或“園丁”，反映了他們","height":0.02180232569312568,"width":0.38969072614397315},{"width":0.38762886410667785,"y":0.5741279071611489,"text":"傳統的職業背景。今天，許多巴","x":0.5587628896877835,"height":0.01907108492655074},{"text":"格班人仍從事水果和蔬菜買賣，","x":0.5587628885701198,"height":0.020348836352703126,"width":0.38556700206938244,"y":0.552325581993222},{"height":0.020348836352703126,"width":0.38969072614397315,"y":0.5305232563149276,"text":"也有人在政府部門任職。他們十","x":0.5587628867862608},{"x":0.558762887134199,"width":0.38969072614397327,"y":0.5100755665625999,"height":0.018994200840204534,"text":"分重視家庭，並努力為家人提供"},{"x":0.26804123830676785,"width":0.17113402230398994,"height":0.01343408860047246,"y":0.5041981529937469,"text":"Photo Source: Pixabay"},{"width":0.38762886410667785,"text":"更好的生活條件。許多家庭願意","height":0.020570948782535736,"y":0.48824517212228724,"x":0.5587628906614377},{"height":0.018962470149913813,"text":"讓兒子和女兒都接受教育。然而，","y":0.46802325599835815,"x":0.5587628917759629,"width":0.4103092738560268},{"y":0.4462209308062066,"text":"在印度種姓政治和社會結構的影","x":0.5587628852490739,"width":0.38969072614397315,"height":0.020348836352703126},{"y":0.4331395354089198,"x":0.053608254838923466,"width":0.24948452540806365,"height":0.020348836352703015,"text":"• 口：884, 000"},{"text":"響，巴格班人在進入醫學、法","y":0.42441860524903596,"x":0.5587628844709687,"width":0.38969072614397327,"height":0.020348836352703126},{"x":0.12164948354374756,"y":0.3982558141156465,"height":0.021979282324700478,"text":"（截至2025年8月）","width":0.22886597769601008},{"width":0.38969072614397327,"text":"律等專業領域時，仍面臨不少限","y":0.4026028550212605,"height":0.020570948782535625,"x":0.5587628874606594},{"width":0.12806011381603422,"height":0.019667102547876958,"x":0.5586503562610625,"y":0.3818815650917149,"text":"制和挑戰。"},{"text":"• 宗教：印度教\/伊斯蘭教","y":0.3618807720672489,"x":0.0536082516407448,"width":0.3752577282133557,"height":0.020570948782535625},{"text":"自十八世紀以來，宣教士便開始","width":0.38762886410667785,"x":0.5608247459731707,"y":0.3386627908820792,"height":0.019019829135897948},{"height":0.02180232569312568,"y":0.32558139536564645,"text":"• 語言：烏爾都語\/印地語","width":0.37525772821335557,"x":0.053608251975796356},{"x":0.558762887134199,"width":0.38969072614397327,"text":"在印度開展福音工作，最初主要","y":0.31686046562763515,"height":0.020348836352703015},{"x":0.5587628853807963,"width":0.38762886410667785,"height":0.019017387697618626,"y":0.2963895888621626,"text":"集中于南印度，後來逐漸擴展至"},{"width":0.3319587707519531,"text":"• 基督徒比例：0-0.1%","y":0.2892441860724052,"height":0.021838937658506863,"x":0.05360824556474509},{"width":0.38969072614397315,"text":"東部和北部地方。印度本土宣教","x":0.5587628875981164,"y":0.2745591939844879,"height":0.020570948782535625},{"height":0.021980502643473065,"x":0.05360825382958479,"y":0.2527287995199502,"text":"• 新約聖經：已有","width":0.2680412292480469},{"x":0.5587628875981164,"text":"士在福音傳播方面也發揮了重要","height":0.020570948782535625,"y":0.25272879949407856,"width":0.38969072614397315},{"x":0.5587628875981164,"text":"作用。但儘管如此，如今在巴格","height":0.018911213558526874,"width":0.38969072614397315,"y":0.2325581397071761},{"y":0.21788413116677263,"text":"• 全本聖經：已有","x":0.053608253030615685,"width":0.2680412292480469,"height":0.020570948782535625},{"height":0.02035737938484561,"text":"班人中，基督徒比例仍然接近於","x":0.558762888247601,"y":0.21074727140778504,"width":0.38969072614397327},{"text":"零。","height":0.017441860874794157,"y":0.19040697661202166,"width":0.049484534490676135,"x":0.5587628877031156}]