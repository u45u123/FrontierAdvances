[{"y":0.9664147773843581,"x":0.020618559534349382,"width":0.3175257728213356,"text":"76| 亞洲其他地區 - 馬爾地夫人","height":0.014693534844668399},{"width":0.42474227178664437,"y":0.9403862300688263,"height":0.020570948782535736,"x":0.5360824693202272,"text":"馬爾地夫人至今仍是全球福音最少觸"},{"text":"及的群體之一。長期以來，無論是宣","x":0.5360824748283273,"width":0.42474227178664437,"y":0.9185558354337603,"height":0.020570948782535736},{"text":"DAY 28","y":0.9037305722133083,"width":0.1074344725835891,"height":0.018120250814007033,"x":0.06587039168136763},{"height":0.019040575355766753,"y":0.8982558141378931,"x":0.5360824747137798,"text":"教工作還是基督教書籍，都無法合法","width":0.42474227178664437},{"height":0.020348836352703126,"text":"進入馬爾地夫。政府一方面否認有本","width":0.42474227178664437,"y":0.876453489003881,"x":0.5360824756118324},{"width":0.42474227178664437,"height":0.01899664147774982,"text":"土基督徒的存在，另一方面卻對持守","x":0.5360824766015231,"y":0.8560033584831943},{"text":"亞洲其他地區","x":0.05353838003480687,"y":0.8500103602088714,"width":0.18570674714587984,"height":0.023816489853046185},{"width":0.4164948236374628,"x":0.5360824885592754,"height":0.01902471041098852,"y":0.8341729639564478,"text":"基督信仰的人採取拘捕行動。目前，"},{"width":0.42061854771205365,"y":0.8123425694539261,"x":0.5381443385975814,"height":0.019052779344227222,"text":"以迪維希語即馬爾地夫語出版的基督"},{"y":0.7900267980564396,"x":0.053415874292854444,"width":0.34265278407505584,"height":0.0507603588472586,"text":"馬爾地夫人"},{"y":0.7905121749796986,"text":"教資源極為有限，懂有《路加福音》","x":0.5360824762303892,"height":0.020570948782535625,"width":0.42474227178664425},{"text":"和《使徒行傳》譯本，而且這些資源","width":0.42474227178664437,"x":0.5360824753879738,"y":0.7703488373937071,"height":0.018903891645891124},{"text":"至今仍不被允許帶入國內。","y":0.7485306468766177,"x":0.5360824859107391,"height":0.018911213558526985,"width":0.3113401867094494},{"y":0.7426532327590887,"text":"Maldivian","x":0.05360824935962006,"width":0.3154639107840402,"height":0.03787002275212292},{"x":0.5360824693202272,"width":0.42474227178664437,"height":0.019045457431591473,"text":"馬爾地夫同時面臨許多社會問題，包","y":0.7063953488762652},{"y":0.6845930234402187,"width":0.42474227178664437,"text":"括全球最高的離婚率之一，以及不斷","height":0.019017387697618626,"x":0.5360824753879738},{"height":0.018989318764379925,"width":0.42474227178664437,"x":0.5360824693202272,"text":"上升的犯罪率、幫派活動、兒童虐待","y":0.6627906977134745},{"text":"和青少年毒品問題。","width":0.23298968360537575,"x":0.5360824771870029,"y":0.6409883727248112,"height":0.020348836352703015},{"y":0.5986565907447527,"x":0.53814434261408,"height":0.020570948782535625,"width":0.4268040974934896,"text":"為什麼馬爾地夫人長期以來都屬於未"},{"width":0.1876288641066779,"y":0.5741279068082249,"text":"得之民群體呢？","x":0.536082476874496,"height":0.026207945508980868},{"x":0.5360824747137798,"height":0.018934401216675112,"y":0.5348446685117109,"text":"其中一個重要原因是當地社會高度封","width":0.42474227178664437},{"x":0.5381443323418204,"width":0.42268040974934895,"height":0.020570948782535625,"text":"閉。在馬爾地夫，居民若要前往其他","y":0.513014273643726},{"width":0.16082473028273814,"y":0.5058139534733753,"x":0.2969072232091464,"text":"Photo Source: Pexels","height":0.011818288455581971},{"text":"島嶼居住或長期停留，往往需要獲得","x":0.5360824688145817,"width":0.42474227178664437,"y":0.491183878852929,"height":0.020570948782535736},{"width":0.41855668567475823,"text":"當地島嶼管理者或社區領袖的許可。","x":0.5360824860904558,"height":0.018994200840204534,"y":0.47093023271347456},{"width":0.42268040974934906,"y":0.4491279071611489,"height":0.018966131106231687,"text":"由於每座島嶼平均人口僅約一千五百","x":0.5381443342269454},{"height":0.023255813432080052,"y":0.4331395349506266,"text":"•人口：529,676","x":0.05154639552556512,"width":0.24536081949869792},{"width":0.3938144138881138,"height":0.020348836352703126,"text":"人，加上許多人一生中會結5-10次","y":0.42732558169646817,"x":0.5360824835585204},{"text":"婚，因此島上的居民之間普遍存在親","x":0.5360824750087396,"width":0.42474227178664437,"height":0.019071085727284887,"y":0.40680100724783064},{"width":0.22886597769601003,"y":0.3982558137159372,"x":0.0927835067361874,"text":"（截至2025年8月）","height":0.021979283125434512},{"height":0.019099154660523587,"y":0.3849706125848197,"text":"屬關係。在這樣緊密而封閉的社會結","width":0.42474227178664437,"x":0.5360824688145817},{"width":0.2597938174293155,"x":0.05154638864616702,"height":0.02180232569312568,"y":0.36337209318541397,"text":"• 宗教：伊斯蘭教"},{"width":0.42474227178664437,"text":"構中，來自外界的新思想和不同信仰","x":0.5360824758936193,"height":0.019079627958693335,"y":0.36337209321977293},{"height":0.020348836352703126,"text":"很難進入社區，也使人們不容易接觸","y":0.34156976794283445,"x":0.5360824758936193,"width":0.42474227178664437},{"x":0.04948453605113749,"width":0.2927835010346912,"y":0.32703488359239063,"height":0.02183161494513708,"text":"• 語言：馬爾地夫語"},{"width":0.1567010243733724,"y":0.32115869014377585,"x":0.5340206231397742,"height":0.01895758887482324,"text":"到福音信息。"},{"width":0.3092783610026042,"x":0.05154638479079418,"y":0.2905121746263478,"text":"• 基督徒比例：0.01%","height":0.02198782535684296},{"height":0.021877990261433333,"y":0.2543604651330883,"text":"• 新約聖經：僅有路加福音和","x":0.05154639080265814,"width":0.4020618620372954},{"x":0.08659793847772267,"text":"使徒行傳","y":0.22670025170113905,"height":0.023299748110831242,"width":0.12989690871465776},{"text":"• 全本聖經：暫無","x":0.05154639802382844,"y":0.19185558385799772,"height":0.02183039462636438,"width":0.2618556613013858}]