[{"text":"54| 印度- 薩塔尼人","width":0.21030927385602677,"x":0.016494848922502046,"y":0.9664147773843581,"height":0.014693534844668399},{"y":0.9229651164634746,"text":"薩塔尼人屬於南亞民族中的泰盧","width":0.36907214210146955,"height":0.019100374979296175,"x":0.55876290065766},{"y":0.9024493607962446,"x":0.07211337363467091,"height":0.016322208792096338,"width":0.10319593520391554,"text":"DAY 19"},{"text":"固族群群集，僅分佈於印度境","y":0.9011627907367303,"height":0.019072306046057586,"x":0.5587628824677332,"width":0.34226804460798},{"width":0.06597938083467036,"x":0.5587628875208092,"text":"內。.","y":0.8778337535369346,"height":0.018968571743776974},{"height":0.02185968387837578,"x":0.06804123831299096,"width":0.05979381288800921,"text":"印度","y":0.8488372093191348},{"x":0.5587629017121517,"y":0.8371116706023028,"width":0.36907214210146955,"height":0.018992980521431946,"text":"傳統上，部分薩塔尼人仍從事與"},{"x":0.5587629017121517,"height":0.019021049454670536,"text":"宗教相關的職業，例如擔任寺廟","width":0.36907214210146955,"y":0.8152812760876689},{"height":0.04796511620458288,"y":0.7892441860038133,"x":0.06185567219646048,"text":"薩塔尼人","width":0.27422679719470794},{"y":0.7934508815851471,"text":"祭司、廟宇僕役，或負責主持各","x":0.5587629010970315,"width":0.36907214210146944,"height":0.019049118387909347},{"width":0.3670103163946242,"height":0.020570948782535736,"x":0.5587628810008552,"text":"類宗教儀式。他們屬於印度教毗","y":0.771620487237696},{"height":0.018907552602209,"y":0.751453488411149,"text":"濕奴派，遵循著名宗教改革家羅","x":0.558762880418299,"width":0.3670103163946242},{"text":"Satani","y":0.7397145248131074,"x":0.06185566966076435,"width":0.21855670383998327,"height":0.03790175424314768},{"width":0.36701031639462434,"x":0.5587628807459869,"text":"摩努闇的教導。薩塔尼人所有重","height":0.020361040341163372,"y":0.7296389591578625},{"x":0.5587629009595745,"height":0.020570948782535625,"text":"要的宗教儀式，通常都由本族群","y":0.7078085645463292,"width":0.36907214210146955},{"text":"中的宗教人士主持。他們主要敬拜","x":0.5587628942500268,"height":0.020570948782535625,"width":0.3814432779947916,"y":0.685978169230961},{"text":"毗濕奴、吉祥天女拉克希米，以及各","y":0.6656976744213234,"x":0.5567010318347246,"height":0.019021049454670536,"width":0.38556700206938244},{"text":"地傳統的地方神祇。","y":0.6452560875527642,"height":0.018988098445607227,"width":0.21237113589332213,"x":0.5587628869889059},{"height":0.019044236312084628,"y":0.6015952983872315,"width":0.3670103163946242,"text":"目前在薩塔尼人當中尚未出現公","x":0.5608247350398015},{"text":"開承認信仰耶穌基督的信徒，可","width":0.3670103163946242,"height":0.020570948782535625,"x":0.5587628799813821,"y":0.5797649033884327},{"width":0.3628865923200335,"x":0.5587628871389524,"height":0.018912434678033718,"y":0.5595930233039541,"text":"能有少數信徒尚未為外界所知。"},{"x":0.55876290065766,"height":0.018902671327118536,"text":"對於薩塔尼人而言，從印度教歸","y":0.5377833751454535,"width":0.36907214210146955},{"height":0.020570948782535736,"x":0.5587628830110158,"y":0.5159529807939649,"text":"信基督往往需要付上極大的代","width":0.3422680446079799},{"y":0.49412258619050653,"height":0.020570948782535736,"text":"價。接受並跟隨耶穌的人，很可","width":0.3670103163946242,"x":0.5587628811841312},{"x":0.5587628873572766,"height":0.01902593072976111,"y":0.47383720948673036,"text":"能遭到家人、親友和社區的反","width":0.3422680446079799},{"height":0.01899786179652241,"y":0.45203488389322255,"width":0.3649484543573288,"text":"對，甚至失去原有的人際關係、","x":0.5587628892646346},{"y":0.43023255818767514,"x":0.5587628807459869,"width":0.36701031639462434,"height":0.018969792863283708,"text":"社會地位和歸屬感。因此，他們"},{"text":"特別需要從神而來的勇氣和力","y":0.40843023278295076,"width":0.33814432053338916,"height":0.020348836352703126,"x":0.5587628882693879},{"x":0.5587628839424696,"text":"量，使他們願意無論付上什麼代","width":0.3649484543573289,"height":0.020570948782535736,"y":0.38790931954724406},{"text":"價，都堅定跟隨基督。","height":0.019095492903471678,"width":0.2556700933547247,"x":0.5587628930649057,"y":0.3660789256712079},{"x":0.09278349680139349,"y":0.33711167081290916,"text":"Image generated by Al using Microsoft Copilot","height":0.013179026763044832,"width":0.35670104253859747},{"text":"1871年的人口普查將薩塔尼人描","height":0.018925858985266664,"x":0.5587628888301722,"width":0.3649484543573288,"y":0.3240973967896309},{"y":0.3022670024462173,"width":0.36701031639462434,"height":0.020570948782535625,"x":0.5587628807459869,"text":"述為從事宗教乞討、擔任基層寺"},{"height":0.021857243240830493,"y":0.28337531517259285,"x":0.05360824821546483,"text":"•口：489,000","width":0.251546387445359},{"text":"廟祭司，以及販售祭祀用花卉的","height":0.020570948782535625,"width":0.3649484543573288,"x":0.5587628885043253,"y":0.28043660807693205},{"height":0.01900274307161287,"y":0.26017441864370716,"width":0.3670103163946242,"text":"人群。由於被視為地位較低的群","x":0.5587628810008552},{"y":0.24853064656670154,"text":"（截至2025年8月）","height":0.02183039462636438,"x":0.12164948347158261,"width":0.22886597769601003},{"text":"體，他們長期受到高種姓階層的","y":0.23837209307139595,"x":0.5587628839424696,"width":0.3649484543573289,"height":0.01897467413837428},{"width":0.23711338951474142,"x":0.053608251325103544,"text":"• 宗教：印度教","height":0.02200491062039389,"y":0.2120067172697735},{"width":0.3649484543573288,"text":"輕視和排斥，甚至遭到社會性的","x":0.5587628885043253,"y":0.21656976794283456,"height":0.020348836352703015},{"x":0.5587628882557042,"y":0.19605373632648493,"text":"孤立。","width":0.07422680173601426,"height":0.019062542695142404},{"x":0.05360824867494568,"width":0.26804122924804685,"height":0.020570948782535625,"y":0.1771620486113633,"text":"•語言：泰盧固語"},{"text":"這種歷史背景也使許多薩塔尼人","x":0.5587628839424696,"y":0.15261627942539258,"width":0.3649484543573289,"height":0.020348836352703015},{"y":0.13937867307167318,"height":0.02195853610483156,"x":0.05360824619611405,"text":"• 基督徒比例：0.00%","width":0.319587634858631},{"text":"長期生活在身分認同與社會接納","width":0.3649484543573288,"height":0.020348836352703126,"x":0.5587628897079335,"y":0.13081395371318338},{"x":0.053608248463858046,"text":"• 新約聖經：已有","width":0.27010309128534227,"height":0.02193900940300131,"y":0.10610465128861168},{"x":0.558734829332197,"y":0.11035034564535118,"width":0.15469529288155692,"text":"的張力之中。","height":0.019124890254586857},{"width":0.27010309128534227,"height":0.020348836352703015,"x":0.053608249859906164,"text":"• 全本聖經：已有","y":0.0712209307335323}]