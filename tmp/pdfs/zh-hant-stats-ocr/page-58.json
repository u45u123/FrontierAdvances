[{"height":0.014693534844668399,"x":0.020618558784327064,"y":0.9664147773843581,"text":"58| 印度 - 泰利人","width":0.19381443205333893},{"text":"泰利人是印度傳統的榨油種姓群","x":0.548453619580102,"y":0.9286314020881183,"width":0.37113400413876485,"height":0.020570948782535736},{"y":0.9019760188376311,"height":0.017268892699785376,"x":0.07815441202506869,"width":0.10142313639322915,"text":"DAY 21"},{"y":0.9068010077239407,"height":0.02197806200592789,"x":0.548453614985251,"text":"體，其名稱源自梵語中“油”的詞","width":0.3938144138881138},{"width":0.3938144138881139,"height":0.019099154660523587,"text":"彙。在傳統種姓體系中，他們通常","x":0.548453619986069,"y":0.884970612742281},{"x":0.5484536104796566,"text":"被歸為四大種姓中的第三階層。","y":0.8633720932076605,"width":0.3649484543573289,"height":0.019079627958693335},{"text":"印度","height":0.02185968387837567,"y":0.8488372094644837,"width":0.059793812888009196,"x":0.06391752673125314},{"width":0.3938144138881139,"height":0.020348836352703126,"text":"隨著榨油產業逐漸機械化，許多泰","x":0.5484536145164243,"y":0.8139534887277182},{"text":"泰利","width":0.1896907261439732,"height":0.049418605545005545,"y":0.7877906971548227,"x":0.059793811658826676},{"y":0.7921511629751025,"text":"利人已不再從事傳統行業，而轉向","width":0.3938144138881139,"height":0.018931960579129825,"x":0.548453619986069},{"width":0.3938144138881138,"y":0.7703488372483582,"x":0.548453614985251,"text":"農業和勞力工作。由於不少家庭沒","height":0.018903891645891235},{"width":0.3958762759254092,"y":0.7485306463688337,"text":"有自己的土地，一些泰利人申請登","x":0.5484536185733777,"height":0.020570948782535625},{"text":"Teli","y":0.7397145261137843,"x":0.063917526063918,"width":0.12577319372267948,"height":0.03790175264167939},{"width":0.3958762759254092,"text":"記為“其他落後階層”，以獲得政","height":0.021846259571142723,"x":0.5484536185733777,"y":0.7267002521562341},{"text":"府提供的相關補助與支援。與此同","height":0.01896735222573842,"y":0.7048698570375312,"x":0.548453619986069,"width":0.3938144138881139},{"y":0.6830394625228972,"x":0.5484536185733777,"text":"時，也有部分泰利人進入商業、政","width":0.3958762759254092,"height":0.018995421158977233},{"width":0.28659793308803017,"height":0.019023490092215933,"text":"府部門和政治領域發展。","x":0.5484536131638886,"y":0.6612090679961506},{"text":"泰利人廣泛分佈於印度各地，在孟","width":0.3938144138881138,"x":0.548453615336871,"y":0.611918604699303,"height":0.01906376301391499},{"text":"加拉、尼泊爾、斯里蘭卡和巴基斯","height":0.01903569408067618,"x":0.5484536179135839,"y":0.5901162792662846,"width":0.3958762759254092},{"y":0.568313953978964,"width":0.2082474118187314,"x":0.5484536151657446,"text":"坦也有少量人口。","height":0.020348836352703015},{"x":0.5484536174423027,"width":0.3958762759254093,"height":0.020352498109755146,"text":"在家庭和社會生活方面，泰利人大","y":0.5188916875707492},{"text":"多在本族群內部通婚，婚姻通常由","height":0.020570948782535736,"x":0.5484536145610979,"y":0.4970612931973112,"width":0.3938144138881138},{"text":"Photo Source:Wikimedia","width":0.18762886410667784,"height":0.011790219121976198,"x":0.32164948734872295,"y":0.48401162809546827},{"x":0.5484536145164243,"y":0.47523089840651445,"height":0.020570948782535625,"text":"長輩安排，並以現金或貴重物品作","width":0.3938144138881139},{"text":"為嫁妝。雖然女性的社會地位普遍","x":0.5484536145164243,"y":0.45340050358742345,"height":0.018983217170516764,"width":0.3938144138881139},{"y":0.4345930234331822,"width":0.022680412020002087,"text":"•","height":0.0130813952557286,"x":0.05360824745391649},{"height":0.02365967488709264,"text":"人口：21,850,000","y":0.4286538395105761,"x":0.10067120897663914,"width":0.25223346891857323},{"width":0.3938144138881139,"height":0.020570948782535736,"y":0.43157010951452013,"x":0.548453619986069,"text":"較低，但她們在宗教活動和社區事"},{"width":0.3958762759254092,"height":0.020570948782535736,"text":"務中扮演重要角色，也經常透過各","x":0.5484536113568831,"y":0.4097397143380409},{"width":0.22680411565871464,"y":0.3953488375715343,"text":"（截至2025年8月）","x":0.12371134320157054,"height":0.020348836352703126},{"y":0.38790931968221076,"width":0.2597938174293155,"height":0.020570948782535736,"text":"種副業補貼家庭收人。","x":0.5484536086049299},{"height":0.021871887866836137,"x":0.053608252682491836,"y":0.35894206585908706,"text":"• 宗教：印度教","width":0.23711338951474145},{"x":0.5484536003681286,"text":"泰利人大多信奉印度教，並保有與","height":0.020348836352703015,"width":0.39175258818126857,"y":0.33866279105329955},{"x":0.053608245930921665,"y":0.3226744186214604,"width":0.23711340767996653,"height":0.021993926950706122,"text":"• 語言：印地語"},{"x":0.5484536168139276,"height":0.020348836352703126,"width":0.3958762759254092,"text":"婚禮、生育和喪葬相關的傳統宗教","y":0.31686046560917813},{"y":0.29505814003585784,"x":0.5484536170888417,"text":"儀式。他們通常將逝者火化，並將","width":0.3958762759254093,"height":0.020348836352703015},{"width":0.31752577282133554,"height":0.02183039462636438,"y":0.2863140215247221,"text":"• 基督徒比例：0.01%","x":0.05567010129551783},{"width":0.38969072614397327,"x":0.5484536084357453,"height":0.020348836352703015,"text":"骨灰撒入被視為神聖的河流之中。","y":0.27325581445446256},{"width":0.26804122924804685,"x":0.055670108700718805,"text":"• 新約聖經：已有","y":0.25145348839798665,"height":0.021846259571142723},{"x":0.5484536174423027,"text":"他們重視祖先崇拜，同時尋求保佑","width":0.3958762759254093,"height":0.01890755260220911,"y":0.25145348855649774},{"width":0.38969072614397315,"height":0.018907552602209,"y":0.22963895884129315,"text":"與抵擋邪靈侵擾。在信仰實踐上，","x":0.5484536032166732},{"y":0.216569767313321,"width":0.27010309128534227,"height":0.021885312174069194,"text":"• 全本聖經：已有","x":0.053608246242454055},{"x":0.5484536185733777,"text":"泰利人往往較為務實。他們特別敬","y":0.20780856447200802,"width":0.3958762759254092,"height":0.01893562153544781},{"width":0.3979381379627046,"x":0.5463917597402971,"text":"拜一位被認為能夠實現人願望的女","height":0.020570948782535625,"y":0.1859781694586743},{"height":0.020570948782535625,"x":0.548453615336871,"width":0.3938144138881138,"y":0.16414777481322618,"text":"神，並相信這位神祇會回應他們的"},{"y":0.14231738012737172,"height":0.019019829135897948,"x":0.5484536090732473,"text":"祈求。","width":0.07628865923200334}]