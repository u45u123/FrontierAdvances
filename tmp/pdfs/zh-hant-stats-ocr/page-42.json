[{"y":0.9664147772493913,"width":0.28247422717866444,"height":0.014693534844668399,"text":"42| 印度 -卡拉爾伊迪加人","x":0.02061855449608753},{"y":0.9403862299079879,"text":"卡拉爾伊迪加人是印度的一個種","width":0.36907214210146955,"x":0.55876290065766,"height":0.018916095634351482},{"x":0.558762895353298,"width":0.37113400413876485,"height":0.020570948782535736,"text":"姓群體，傳統上以採集棕櫚汁並","y":0.9185558358068223},{"x":0.07628866059065431,"y":0.9026028551145346,"width":0.10309278397333055,"height":0.01600179584160466,"text":"DAY 13"},{"height":0.020570948782535625,"text":"釀造棕櫚酒為業。由於釀酒行業","y":0.8967254409191263,"width":0.36701031639462434,"x":0.5587628808129972},{"text":"在印度社會中長期不受尊重，卡","height":0.019012506422528053,"y":0.8764534885564979,"x":0.5587628850787474,"width":0.36701031639462434},{"text":"拉爾伊迪加人也因此被視為較低","y":0.8546511629841868,"width":0.36907217843191964,"x":0.558762882162906,"height":0.018984437489289352},{"height":0.02185968387837578,"y":0.8488372094281464,"width":0.059793812888009196,"text":"印度","x":0.0639175267003253},{"text":"地位的種姓。印度政府將他們列","x":0.5587628850787474,"width":0.36701031639462434,"y":0.8328488377022014,"height":0.020348836352703126},{"width":0.3670103163946242,"text":"為“其他落後階層”，使他們在","x":0.5587628811841312,"height":0.023255813432080163,"y":0.8110465116948127},{"y":0.7863140225740942,"width":0.4701030912853423,"x":0.010309279212061758,"text":"卡拉爾伊迪加人","height":0.0495382031905961},{"width":0.3670103163946242,"text":"教育和就業方面享有部分保障措","y":0.7905121747939433,"height":0.019080848277465923,"x":0.5587628810008552},{"x":0.5587628807459869,"height":0.02035737938484561,"y":0.7688953491928345,"width":0.36701031639462434,"text":"施，例如大學保留名額，但這也"},{"height":0.018911213558526874,"text":"反映出他們在社會中的弱勢處","x":0.5587628873572766,"width":0.3422680446079799,"y":0.7485306468675335},{"x":0.061428401151567905,"width":0.3699267069498698,"text":"Kalal Idiga","y":0.7279596489449323,"height":0.0513481441212742},{"width":0.049484534490676135,"text":"境。","x":0.5587628873251087,"height":0.018939282491765685,"y":0.7267002521227638},{"text":"近年，部分卡拉爾伊迪加人逐漸","width":0.36907214210146944,"x":0.5587629010970315,"y":0.6830394628394665,"height":0.020570948782535625},{"width":0.3670103163946242,"x":0.5587628848748528,"text":"擺脫傳統職業的限制，進入商業","y":0.6627906978515559,"height":0.018989318764379925},{"height":0.018961249831141225,"y":0.6409883721411634,"width":0.34226804460798,"x":0.5587628827733296,"text":"領域，甚至投身政治發展。然"},{"text":"而，許多居住在鄉村地區的人依","y":0.6191860467703538,"width":0.36907214210146955,"height":0.020348836352703126,"x":0.5587628965953134},{"y":0.5986565910981035,"text":"然生活貧困，必須面對經濟和社","x":0.55876290065766,"width":0.36907214210146955,"height":0.01907596700237535},{"y":0.5768261965834695,"width":0.23298968360537575,"height":0.01931150293870687,"x":0.558762891820287,"text":"會發展的種種挑戰。"},{"y":0.5334302330736485,"width":0.38556700206938244,"text":"卡納塔克邦、安德拉邦和特倫甘","height":0.020348836352703015,"x":0.5587628945735561},{"text":"納邦是卡拉爾伊迪加人最集中的","height":0.018962470149913813,"x":0.5587628960320663,"width":0.38350514003208713,"y":0.5130142739970768},{"width":0.383505140032087,"x":0.558762891504575,"text":"地區，他們也分佈於印度南部其","y":0.49118387934617813,"height":0.018990539083152513},{"height":0.020570948782535736,"x":0.5587628962983894,"text":"他一些邦。部分邦政府曾制定限","y":0.4693534844836438,"width":0.383505140032087},{"text":"制轉換宗教的法律；例如卡納塔","height":0.018966131906965722,"x":0.558762891504575,"y":0.4491279070248845,"width":0.383505140032087},{"width":0.38350514003208713,"x":0.5587628931454686,"text":"克邦過去曾實施相關法令，但後","y":0.4273255819932221,"height":0.020348836352703015},{"text":"來已被撤銷","width":0.13826396578834177,"x":0.5587030687735017,"y":0.4053194940666367,"height":0.020756361166235804},{"y":0.3633720932076605,"x":0.55876290065766,"width":0.36907214210146955,"text":"近年來，印度政府持續強化印度","height":0.019079627958693335},{"height":0.020348836352703015,"y":0.34156976787016013,"width":0.36907214210146955,"text":"教。在某些地區，帶領他人歸信","x":0.5587629017121517},{"y":0.3211586900907122,"x":0.17731959383563567,"text":"Photo Source: Negliea - Wikimedia","height":0.01314363551680331,"width":0.274226797194708},{"text":"基督的人可能被監禁。與此同","y":0.31976744236143917,"x":0.5587628870516802,"width":0.3422680446079799,"height":0.020348836352703015},{"height":0.010495382031906031,"width":0.23092783973330544,"text":"Licensed under CC BY-SA 3.0","y":0.30940386210975646,"x":0.22061855628455002},{"text":"時，對本地居民和外籍人士的旅","height":0.01898565780806205,"x":0.5587629010970315,"y":0.29932829562914176,"width":0.36907214210146944},{"height":0.020570948782535736,"width":0.36907214210146944,"x":0.5587629010970315,"y":0.2774979006424553,"text":"行限制，也增加了接觸偏遠地區"},{"y":0.25566750668630733,"text":"卡拉爾伊迪加人的難度。儘管如","width":0.3670103163946242,"x":0.5587628824899731,"height":0.020570948782535625},{"x":0.05360825567048659,"y":0.23677581857258345,"text":"• 口：2,026,000（截至","width":0.3608247302827381,"height":0.021945111797598615},{"text":"此，印度信徒仍持續努力向他們","y":0.23546511647962431,"width":0.36907217843191975,"x":0.558762881906606,"height":0.018942944248817706},{"width":0.1548159644717262,"height":0.02102743768571902,"x":0.11949923511878563,"text":"2025年8月）","y":0.21041651379225557},{"width":0.36907217843191975,"y":0.21366279119057363,"x":0.558762881906606,"text":"分享福音。在一些擁有教會的城","height":0.020348836352703015},{"x":0.5587629010970315,"y":0.1918555835414285,"width":0.36907214210146944,"height":0.020353718428527623,"text":"鎮和城市中，已有少數卡拉爾伊"},{"y":0.17422334212712232,"x":0.05360824630729213,"text":"• 宗教：印度教","width":0.2371134076799665,"height":0.020570948782535736},{"height":0.019084510034517943,"text":"迪加人接受耶穌基督，成為主的","width":0.3670103163946242,"y":0.17151162794603259,"x":0.558762880418299},{"width":0.0783505121866862,"y":0.14970930249787373,"height":0.019056440300545097,"x":0.5567010332193716,"text":"門徒。"},{"width":0.3917525881812686,"x":0.05360824416824311,"height":0.020348836352702904,"y":0.13808139585788626,"text":"•語言：主要使用泰盧固語"},{"y":0.11036520951294293,"width":0.1608790261404855,"x":0.11749863226460278,"text":"和卡納達語","height":0.022002139279664212},{"text":"•","height":0.010174418176351563,"y":0.08139534912403357,"width":0.04742267699468704,"x":0.05567010559200353},{"text":"基督徒比例：0.01%","y":0.07556675059429196,"width":0.2721649533226376,"height":0.02183039462636438,"x":0.09896906778639841}]