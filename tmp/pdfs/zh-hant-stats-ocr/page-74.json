[{"y":0.9664147773843581,"text":"74| 亞洲其他地區- 馬來西亞馬來人","width":0.35876286824544273,"x":0.020618568866969327,"height":0.014693534844668399},{"height":0.01894782552390817,"y":0.9374475232833295,"text":"馬來人約占馬來西亞全國人口的60%。雖","x":0.5360824845208684,"width":0.4185566856747581},{"x":0.5360824837401188,"y":0.9156171287596112,"height":0.01897589445714687,"width":0.4082474118187315,"text":"然馬來西亞非馬來族群當中約有9%是基"},{"text":"DAY 27","x":0.06577431603053764,"width":0.10762662433442617,"y":0.9019668738179706,"height":0.01874067080711539},{"x":0.5360824850978272,"y":0.893786733444243,"text":"督徒，但馬來人中的福音派基督徒比例","height":0.019003964191119715,"width":0.40618554978143595},{"x":0.5360360419413991,"y":0.8704935693225387,"text":"僅約0.08%。","width":0.12792791639055534,"height":0.020640768792627218},{"text":"亞洲其他地區","y":0.8517441859179721,"x":0.05154639134872295,"height":0.02189141456866639,"width":0.18762886410667784},{"y":0.8270348839796562,"text":"到了十五世紀，伊斯蘭教已經成為馬來","width":0.40618554978143606,"height":0.020348836352703126,"x":0.5360824805903817},{"x":0.5360824850978272,"height":0.019090611628381104,"text":"社會的主要信仰。自十六世紀起，馬來","width":0.40618554978143595,"y":0.8066860466960326},{"text":"馬來西亞","x":0.05351656429935281,"y":0.7889920778335183,"height":0.049922821403650675,"width":0.2723483131045387},{"height":0.019062542695142293,"x":0.536082480302581,"y":0.7848837209602042,"width":0.40618554978143606,"text":"西亞先後經歷葡萄牙、荷蘭和英國的殖"},{"width":0.3814432779947917,"y":0.7630813955211295,"x":0.5381443435627415,"text":"民統治。為了避免加劇政治和社會動","height":0.019034473761903703},{"text":"盪，殖民政府普遍不鼓勵向馬來人傳福","height":0.019006404828665002,"width":0.40618554978143595,"x":0.5360824850978272,"y":0.7412790699518466},{"x":0.05154639642428004,"text":"馬來人","height":0.05247691015952982,"y":0.7237615451580787,"width":0.2082474118187314},{"y":0.7194767443704513,"height":0.018978335094692156,"text":"音。因此，基督教宣教工作大多集中在","x":0.5360824850978272,"width":0.40618554978143595},{"text":"華人、印度人及原住民族群當中，而馬","y":0.6976744187799717,"width":0.40618554978143595,"x":0.5360824853799004,"height":0.018950266161453344},{"text":"Malay of Malaysia","x":0.03505153873575195,"y":0.6889168770845093,"width":0.37938145228794645,"height":0.0291063787554815},{"y":0.6758720932076605,"width":0.40412372407459074,"text":"來人則長期處於較少接觸福音的處境。","height":0.018922197228214754,"x":0.5360824701047435},{"width":0.4082474118187315,"y":0.6540697676262652,"text":"這種歷史發展也讓許多馬來人產生一種","height":0.01889534861374864,"x":0.5360824825736975},{"width":0.4082474118187315,"x":0.5360824837401188,"y":0.6322418137491763,"text":"印象，認為教會並不關心他們，福音與","height":0.018920976909442055},{"text":"他們無關。","width":0.11765755244663789,"x":0.5360165855803656,"height":0.01930693715285292,"y":0.610259322185241},{"height":0.021912160788535306,"width":0.3958762759254092,"x":0.5360824830682233,"y":0.5667506300831002,"text":"雖然馬來西亞早已獨立，但“馬來人”"},{"text":"與“穆斯林”的身分認同至今仍密不可","x":0.5360824850978272,"height":0.021940230522508042,"y":0.5449202347061608,"width":0.40618554978143595},{"text":"分。根據馬來西亞法律的定義，成為馬","width":0.40824741181873136,"height":0.019061322376369816,"x":0.5340206205854797,"y":0.5230898402178108},{"x":0.5360824808603938,"y":0.5012594458020541,"text":"來人必須信奉伊斯蘭教。〝馬來世界就","width":0.40824741181873136,"height":0.021996368388985443},{"x":0.5360824735560945,"y":0.479651162780254,"width":0.40206186203729544,"text":"是穆斯林世界”以及“不信伊斯蘭教，","height":0.02180232569312568},{"x":0.5360824837401188,"height":0.02200002934530343,"width":0.4082474118187315,"text":"就不是馬來人”等口號，都反映出馬來","y":0.4578488371970417},{"text":"Photo Source: Pixabay","height":0.01312410921534013,"width":0.17113402230398994,"x":0.2762886606212009,"y":0.4331395347994613},{"x":0.5360824850978272,"text":"社會對伊斯蘭身分的強烈認同。馬來西","height":0.019033253443131004,"y":0.4360465118123118,"width":0.40618554978143595},{"y":0.41424418608556757,"text":"亞法律禁止向穆斯林傳教，違者可能面","width":0.40618554978143595,"height":0.019005184509892303,"x":0.5360824799399154},{"y":0.3924418605041723,"width":0.40618554978143595,"text":"臨罰款、監禁甚至鞭刑等處罰。歸信基","x":0.5360824799399154,"height":0.018977114775919457},{"y":0.37063953505904135,"height":0.018949045842680756,"width":0.40618554978143595,"x":0.5360824853799004,"text":"督的馬來人往往會遭受社會壓力和汙名"},{"y":0.3618807722384694,"width":0.29896906898135234,"text":"• 人口：14,258, 000","height":0.021840157977279562,"x":0.053608246024787816},{"width":0.4082474118187315,"x":0.5340206279463042,"height":0.02350965575146935,"text":"化。有些人甚至可能被送往所謂的“改","y":0.3471872376249735},{"x":0.12164948347158261,"height":0.021831614945136968,"width":0.22886597769601003,"y":0.32703488360450306,"text":"（截至2025年8月）"},{"y":0.3270348840329508,"x":0.5237113319419078,"width":0.4144329979306176,"height":0.020348836352703015,"text":"造中心”，被要求重新回歸伊斯蘭教。"},{"width":0.2701030912853422,"height":0.02198782535684296,"x":0.05360825010106968,"y":0.29051217477169655,"text":"• 宗教：伊斯蘭教"},{"text":"在這樣的政治和社會環境下，許多馬來","x":0.5360824805846544,"height":0.018950266161453455,"width":0.40618554978143595,"y":0.28337531504949054},{"width":0.23711340767996653,"y":0.2556675061278211,"height":0.020570948782535736,"x":0.05360824579919198,"text":"• 語言：馬來語"},{"x":0.5360824850978272,"width":0.40618554978143595,"y":0.26017441909755024,"height":0.020348836352703015,"text":"人難以接觸福音。同時，這也使馬來西"},{"height":0.01900640482866489,"y":0.23971452548111638,"x":0.5360824776370261,"width":0.40824741181873136,"text":"亞基督徒在向馬來人分享信仰時面臨諸"},{"text":"• 基督徒比例：0-0.1%","height":0.021917042864359915,"width":0.33608245849609375,"y":0.21947674404842255,"x":0.053608253187520175},{"height":0.019034473761903703,"x":0.536082484230204,"y":0.2178841308502033,"text":"多限制。2017年2月，長期關心馬來人事","width":0.4185566856747581},{"width":0.41855668567475823,"x":0.536082482987363,"height":0.020348836352703015,"text":"工的華人牧師許景城（Raymond Koh）遭","y":0.19476744211919117},{"height":0.021956095467286385,"y":0.18459302326353888,"width":0.27010309128534227,"x":0.053608249859906164,"text":"• 新約聖經：已有"},{"y":0.17422334181185084,"x":0.5360824822091909,"height":0.019090611628381104,"width":0.4082474118187315,"text":"人強行帶走後失蹤，時至今日，其家人"},{"text":"• 全本聖經：已有","x":0.053608249859906164,"y":0.1497093028265556,"width":0.27010309128534227,"height":0.020348836352703015},{"x":0.5360824830803249,"y":0.1511335008697403,"height":0.020570948782535736,"text":"仍不知道他的下落。這事件也讓許多人","width":0.4082474118187315},{"text":"更加意識到當地福音工作的困難與挑","width":0.383505140032087,"y":0.1293031066312691,"x":0.5360824839272553,"height":0.020570948782535736},{"y":0.10901162777481221,"text":"戰。","x":0.5360824748614412,"height":0.01744186087479427,"width":0.04536082404000419}]