[{"x":0.02061855633917624,"y":0.9664147772535442,"width":0.251546387445359,"height":0.014693534844668288,"text":"16| 非洲-奧羅莫加雷人"},{"height":0.01907474668360276,"text":"加雷人與索馬利亞人和奧羅莫人都有","y":0.9256926951468907,"width":0.4268041338239398,"x":0.534020616167927},{"height":0.018079144328106977,"width":0.10742149353027344,"text":"DAY 02","y":0.9081115907499977,"x":0.07618616024368832},{"height":0.020570948782535736,"x":0.5340206170571024,"text":"深厚的歷史聯繫。傳統上，他們被視","width":0.42680413382393967,"y":0.9038623009397416},{"y":0.8837111670660478,"height":0.018905111964663712,"x":0.5340206165490021,"text":"為索馬利亞氏族體系的一部分，在索","width":0.4268041338239398},{"width":0.4268041338239398,"x":0.5340206165490021,"height":0.018933180897902524,"y":0.8618807725514137,"text":"馬利亞南部扮演重要角色，並參與建"},{"text":"非洲","y":0.8471872377848572,"x":0.061855670501871685,"width":0.05979381288800921,"height":0.02350965575146935},{"height":0.019051559025454523,"y":0.8415697676171809,"x":0.534020616167927,"text":"立巴拉韋（Barawe）和基斯馬尤","width":0.4268041338239398},{"height":0.019023490092215933,"x":0.5422680489698839,"y":0.819767441899521,"width":0.36907214210146944,"text":"（Kismayo） 等具影響力的城鎮。"},{"text":"奧羅莫加雷人","y":0.7863140211349637,"width":0.4103092738560268,"x":0.06185567088494686,"height":0.0495382031905961},{"x":0.534020616167927,"text":"與此同時，不少加雷人，特別是居住","y":0.7761627908911635,"height":0.018967352225738532,"width":0.4268041338239398},{"width":0.4268040974934896,"x":0.5340206346140799,"text":"在衣索比亞和肯亞的群體，與奧羅莫","y":0.7543604653410902,"height":0.020348836352703126},{"x":0.06597938669979286,"text":"Oromo Gare","y":0.7455919392311021,"width":0.2969072069440569,"height":0.024769101595297993},{"text":"人通婚，並接受了部分奧羅莫文化和","y":0.7338371119520032,"width":0.4288659595307849,"x":0.5319587685232674,"height":0.019069864607778153},{"y":0.7120067167940962,"x":0.5340206194733453,"width":0.07628865923200334,"text":"傳統。","height":0.019097934341751},{"y":0.6700251887193095,"width":0.4268041338239398,"x":0.534020616167927,"text":"現今他們主要分佈於索馬利亞、衣索","height":0.01892829962281195},{"x":0.534020616167927,"y":0.6481947942046753,"text":"比亞和肯亞一帶，其族群認同和使用","height":0.018956368556050762,"width":0.4268041338239398},{"text":"的語言也會因居住地區而有所不同。","x":0.5340206165490021,"y":0.6279069769285908,"width":0.4268041338239398,"height":0.019028371367306507},{"text":"正因如此，許多人視他們為連接不同","x":0.5340206165490021,"height":0.019000302434067584,"width":0.4268041338239398,"y":0.6061046513471955},{"height":0.02191094046976272,"text":"民族與文化的“橋樑民族”。","x":0.5360824813238798,"y":0.5843023255774404,"width":0.33814432053338916},{"x":0.5340206209772026,"y":0.5406976746773308,"width":0.44329895746140247,"height":0.020348836352703015,"text":"加雷人的生活以社區和畜牧業為中心，"},{"height":0.01909305226592639,"text":"主要飼養駱駝、山羊、牛和綿羊。傳","width":0.4268041338239398,"y":0.5201511337415292,"x":0.5340206165490021},{"y":0.4985465121288811,"height":0.020348836352703015,"width":0.42680413382393967,"text":"統上，他們過著遊牧生活，居住在可","x":0.5340206170571024},{"y":0.4781696056697706,"width":0.4268041338239398,"x":0.5340206165490021,"height":0.018923417546987342,"text":"搬遷的圓形棚屋中，牲畜則圍在營地"},{"x":0.5340206227468135,"width":0.4185566856747581,"height":0.018951486480226043,"y":0.4563392110219002,"text":"中央。部分家庭也從事小規模貿易，"},{"x":0.5340206187450238,"width":0.38969072614397315,"y":0.43450881615633774,"height":0.020570948782535736,"text":"以牲畜交換糧食及其他生活用品。"},{"y":0.39084802718927847,"width":0.44329895746140247,"height":0.021942670359319294,"text":"加雷人大約於十五世紀歸信伊斯蘭教，","x":0.5340206236919792},{"x":0.5319587685232674,"text":"現今幾乎全數為穆斯林，並嚴格遵守","y":0.3706395349227768,"height":0.018949045842680867,"width":0.4288659595307849},{"width":0.44329895746140247,"height":0.018920976909442166,"text":"其信仰傳統。大多數人從未聽聞福音，","x":0.5340206218993103,"y":0.3488372093413814},{"width":0.21294900803338912,"y":0.3268230036997244,"x":0.23479391752661477,"text":"Photo Source: Erik Laursen，","height":0.01417041845826117},{"y":0.32829554991649057,"text":"而曾接觸福音的人，也往往因擔心基","width":0.42680413382393967,"height":0.019088170990835818,"x":0.5340206158715353},{"text":"New Covenant Missions","y":0.31234256925452464,"width":0.17731959025065103,"x":0.2639175230705508,"height":0.011785337446518662},{"x":0.5340206165490021,"y":0.3066860466960327,"text":"督信仰會削弱他們的民族認同、社區","height":0.019090611628380993,"width":0.4268041338239398},{"x":0.5340206248898264,"y":0.28488372112674964,"width":0.4453608194986979,"height":0.019062542695142404,"text":"歸屬感和傳統文化，而選擇拒絕接受。"},{"width":0.24536081949869792,"height":0.023255813432080052,"text":"• 人口：741,000","x":0.05154639552556512,"y":0.2543604651831848},{"y":0.21947674434820452,"x":0.0927835079973558,"text":"（截至2025年8月）","width":0.22886597769601003,"height":0.02191704206362588},{"x":0.04948454146270913,"width":0.26185566130138577,"text":"• 宗教：伊斯蘭教","height":0.021902397437620125,"y":0.18303946290167528},{"height":0.02350965575146935,"x":0.0515463967591232,"width":0.38556700206938244,"text":"• 語言：加雷語，一些人說","y":0.1452560874055896},{"width":0.15889727274576823,"height":0.022294002055721407,"x":0.088592600844969,"text":"索馬利亞語","y":0.12039369642885611},{"text":"• 基督徒比例：少於0.01%","y":0.08430232564830098,"x":0.051546399025371885,"height":0.023255813432080163,"width":0.3731958661760602},{"x":0.049484531952269234,"y":0.049418604996405935,"text":"• 聖經翻譯現狀：已開始","width":0.34226804460798,"height":0.020348836352703015}]