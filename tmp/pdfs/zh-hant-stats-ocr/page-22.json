[{"text":"22| 阿拉伯世界 - 阿拉伯文化親緣群體","x":0.020618554534795157,"y":0.9651162791051984,"width":0.39175258818126857,"height":0.01473258744759487},{"y":0.943313953527428,"width":0.4268041338239398,"x":0.5340206104518004,"height":0.018902671327118536,"text":"阿拉伯文化親緣群體包括那些文化背"},{"text":"DAY 04","x":0.07010309317402477,"width":0.10927835191999163,"height":0.018938062172992987,"y":0.9273255815797536},{"height":0.020570948782535736,"y":0.9214945421256425,"x":0.5340206164311818,"text":"景源自阿拉伯半島的民族和社群，其","width":0.4268041338239398},{"x":0.5360824747137798,"y":0.9011627908820792,"width":0.42474227178664437,"text":"中大多數人以阿拉伯語為主要語言。","height":0.019072306046057474},{"height":0.01904423631208474,"y":0.8793604653097681,"width":0.4268041338239398,"text":"伊斯蘭教是他們最主要的信仰，而阿","x":0.534020616167927},{"y":0.8719563390785827,"x":0.055670104854729244,"text":"阿拉伯世界","width":0.1463917505173456,"height":0.02350965575146935},{"x":0.5340206162667244,"height":0.020348836352703015,"width":0.42680413382393967,"text":"拉伯文化也深深影響著他們的衣著、","y":0.857558140132757},{"y":0.8371116705932186,"height":0.018992980521431946,"x":0.5340206260467976,"text":"價值觀和日常生活方式。","width":0.28453607105073464},{"height":0.04957481595671143,"x":0.05567010345692577,"width":0.3402061825706845,"text":"阿拉伯文化","y":0.8110465111034663},{"y":0.7934508814276859,"width":0.4268041338239398,"height":0.019049118387909347,"x":0.5340206104518004,"text":"這些群體主要分佈於中東、北非、非"},{"y":0.7716204869221361,"width":0.4268041338239398,"x":0.5340206108328754,"height":0.019077187321148048,"text":"洲之角，以及世界各地的阿拉伯移民"},{"width":0.27647919427780876,"text":"親緣群體","height":0.04995065492106321,"x":0.053512979045709064,"y":0.7570014169704224},{"y":0.7497900926180878,"height":0.020570948782535736,"x":0.5340206123835628,"text":"群體（Diaspora）當中。根據約書亞","width":0.4268041338239398},{"y":0.7296389585247238,"height":0.017632241813602123,"x":0.5340206140293583,"text":"計畫 （Joshua Project）的分類，蘇","width":0.42474227178664437},{"x":0.05154639147581874,"text":"Arabs as an","y":0.7120067164322491,"width":0.2989690689813523,"height":0.029387069689336687},{"text":"丹阿拉伯人也歸屬于阿拉伯文化親緣","height":0.0189356215354477,"y":0.7078085644810923,"x":0.534020616167927,"width":0.4268041338239398},{"text":"群體。","x":0.5340206193144107,"height":0.017441860874794157,"y":0.6874999998678355,"width":0.07628865923200345},{"y":0.6729638954924797,"x":0.051546386359388935,"height":0.03488494206836101,"width":0.3670103163946242,"text":"Affhinity Group"},{"y":0.6438953488762653,"text":"由於伊斯蘭教在這個文化親緣群體中","width":0.42474227178664437,"x":0.5360824699944212,"height":0.018992980521431835},{"width":0.42474227178664437,"text":"主導地位，因此對這些地區的穆斯","height":0.018964911588193245,"x":0.5360824699944212,"y":0.6220930232948698},{"x":0.5340206275625337,"height":0.020348836352703126,"y":0.6002906983062066,"text":"林來說，每年前往麥加朝聖禱告是很","width":0.4268040974934896},{"y":0.5797649033019989,"width":0.10309278397333055,"text":"重要的。","height":0.019072306046057586,"x":0.5340206184600702},{"y":0.5363372093413816,"x":0.5340206104518004,"text":"沙烏地阿拉伯是伊斯蘭教的發源地，","width":0.4268041338239398,"height":0.019078407639920636},{"y":0.5145348837720986,"text":"也是其重要中心。以麥加為核心，伊","x":0.5340206099437004,"height":0.019050338706681935,"width":0.42680413382393967},{"x":0.5340206158715353,"height":0.020348836352703015,"y":0.4927325586485839,"width":0.42680413382393967,"text":"斯蘭教對全球數十億人口發揮著深遠"},{"height":0.01898687812683464,"text":"影響，並影響著世界各地不同的文化。","y":0.4722921915724815,"x":0.5340206224691166,"width":0.4474226815359933},{"x":0.5340206108328754,"width":0.4268041338239398,"text":"每年，從石油產業得到的寵大收入被","height":0.01901494706007345,"y":0.4504617969506527},{"y":0.4286314019323876,"width":0.4268041338239398,"height":0.020570948782535625,"x":0.5340206104518004,"text":"用於推動伊斯蘭教在全球的發展與傳"},{"y":0.40843023259719546,"width":0.4268041338239398,"text":"播。若福音能在這片土地上帶來屬靈","height":0.018941723930045007,"x":0.5340206104518004},{"x":0.5340206099437004,"text":"更新，使許多人歸向耶穌基督，將可","height":0.018913654996806306,"y":0.3866279070279125,"width":0.42680413382393967},{"width":0.1731958661760603,"text":"Photo Source: Pixabay","x":0.27422681062331006,"y":0.3604651164235124,"height":0.01453488379541712},{"width":0.4268041338239398,"height":0.020354938747300322,"y":0.3648194793563768,"x":0.5340206108328754,"text":"能對伊斯蘭世界及其追隨者產生深遠"},{"x":0.5340206174635065,"height":0.01892951994158454,"text":"的影響。","y":0.3429890845372858,"width":0.10309278397333055},{"width":0.4268041338239398,"y":0.29932829515708936,"text":"所有穆斯林每天都要面向麥加禱告五","x":0.534020616167927,"height":0.020570948782535625},{"x":0.051546387985845044,"text":"•人口：139,929,000","width":0.3072164989653088,"y":0.29345088158473465,"height":0.02350965575146935},{"width":0.4268041338239398,"y":0.27906976762626523,"text":"次，每年有超過兩百萬人前往麥加參","x":0.5340206165490021,"height":0.018999082115294996},{"width":0.3587628682454427,"text":"（僅統計前沿民族群體，截","height":0.02350965575146935,"y":0.25860621338809575,"x":0.09072166029152416},{"width":0.42680413382393967,"height":0.023255813432080052,"text":"加“朝覲“（Hajj）。願那些真誠尋求","y":0.25726744225036824,"x":0.5340206124580187},{"text":"至2025年8月","x":0.09072165540849628,"y":0.23255813934275416,"height":0.021849921328194633,"width":0.1670102982293992},{"y":0.23677581873109466,"text":"神的人，在尋索的過程中遇見永活的","height":0.019038134718221578,"x":0.5340206158715353,"width":0.42680413382393967},{"x":0.5340206111292674,"y":0.21494542407111183,"width":0.42680413382393967,"text":"基督，因為惟有祂是真理與生命的源","height":0.019066203651460167},{"width":0.25979381742931545,"height":0.02196951977451944,"y":0.1960537361679736,"x":0.05154639169771339,"text":"• 宗教：伊斯蘭教"},{"y":0.19311502944019854,"height":0.01909427258469898,"width":0.049484534490676135,"text":"頭。","x":0.5340206192288888},{"x":0.049484542353725354,"text":"• 語言：阿拉伯語","y":0.15988372094704173,"width":0.26185566130138577,"height":0.021896295843757074},{"x":0.04948454059602669,"width":0.3278350466773623,"height":0.02350965575146935,"text":"• 基督徒比例：0-0.1%","y":0.12342569292971517}]