.5463917507597771,"width":0.4144329979306176,"height":0.018960029512368526},{"x":0.5463917514176073,"text":"屬靈夥伴，長期處於孤島狀態；有","width":0.4144329979306176,"height":0.018988098445607338,"y":0.14525608758261244},{"text":"些人更面臨威脅甚至暴力對待。.","x":0.5463917590427027,"height":0.021903618557126858,"width":0.3979381379627046,"y":0.12209302301826264}]