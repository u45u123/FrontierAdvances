[{"x":0.014432996521113494,"y":0.9664147773843581,"text":"18| 非洲-索馬裡","height":0.014693534844668399,"width":0.17938143412272137},{"y":0.9345088162185466,"text":"全球約有2,800萬索馬利亞人，分佈","height":0.02188653249284178,"width":0.4144329979306175,"x":0.5463917472030762},{"text":"於約35個國家，其中約一半居住在","x":0.5463917485432822,"width":0.4144329979306176,"y":0.9156171288339324,"height":0.020570948782535625},{"height":0.01805166153223159,"text":"DAY 03","x":0.07619050173254488,"width":0.10741281055268787,"y":0.9081253321479887},{"text":"索馬利亞。大多數索馬利亞人隸屬","y":0.8953488373937071,"x":0.5463917507597771,"width":0.4144329979306176,"height":0.019008845466210178},{"y":0.8735465118213961,"width":0.4144329979306176,"text":"於五大氏族之一，氏族關係深刻影","height":0.018980776532971477,"x":0.5463917510475778},{"width":0.059793812888009196,"x":0.07010309322380753,"text":"非洲","y":0.8471872377767822,"height":0.02350965575146935},{"x":0.5463917510475778,"y":0.8517441865474857,"height":0.020348836352703015,"text":"響著他們的社會生活和政治制度。","width":0.4144329979306176},{"height":0.019056441101279242,"y":0.8312342565340834,"x":0.5463917507597771,"text":"忠誠於氏族極為重要，許多事務都","width":0.4144329979306176},{"width":0.4144329979306176,"text":"是透過氏族長老和家族網路來協調","y":0.809403862432918,"x":0.5463917478559971,"height":0.020570948782535625},{"width":0.2721649533226376,"x":0.06185566662178985,"y":0.7877906971604132,"height":0.049418605545005434,"text":"索馬利亞"},{"height":0.01890023068957325,"x":0.5443298958140219,"y":0.7892441860734551,"text":"和決策。","width":0.10309278397333055},{"height":0.027616278250411685,"y":0.7470930237589304,"text":"Somali","width":0.1628865923200335,"x":0.0618556740756239},{"text":"約有60%至70%的索馬利亞人過著遊","x":0.5443299047939343,"width":0.4164948236374628,"y":0.7455919392877078,"height":0.018942944248817595},{"y":0.7237615447730738,"height":0.018971013182056295,"x":0.5443299047939343,"width":0.4164948236374628,"text":"牧或半遊牧生活，隨著牲畜遷徙，"},{"height":0.018999082115294996,"y":0.7019311504128729,"x":0.5463917510475778,"text":"尋找水源和牧草。鄉村生活條件艱","width":0.4144329979306176},{"height":0.019027151048533808,"width":0.4144329979306176,"y":0.6801007556590188,"text":"苦，學校、醫療設施和潔淨水資源","x":0.5463917466876121},{"height":0.021864565954200277,"x":0.5463917506517753,"text":"十分有限。全國僅約1.6%的土地適","y":0.6569767439744505,"width":0.4144329979306176},{"text":"合耕種，頻繁發生的旱災經常導致","x":0.5443299036039491,"height":0.020348836352703015,"y":0.6380813956899276,"width":0.4164948236374628},{"height":0.019079627958693224,"text":"饑荒和人口遷移。","y":0.6175482789699107,"width":0.2061855679466611,"x":0.5463917533978034},{"width":0.4144329979306176,"height":0.01907108492655074,"x":0.5463917514176073,"text":"索馬利亞長期經歷戰爭與衝突。自","y":0.5741279071611489},{"width":0.4164948236374628,"text":"1991年中央政府倒臺以來，數百萬","x":0.5443299042981071,"y":0.5523255814465171,"height":0.01904301599331215},{"x":0.5443299042981071,"y":0.5305232561695787,"text":"人被迫離開家園。有些人在國內難","width":0.4164948236374628,"height":0.020348836352703126},{"height":0.010202487509957225,"x":0.19793815660932645,"y":0.5116279072635685,"text":"Photo Source: Tosco.diaz - Flickr","width":0.2536082313174293},{"y":0.5100755664051388,"width":0.4144329979306175,"x":0.5463917450037634,"text":"民營生活，有些則遷往鄰近國家，","height":0.018994200840204423},{"x":0.5463917514176073,"y":0.4882451720479659,"text":"如衣索比亞和肯亞，或散居世界各","width":0.4144329979306176,"height":0.019022269773443234},{"text":"地。","width":0.049484534490676135,"x":0.5463917537855898,"y":0.46641477754544425,"height":0.019050338706681935},{"text":"• 人口：16,288,200。分佈在","x":0.051546402064430126,"height":0.02350965575146946,"width":0.4164948236374628,"y":0.4185558352758546},{"width":0.4144329979306176,"y":0.4229651167800438,"x":0.5463917510475778,"height":0.020359820022390784,"text":"北部的索馬利蘭（Somaliland，自"},{"height":0.018908772920981587,"text":"1991年以來實行自治）及邦特蘭","width":0.4164948236374628,"y":0.4026028548015904,"x":0.5443299036039491},{"y":0.39378673377119444,"width":0.3628865923200335,"x":0.08865979921553552,"text":"16個國家中。（僅統計前沿","height":0.020570948782535625},