[{"text":"52| 印度 - 拉傑普特人","x":0.057731958346405696,"height":0.014693534844668399,"y":0.9664147773843581,"width":0.23092783973330544},{"x":0.5360824739096155,"width":0.4103092738560268,"text":"拉傑普特人是一個規模龐大且多元","y":0.92863140241785,"height":0.01904301599331204},{"height":0.0181527037664585,"text":"DAY 18","y":0.902260857740862,"width":0.10538731529599143,"x":0.06380118683757044},{"x":0.536082473543268,"width":0.4103092738560268,"height":0.020348836352703015,"text":"的印度教群體，普遍自認靥於剎帝","y":0.9055232561799608},{"y":0.8837111670733152,"text":"利武士階層。他們是印度重要的高","width":0.4103092738560268,"x":0.5360824785255949,"height":0.018905111964663712},{"width":0.4123711358933222,"y":0.8618807725393013,"x":0.5360824767268784,"height":0.018933180897902524,"text":"種姓群體之一，擁有不同的族源與"},{"height":0.02350965575146935,"width":0.061855670383998335,"y":0.847187237930206,"text":"印度","x":0.06597938168944412},{"width":0.4123711358933222,"height":0.020570948782535736,"x":0.536082469909009,"text":"地域背景，雖然主要聚居於拉賈斯","y":0.8400503776834287},{"width":0.4103092738560268,"y":0.818219982892632,"height":0.020570948782535625,"text":"坦邦，但在印度各地都可見他們的","x":0.5360824739096155},{"text":"蹤跡。","width":0.0783505121866862,"x":0.5360824753057732,"y":0.7963895888621627,"height":0.019017387697618626},{"width":0.342483883812314,"height":0.05016686273762205,"text":"拉傑普特人","x":0.06174774774563021,"y":0.7874165685699382},{"height":0.02350965575146935,"x":0.5443298929072166,"width":0.4,"text":"“拉傑普特”一詞意為“王者之子”或","y":0.7527287992538086},{"height":0.045434437710932585,"y":0.7294630134769593,"width":0.2290144784109933,"x":0.06178142084530339,"text":"Rajput"},{"height":0.022008572377445912,"text":"“國王之子”。歷史上，拉傑普特人多","y":0.7308984043953524,"x":0.5463917564702852,"width":0.3958762759254092},{"height":0.019077187321148048,"text":"為王族、領主和武士，負責統治和保衛","width":0.40618554978143595,"x":0.5360824799399154,"y":0.7093023256204513},{"width":0.40618554978143595,"text":"各地獨立王國，並極為重視家族血統和","height":0.019049118387909347,"x":0.5360824850978272,"y":0.6875000001844047},{"y":0.6641477749343503,"height":0.020570948782535625,"width":0.40824741181873136,"text":"氏族傳承。1970年，印度政府正式廢除","x":0.5360824830597064},{"x":0.5360824805846544,"height":0.018992980521431835,"width":0.40618554978143595,"text":"了他們的貴族頭銜和相關財產權利。然","y":0.6438953488762653},{"text":"而，在拉賈斯坦邦，許多昔日王朝的影","y":0.6220930232857856,"height":0.018964911588193245,"x":0.536082480302581,"width":0.40618554978143606},{"width":0.4103092738560268,"text":"響至今仍然存在，他們的家族和氏族體","height":0.0189368418542204,"y":0.6002906978588234,"x":0.5340206249070379},{"text":"系依然廣為人知。","x":0.5360824763358364,"height":0.018908772920981698,"y":0.5784883722683437,"width":0.18762886410667778},{"y":0.5348446685026265,"x":0.5360824853799004,"text":"時至今日，拉傑普特人在政治、軍隊和","height":0.018934401216675112,"width":0.40618554978143595},{"height":0.020348836352703126,"text":"員警體系中仍佔有重要地位。他們以領","y":0.5116279073323693,"x":0.5360824771060982,"width":0.4082474118187315},{"text":"導力、勇氣和忠誠著稱，並持續在社會","x":0.536082480302581,"y":0.4898255814434891,"height":0.018990539083152513,"width":0.40618554978143606},{"x":0.5381443317273098,"y":0.46802325599835815,"text":"中發揮影響力和帶領作用。","height":0.018962470149913813,"width":0.28247422717866444},{"x":0.5360824859654506,"text":"大多數拉傑普特人信奉印度教，主","width":0.3938144138881138,"height":0.01890633228343641,"y":0.4244186048355676},{"x":0.5360824848000036,"height":0.020348836352703015,"y":0.40116279098062535,"text":"要敬拜濕婆神、太陽神（Surya）和","width":0.40618554978143595},{"y":0.38077246042322077,"text":"難近母，並尋求守護神的庇佑以及","x":0.5360824862389327,"width":0.3938144138881139,"height":0.0189368418542204},{"width":0.3938144138881139,"text":"印度教導師（Guru）的指引。雖然","height":0.0189649107874591,"x":0.5360824813162524,"y":0.35894206576323795},{"x":0.5360824801471124,"text":"聖經和基督教資源已有印地語譯","width":0.37113400413876485,"y":0.33711167124860386,"height":0.0189929797206978},{"y":0.3152812765350521,"x":0.5360824810063675,"text":"本，但由於他們強烈的高種姓認同","height":0.020570948782535625,"width":0.3958762759254093},{"height":0.010174418176351452,"width":0.1917525700160435,"x":0.2350515524404318,"text":"Photo Source: Wikimedia","y":0.28924418631516724},{"text":"及相對封閉的社交圈，許多拉傑普","height":0.020348836352703015,"x":0.5360824827795633,"y":0.2921511630155089,"width":0.3958762759254093},{"width":0.2618556613013857,"y":0.27162048691305185,"height":0.019077187321148048,"x":0.5340206203389979,"text":"特人仍極少接觸福音。"},{"text":"•口：31,894,000","x":0.05326311339686295,"y":0.2353403332599372,"height":0.02422004943130196,"width":0.29960477919805617},{"width":0.22886597769601003,"x":0.12164948384958953,"text":"（截至2025年8月）","y":0.2019311503452047,"height":0.021906059194672034},{"width":0.23505154564267117,"height":0.02195975642360426,"x":0.055670102161482285,"text":"• 宗教：印度教","y":0.1656976742900651},{"height":0.02199880902653073,"y":0.13081395335983248,"text":"• 語言：印地語","x":0.053608251325103544,"width":0.23711338951474142},{"text":"• 基督徒比例：0.01%","y":0.09445843836617163,"x":0.055670103898610566,"width":0.3175257728213356,"height":0.02183039462636438},{"height":0.02185114164696733,"x":0.055670108940041374,"y":0.05959302327262317,"width":0.26804122924804685,"text":"• 新約聖經：已有"},{"x":0.05360825010106968,"height":0.021890194249893802,"text":"• 全本聖經：已有","width":0.2701030912853422,"y":0.02470930234239066}]