[{"height":0.014693534844668399,"width":0.3175257728213356,"text":"78| 亞洲其他地區 - 努裡斯坦人","x":0.020618559534349382,"y":0.9664147773843581},{"text":"努里斯坦人泛指居住在阿富汗東北部努","x":0.5360824781392197,"width":0.4474226815359933,"height":0.01894782552390817,"y":0.9374475232742452},{"text":"里斯坦省及巴基斯坦北部山區的居民。","y":0.9156171286142624,"height":0.01897589445714687,"x":0.536082480064088,"width":0.44123709542410716},{"y":0.9025265257897775,"width":0.10520926884242467,"height":0.016167879304797794,"x":0.06595206555842191,"text":"DAY 29"},{"text":"他們使用屬於努里斯坦語族的多種語","x":0.5360824753879738,"height":0.019003964191119715,"y":0.893786733444243,"width":0.42474227178664437},{"height":0.019032033124358305,"y":0.871956338929609,"x":0.5360824768608693,"width":0.4474226815359933,"text":"言。從民族分類來看，努里斯坦人群集"},{"y":0.8517441859179721,"height":0.02189141456866639,"width":0.18762886410667784,"text":"亞洲其他地區","x":0.05154639134872295},{"x":0.5360824750087396,"y":0.8501259447315441,"width":0.42474227178664437,"height":0.020570948782535736,"text":"包含八個主要群體：阿什庫尼一瓦邁"},{"x":0.5360824768608693,"y":0.8282955499003408,"width":0.4474226815359933,"height":0.019088170990835818,"text":"人；納里薩提人；格蘭加利人；卡姆維"},{"x":0.5360824781392197,"height":0.019090611628381104,"width":0.4474226815359933,"text":"里人；馬拉赫爾人；瓦伊格利人；普拉","y":0.8066860466960326},{"height":0.05445689818720967,"y":0.7881785291771115,"text":"努里斯坦人","width":0.3449689592633928,"x":0.051226859427612834},{"x":0.5360824745843114,"text":"蘇尼人；特雷加米人。","y":0.7848837211146373,"width":0.2597938174293154,"height":0.019062542695142293},{"width":0.42474227178664437,"text":"最早與努里斯坦人接觸的基督徒並非","height":0.019038134718221578,"y":0.7441860465415995,"x":0.5360824696994614},{"y":0.7388070242195177,"text":"Nuristani","height":0.044188277647337126,"x":0.059531485967862896,"width":0.3221741449265253},{"text":"直接進入當地，而是透過當時的英國","width":0.42474227178664437,"height":0.019010065784982877,"x":0.5360824758936193,"y":0.7223837211267498},{"width":0.42474227178664437,"height":0.018981996851744065,"x":0.5360824750087396,"text":"殖民軍隊間接接觸。那時候，努里斯","y":0.7005813955423262},{"text":"坦仍被稱為卡菲里斯坦，即“異教徒","height":0.02189263488743909,"x":0.5360824753879738,"y":0.6787790697842511,"width":0.42474227178664437},{"width":0.40824741181873136,"x":0.5360824830597064,"text":"之地”。有一些來自卡菲里斯坦的","y":0.6582703611705878,"height":0.021962197061149547},{"y":0.6364399662199907,"height":0.020570948782535625,"text":"士兵，他們在軍中接觸到基督教信","width":0.3938144138881138,"x":0.5360824809646323},{"x":0.5360824783930992,"height":0.020354938747300322,"text":"仰，並開始對福音產生興趣。","y":0.614825581993222,"width":0.33814432053338916},{"text":"其中一位特別渴望進一步認識基督信","x":0.5360824696994614,"width":0.42474227178664437,"y":0.5726280433183264,"height":0.018941723930045007},{"y":0.5507976489672097,"height":0.018969792863283708,"width":0.42474227178664437,"text":"仰的卡菲爾士兵，邀請基督徒前往自","x":0.5360824750087396},{"width":0.42474227178664437,"y":0.530523255840897,"text":"己的家鄉。1864年，兩位由普什圖族","x":0.5360824688145817,"height":0.01901494706007334},{"width":0.3958762759254093,"x":0.5360824845527592,"text":"歸信基督的信徒應邀前往卡菲里斯","height":0.01898687812683464,"y":0.5087209304169629},{"x":0.5360824753879738,"text":"坦，展開有記錄以來首次進入當地的","y":0.4869186048355676,"width":0.42474227178664437,"height":0.018958809193595938},{"height":0.018930740260357126,"y":0.4651162792541723,"x":0.5360824859654506,"text":"福音旅程。他們在當地傳講基督信","width":0.3938144138881138},{"y":0.4433139537131834,"x":0.5360824833446028,"width":0.3938144138881139,"text":"仰，分發以貿易通用語言翻譯的聖","height":0.020348836352703015},{"height":0.019100374979296175,"x":0.5360824753879738,"text":"經，並提供醫療協助，因此受到當地","width":0.42474227178664437,"y":0.42296511646347446},{"x":0.5360824693202272,"text":"居民友善接待。離開時，當地居民甚","height":0.019072306046057586,"width":0.42474227178664437,"y":0.40116279073673033},{"height":0.020348836352703015,"y":0.3793604654719043,"text":"至托他們帶出一封信，盼望他們再次","width":0.42474227178664437,"x":0.5360824688145817},{"x":0.5360824688145817,"width":0.42474227178664437,"text":"返回，繼續教導他們關於基督信仰的","y":0.3589420657602097,"height":0.0189649107874591},{"height":0.018992980521431946,"text":"信息。然而，由於種種原因，這次回","x":0.5340206099437004,"width":0.42680413382393967,"y":0.3371116704690663},{"height":0.020570948782535736,"text":"訪最終未能實現。","y":0.3152812764146202,"x":0.5360824811451261,"width":0.2082474118187313},{"x":0.25567010994043177,"y":0.30668604675000255,"width":0.1917525700160435,"height":0.010274490721580043,"text":"Photo Source: Wikimedia"},{"y":0.2732558141378931,"width":0.42474227178664437,"height":0.01893562153544781,"x":0.5360824753879738,"text":"在隨後數十年間，雖然仍有零星訪客"},{"width":0.42474227178664437,"x":0.5360824753879738,"text":"進入卡菲里斯坦，但1896年，當地居","height":0.01890755260220911,"y":0.25145348855649774},{"width":0.2462641398111979,"text":"• 人口：356,300","height":0.025942544592818195,"y":0.24534937555968617,"x":0.051105141008465},{"height":0.01890755260220911,"width":0.42268040974934906,"y":0.22963895900740605,"x":0.5381443342269454,"text":"民被強制改信伊斯蘭教。此後，卡菲"},{"y":0.21074727082187605,"x":0.0907216539169908,"height":0.02183039462636438,"text":"（截至2025年8月）","width":0.23092782156808037},{"width":0.3958762759254092,"x":0.5360824838929654,"height":0.020570948782535736,"y":0.2078085639878431,"text":"里斯坦被改名為努里斯坦，意思是"},{"height":0.02198782535684296,"y":0.18749999999604516,"x":0.5484536149648291,"text":"“光明之地”。","width":0.16701029822939917},{"text":"• 宗教：伊斯蘭教","y":0.17587209304006513,"height":0.021860904197148368,"width":0.25979381742931545,"x":0.05154639169771339},{"y":0.13937867318068475,"x":0.05154639118089597,"text":"• 語言：5種本土語言","width":0.3051546369280134,"height":0.021958536104831672},{"y":0.1031976744644838,"width":0.2969072069440569,"text":"• 基督徒比例：0.0%","x":0.051546399497043656,"height":0.021907279513444733},{"height":0.021912160788535306,"text":"• 新約聖經：無","width":0.22886597769601005,"y":0.0667506298287398,"x":0.051546393948386705},{"height":0.0219536548297411,"y":0.03052325568541392,"x":0.0494845320921102,"text":"• 全本聖經：無","width":0.2309278397333054}]