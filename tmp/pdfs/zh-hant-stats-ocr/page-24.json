[{"text":"24| 阿拉伯世界 - 葉門人","y":0.9664147778281076,"width":0.25360824948265437,"height":0.016143361627304897,"x":0.020618553325683193},{"width":0.377319590250651,"height":0.019033253443131004,"y":0.936046511666963,"x":0.5587628831908257,"text":"葉門位於紅海與阿拉伯海之間，"},{"y":0.9142441866782997,"x":0.560824742697446,"width":0.37525772821335557,"text":"自古以來便佔據重要戰略位置，","height":0.020348836352703015},{"y":0.9040020516295036,"text":"DAY 05","width":0.1051996776035854,"x":0.07008057409492524,"height":0.01757729223653315},{"y":0.8924418609660904,"width":0.383505140032087,"height":0.020348836352703015,"text":"擁有數千年的悠久歷史。透過與","x":0.5587628962983894},{"x":0.5587628911621597,"text":"阿拉伯半島、埃及、海灣地區及","y":0.8719563395849942,"width":0.38350514003208713,"height":0.01903203232362427},{"text":"阿拉伯世界","height":0.02350965575146935,"y":0.847187237930206,"width":0.1463917505173456,"x":0.055670104854729244},{"x":0.5587628966408047,"y":0.8501259444149749,"height":0.019060102057597117,"text":"印度的貿易往來，古代葉門諸王","width":0.383505140032087},{"x":0.5587628951798328,"text":"國得以興盛發展，其中包括聖經","y":0.8282955503477241,"width":0.38350514003208713,"height":0.020570948782535625},{"y":0.8066860467703538,"x":0.5587628853573587,"height":0.02035005747220986,"text":"所記載的示巴王國。","width":0.23505154564267106},{"y":0.7863140216559761,"x":0.05360824540306216,"text":"葉5人","height":0.05247691015952971,"width":0.18350515819731214},{"x":0.5587628962983894,"width":0.383505140032087,"height":0.01894660520513558,"text":"六世紀時，基督教曾在葉門部分","y":0.7644836273048637},{"width":0.18870667957124254,"y":0.7394389492570503,"height":0.032750008788857476,"text":"Yemeni","x":0.05719305291450437},{"width":0.383505140032087,"height":0.01897467413837428,"x":0.558762891504575,"text":"地區廣泛傳播。然而，自那以後","y":0.7426532326630495},{"y":0.7208228376551663,"width":0.383505140032087,"height":0.020570948782535736,"text":"葉門人逐漸成為堅定而熱忱的穆","x":0.558762891504575},{"x":0.5587628960320663,"text":"斯林。有些葉門人在穆罕默德離","width":0.38350514003208713,"height":0.018981996851744065,"y":0.7005813955332421},{"height":0.020348836352702904,"y":0.6787790701230672,"text":"世前便已歸信伊斯蘭教。時至今","x":0.558762891504575,"width":0.383505140032087},{"x":0.5608247471746781,"y":0.6569767445598403,"width":0.38350514003208713,"height":0.020348836352703015,"text":"日，伊斯蘭信仰已深深融入葉門"},{"width":0.40412368774414065,"x":0.558762899515264,"y":0.636439966448396,"height":0.020570948782535625,"text":"文化和社會生活，對許多人來說，"},{"text":"身為葉門人也意味著身為穆斯林。","width":0.40412372407459074,"y":0.6148255815706694,"height":0.019095492903471456,"x":0.5587628827565191},{"width":0.383505140032087,"y":0.5930232558620938,"height":0.019067423970232866,"x":0.558762891504575,"text":"今日，葉門的宰德派（Zaydi）穆"},{"x":0.5587628962983894,"height":0.020348836352703015,"text":"斯林屬於什葉派體系，例如胡塞","width":0.383505140032087,"y":0.5712209307335322},{"y":0.5507976489460131,"text":"武裝 （Houthis）便源於這一傳統，","width":0.40412368774414065,"height":0.018969792863283708,"x":0.5587629017636685},{"width":0.38350514003208713,"x":0.5587628911621597,"height":0.01899786179652252,"y":0.5289672542981425,"text":"主要聚居於西北部山區；遜尼派"},{"y":0.5071368599288575,"height":0.01902593072976111,"text":"穆斯林則主要分佈於南部、東部","width":0.38350514003208713,"x":0.5587628960320663},{"height":0.020570948782535736,"x":0.5587628963930255,"width":0.40412368774414065,"text":"及沿海城市地區。即使到了今天，","y":0.4853064650027329},{"text":"部落制度仍深刻影響著當地社會","x":0.5587628911621597,"y":0.46511627910882336,"height":0.018930740260357237,"width":0.38350514003208713},{"width":0.2061855679466611,"y":0.4433139536818612,"text":"生活和政治運作。","x":0.5587628874184221,"height":0.018902671327118536},{"y":0.39966414792593086,"text":"1990年，南葉門與北葉門統一，","width":0.3793814522879464,"height":0.020570948782535736,"x":0.5587628831687416},{"y":0.37936046514322264,"text":"成立葉門共和國。然而，各種衝","width":0.383505140032087,"height":0.019044237112818774,"x":0.558762890705606},{"x":0.5587628966408047,"y":0.3575581397192885,"text":"突並未因此停止。2014年爆發的","height":0.01901616737884604,"width":0.383505140032087},{"width":0.3628865923200335,"y":0.341569767489156,"x":0.08247423005500537,"height":0.011627906716040082,"text":"Photo Source: Rod Waddington - Flickr Licensed"},{"x":0.5587628961112527,"text":"內戰給葉門人民帶來極大的苦難，","width":0.40824741181873136,"height":0.020348836352703015,"y":0.33575581446899727},{"text":"under CC BY-SA 2.0","y":0.32703488376407297,"x":0.07835051664410701,"height":0.011756048194507263,"width":0.1628865923200335},{"y":0.31528127594232,"text":"數萬人喪生，無數人流離失所，","width":0.377319590250651,"height":0.019021049454670647,"x":0.5587628831908257},{"x":0.55876288323747,"width":0.3793814522879464,"text":"兒童營養不良問題尤為嚴重。","y":0.2921511630494237,"height":0.020348836352703015},{"width":0.38556700206938244,"text":"2022年的停火協議曾帶來一些和","x":0.5567010378018331,"y":0.2716204870584007,"height":0.019077187321148048},{"y":0.2543604652108703,"width":0.29278350103469125,"x":0.0515463951380299,"height":0.023255813432080052,"text":"• 人口：34,350,000"},{"width":0.383505140032087,"text":"平的希望，但隨著胡塞武裝介人","height":0.020361040341163372,"x":0.5587628940664306,"y":0.25000000063178807},{"width":0.383505140032087,"height":0.020348836352703126,"text":"加薩戰爭以支持哈馬斯，其後又","y":0.22819767491957876,"x":0.5587628962983894},{"y":0.21947674423010866,"width":0.22886597769601008,"x":0.09278350742776816,"height":0.021917042864359915,"text":"（截至2025年8月）"},{"y":0.20639534906202062,"text":"引發西方國家和以色列的軍事行","x":0.5587628942726162,"width":0.38350514003208713,"height":0.020348836352703015},{"height":0.020348836352703015,"y":0.18459302361143914,"width":0.26185566130138577,"text":"• 宗教：伊斯蘭教","x":0.0494845383011972},{"text":"動，使局勢再次趨於緊張。","y":0.18597816996645833,"x":0.5587628982818732,"height":0.0189636904686864,"width":0.3113401867094494},{"width":0.4350515456426711,"height":0.023255813432080052,"x":0.049484534206155895,"text":"• 語言：阿拉伯語，多種方言","y":0.14680232603589793},{"height":0.02350965575146935,"text":"• 基督徒比例：少於0.1%","x":0.049484547629855935,"width":0.35876286824544273,"y":0.11041141911704311},{"y":0.07556675059429196,"text":"• 聖經：已有譯本，但分發上","height":0.02183039462636438,"x":0.05154639963929516,"width":0.41649482363746276},{"x":0.08659793784004444,"height":0.021908499832217432,"y":0.04785894201143848,"width":0.09690721602666946,"text":"有困難"}]