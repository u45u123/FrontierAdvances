[{"x":0.02061856199000741,"height":0.016143361627304897,"text":"38| 印度-婆羅門","width":0.18969070797874812,"y":0.9664147778281076},{"y":0.9302325583239397,"text":"婆羅門傳統上是印度社會中的祭司、","width":0.41855668567475823,"height":0.018969792863283708,"x":0.5360824848945797},{"y":0.9084302330510386,"text":"教師和宗教經典的守護者。數千年","width":0.3999999999999999,"x":0.5360824764490263,"height":0.020348836352703015},{"width":0.09690721602666946,"x":0.07628865942223229,"y":0.9026028544850211,"height":0.0176322418136019,"text":"DAY 11"},{"text":"來，他們在印度的文化和宗教生活中","width":0.42474227178664437,"x":0.5360824753879738,"height":0.020348836352703126,"y":0.8866279074881003},{"y":0.8660789255288872,"width":0.428865959530785,"height":0.019095492903471567,"x":0.531958769238044,"text":"一直佔據重要地位。歷史上，婆羅門"},{"height":0.02350965575146935,"text":"印度","y":0.8471872372229104,"width":0.06185567038399833,"x":0.06185567008046034},{"width":0.42268040974934895,"y":0.8444767443795356,"height":0.01908328891501121,"text":"曾擔任統治者的顧問，在殖民時期參","x":0.5381443338495523},{"width":0.42474227178664437,"x":0.5360824753879738,"text":"與行政管理，並在印度獨立後繼續活","y":0.8226744187890559,"height":0.01905521998177251},{"width":0.41855668567475823,"text":"躍於政府和公共事務領域。傳統上，","x":0.5360824860904558,"height":0.020348836352703015,"y":0.800872093509695},{"width":0.2061855679466611,"height":0.049418605545005545,"text":"婆羅門","y":0.7877906972935649,"x":0.06185567057212399},{"x":0.5360824745399873,"y":0.7804366077603627,"text":"他們的職責包括主持廟宇禮儀、執行","height":0.018981996851744176,"width":0.43711340767996654},{"height":0.020570948782535736,"text":"人生重要儀式，以及擔任宗教導師。","width":0.4309278215680804,"x":0.536082483661836,"y":0.758606213562298},{"y":0.7363998807313572,"height":0.03592116886782715,"x":0.051064187974737066,"width":0.24838709150041854,"text":"Brahmin"},{"height":0.020570948782535736,"y":0.7367758182469298,"width":0.4350515456426711,"text":"不過，許多婆羅門也從事農業、商業","x":0.5360824773204169},{"y":0.7165697676141529,"x":0.5360824724770493,"width":0.16082474844796313,"text":"及其他職業。","height":0.01894660520513547},{"width":0.42474227178664437,"height":0.01889656893252123,"y":0.672963895999353,"text":"儘管婆羅門在傳統種姓體系中擁有較","x":0.5360824693202272},{"height":0.020570948782535736,"y":0.6511335011459031,"x":0.5360824750087396,"width":0.42474227178664437,"text":"高地位，現代印度社會的發展卻改變"},{"height":0.019060102057597117,"x":0.5360824681066779,"y":0.630813953527428,"width":0.42474227178664437,"text":"了這種情況。隨著政府推動保障弱勢"},{"y":0.6090116280913815,"text":"族群的措施，不少婆羅門認為自己逐","width":0.42474227178664437,"height":0.01903203232362416,"x":0.5360824753879738},{"text":"漸失去了過去在政治、經濟和社會上","x":0.5360824714056469,"width":0.42474227178664437,"height":0.020348836352703015,"y":0.5872093029573694},{"height":0.023255813432080052,"text":"的優勢，甚至感受到某種程度的“反","y":0.5654069771986887,"x":0.5360824751719698,"width":0.42474227178664437},{"y":0.544920234805367,"height":0.021940230522508153,"text":"向歧視”。在南印度，反婆羅門運動","width":0.42268040974934895,"x":0.538144329278492},{"text":"尤其活躍，反映出社會長期以來對婆","y":0.523089840375272,"x":0.5360824753879738,"width":0.42474227178664437,"height":0.019061322376369705},{"y":0.501259445855035,"width":0.1917525700160435,"text":"Photo Source: Wlkimedia","height":0.011821949411899846,"x":0.26391753102290605},{"y":0.5012594461668252,"height":0.020570948782535625,"x":0.5360824753879738,"text":"羅門影響力的不滿與反思。然而，總","width":0.42474227178664437},{"x":0.5360824753879738,"width":0.42474227178664437,"height":0.01889534861374864,"text":"體而言，婆羅門群體仍享有相對較高","y":0.4811046513471954},{"x":0.0536082391584026,"y":0.4563392110097878,"text":"婆羅門是印度最具影響力的群體之一，然而","width":0.4144329979306176,"height":0.018951486480226043},{"width":0.42474227178664437,"height":0.018919756590669357,"text":"的教育水準和經濟條件，許多家庭能","y":0.4592779177797951,"x":0.5360824750087396},{"text":"專門針對他們的福音工作卻相對有限。近年","y":0.4374475232742452,"width":0.41237113589332214,"x":0.05567010628014295,"height":0.01894782552390817},{"height":0.01906498333268769,"y":0.43895348855649774,"x":0.536082477501748,"text":"夠為子女提供良好的教育資源。","width":0.3649484543573288},{"y":0.41855583508716654,"x":0.05360824943183668,"text":"值得感恩的是，一些受過良好教育的高種姓","width":0.41237113589332214,"height":0.017632241813602012},{"width":0.41237113589332214,"y":0.3996641480070092,"text":"印度教徒，以及持較世俗觀點的人士，開始","height":0.017632241813602012,"x":0.05360824943183668},{"width":0.42474227178664437,"height":0.01900884546621029,"y":0.39534883723927383,"text":"婆羅門內部其實非常多元。不同支系","x":0.5360824696994614},{"y":0.3764534886727767,"width":0.4164948236374629,"height":0.019012506422528164,"text":"對新的思想和信仰議題表現出開放的態度。.","x":0.05360826162456751},{"height":0.018980776532971477,"text":"之間在宗教觀念和實踐上存在差異，","y":0.3735465118123117,"width":0.42061854771205354,"x":0.5360824829274783},{"width":0.42474227178664437,"text":"信仰光譜也相當廣泛，有人是虔誠的","y":0.35174418655786777,"height":0.020348836352703015,"x":0.5360824753879738},{"y":0.3299418602275651,"width":0.42474227178664437,"x":0.5360824700173308,"height":0.02186334563542769,"text":"印度教徒，也有人傾向世俗主義，甚"},{"x":0.053608250675417746,"width":0.2989690689813523,"height":0.02350965575146935,"y":0.31821998289461007,"text":"•人口：48, 000, 000"},{"x":0.5360824753879738,"y":0.30940386201944936,"width":0.42474227178664437,"height":0.019084510034517943,"text":"至不信奉任何宗教。因此，很難用單"},{"y":0.2848837208138054,"height":0.022001249664076017,"width":0.22886597769601003,"x":0.12164948347158261,"text":"（截至2025年8月）"},{"text":"一標準來描述整個婆羅門群體。","x":0.529896919167731,"height":0.01909427258469898,"width":0.37113400413876496,"y":0.2877906978588234},{"width":0.2350515456426711,"height":0.02183039462636438,"y":0.24853064669993796,"x":0.05360824910306304,"text":"• 宗教：印度教"},{"x":0.5360824758936193,"text":"若要與婆羅門建立有意義的對話，理","height":0.018942944248817595,"y":0.24559193942094437,"width":0.42474227178664437},{"y":0.22376154493053502,"height":0.018971013182056295,"text":"解他們所重視的價值觀十分重要，例","x":0.5360824758936193,"width":0.42474227178664437},{"text":"• 語言：印地語，方言","y":0.21366279105329955,"height":0.020348836352703015,"x":0.05360824780822605,"width":0.32783504667736235},{"text":"如紀律、自我修養、學習精神以及對","width":0.42474227178664437,"height":0.018999082115295107,"y":0.2019311504128728,"x":0.5360824750087396},{"text":"• 基督徒比例：0.04%","x":0.053608249373982834,"width":0.31752577282133554,"height":0.020570948782535736,"y":0.17716204877932196},{"text":"智慧的追求。對於這個群體而言，許","y":0.18010075550188887,"width":0.42474227178664425,"x":0.5360824698111453,"height":0.020570948782535736},{"height":0.020570948782535625,"x":0.5360824834511321,"text":"多適用於邊緣或弱勢群體的福音策","y":0.1582703606481075,"width":0.3938144138881138},{"y":0.14098837259399744,"text":"• 新約聖經：已有","x":0.053608253030615685,"height":0.020348836352703015,"width":0.2680412292480469},{"height":0.01892951994158465,"y":0.13808139553324206,"text":"略，往往未必能夠產生相同效果，因","x":0.536082481725711,"width":0.42061854771205365},{"y":0.11627906995184678,"x":0.5360824766015231,"width":0.42474227178664437,"text":"此需要更具針對性、尊重和深度的交","height":0.018901451008345838},{"y":0.10453400468215812,"x":0.051546394752517835,"width":0.27010309128534227,"height":0.020570948782535736,"text":"• 全本聖經：已有"},{"width":0.10309278397333055,"height":0.019099154660523587,"x":0.5360824747290931,"y":0.09593023274254442,"text":"流方式。"}]