[{"text":"68 | 亞洲其他地區 - 達吉斯坦前沿民族群體","width":0.4371134076799665,"y":0.9664147772390093,"height":0.014693534844668399,"x":0.020618550249363852},{"y":0.9171511629751025,"width":0.3793814522879464,"x":0.5587628858972639,"height":0.01903691439944888,"text":"達吉斯坦全稱達吉斯坦共和國，"},{"y":0.9023155895204222,"width":0.10741014026460194,"text":"DAY 24","height":0.01804323941093844,"x":0.0720681250747269},{"x":0.5587628966408047,"y":0.8953488373937071,"height":0.019008845466210178,"width":0.383505140032087,"text":"是俄羅斯聯邦22個自治共和國之"},{"text":"一，位於北高加索地區，瀕臨裡","height":0.020348836352703015,"y":0.8735465119939143,"x":0.5546391734253062,"width":0.38762886410667785},{"text":"海西岸。這裡被認為是世界上民","x":0.5587628917708981,"height":0.019028371367306396,"y":0.8530646517041028,"width":0.383505140032087},{"y":0.847187237938281,"text":"亞洲其他地區","x":0.057731963913762355,"width":0.18556700206938243,"height":0.02350965575146935},{"width":0.3773195902506511,"x":0.5587628843076643,"height":0.020570948782535625,"y":0.8312342566084048,"text":"族和語言最為多元的地區之一，"},{"y":0.8094038623360187,"height":0.020570948782535736,"x":0.5587628962983894,"text":"擁有三十多種語言和十四個官方","width":0.383505140032087},{"width":0.34869646344866073,"height":0.04174409445146865,"text":"達吉斯坦前沿","x":0.05967238817303783,"y":0.7930814412205967},{"y":0.7892441860855676,"x":0.5587628911621597,"text":"認可的民族群體。其中許多語言","width":0.38350514003208713,"height":0.01890023068957325},{"width":0.383505140032087,"y":0.7674223338114262,"x":0.558762891504575,"text":"僅在山區小型社群中使用，並在","height":0.018914875315578894},{"y":0.7485306467995558,"width":0.22886597769601003,"height":0.04072208228379526,"x":0.06391752756952074,"text":"民族群體"},{"width":0.3793814522879464,"height":0.02197684168715519,"y":0.7441860465492013,"text":"數百年的歷史中得以保存至今。","x":0.5587628848133168},{"x":0.04655463451449331,"text":"FPGs in Dagestan","height":0.03875169345653928,"y":0.7044855371228274,"width":0.4016717819940476},{"height":0.01901372674130075,"width":0.383505140032087,"y":0.7034883722683437,"text":"儘管民族眾多、語言各異，達吉","x":0.5587628962983894},{"width":0.38350514003208713,"height":0.020348836352703126,"x":0.5587628960320663,"y":0.681686047004527,"text":"斯坦各族群卻擁有彼此交織的歷"},{"y":0.6582703613926804,"x":0.5587628900664308,"text":"史。到了十五世紀，伊斯蘭教已","width":0.383505140032087,"height":0.02350965575146935},{"width":0.383505140032087,"height":0.020570948782535736,"x":0.5587628962983894,"text":"經成為當地主要信仰，並逐漸與","y":0.6393786730094642},{"width":0.383505140032087,"x":0.5587628966408047,"y":0.617548278484448,"height":0.020570948782535736,"text":"各民族原有傳統融合。十八世紀"},{"x":0.560824755139202,"y":0.5959302330591136,"width":0.3814432779947916,"text":"以後，俄羅斯勢力開始進入該地","height":0.020358599703618196},{"height":0.020348836352703126,"text":"區；1921年，達吉斯坦成為蘇聯","y":0.5741279072354701,"width":0.383505140032087,"x":0.5587628969942657},{"text":"的一部分。1991年蘇聯解體後，","height":0.018938062172993098,"y":0.5537363562593658,"x":0.5587628821427159,"width":0.377319590250651},{"height":0.018966131106231687,"y":0.5319059617533834,"width":0.38350514003208713,"x":0.5587628911621597,"text":"當地長期面臨政治不穩和貪腐問"},{"text":"題。在車臣戰爭期間及21世紀","width":0.35670104253859747,"height":0.020570948782535736,"y":0.5100755668791693,"x":0.5587628830219383},{"y":0.4898255815676412,"text":"初，達吉斯坦也曾遭受武裝極端","height":0.018990539083152513,"x":0.5587628939309445,"width":0.38556700206938244},{"height":0.020348836352703015,"x":0.558762890705606,"text":"主義活動的衝擊。俄羅斯政府表","y":0.46802325616957874,"width":0.383505140032087},{"height":0.020348836352703015,"text":"示，這些活動至2017年前後已大","y":0.44622093058818335,"x":0.558762891504575,"width":0.383505140032087},{"height":0.011807304785894313,"text":"Photo Source: Wikipedia","y":0.42569269515642805,"x":0.26391752905490845,"width":0.18762886410667778},{"y":0.4256926951287221,"x":0.5587628845131318,"text":"致受到控制。","width":0.16082474844796324,"height":0.01907474668360276},{"text":"•","x":0.05360824741628478,"height":0.01453488379541712,"y":0.3793604652243844,"width":0.016494845208667563},{"y":0.3822674422160903,"x":0.558762891504575,"width":0.383505140032087,"height":0.020348836352703015,"text":"如今，達吉斯坦大多數居民信奉"},{"x":0.10309278858824275,"text":"人口：3,182,054","width":0.2391752515520368,"y":0.37489504653728434,"height":0.02350965575146935},{"y":0.3618807725423293,"text":"伊斯蘭教。不同民族雖然保有各","x":0.5587628962983894,"width":0.383505140032087,"height":0.018933180897902413},{"y":0.3400503775090101,"height":0.020570948782535736,"text":"（截至2025年8月）","x":0.11958763475401314,"width":0.23298968360537575},{"height":0.018961249831141114,"width":0.383505140032087,"text":"自的語言、文化和傳統，卻因共","x":0.5608247523109078,"y":0.3400503779952514},{"x":0.5587628789419374,"height":0.020570948782535736,"text":"同的宗教信仰而能夠和平共處。","y":0.31821998289263187,"width":0.3793814522879465},{"text":"• 宗教：伊斯蘭教","x":0.05360824592090274,"y":0.3037790696267899,"width":0.27010309128534227,"height":0.021997588707758142},{"text":"首府馬哈奇卡拉是當地重要的伊","x":0.5587628960320663,"y":0.29796511646347457,"height":0.01899542115897712,"width":0.38350514003208713},{"width":0.38350514003208713,"x":0.5587628960320663,"text":"斯蘭文化中心。此外，當地也居","y":0.2761627908820792,"height":0.01896735222573842},{"x":0.0536082439231708,"width":0.32164949689592637,"text":"• 基督徒比例：0.01%","y":0.2674223337922077,"height":0.02183039462636438},{"y":0.25436046516441924,"width":0.383505140032087,"x":0.558762891504575,"height":0.01893928329249972,"text":"住著山區猶太人和哥薩克基督徒"},{"height":0.017441860874794157,"x":0.5690721761780402,"width":0.37113400413876485,"text":"（Christian Cossacks）。雖然","y":0.23255813918469592},{"x":0.5587628962983894,"height":0.019097934341751,"y":0.21200671677289962,"text":"持續受到外來文化和政治力量的","width":0.383505140032087},{"y":0.19040697679232632,"width":0.383505140032087,"text":"影響，各民族仍努力維護自己的","height":0.019080848277465923,"x":0.558762891504575},{"width":0.38556700206938244,"y":0.16860465121093082,"text":"語言和傳統，因此族群認同十分","x":0.5587628883080923,"height":0.019052779344227222},{"text":"強烈。","width":0.07835051218668632,"x":0.5587628887262445,"height":0.01895636855605065,"y":0.14819479418650683}]