[{"x":0.02061856045048441,"y":0.9664147773739761,"height":0.014693534844668288,"text":"50| 印度- 馬拉塔人","width":0.2103092738560268},{"text":"馬拉塔人是印度馬哈拉斯特拉邦極","x":0.5587628874349605,"height":0.018969792863283708,"y":0.9302325583530094,"width":0.4020618620372953},{"x":0.07006283457018106,"height":0.017684678687056476,"text":"DAY 17","width":0.10523515428815569,"y":0.9039483582566982},{"width":0.3958762759254093,"x":0.5587628969238932,"text":"具影響力的群體，屬於自我認同強","height":0.020348836352703015,"y":0.9084302330445787},{"y":0.8879093201767577,"text":"烈的剎帝利階層，主要使用馬拉地","width":0.3938144138881139,"height":0.019067423970232866,"x":0.5587628983365844},{"y":0.8660789255258591,"text":"語。他們主要分佈於馬拉塔瓦達地","height":0.019095492903471567,"x":0.5587628936873863,"width":0.3938144138881138},{"y":0.847187237250596,"height":0.02350965575146935,"x":0.06185567010009705,"width":0.06185567038399833,"text":"印度"},{"y":0.8444767447415263,"text":"區，也有部分人口居住在與卡納塔","width":0.3938144138881138,"x":0.5587628970379017,"height":0.020348836352703126},{"text":"克邦接壤的邊境地帶；另有少數馬","height":0.020348836352703015,"y":0.8226744191201601,"width":0.3958762759254093,"x":0.5587628969238932},{"y":0.8022670022749968,"x":0.5587628919920673,"text":"拉塔人居住在巴基斯坦。","width":0.28659793308803017,"height":0.018953927918505475},{"x":0.06382913946381727,"width":0.27234171912783667,"text":"馬拉塔人","height":0.04846602503138364,"y":0.7889937324053952},{"text":"在傳統鄉村社會中，馬拉塔人大多","y":0.7601744188098201,"width":0.4020618620372953,"height":0.01900274307161287,"x":0.5587628862862124},{"y":0.7383720932076605,"x":0.5587628862862124,"height":0.01897467413837428,"width":0.4020618620372953,"text":"處於較高的社會階層。許多人屬於"},{"width":0.3227161589122954,"height":0.04640412670939431,"x":0.05926047848282123,"text":"Mahratta","y":0.7333386343424608},{"x":0.5587628969238932,"height":0.01894660520513547,"y":0.7165697676262652,"text":"昆比（農民）階層，大多數農村家","width":0.3958762759254093},{"x":0.5587628986100667,"y":0.6947674420539542,"height":0.01891853627189677,"width":0.3938144138881139,"text":"庭擁有自己的土地，並以農業為主"},{"y":0.672963895660537,"width":0.3938144138881139,"x":0.5587628986100667,"text":"要生計。他們的土地通常足以同時","height":0.020350057472209748},{"text":"種植經濟作物和糧食作物，因此整","width":0.3938144138881139,"y":0.6526162792541722,"x":0.5587628983365844,"height":0.019088170990835818},{"text":"體經濟狀況相對穩定。","width":0.2577319553920201,"y":0.6308139535365123,"x":0.5587628866725468,"height":0.019060102057597117},{"width":0.38350514003208713,"x":0.5587628960320663,"height":0.018977114775919457,"y":0.5885810247199084,"text":"與印度部分傳統群體相比，馬拉塔人"},{"x":0.5587628966408047,"width":0.383505140032087,"y":0.5667506294045401,"height":0.019005184509892414,"text":"的社會觀念較為開放。例如，雖然婚"},{"y":0.5449202351960933,"text":"姻仍受家庭影響，但包辦婚姻並非絕","x":0.5587628966408047,"width":0.383505140032087,"height":0.020570948782535625},{"x":0.5587628977673129,"height":0.018951486480226043,"width":0.3587628682454427,"y":0.5247093025099863,"text":"對要求；若對象是婆羅門或馬拉塔"},{"y":0.5188916877382789,"width":0.1917525700160435,"height":0.01017807953303651,"x":0.2597938200022875,"text":"Photo Source: Wikimedia"},{"y":0.5029069769285908,"width":0.383505140032087,"text":"人，年輕人通常有較大的自主選擇空","height":0.018923417546987453,"x":0.5587628977365338},{"text":"間。他們對其他文化也表現出一定程","height":0.020348836352703015,"y":0.48110465179457873,"width":0.383505140032087,"x":0.5587628940251936},{"x":0.5587628979957312,"y":0.46075581422267997,"width":0.3814432779947916,"height":0.01909305226592628,"text":"度的包容。然而，由於普遍認同自己"},{"height":0.024911794013880884,"y":0.4454193498706631,"text":"•口：36,204,000","x":0.053242142246548545,"width":0.3016908373151507},{"width":0.38350514003208713,"height":0.01906498333268769,"y":0.43895348855649774,"x":0.5587628960320663,"text":"屬於較高種姓，不少馬拉塔人仍傾向"},{"height":0.020570948782535625,"text":"（截至2025年8月）","y":0.41267842150296163,"x":0.12371134320157054,"width":0.22680411565871464},{"width":0.3793814522879465,"text":"輕視那些被視為社會地位較低的人。","x":0.5587628844745833,"height":0.020348836352703126,"y":0.4171511632916717},{"text":"對於許多中產階級馬拉塔家庭而言，","y":0.39534883743411364,"x":0.5587628815261299,"height":0.020348836352703015,"width":0.3793814522879464},{"y":0.37645348837981807,"text":"• 宗教：印度教","height":0.021951213391461666,"x":0.05360825200748673,"width":0.2391752515520368},{"x":0.5587628977365338,"width":0.383505140032087,"y":0.37489504636408566,"height":0.019000302434067695,"text":"為自己和下一代爭取穩定而有保障的"},{"height":0.019028371367306396,"text":"未來是人生的重要目標，因此經濟成","y":0.35306465184945157,"x":0.5587628966408047,"width":0.383505140032087},{"x":0.05360824666660726,"width":0.27010309128534227,"text":"• 語言：馬拉地語","y":0.33866279119093656,"height":0.023255813432080163},{"x":0.5587628865092901,"y":0.33123425684027064,"text":"就和社會地位往往受到高度重視。","width":0.35463918050130205,"height":0.020570948782535736},{"text":"• 基督徒比例：0.00%","y":0.30377906979333547,"x":0.05567010209388037,"width":0.31958763485863095,"height":0.021997588707758142},{"y":0.289244186218804,"x":0.5587628970973584,"width":0.38350514003208713,"height":0.018900229888839215,"text":"大多數馬拉塔人信奉印度教，視濕婆"},{"x":0.055670106542895836,"text":"• 新約聖經：已有","y":0.26889534885401845,"height":0.02180232569312568,"width":0.2701030912853422},{"text":"神為家族守護神，並尊崇十七世紀著","height":0.020570948782535625,"x":0.5587628962983894,"y":0.2674223342642601,"width":0.383505140032087},{"width":0.3938144138881139,"x":0.5587628983365844,"height":0.019069864607778153,"text":"名的馬拉塔領袖希瓦吉（Shivaji）為","y":0.24709302344021877},{"y":0.23383711177229527,"width":0.27010309128534227,"height":0.02197684168715519,"text":"• 全本聖經：已有","x":0.05360824592090274},{"width":0.3608247302827381,"height":0.019041795674539452,"y":0.22529069784671096,"text":"民族英雄。許多人也將土地視為母","x":0.5587628955974625},{"text":"親，對自己的土地、語言、歷史和文","width":0.38556700206938255,"height":0.01901372674130064,"y":0.20348837213207915,"x":0.5567010311921129},{"x":0.5587628910148844,"width":0.383505140032087,"text":"化懷有強烈認同感，並積極維護這些","y":0.18168604677035394,"height":0.020348836352703015},{"y":0.16120906800826307,"text":"傳統。","height":0.019023490092215822,"width":0.06804123833065945,"x":0.5587628863673163}]