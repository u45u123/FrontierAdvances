[{"height":0.014693534844668399,"y":0.9664147773843581,"text":"48| 印度- 庫爾米人","x":0.020618561186284877,"width":0.21649484180268785},{"text":"庫爾米人是分佈於印度和尼泊","width":0.3814432779947917,"x":0.5587628947010578,"height":0.018916095634351482,"y":0.9403862297717234},{"y":0.9185558352601174,"width":0.383505140032087,"x":0.558762890705606,"height":0.018944164567590183,"text":"爾的重要農業種姓群體，在孟"},{"height":0.018805309266827885,"text":"DAY 16","y":0.9033880431222068,"x":0.07400770149899683,"width":0.10559284573509581},{"y":0.8967254411952891,"text":"加拉和巴基斯坦也有少量人口。","width":0.40618554978143595,"x":0.5587628985972545,"height":0.020570948782535625},{"x":0.5587628962983894,"height":0.019012506422528053,"text":"在印度，庫爾米人主要居住於","width":0.383505140032087,"y":0.8764534885474135},{"x":0.5587628981137002,"y":0.8546511629751025,"text":"北方邦、比哈爾邦邦、中央邦、","width":0.40618554978143606,"height":0.018984437489289352},{"text":"印度","y":0.8488372093191348,"x":0.06804123831299096,"height":0.02185968387837578,"width":0.05979381288800921},{"y":0.8328488377102764,"text":"旁遮普邦、賈坎德邦、阿薩姆","x":0.5587628962983894,"height":0.020348836352703015,"width":0.383505140032087},{"height":0.019052779344227222,"text":"邦以及西孟加拉邦部分地區。","y":0.8123425694418138,"x":0.5587628852649614,"width":0.3793814522879465},{"height":0.051080066351005704,"text":"庫爾米人","x":0.0615591616854774,"y":0.78695996755186,"width":0.274819819132487},{"height":0.019080848277465923,"y":0.7905121749483764,"width":0.3814432779947916,"text":"其中，僅北方邦的庫爾米人口","x":0.5587628994690991},{"y":0.7688953490959354,"text":"便超過五百萬。庫爾米人被認為","x":0.5587628961007949,"width":0.383505140032087,"height":0.020357379384845498},{"text":"是印度歷史最悠久的農業種姓之","y":0.7485306468584492,"width":0.383505140032087,"height":0.018911213558526874,"x":0.5587628962983894},{"text":"Kurmi","height":0.040773337273713794,"x":0.06804124196592608,"y":0.7354651172325682,"width":0.23298968360537575},{"height":0.018939282491765685,"text":"一。他們使用庫爾馬利語，這是","x":0.5525773140929618,"width":0.38969072614397327,"y":0.7267002522196628},{"text":"一種擁有多種方言的語言。在西","x":0.5525773145568794,"height":0.020570948782535736,"y":0.7048698572191338,"width":0.38969072614397327},{"y":0.6845930234311344,"x":0.5587628962983894,"width":0.383505140032087,"text":"孟加拉邦，庫爾馬利語通常以孟","height":0.019017387697618626},{"x":0.5587628937640251,"y":0.6612090680825844,"text":"加拉文字書寫；在賈坎德邦則使","width":0.38350514003208713,"height":0.020570948782535625},{"x":0.5587628947010578,"width":0.3814432779947917,"y":0.6409883724486485,"text":"用天城文；在奧迪沙則多採用","height":0.020348836352703015},{"text":"奧利亞文字。","height":0.019698595420139187,"x":0.5586661713505333,"width":0.15483260381789432,"y":0.620237911515523},{"width":0.383505140032087,"y":0.5768261962301187,"height":0.020570948782535625,"x":0.5587628932004512,"text":"庫爾米人大多信奉印度教。他"},{"height":0.01907474668360276,"text":"們主要敬拜羅摩，這位被視為","y":0.5552325583239397,"x":0.5587628966408047,"width":0.383505140032087},{"y":0.5334302327965141,"width":0.1917525700160435,"height":0.010230556443196037,"x":0.2639175326208441,"text":"Photo Source: Wikimedia"},{"width":0.3773195902506511,"height":0.020348836352703015,"y":0.5334302329137648,"x":0.5587628829287983,"text":"理想君王與完美人格的化身，"},{"y":0.5130142739879924,"x":0.5587628962983894,"width":0.383505140032087,"height":0.018962470149913813,"text":"象徵公義、德行與達摩；同時"},{"x":0.558762890705606,"width":0.383505140032087,"text":"也敬拜毗濕奴，即印度教的主","y":0.491183878852929,"height":0.020570948782535736},{"height":0.020570948782535625,"y":0.4693534845563183,"width":0.38350514003208713,"text":"要神祇之一。此外，他們也敬","x":0.5587628916923512},{"text":"• 人口：15, 630, 000","x":0.05360824972384785,"y":0.4475230901523427,"width":0.2969072069440569,"height":0.021953654029006953},{"width":0.383505140032087,"y":0.44912790715206463,"x":0.5587628962983894,"text":"拜迦梨、難近母和哈努曼等神","height":0.0189661311062318},{"y":0.4273255814344048,"width":0.38350514003208713,"height":0.018938062172992987,"x":0.5587628911621597,"text":"明。他們重視宗教節慶，每年都"},{"y":0.4142441861723325,"text":"（截至2025年8月）","width":0.22886597769601003,"height":0.021943890678091882,"x":0.12164948384958953},{"y":0.40552325631492747,"x":0.5587628962983894,"width":0.383505140032087,"text":"會慶祝排燈節、灑紅節、濕婆節","height":0.020348836352703126},{"text":"和十勝節等重要印度教節日。","height":0.019099154660523587,"x":0.5587628936950139,"y":0.38497061274228095,"width":0.33814432053338916},{"y":0.3778337528181205,"text":"• 宗教：印度教","width":0.23711338951474142,"height":0.021875549623888157,"x":0.05360825567218252},{"text":"•語言：印地語","y":0.3415697678055606,"x":0.053608246491379234,"width":0.2350515456426711,"height":0.020348836352703126},{"height":0.019051559025454523,"y":0.34156976756812574,"x":0.5587628945735561,"width":0.38556700206938244,"text":"基督信仰在庫爾米人當中仍極為"},{"text":"少數。絕大多數庫爾米人堅持印","x":0.5587628931111043,"y":0.3197674424583383,"width":0.38350514003208713,"height":0.020348836352703126},{"y":0.3052057092511803,"x":0.05567010530067241,"height":0.02183039462636449,"text":"• 基督徒比例：0.01%","width":0.3175257728213356},{"x":0.5587628962983894,"height":0.020348836352703015,"text":"度教信仰，僅有極少數人成為基","width":0.383505140032087,"y":0.2979651167800438},{"width":0.3793814522879465,"text":"督徒。根據約書亞計畫的資料，","height":0.01901372674130075,"x":0.5587628844745833,"y":0.2774979011175358},{"y":0.27162048722962107,"width":0.2659793853759766,"text":"• 新約聖經：已有","x":0.0556700994640736,"height":0.020570948782535736},{"height":0.020570948782535736,"y":0.25566750598247245,"x":0.558762891504575,"width":0.383505140032087,"text":"庫爾米人擁有強烈的印度教身分"},{"text":"• 全本聖經：已有","y":0.23677581889424015,"width":0.26597938537597654,"x":0.05567009964878148,"height":0.020570948782535625},{"text":"認同，同時也承受來自家庭、社","height":0.020570948782535625,"x":0.5587628962983894,"y":0.23383711161318732,"width":0.383505140032087},{"x":0.558762891504575,"text":"區和社會的壓力，使他們傾向繼","width":0.383505140032087,"height":0.020570948782535625,"y":0.21200671695320428},{"width":0.2061855679466611,"x":0.5587628874184221,"text":"續維持傳統信仰。","y":0.191855583215775,"height":0.01890023068957325}]