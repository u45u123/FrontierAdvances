[{"height":0.01473258744759487,"text":"26| 阿拉伯世界 - 阿拉伯語阿爾及利亞人","x":0.0206185710335022,"y":0.9651162791051984,"width":0.4164948236374628},{"x":0.5587628867648575,"width":0.4020618620372953,"height":0.020348836352703015,"y":0.9331395354089198,"text":"阿爾及利亞的阿拉伯人可追溯至西"},{"height":0.01900762514743748,"x":0.5587628867648575,"y":0.9126784213372469,"width":0.4020618620372953,"text":"元七世紀的阿拉伯擴張時期。隨著"},{"text":"DAY 06","x":0.06996782851064712,"y":0.900739861242083,"height":0.0182877195471981,"width":0.10748702457972936},{"x":0.5587628862862124,"height":0.018977114775919457,"text":"伊斯蘭教在阿拉伯半島興起並迅速","width":0.4020618620372953,"y":0.892441860649521},{"text":"向外傳播，阿拉伯文化和語言逐漸","x":0.5587628793937234,"y":0.8706395349227769,"width":0.40206186203729544,"height":0.018949045842680756},{"text":"阿拉伯世界","x":0.053608248573264135,"y":0.8488372094903553,"width":0.14845360347202846,"height":0.023255813432080052},{"text":"進入北非地區。在阿拉伯人到來之","y":0.8488372095074945,"x":0.5587628862862124,"width":0.4020618620372953,"height":0.018920976909442055},{"x":0.5587628954393573,"text":"前，北非主要由柏柏爾人","height":0.020348836352703015,"y":0.8270348842219043,"width":0.3958762759254092},{"width":0.38762886410667785,"text":"（Berbers）居住。他們擁有自己","x":0.5670103063384138,"y":0.8066860465506838,"height":0.019090611628381104},{"y":0.7877906973001717,"width":0.3402061825706845,"x":0.05567010629197731,"text":"阿拉伯語阿","height":0.049418605545005545},{"x":0.5587628957928182,"height":0.019062542695142293,"text":"的語言和獨特文化傳統。經過數個","y":0.7848837211146373,"width":0.3958762759254092},{"text":"世紀的發展，阿拉伯語和伊斯蘭文","height":0.019034473761903703,"x":0.5587628862862124,"width":0.4020618620372953,"y":0.763081395533242},{"x":0.5587628909857489,"height":0.020348836352703126,"width":0.3958762759254092,"y":0.7412790699922531,"text":"化逐漸成為社會主流，當地也經歷"},{"y":0.7338371108712026,"height":0.04959312233976909,"width":0.3402061825706845,"x":0.05773196130056839,"text":"爾及利亞人"},{"x":0.5587628911732162,"width":0.28659793308803017,"height":0.019002743071612982,"y":0.72082283828468,"text":"了長期的阿拉伯化過程。"},{"height":0.033585222502099055,"text":"Arabic-speaking","x":0.0536082447672119,"y":0.6859781690013004,"width":0.36494845435732887},{"x":0.5587628827221476,"height":0.020570948782535736,"y":0.6771620485532237,"text":"現今的阿爾及利亞阿拉伯語融合了","width":0.40206186203729544},{"text":"Algerian","x":0.053309794455509825,"height":0.033825356253648686,"width":0.19441134134928387,"y":0.654598949841248},{"text":"許多柏柏爾語言的詞彙與語法特色，","x":0.5567010312161382,"y":0.6569767445562067,"width":0.42061854771205354,"height":0.020348836352702904},{"width":0.3958762759254092,"text":"同時也吸收了其他語言的影響。除","x":0.5587628901374426,"y":0.635174418643707,"height":0.01889778925129393},{"width":0.3958762759254093,"x":0.5587628896661614,"y":0.6133501257350485,"text":"了日常使用的阿爾及利亞阿拉伯語","height":0.01891731595312418},{"width":0.4020618620372953,"y":0.5915197316702203,"x":0.5587628867648575,"height":0.020570948782535625,"text":"之外，標準阿拉伯語也廣泛用於宗"},{"width":0.4020618620372953,"text":"教、教育和官方場合；柏柏爾語至","x":0.5587628862862124,"height":0.019039355036994166,"y":0.5712209304169629},{"text":"今也仍在部分地區持續使用。","width":0.33814432053338905,"x":0.5587628885992848,"height":0.020348836352703126,"y":0.549418605249036},{"width":0.4164948236374628,"height":0.01902593072976122,"y":0.5071368597835085,"x":0.558762894484656,"text":"阿爾及利亞以遜尼派伊斯蘭教為主，"},{"text":"在宗教事務方面對非穆斯林活動設","height":0.01905399966299981,"x":0.5587628862862124,"width":0.4020618620372953,"y":0.48530646543498734},{"y":0.4634760704154246,"x":0.5587629000627119,"text":"有不少限制。近年來，基督徒群體，","width":0.4164948236374628,"height":0.020570948782535625},{"width":0.4020618620372953,"text":"尤其是柏柏爾人中的卡拜爾族","y":0.4433139536606645,"height":0.018902671327118536,"x":0.5587628867648575},{"width":0.3938144138881138,"height":0.020348836352703015,"y":0.4200581400794624,"text":"（Kabyle）信徒，面臨相當大的","x":0.5670103227672832},{"width":0.4020618620372953,"height":0.020570948782535736,"y":0.39966414783941373,"x":0.5587628862862124,"text":"壓力和逼迫。許多福音派教會已"},{"y":0.3793604652915996,"x":0.5587628954393573,"height":0.019044236312084628,"text":"被政府關閉，公開聚會和福音事工","width":0.3958762759254092},{"height":0.02008981488513706,"x":0.5585906272886767,"y":0.35696090644679557,"text":"受到限制。","width":0.12817956833612354},{"height":0.010174418176351563,"text":"Photo Source: Basel2019 - Wikimedia","width":0.2948453449067615,"x":0.15670104257239234,"y":0.3081395351523766},{"height":0.02350965575146935,"x":0.05154638957290135,"text":"• 人口：36,947,700 散居在","y":0.271620487300813,"width":0.4},{"text":"八個國家中（截至2025年8","x":0.08865979648112934,"y":0.2455919392775735,"height":0.021849921328194633,"width":0.3649484543573288},{"y":0.21788413132588047,"text":"月）","x":0.08865979471768319,"width":0.04329896654401506,"height":0.021941450040546706},{"x":0.05154639169771339,"y":0.18168604652843723,"height":0.021924364776995664,"width":0.25979381742931545,"text":"• 宗教：伊斯蘭教"},{"text":"• 語言：阿爾及利亞阿拉伯語","height":0.02350965575146935,"width":0.4185566856747582,"x":0.04948454270901266,"y":0.1452560874055896},{"y":0.11041141906694685,"x":0.05154639888218744,"height":0.021856022922057905,"width":0.3731958661760603,"text":"• 基督徒比例：少於0.01%"},{"width":0.2618556613013858,"x":0.05154639760818449,"y":0.07412790699355332,"text":"• 新約聖經：已有","height":0.02200979269621861},{"x":0.051546392585984924,"height":0.020570948782535625,"y":0.03904282113825597,"text":"• 全本聖經：無","width":0.21237113589332218}]