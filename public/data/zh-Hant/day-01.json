  "prayerPoints": [
    {
      "runs": [
        {
          "text": "求聖靈在富拉尼人中興起不被攔阻的復興運動，在非洲及世界各地興起基督門徒、",
          "bold": false
        },
        {
          "text": "屬靈領袖",
          "bold": true
        },
        {
          "text": "、牧者和宣教士。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求主差派更多充滿愛心、願意長期委身的工人服事富拉尼人。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "為恐怖主義和暴力事件的受害者禱告，求富拉尼人因福音得著自由、平安與生命的更新。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "為遭受歧視和流離失所的富拉尼難民禱告，求神供應他們一切所需，並幫助他們面對未來的挑戰。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求神感動富拉尼領袖，看見下一代接受正規教育的重要性，為年輕人開闢更美好的未來。隨著社會變遷、人口增長及資源壓力增加，富拉尼人傳統的遊牧生活方式正面臨越來越大的挑戰。",
          "bold": false
        }
      ]
    }
  ],
