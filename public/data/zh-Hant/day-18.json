  "prayerPoints": [
    {
      "runs": [
        {
          "text": "求主拆毀世世代代捆綁拉傑普特人的屬靈營壘。願錯誤的信仰、偶像崇拜和各樣攔阻人認識神的捆綁被打破，取而代之的是對耶穌基督真理的渴慕，使他們在主裡面得著真正的自由和救恩。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求主柔軟拉傑普特人的心，使他們願意領受真理。願耶穌基督的救恩信息深深觸動他們的生命；也求神透過異夢、異象和奇妙的相遇向他們顯現，使他們親自經歷主的慈愛與恩典。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求神賜給拉傑普特人",
          "bold": false
        },
        {
          "text": "謙卑的心",
          "bold": true
        },
        {
          "text": "，使他們願意接受福音。願神更新並潔淨他們的文化傳統，使其中美善的部分能夠榮耀主；也願他們在保有自身歷史傳承的同時，發現自己真正的身分乃是至高神的兒女。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求主差派屬祂的人進入拉傑普特人當中，以生命見證什麼是真正跟隨耶穌、敬拜萬王之王。願更多家庭樂意分享神的話語，渴慕尋求神的國，並以祂的旨意為生命的首要目標。",
          "bold": false
        }
      ]
    }
  ],
