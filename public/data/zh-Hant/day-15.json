  "generalInformation": [
    {
      "runs": [
        {
          "text": "印度傳說提到庫姆哈爾人是造物主梵天的後裔，因此有些人以普拉贾帕蒂(Prajapati)作為自己的姓氏。他們也認為自己是最早發明陶輪的人。庫姆哈爾人這個名字的意思是“",
          "bold": false
        },
        {
          "text": "製作陶器的人",
          "bold": true
        },
        {
          "text": "”，反映了他們世代相傳的傳統職業。他們分佈於印度各地，並使用當地的語言。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "庫姆哈爾人普遍以誠實、勤奮和重視信仰著稱。許多人靠務農、飼養牲畜，以及製作陶器和泥塑神像維生。然而，這些工作往往受季節影響，收入並不穩定，許多家庭難以僅靠傳統手工業維持生計。不少庫姆哈爾農民耕種的土地並不屬於自己，而是向較高種姓地主租用土地耕作，收成時只能獲得部分農作物作為報酬。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "庫姆哈爾人迫切需要職業技能培訓和更完善的教育資源。由於部分家庭經常遷移居住，孩子們求學經常受到影響。許多兒童為了幫助家庭維持生計，不得不提早離開學校投入工作。此外，他們也常缺乏現代醫療服務和安全潔淨的飲用水資源。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "庫姆哈爾人大多信奉印度教，主要敬拜濕婆神（Shiva）和母神瑪塔（Mata）。",
          "bold": false
        }
      ]
    }
  ],
  "scripture": [
    {
      "runs": [
        {
          "text": "“大戶人家不但有金器銀器，也有木器瓦器；有作為貴重之用的，有作為卑賤之用的。人若自潔，脫離卑賤的事，必成為貴重的器皿，成為聖潔，合乎主用，預備行各樣的善事。”",
          "bold": true
        }
      ]
    },
    {
      "runs": [
        {
          "text": "提摩太后書2:20-21",
          "bold": true
        }
      ]
    }
  ],
  "prayerPoints": [
    {
      "runs": [
        {
          "text": "求神讓庫姆哈爾人明白，他們並非只是製造陶器的人，更是神親手所造、按著祂形像而創造的人。願他們願意將生命交在主手中，讓這位陶匠繼續塑造他們，使他們成為合乎祂心意的",
          "bold": false
        },
        {
          "text": "器皿",
          "bold": true
        },
        {
          "text": "。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "感謝神賜給庫姆哈爾人誠實、勤奮和追求信仰的特質。求主使用這些美好的品格，使他們能夠反映神的性情，並在生活中見證祂的榮耀。",
          "bold": false
        }
      ]
    }
  ],
