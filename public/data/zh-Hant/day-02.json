  "generalInformation": [
    {
      "runs": [
        {
          "text": "加雷人與索馬利亞人和奧羅莫人都有深厚的歷史聯繫。傳統上，他們被視為索馬利亞氏族體系的一部分，在索馬利亞南部扮演重要角色，並參與建立巴拉韋（ Barawe）和基斯馬尤（Kismayo）等具影響力的城鎮。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "與此同時，不少加雷人，特別是居住在衣索比亞和肯亞的群體，與奧羅莫人通婚，並接受了部分奧羅莫文化和傳統。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "現今他們主要分佈於索馬利亞、衣索比亞和肯亞一帶，其族群認同和使用的語言也會因居住地區而有所不同。正因如此，許多人視他們為連接不同民族與文化的",
          "bold": false
        },
        {
          "text": "“橋樑民族”",
          "bold": true
        },
        {
          "text": "。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "加雷人的生活以社區和畜牧業為中心，主要飼養駱駝、山羊、牛和綿羊。傳統上，他們過著遊牧生活，居住在可搬遷的圓形棚屋中，牲畜則圍在營地中央。部分家庭也從事小規模貿易，以牲畜交換糧食及其他生活用品。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "加雷人大約於十五世紀歸信伊斯蘭教，現今幾乎全數為穆斯林，並嚴格遵守其信仰傳統。大多數人從未聽聞福音，而曾接觸福音的人，也往往因擔心基督信仰會削弱他們的民族認同、社區歸屬感和傳統文化，而選擇拒絕接受。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "奧羅莫加雷人的獨特之處，在於他們融合了索馬利亞和奧羅莫兩種文化傳統。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "加雷（Garre）一詞源自 索馬利亞語，意思是“用來拴住駱駝的",
          "bold": false
        },
        {
          "text": "堅固繩索",
          "bold": true
        },
        {
          "text": "”，象徵堅固的聯繫與連結；在某些方言中，這個詞也有“公義”或“我的家園”的意思。",
          "bold": false
        }
      ]
    }
  ],
  "scripture": [
    {
      "runs": [
        {
          "text": "“若遇敵攻擊，孤身難擋，二人就能抵擋他；三股合成的繩子不易折斷。”",
          "bold": true
        }
      ]
    },
    {
      "runs": [
        {
          "text": "傳道書 4:12",
          "bold": true
        }
      ]
    }
  ],
  "prayerPoints": [
    {
      "runs": [
        {
          "text": "求主耶穌將平安和力量賜給加雷人的社區，藉著三一神那股三重合成、不易折斷的繩索，將他們緊緊連結在一起。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求主讓加雷人明白，主耶穌渴望他們自己、家族和社區都能與祂建立關係",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求主差派工人進入加雷人當中，與他們建立真誠而長久的友誼，在信任中分享神的話語。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求主加給加雷信徒智慧，知道如何向家人和朋友傳講神的話。成為這片多元地區中福音的",
          "bold": false
        },
        {
          "text": "橋樑",
          "bold": true
        },
        {
          "text": "和使者。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求神感動加雷人中的領袖敞開心門，願意參與家庭查經聚會，認識神的慈愛與救恩",
          "bold": false
        }
      ]
    }
  ],
