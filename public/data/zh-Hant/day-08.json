  "prayerPoints": [
    {
      "runs": [
        {
          "text": "願神的光照進蘇丹的動盪與混亂之中。求主憐憫這片土地和其中的百姓，在戰亂、貧窮和不安中賜下平安與盼望。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求主賜給蘇丹教會和信徒異象與勇氣，使他們成為身邊蘇丹阿拉伯人的光，在生活中見證基督的愛與真理。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求神使蘇丹阿拉伯人渴慕光明與真理，並遇見那位世界的光──耶穌基督。願主透過異夢、異象和各樣方式向尋求祂的人顯現，也引導他們主動接觸基督徒，尋求禱告和幫助。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求主打發更多工人進入這片莊稼已經成熟的禾場，並賜下從祂而來的智慧和策略，使他們能夠有效地接觸並服事蘇丹阿拉伯人。",
          "bold": false
        }
      ]
    }
  ],
