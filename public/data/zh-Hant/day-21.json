  "generalInformation": [
    {
      "runs": [
        {
          "text": "泰利人是印度傳統的",
          "bold": false
        },
        {
          "text": "榨油",
          "bold": true
        },
        {
          "text": "種姓群體，其名稱源自梵語中“油”的詞彙。在傳統種姓體系中，他們通常被歸為四大種姓中的第三階層。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "隨著榨油產業逐漸機械化，許多泰利人已不再從事傳統行業，而轉向農業和勞力工作。由於不少家庭沒有自己的土地，一些泰利人申請登記為“其他落後階層”，以獲得政府提供的相關補助與支援。與此同時，也有部分泰利人進入商業、政府部門和政治領域發展。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "泰利人廣泛分佈於印度各地，在孟加拉、尼泊爾、斯里蘭卡和巴基斯坦也有少量人口。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "在家庭和社會生活方面，泰利人大多在本族群內部通婚，婚姻通常由長輩安排，並以現金或貴重物品作為嫁妝。雖然女性的社會地位普遍較低，但她們在宗教活動和社區事務中扮演重要角色，也經常透過各種副業補貼家庭收入。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "泰利人大多信奉印度教，並保有與婚禮、生育和喪葬相關的",
          "bold": false
        },
        {
          "text": "傳統宗教儀式",
          "bold": true
        },
        {
          "text": "。他們通常將逝者火化，並將骨灰撒入被視為神聖的河流之中。他們重視祖先崇拜，同時尋求保佑與抵擋邪靈侵擾。在信仰實踐上，泰利人往往較為務實。他們特別敬拜一位被認為能夠實現人願望的女神，並相信這位神祇會回應他們的祈求。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "雖然泰利人普遍不屬於最貧困的群體，但他們在教育和職業發展方面仍受到許多限制。更重要的是，他們需要有人將福音帶給他們，使他們有機會認識復活的主耶穌基督，並願意跟隨祂、領受祂所賜的新生命。",
          "bold": false
        }
      ]
    }
  ],
  "scripture": [
    {
      "runs": [
        {
          "text": "“華冠代替灰燼， 喜樂的油 代替悲哀，讚美為衣代替憂傷的靈；”",
          "bold": true
        }
      ]
    },
    {
      "runs": [
        {
          "text": "以賽亞書 61:3",
          "bold": true
        }
      ]
    }
  ],
  "prayerPoints": [
    {
      "runs": [
        {
          "text": "求泰利人能夠遇見復活的主耶穌，以祂所賜的",
          "bold": false
        },
        {
          "text": "喜樂之油",
          "bold": true
        },
        {
          "text": "代替憂傷的灰塵，在基督裡得著新的生命與真正的盼望。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求神興起更多本地信徒，在泰利人當中分享福音；也求主堅固那些已經跟隨耶穌的人，使他們即使面對壓力和反對，仍有勇氣堅定持守信仰。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "為泰利婦女禱告，願她們在基督裡找到真正的平安、自由和盼望，也經歷神對她們家庭的祝福。求主讓她們在家庭和社會中的重要貢獻得到應有的尊重與肯定。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求泰利人學習從耶穌基督而非其他屬靈力量尋求保護。願他們對邪靈和未知力量的懼怕，被對神的信靠與讚美所取代，在主裡面享受平安與自由。",
          "bold": false
        }
      ]
    }
  ],
