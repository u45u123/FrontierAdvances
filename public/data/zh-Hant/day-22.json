  "prayerPoints": [
    {
      "runs": [
        {
          "text": "求神賜福亞達夫人，使那些行走在黑暗中的人得見祂的大光，並認識耶穌基督所帶來的救恩與盼望。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求主引導亞達夫人遇見願意向他們分享神話語和基督之愛的人，並帶領他們進入門徒群體，在團契中認識主、跟隨主。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求神興起亞達夫背景的音樂家、歌手和創作人，用他們熟悉的口傳文化、",
          "bold": false
        },
        {
          "text": "詩歌和群體歌唱方式傳",
          "bold": true
        },
        {
          "text": "揚福音，使福音信息能夠廣泛傳遍整個族群。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "為年輕的亞達夫人禱告。願他們在尋求未來出路的過程中，不但找到合適的工作機會，也因此遇見耶穌基督，並在祂裡面找到生命真正的方向。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "為那些正逐漸歸向耶穌的家庭和村莊禱告。求主賜給他們勇氣、盼望、忍耐和喜樂",
          "bold": false
        },
        {
          "text": ".",
          "bold": true
        }
      ]
    }
