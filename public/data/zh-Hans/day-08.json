  "prayerPoints": [
    {
      "runs": [
        {
          "text": "愿",
          "bold": false
        },
        {
          "text": "神的光",
          "bold": true
        },
        {
          "text": "照进苏丹的动荡与混乱之中。求主怜悯这片土地和其中的百姓，在战乱、贫穷和不安中赐下平安与盼望。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求主赐给苏丹教会和信徒异象与勇气，使他们成为身边苏丹阿拉伯人的光，在生活中见证基督的爱与真理。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求神使苏丹阿拉伯人渴慕光明与真理，并遇见那位世界的光──耶稣基督。愿主透过异梦、异象和各样方式向寻求祂的人显现，也引导他们主动接触基督徒，寻求祷告和帮助。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求主打发更多工人进入这片庄稼已经成熟的禾场，并赐下从祂而来的智慧和策略，使他们能够有效地接触并服事苏丹阿拉伯人。",
          "bold": false
        }
      ]
    }
