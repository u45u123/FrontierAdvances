  "generalInformation": [
    {
      "runs": [
        {
          "text": "泰利人是印度传统的",
          "bold": false
        },
        {
          "text": "榨油种姓",
          "bold": true
        },
        {
          "text": "群体，其名称源自梵语中“油”的词汇。在传统种姓体系中，他们通常被归为四大种姓中的第三阶层。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "随着榨油产业逐渐机械化，许多泰利人已不再从事传统行业，而转向农业和劳力工作。由于不少家庭没有自己的土地，一些泰利人申请登记为“其他落后阶层”，以获得政府提供的相关补助与支持。与此同时，也有部分泰利人进入商业、政府部门和政治领域发展。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "泰利人广泛分布于印度各地，在孟加拉国、尼泊尔、斯里兰卡和巴基斯坦也有少量人口。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "在家庭和社会生活方面，泰利人大多在本族群内部通婚，婚姻通常由长辈安排，并以现金或贵重物品作为嫁妆。虽然女性的社会地位普遍较低，但她们在宗教活动和社区事务中扮演重要角色，也经常透过各种副业补贴家庭收入。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "泰利人大多信奉印度教，并保有与婚礼、生育和丧葬相关的",
          "bold": false
        },
        {
          "text": "传统宗教仪式",
          "bold": true
        },
        {
          "text": "。他们通常将逝者火化，并将骨灰撒入被视为神圣的河流之中。他们重视祖先崇拜，同时寻求保佑与抵挡邪灵侵扰。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "在信仰实践上，泰利人往往较为务实。他们特别敬拜一位被认为能够实现人愿望的女神，并相信这位神祇会回应他们的祈求。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "虽然泰利人普遍不属于最贫困的群体，但他们在教育和职业发展方面仍受到许多限制。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "更重要的是，他们需要有人将福音带给他们，使他们有机会认识复活的主耶稣基督，并愿意跟随祂、领受祂所赐的新生命。",
          "bold": false
        }
      ]
    }
  ],
  "scripture": [
    {
      "runs": [
        {
          "text": "“华冠代替灰烬，喜乐的油代替悲哀，赞美为衣代替忧伤的灵”",
          "bold": true
        }
      ]
    },
    {
      "runs": [
        {
          "text": "以赛亚书 61:3",
          "bold": true
        }
      ]
    }
  ],
  "prayerPoints": [
    {
      "runs": [
        {
          "text": "求泰利人能够遇见复活的主耶稣，以祂所赐的 ",
          "bold": false
        },
        {
          "text": "喜乐油",
          "bold": true
        },
        {
          "text": "代替忧伤的灰尘，在基督里得着新的生命与真正的盼望。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求神兴起更多本地信徒，在泰利人当中分享福音；也求主坚固那些已经跟随耶稣的人，使他们即使面对压力和反对，仍有勇气坚定持守信仰。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "为泰利妇女祷告，愿她们在基督里找到真正的平安、自由和盼望，也经历神对她们家庭的祝福。求主让她们在家庭和社会中的重要贡献得到应有的尊重与肯定。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求泰利人学习从耶稣基督而非其他属灵力量寻求保护。愿他们对邪灵和未知力量的惧怕，被对神的信靠与赞美所取代，在主里面享受平安与自由。",
          "bold": false
        }
      ]
    }
  ],
