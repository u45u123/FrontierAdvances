      "runs": [
        {
          "text": "求神眷顾卡拉尔伊迪加人群体，使他们经历从神而来的自由、医治、供应和盼望，并在",
          "bold": false
        },
        {
          "text": "福音",
          "bold": true
        },
        {
          "text": "中重拾尊严， ",
          "bold": false
        },
        {
          "text": "领受祂无条件的爱",
          "bold": true
        },
        {
          "text": "。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求主开启更多卡拉尔．伊迪加人的心，使他们认识耶稣基督，并愿意信靠祂为生命的主和救主。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
