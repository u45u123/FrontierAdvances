  "prayerPoints": [
    {
      "runs": [
        {
          "text": "求神赐福亚达夫人，使那些行走在黑暗中的人得见祂的大光，并认识耶稣基督所带来的救恩与盼望。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求主引导亚达夫人遇见愿意向他们分享神话语和基督之爱的人，并带领他们进入门徒群体，在团契中认识主、跟随主。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求神兴起亚达夫背景的音乐家、歌手和创作人，用他们熟悉的口传文化、诗歌和群体",
          "bold": false
        },
        {
          "text": "歌唱",
          "bold": true
        },
        {
          "text": "方式传扬",
          "bold": false
        },
        {
          "text": "福音",
          "bold": true
        },
        {
          "text": "，使福音信息能够广泛传遍整个族群。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "为年轻的亚达夫人祷告。愿他们在寻求未来出路的过程中，不但找到合适的工作机会，也因此遇见耶稣基督，并在祂里面找到生命真正的方向。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "为那些正逐渐归向耶稣的家庭和村庄祷告。求主赐给他们勇气、盼望、忍耐和喜乐",
          "bold": false
        }
      ]
    }
  ],
