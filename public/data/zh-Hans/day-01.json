  "generalInformation": [
    {
      "runs": [
        {
          "text": "富拉尼人是世界上最大的游",
          "bold": false
        },
        {
          "text": "牧民族",
          "bold": true
        },
        {
          "text": "。过去一千多年来，他们对西非的政治、贸易和宗教发展都产生了深远影响。作为西非最早接受伊斯兰教的民族之一，他们透过数次圣战推动伊斯兰教的传播，并于十九世纪建立了强盛的富拉尼帝国。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "富拉尼人在各地有不同名称。豪萨语称他们为 Fulani 或 Fula；法语地区多称为 Peul 或 Peulh；英语文献常见 Fulbe；而在乍得和苏丹，则常被称为 Fallata 或Fellata。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "传统上，富拉尼人以放牧为生，带领牛群迁徙，寻找青草和水源。凭着丰富的自然知识，他们发展出独特的游牧文化。虽然今日仍有许多人维持传统生活方式，但也有不少人已在城镇定居，并在商业贸易领域占有重要地位。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "富拉尼人通常住着简朴的住所，但穿着色彩鲜艳、图案丰富的传统服饰。他们家庭关系紧密，重视礼貌、勤奋和民族文化认同。音乐、口述故事和舞蹈在他们的生活中占有重要地位，是传承历史、价值观和身分认同的重要媒介。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "然而，数百年来，游牧牧民与农民之间持续存在张力与冲突。农民认为",
          "bold": false
        },
        {
          "text": "牧群",
          "bold": true
        },
        {
          "text": "损毁农作物；",
          "bold": false
        },
        {
          "text": "牧民",
          "bold": true
        },
        {
          "text": "则面临牲畜被盗、水源不足及迁徙路线受限等问题。这些处境需要透过和平、理解和彼此支持来化解。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "富拉尼人普遍以穆斯林身分为荣，但因各地生活环境和教育背景不同，他们的身份认同也不尽相同。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "神已经向一些富拉尼人显明自己，在多个国家中兴起了跟随他的人。但他们往往因信仰而受到家人和社区的排斥，也经常面对极端主义势力的威胁。有些人遭受攻击，甚至被迫离开家园，流离失所。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "感谢神，西非部分地区已有成熟的教会和本地牧者，甚至有富拉尼牧者成立了「富拉尼事工」，专门向本民族传福音。尽管如此，富拉尼人当中仍需要更多福音工人和门徒训练事工。",
          "bold": false
        }
      ]
    }
  ],
  "scripture": [
    {
      "runs": [
        {
          "text": "“耶和华要保护你出你入，从今时直到永远。”",
          "bold": true
        }
      ]
    },
    {
      "runs": [
        {
          "text": "诗篇121:8",
          "bold": true
        }
      ]
    }
  ],
  "prayerPoints": [
    {
      "runs": [
        {
          "text": "求圣灵在富拉尼人中兴起不被拦阻的复兴运动，在非洲及世界各地兴起基督门徒、",
          "bold": false
        },
        {
          "text": "属灵领袖",
          "bold": true
        },
        {
          "text": "、牧者和宣教士。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求主差派更多充满爱心、愿意长期委身的工人服事富拉尼人。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "为恐怖主义和暴力事件的受害者祷告，求富拉尼人因福音得着自由、平安与生命的更新。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "为遭受歧视和流离失所的富拉尼难民祷告，求神供应他们一切所需，并帮助他们面对未来的挑战。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求神感动富拉尼领袖，看见下一代接受正规教育的重要性，为年轻人开辟更美好的未来。随着社会变迁、人口增长及资源压力增加，富拉尼人传统的游牧生活方式正面临越来越大的挑战。",
          "bold": false
        }
      ]
    }
  ],
