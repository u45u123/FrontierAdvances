  "generalInformation": [
    {
      "runs": [
        {
          "text": "印度传说提到库姆哈尔人是造物主梵天（ Brahma/Prajapati）的后裔，因此有些人以 Prajapati作为自己的姓氏。他们也认为自己是最早发明陶轮的人。库姆哈尔人这个名字的意思是 “",
          "bold": false
        },
        {
          "text": "制作陶器的人",
          "bold": true
        },
        {
          "text": "”，反映了他们世代相传的传统职业。他们分布于印度各地，并使用当地的语言。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "库姆哈尔人普遍以诚实、勤奋和重视信仰著称。许多人靠务农、饲养牲畜，以及制作陶器和泥塑神像维生。然而，这些工作往往受季节影响，收入并不稳定，许多家庭难以仅靠传统手工业维持生计。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "不少库姆哈尔农民耕种的土地并不属于自己，而是向较高种姓地主租用土地耕作，收成时只能获得部分农作物作为报酬。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "库姆哈尔人迫切需要职业技能培训和更完善的教育资源。由于部分家庭经常迁移居住，孩子们求学经常受到影响。许多儿童为了帮助家庭维持生计，不得不提早离开学校投入工作。此外，他们也常缺乏现代医疗服务和安全洁净的饮用水资源。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "库姆哈尔人大多信奉印度教，主要敬拜湿婆神（Shiva）和母神玛塔（Mata）。",
          "bold": false
        }
      ]
    }
  ],
  "scripture": [
    {
      "runs": [
        {
          "text": "“大户人家不但有金器银器，也有木器瓦器；有作为贵重之用的，有作为卑贱之用的。人若自洁，脱离卑贱的事，必成为贵重的器皿，成为圣洁，合乎主用，预备行各样的善事。”",
          "bold": true
        }
      ]
    },
    {
      "runs": [
        {
          "text": "提摩太后书2:20-21",
          "bold": true
        }
      ]
    }
  ],
  "prayerPoints": [
    {
      "runs": [
        {
          "text": "求神让库姆哈尔人明白，他们并非只是制造陶器的人，更是神亲手所造、 按着祂形像而创造的 器皿。愿他们愿意将生命交在主手中，让这位陶匠继续塑造他们，使他们成为合乎祂心意的",
          "bold": false
        },
        {
          "text": "器皿",
          "bold": true
        },
        {
          "text": "。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "感谢神赐给库姆哈尔人诚实、勤奋和追求信仰的特质。求主使用这些美好的品格，使他们能够反映神的性情，并在生活中见证祂的荣耀。",
          "bold": false
        }
      ]
    }
  ],
