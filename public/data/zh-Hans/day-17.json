  "prayerPoints": [
    {
      "runs": [
        {
          "text": "求神使那些倚靠自身能力、社会地位或 文化优越感 的人明白，救恩惟独在耶稣基督里。愿他们谦卑下来，向福音真理敞开心扉，认识到人无法凭自己的努力得救，唯有靠着耶稣基督的名才能得着救恩。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求神破除马拉塔人强烈的传统观念和宗教认同所带来的拦阻，使他们能够真正听见并领受福音。愿耶稣基督的真理深深触动他们的心。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求父神亲自向马拉塔人显明藉着祂儿子耶稣基督而来的救恩之路和永恒生命，使他们愿意谦卑领受神的恩典与怜悯。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求神赐下智慧，使福音能以合乎当地文化、并能触动人心的方式传扬给马拉塔人，让他们既能理解福音的信息，也能经历福音的大能。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求神的同在临到马拉塔人的村庄和社区，使家庭、邻里和整个群体都经历祂的作为，并开启人心归向基督。",
          "bold": false
        }
      ]
    }
  ],
