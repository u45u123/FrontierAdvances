  "prayerPoints": [
    {
      "runs": [
        {
          "text": "求主拆毁世世代代捆绑拉杰普特人的属灵营垒。愿错误的信仰、偶像崇拜和各样拦阻人认识神的捆绑被打破，取而代之的是对耶稣基督真理的渴慕，使他们在主里面得着真正的自由和救恩。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求主柔软拉杰普特人的心，使他们愿意领受真理。愿耶稣基督的救恩信息深深触动他们的生命；也求神透过异梦、异象和奇妙的相遇向他们显现，使他们亲自经历主的慈爱与恩典。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求神赐给拉杰普特人",
          "bold": false
        },
        {
          "text": "谦卑的心",
          "bold": true
        },
        {
          "text": "，使他们愿意接受福音。愿神更新并洁净他们的文化传统，使其中美善的部分能够荣耀主；也愿他们在保有自身历史传承的同时，发现自己真正的身分乃是至高神的儿女。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求主差派属祂的人进入拉杰普特人当中，以生命见证什么是真正跟随耶稣、敬拜万王之王。愿更多家庭乐意分享神的话语，渴慕寻求神的国，并以祂的旨意为生命的首要目标。",
          "bold": false
        }
      ]
    }
  ],
