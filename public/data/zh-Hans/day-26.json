  "generalInformation": [
    {
      "runs": [
        {
          "text": "洛尔人主要居住在伊朗西部和西南部的札格罗斯山脉（ ZagrosMountains）一带，也有部分人口分布于伊拉克境内。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "传统上，洛尔人属于 ",
          "bold": false
        },
        {
          "text": "游牧民族",
          "bold": true
        },
        {
          "text": "，以放牧为生。每年有六至八个月的时间，他们带着羊群迁徙，居住在以黑色山羊毛编织而成的帐篷中；到了冬季，则会回到固定住所居住数个月。近年来，也有部分洛尔人定居乡村，从事农业生产，以种植小麦和大麦为主。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "在洛尔人的观念中，一位牧人的成功取决于个人能力和运气。社会地位通常与牲畜数量和财富多寡有关。拥有大量牲畜和财富的人处于较高阶层，而较贫穷的人则往往受雇为这些家庭照看羊群。整体而言，多数洛尔人属于社会中的基层群体。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "洛尔人大多信奉什叶派伊斯兰教。他们的宗教生活相对务实，日常宗教实践并不复杂。其中一个重要特色，是他们十分重视纪念圣人的陵墓和圣祠。这些圣祠通常是历史上重要宗教领袖或伊斯兰宗教团体创始人的安息之地。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "许多人相信这些圣祠具有医治能力，因此每年都有不少身体或心理受困扰的人前往朝圣，希望获得帮助和医治。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "目前已知的洛尔族基督徒人数极少。不过，已有部分福音资源和传福音材料以洛尔语制作。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "洛尔人的社会组织以部落为基础。每个部落称为 “il”，由世袭首领 可汗（khan） 领导，而这些首领通常出自部落内部的重要支系。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "然而，他们更需要认识那位真正统管万有的君王，万王之王耶稣基督。",
          "bold": false
        }
      ]
    }
  ],
  "scripture": [
    {
      "runs": [
        {
          "text": "“我是好牧人，好牧人为羊舍命。”",
          "bold": true
        }
      ]
    },
    {
      "runs": [
        {
          "text": "约翰福音 10:11",
          "bold": true
        }
      ]
    }
  ],
  "prayerPoints": [
    {
      "runs": [
        {
          "text": "求主使洛尔人，无论是游牧牧人还是定居农民，都能听见耶稣这位",
          "bold": false
        },
        {
          "text": "好牧人",
          "bold": true
        },
        {
          "text": "的声音，并明白自己也是祂所寻找、所呼召归入羊圈的“另外的羊”",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求神亲自向各部落首领和家族领袖显现，使他们归信基督；愿他们成为福音的桥梁，将好消息带给自己的家人、部落和族群。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求主让基督的福音突破洛尔社会中长期存在的阶层隔阂和贫富鸿沟，使人们在基督里找到真正的合一、尊严和盼望，认识自己同属一位牧人、同归一个羊群。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "为少数已经信主的洛尔信徒祷告，求神坚固他们的信心，并为他们预备属灵同伴和团契生活，使他们不致孤单。也求主感动伊朗教会关心洛尔人，积极寻找机会和途径与他们建立联系，向他们分享福音。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求主兴起更多愿意长期住在洛尔人当中的福音工人，以无条件的爱接纳他们、服事他们，并用生命见证耶稣基督的救恩。",
          "bold": false
        }
      ]
    }
  ],
