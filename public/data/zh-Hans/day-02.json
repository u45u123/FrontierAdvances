  "generalInformation": [
    {
      "runs": [
        {
          "text": "加雷人与索马里人和奥罗莫人都有深厚的历史联系。传统上，他们被视为索马里氏族体系的一部分，在索马里南部扮演重要角色，并参与建立巴拉韦（Barawe）和基斯马尤（Kismayo）等具影响力的城镇。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "与此同时，不少加雷人，特别是居住在埃塞俄比亚和肯尼亚的群体，与奥罗莫人通婚，并接受了部分奥罗莫文化和传统。现今他们主要分布于索马里、埃塞俄比亚和肯尼亚一带，其族群认同和使用的语言也会因居住地区而有所不同。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "正因如此，许多人视他们为连接不同民族与文化的“",
          "bold": false
        },
        {
          "text": "桥梁民族",
          "bold": true
        },
        {
          "text": "”。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "加雷人的生活以社区和畜牧业为中心，主要饲养骆驼、山羊、牛和绵羊。传统上，他们过着游牧生活，居住在可搬迁的圆形棚屋中，牲畜则围在营地中央。部分家庭也从事小规模贸易，以牲畜交换粮食及其他生活用品。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "加雷人大约于十五世纪归信伊斯兰教，现今几乎全数为穆斯林，并严格遵守其信仰传统。大多数人从未听闻福音，而曾接触福音的人，也往往因担心基督信仰会削弱他们的民族认同、社区归属感和传统文化，而选择拒绝接受。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "奥罗莫加雷人的独特之处，在于他们融合了索马里和奥罗莫两种文化传统。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "加雷（Garre）一词源自索马里语，意思是“用来拴住骆驼的",
          "bold": false
        },
        {
          "text": "坚固绳索",
          "bold": true
        },
        {
          "text": "”，象征坚固的联系与连结；在某些方言中，这个词也有 “公义”或“我的家园”的意思。",
          "bold": false
        }
      ]
    }
  ],
  "scripture": [
    {
      "runs": [
        {
          "text": "“若遇敌攻击，孤身难挡，二人就能抵挡他；三股合成的绳子不易折断。”",
          "bold": true
        }
      ]
    },
    {
      "runs": [
        {
          "text": "传道书 4:12",
          "bold": true
        }
      ]
    }
  ],
  "prayerPoints": [
    {
      "runs": [
        {
          "text": "求主耶稣将平安和力量赐给加雷人的社区，藉着三一神那股三重合成、不易折断的绳索，将他们紧紧连结在一起。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求主让加雷人明白，主耶稣渴望他们自己、家族和社区都能与祂建立关系",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求主差派工人进入加雷人当中，与他们建立真诚而长久的友谊，在信任中分享神的话语。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求主加给加雷信徒智慧，知道如何向家人和朋友传讲神的话。成为这片多元地区中福音的",
          "bold": false
        },
        {
          "text": "桥梁和使者",
          "bold": true
        },
        {
          "text": "。",
          "bold": false
        }
      ]
    },
    {
      "runs": [
        {
          "text": "求神感动加雷人中的领袖敞开心门，愿意参与家庭查经聚会，认识神的慈爱与救恩",
          "bold": false
        }
      ]
    }
  ],
